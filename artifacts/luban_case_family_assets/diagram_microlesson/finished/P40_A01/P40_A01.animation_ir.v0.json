  "visual_archetype_decision": {
    "primary_archetype": "scoring_diagnosis_reveal",
    "secondary_archetype": "calculation_structure",
    "visual_primitive": "answer_scan",
    "motion_grammar": "scan_hit_partial_miss_then_formula_chain_then_rewrite",
    "why_this_visual": "本卡的核心难点不是知道验收知识，而是看见一份学生答案逐句被扫描后，哪句命中、哪句半命中、哪句完全漏掉，并把缺口补成可写采分句。",
    "why_not_text": "纯文字解析会让学生继续觉得“我只是少写了一点”。答题纸扫描能把钢筋保护层、结构位置尺寸偏差、合同约定项目、监理组织和88/80双阈值这些漏点逐行显出来，才能训练主观题输出。",
    "must_show_domain_objects": true,
    "domain_visual_plan": [
      {
        "scene": "hook",
        "domain_objects": [
          "答题纸",
          "扫描笔",
          "学生答案片段",
          "实体检验题面"
        ],
        "visual_action": "题面和学生答案先进入白板，扫描笔从第一行扫过，告诉学生这不是背答案，而是查采分缺口。",
        "why_object_not_box": "只用“采分点/漏点”文字框，学生看不见自己的答案哪一行在丢分。"
      },
      {
        "scene": "answer_sheet",
        "domain_objects": [
          "学生答题纸",
          "混凝土强度行",
          "钢筋保护层行",
          "空白漏项行"
        ],
        "visual_action": "答题纸逐行扫描：强度命中、保护层部分命中，结构位置尺寸偏差和合同约定项目以漏项红线退出。",
        "why_object_not_box": "实体检验四项是清单对象，必须在答题纸上逐项看见命中和漏项，不能只写“内容不全”。"
      },
      {
        "scene": "score_atoms",
        "domain_objects": [
          "混凝土构件",
          "钢筋保护层",
          "尺寸偏差尺",
          "合同约定项目标签"
        ],
        "visual_action": "四个实体检验对象从构件旁逐个进入采分槽，缺失对象被红色占位提示补写。",
        "why_object_not_box": "如果只列四个词，学生仍会把后三项当可有可无；对象进入采分槽才能说明每项都是得分物。"
      },
      {
        "scene": "organization_gap",
        "domain_objects": [
          "监理单位",
          "施工单位",
          "见证标记",
          "组织箭头"
        ],
        "visual_action": "施工单位组织箭头被淘汰，监理组织、施工实施、监理见证三段箭头按顺序亮起。",
        "why_object_not_box": "主体错是单位角色错位，不画监理/施工对象，就会退化成“主体不准确”的空话。"
      },
      {
        "scene": "calculation_gap",
        "domain_objects": [
          "C35 构件",
          "三个芯样 28.5/31/32",
          "平均值标尺",
          "最小值标尺",
          "88%/80%阈值线"
        ],
        "visual_action": "三个芯样进入公式链，平均值和最小值分别命中88%和80%阈值线，直接比35的错误路径被划掉。",
        "why_object_not_box": "计算判定必须看见芯样数值如何进入两条阈值线，文字框不能解释“为什么不能直接比设计值”。"
      },
      {
        "scene": "rewrite",
        "domain_objects": [
          "标准答题纸",
          "内容清单格",
          "组织主体格",
          "判定依据格"
        ],
        "visual_action": "三个采分格按扫描结果补齐，学生原答案中可保留的行被迁移到标准答题纸，漏项格逐个填入。",
        "why_object_not_box": "作答层最终训练的是改写动作，必须看见原答案如何移动、补齐、重排到标准答案。"
      },
      {
        "scene": "score",
        "domain_objects": [
          "最终答题纸",
          "命中/半命中/漏点标记",
          "补写句"
        ],
        "visual_action": "扫描笔最后从上到下扫完整答题纸，hit/partial/miss 收束成“补这三句”的采分动作。",
        "why_object_not_box": "最终不是记知识点，而是产出能拿分的句子；必须落在答题纸对象上。"
      }
    ],
    "pure_text_allowed": false
  },
