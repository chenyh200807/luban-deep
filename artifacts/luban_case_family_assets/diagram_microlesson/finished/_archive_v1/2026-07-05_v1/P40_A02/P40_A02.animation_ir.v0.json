    "motion_grammar": "hidden_section_open_then_sample_branch_then_answer_scan",
    "why_this_visual": "A02 的认知难点是先定位题干环节，再看材料样品和隐蔽部位是否在不可逆覆盖前通过复验、见证、隐蔽验收。流程 trace 能讲时机，分支淘汰能讲材料/见证/隐蔽三类陷阱。",
    "why_not_text": "纯文字框会把“合格证、复验、见证、隐蔽验收”变成并列名词，学生仍看不见样品何时被抽走、见证链哪里断、墙体覆盖后为什么补验无效，也看不见 A02 与 A01 层级验收程序的边界。",
    "must_show_domain_objects": true,
    "domain_visual_plan": [
      {
        "scene": "hook",
        "domain_objects": [
          "隐蔽部位剖面",
          "覆盖板",
          "材料样品",
          "合格证"
        ],
        "visual_action": "隐蔽剖面先打开，覆盖板试图合上；未复验的材料样品和只有合格证的托盘被红灯挡住。",
        "why_object_not_box": "只写“隐蔽前验收”看不出覆盖后不可见；必须看见剖面被盖住前的窗口。"
      },
      {
        "scene": "material_gate",
        "domain_objects": [
          "材料托盘",
          "合格证",
          "外观检查灯",
          "复验闸门"
        ],
        "visual_action": "材料托盘先查凭证、数量、规格、外观；合格证只能点亮第一盏灯，涉及安全节能的样品被送进复验闸。",
        "why_object_not_box": "合格证与复验是两道不同闸，文字框容易让学生误判有证即用。"
      },
      {
        "scene": "retest_list",
        "domain_objects": [
          "钢筋样品",
          "水泥袋",
          "保温板样品",
          "复验清单格"
        ],
        "visual_action": "样品逐个落到复验清单格；普通钢筋五格亮起，成型钢筋的弯曲格灰掉，保温板导热/密度/燃烧性能格亮起。",
        "why_object_not_box": "复验项目是列全题，必须看见样品对应哪些检测格，而不是背一句“材料复验”。"
      },
      {
        "scene": "witness_chain",
        "domain_objects": [
          "现场取样台",
          "建设单位见证人章",
          "见证记录表",
          "检测机构核验章"
        ],
        "visual_action": "样品在现场取样台被抽取，建设单位见证人章、见证记录、检测机构核验章依次落下；监理确认章和试验员记录章被淘汰。",
        "why_object_not_box": "见证取样考主体和时机，必须看见谁盖章、谁填记录、何时送检。"
      },
      {
        "scene": "hidden_shutter",
        "domain_objects": [
          "节能隐蔽剖面",
          "基层",
          "保温层",
          "热桥处理",
          "隔汽层",
          "隐检记录快门"
        ],
        "visual_action": "墙/屋面剖面保持打开，基层、保温材料、热桥、隔汽层逐项扫描；隐检记录快门先拍下，覆盖板才允许合上。",
        "why_object_not_box": "隐蔽验收是覆盖前的实时见证，不能用“隐蔽验收”四个字替代剖面扫描。"
      },
      {
        "scene": "branch_trap",
        "domain_objects": [
          "有证即用支路",
          "自取自送支路",
          "覆盖后补验支路",
          "合格使用/覆盖主线"
        ],
        "visual_action": "三条错误支路从主流程分出并被红叉淘汰，合格使用/覆盖主线只在复验、见证、隐检记录齐全后亮绿。",
        "why_object_not_box": "A02 是找错型，必须让错支路退出，学生才会知道每个错误为什么扣分。"
      },
      {
        "scene": "score",
        "domain_objects": [
          "答题纸",
          "采分扫描笔",
          "材料样品缩略图",
          "隐蔽剖面缩略图"
        ],
        "visual_action": "扫描笔把现场对象压成答题纸：先定环节、复验见证、覆盖前验收记录、合格后使用或覆盖。",
        "why_object_not_box": "最终要训练主观题采分句，必须从样品和剖面落到答题纸，不是再给一页文字总结。"
      }
    ],
    "pure_text_allowed": false
  },
