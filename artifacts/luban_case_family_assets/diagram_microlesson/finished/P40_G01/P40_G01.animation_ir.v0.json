  "main_exam_action": "把基坑降水案例题先画成剖面: 深度线、填土层、承压水、井点和分层厚度先命中, 再写成“不妥-理由-正确做法”的采分句。",
  "visual_archetype_decision": {
    "primary_archetype": "section_or_spatial_reveal",
    "secondary_archetype": "scoring_diagnosis_reveal",
    "visual_primitive": "pit_threshold_board + answer_scan",
    "motion_grammar": "blueprint_pit_section_reveals_ground_layers_threshold_lines_then_method_objects_trace_into_score_lines",
    "why_this_visual": "G01 虽然是案例题作答层, 但学生真正错在没有把题干工程对象看成空间约束: 深度线、填土层、承压水和分层厚度会直接决定答案。主视觉必须先画工程剖面, 再把采分句贴回图上。",
    "why_not_text": "只用文字框或答题纸扫描会把“管井、回灌、5m分层”讲成抽象判断, 看不见管井为什么被填土淘汰、6m为什么回判轻型井点、回灌为什么不进入承压水突涌口、5m为什么超过≤3m控制。",
    "must_show_domain_objects": true,
    "pure_text_allowed": false,
    "domain_visual_plan": [
      {
        "scene": "hook",
        "domain_objects": [
          "基坑剖面",
          "地面线",
          "填土层",
          "地下水线",
          "承压水层",
          "管井井点",
          "轻型井点",
          "3m/6m阈值线"
        ],
        "visual_action": "深色蓝图板入场, 地面线、U形基坑、填土层、地下水线和承压水层先画出; 3m与6m虚线落下, 管井被红叉淘汰, 轻型井点贴到坑边。",
        "why_object_not_box": "G01 的错法来自现场工况误读, 只放答题纸文字会看不见“填土淘汰管井、6m回判轻型井点”的工程原因。"
      },
      {
        "scene": "threshold_map",
        "domain_objects": [
          "开挖深度H轴",
          "3m分流线",
          "6m本题线",
          "填土层",
          "管井井管",
          "轻型井点管列"
        ],
        "visual_action": "H轴从地面向下扫描, 黄色>3m线先把明排分流出去, 红色6m线回到轻型井点适用深度, 管井井管被填土层红线命中退出。",
        "why_object_not_box": "选型是深度线和土层共同命中的结果, 用判断框会把它误讲成背方法名。"
      },
      {
        "scene": "scan_method",
        "domain_objects": [
          "基坑剖面",
          "填土层",
          "6m深度线",
          "管井淘汰叉",
          "轻型井点",
          "采分句落点"
        ],
        "visual_action": "剖面对象保留, 从填土层、6m线和轻型井点各拉一条扫描线到底部规则卡, 组合成“不妥-理由-正确做法”。",
        "why_object_not_box": "作答层不是把答案贴纸上, 而是把工程对象转译为可给分句; 必须看见对象到句子的 trace。"
      },
      {
        "scene": "trap_inrush",
        "domain_objects": [
          "回灌井",
          "周边沉降路径",
          "承压水突涌箭头",
          "钻孔减压线",
          "水平封底隔渗线"
        ],
        "visual_action": "回灌井箭头只导向坑外沉降控制, 承压水向上突涌箭头从坑底冒出; 减压线和封底隔渗线进入突涌口, 回灌路径被挡回。",
        "why_object_not_box": "回灌和防突涌是不同工程职能, 不画水压路径就会继续误把“地下水相关”当成同一措施。"
      },
      {
        "scene": "correction_sentence",
        "domain_objects": [
          "基坑深度尺",
          "5m红色超限段",
          "≤3m绿色控制段",
          "地面线",
          "分层开挖剖面"
        ],
        "visual_action": "红色5m段落在开挖深度尺上显示超限, 绿色≤3m段覆盖到正确控制厚度, 底部规则卡把错误数值和正确门槛连成一句。",
        "why_object_not_box": "分层题扣的是数字空间尺度, 只写文字“适当减小”看不出为什么不够给分。"
      },
      {
        "scene": "score",
        "domain_objects": [
          "完整基坑剖面",
          "管井淘汰标记",
          "轻型井点",
          "≤3m分层段",
          "承压水突涌措施",
          "回灌沉降路径"
        ],
        "visual_action": "最终蓝图同时保留四类对象, 底部规则卡逐行汇总选型、分层、突涌、回灌职能, 每一行都能回追到图中对象。",
        "why_object_not_box": "最终答案必须能从现场对象逐行 trace 到采分句, 不是把四个关键词列成文字清单。"
      }
    ]
  },
