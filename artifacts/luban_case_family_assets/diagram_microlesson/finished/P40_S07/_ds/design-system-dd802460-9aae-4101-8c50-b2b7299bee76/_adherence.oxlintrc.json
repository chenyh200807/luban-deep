{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": []
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Sans SC|Long Cang))/i]",
        "message": "Font not provided by the design system. Available: Noto Sans SC, Long Cang."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--app-dark",
      "--app-darker",
      "--app-darkest",
      "--band-extreme",
      "--band-extreme-d",
      "--band-general",
      "--band-general-d",
      "--band-larger",
      "--band-larger-d",
      "--band-major",
      "--band-major-d",
      "--blue",
      "--brand-red",
      "--font-body",
      "--font-chop",
      "--fs-body",
      "--fs-caption",
      "--fs-chop",
      "--fs-micro",
      "--fs-min",
      "--fs-mini",
      "--fs-score",
      "--fs-stage",
      "--fs-tiny",
      "--fs-title",
      "--fw-black",
      "--fw-bold",
      "--fw-medium",
      "--fw-regular",
      "--green",
      "--green-light",
      "--hat-yellow",
      "--hat-yellow-d",
      "--highlight",
      "--ink",
      "--ink-2",
      "--ink-soft",
      "--orange",
      "--orange-deep",
      "--pad-card",
      "--pad-controls",
      "--pad-header",
      "--paper",
      "--paper-dot",
      "--r-button",
      "--r-card",
      "--r-object",
      "--r-pill",
      "--r-tag",
      "--sh-float-grn",
