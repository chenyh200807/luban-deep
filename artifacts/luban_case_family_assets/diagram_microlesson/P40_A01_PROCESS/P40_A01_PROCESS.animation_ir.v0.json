    "motion_grammar": "site_object_trace_then_answer_scan",
    "why_this_visual": "本卡最难的不是记住四级名词，而是看见质量风险如何被最小检验批先拦住，再由合格记录托起分项、分部、单位工程。",
    "why_not_text": "纯文字流程框会让学生误以为“报验、检查、验收、记录”只是背诵顺序。必须看见报验单推动检验批小车进现场闸门、检查人员签认、记录表归档、合格结论向上堆层，才知道为什么漏前置会导致上一级悬空。",
    "must_show_domain_objects": true,
    "domain_visual_plan": [
      {
        "scene": "hook",
        "domain_objects": [
          "施工现场",
          "检验批小车",
          "报验单",
          "下道工序遮盖层"
        ],
        "visual_action": "检验批小车带着报验单从现场入口进入，未验收就想进入下道工序的遮盖层被红色闸门挡回。",
        "why_object_not_box": "只写“验收前置”四个字，学生看不见缺陷被覆盖后为什么不可逆。"
      },
      {
        "scene": "self_check",
        "domain_objects": [
          "施工单位自检章",
          "检验批",
          "报验单",
          "整改回路线"
        ],
        "visual_action": "施工单位先在检验批上盖自检章；未盖章的报验单被退回整改，盖章后才沿蓝色路径报监理。",
        "why_object_not_box": "自检是责任闭环，不是流程框中的一个词；必须看见未自检的报验单被退回。"
      },
      {
        "scene": "site_acceptance",
        "domain_objects": [
          "监理/建设检查人员",
          "主控项目红闸",
          "一般项目80%标尺",
          "现场检验批"
        ],
        "visual_action": "检查人员进入现场，主控闸必须全部亮绿，一般项目沿80%标尺通过；主控不合格的检验批被挡住。",
        "why_object_not_box": "主控与一般是不同判定机制，文字框会把它们误压成同一个百分比条件。"
      },
      {
        "scene": "record_lift",
        "domain_objects": [
          "验收记录表",
          "签认笔",
          "检验批砖块",
          "分项工程层"
        ],
        "visual_action": "通过的检验批生成验收记录表，记录表归档后检验批砖块升起并拼入分项工程层。",
        "why_object_not_box": "记录不是附属文书，而是上一级验收消费的证据；要看见记录把砖块托起。"
      },
      {
        "scene": "level_stack",
        "domain_objects": [
          "检验批砖",
          "分项层",
          "分部层",
          "单位工程封顶",
          "悬空屋顶"
        ],
        "visual_action": "检验批砖自下而上堆成分项、分部、单位；镜头尝试先放单位工程屋顶，屋顶悬空闪红并退出。",
        "why_object_not_box": "四级名词若只排成列表，学生仍可能从大往小写；建筑堆层能直接证伪倒装。"
      },
      {
        "scene": "reject_branch",
        "domain_objects": [
          "不合格小车",
          "返修/返工轨",
          "实体检验补证轨",
          "严禁验收终止轨"
        ],
        "visual_action": "红灯小车不直接销毁，而是分流到返修重验、补证、加固评估，只有仍不满足安全/重要使用要求才进入严禁验收终止轨。",
        "why_object_not_box": "不合格处理是分支轨道，不能用一句“不合格返工”替代。"
      },
      {
        "scene": "score",
        "domain_objects": [
          "最终答题纸",
          "流程箭头",
          "四级堆层缩略图",
          "采分句扫描笔"
        ],
        "visual_action": "扫描笔把流程对象压成答题纸采分句：先自检报验、再现场验收记录、再下级合格托起上级。",
        "why_object_not_box": "最终训练的是主观题输出，必须从现场对象落到答题纸，不是再给学生看一张文字总结。"
      }
    ],
