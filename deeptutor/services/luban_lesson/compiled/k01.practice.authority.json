    {
      "answer_type": "single_choice",
      "rule_group": "责任归因·主体维",
      "stem": "施工中发生设计变更（发包人原因）致承包人停工。就该索赔能否成立，选出最完整、能得分的定性作答。",
      "model_answer": "本事件属发包人原因（设计变更），责任在发包人；应分别就工期、费用、利润逐项判成立性，不合并成一句「可索赔」。",
      "options": [
        {
          "text": "设计变更应属承包人自身施工方案的问题，由此产生的停工损失应由承包人自行承担。",
          "is_correct": false,
          "source_error_code": "E08",
          "temptation": "没抓住「设计变更是发包人给的」这个背景。",
          "loss_reason": "责任方判反，后面工期费用连锁全错。",
          "fix": "设计变更属发包人原因，责任在发包人。",
          "option_id": "K01-html-practice-html-q1-5a5b246f81f9:option-1"
        },
        {
          "text": "既然责任在发包人一方，那么工期与费用便都随之成立，一并按发包人责任赔付即可，无需再逐项判。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "「责任在对方就全赔」最顺手，一句话省事。",
          "loss_reason": "把工期和费用绑死了——工期还得过关键线路/总时差闸，不能凭责任一刀切。",
          "fix": "定责任后，工期看网络位置、费用看责任，两闸分开判。",
          "option_id": "K01-html-practice-html-q1-5a5b246f81f9:option-2"
        },
        {
          "text": "本事件属发包人原因（设计变更），责任在发包人；应分别就工期、费用、利润逐项判成立性。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "点责任方 + 分项判工期/费用/利润，定性地基就稳了。",
          "option_id": "K01-html-practice-html-q1-5a5b246f81f9:option-3"
        },
        {
          "text": "该索赔应予成立，承包人可据此向发包人一并主张，按实际发生额赔付即可。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "知道是发包人责任，图省事一句带过。",
          "loss_reason": "没写责任方、没分工期/费用/利润，采分点几乎全漏。",
          "fix": "点明发包人原因、责任在发包人，并分项判工期/费用/利润。",
          "option_id": "K01-html-practice-html-q1-5a5b246f81f9:option-4"
        }
      ],
