    {
      "answer_type": "single_choice",
      "rule_group": "施工缝·数值",
      "stem": "柱、墙水平施工缝距结构上表面的距离，选出数值正确的作答。",
      "model_answer": "柱水平施工缝距结构上表面0~100mm；墙0~300mm；均留在梁板顶面等受剪力较小处。",
      "options": [
        {
          "text": "柱水平施工缝距结构上表面0~100mm，墙0~300mm，都留在梁板顶面等受剪力较小处。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "柱0~100、墙0~300分清，数值维采分到位。",
          "option_id": "C01-html-practice-html-q4-cab9423f74d4:option-1"
        },
        {
          "text": "柱、墙水平施工缝一律距结构上表面0~300mm，两者按同一数值控制即可。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "记了0~300一个数就套用到柱。",
          "loss_reason": "柱是0~100mm、墙才0~300mm，数值混淆。",
          "fix": "柱0~100mm、墙0~300mm，分开记。",
          "option_id": "C01-html-practice-html-q4-cab9423f74d4:option-2"
        },
        {
          "text": "柱的水平施工缝留在柱中段受力较大处，便于后续接柱、施工方便。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "「施工方便」当挡箭牌。",
          "loss_reason": "应留梁板顶面受剪力较小处，留柱中段位置错。",
          "fix": "柱留基础/楼板/梁顶面，距上表面0~100mm。",
          "option_id": "C01-html-practice-html-q4-cab9423f74d4:option-3"
        },
        {
          "text": "柱墙水平缝的具体高度不重要，只要留在竖向构件上、方便支模就行。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "弱化数值、只谈方便。",
          "loss_reason": "漏了0~100/0~300mm的具体数值采分点。",
          "fix": "写明柱0~100mm、墙0~300mm。",
          "option_id": "C01-html-practice-html-q4-cab9423f74d4:option-4"
        }
      ],
