    {
      "answer_type": "single_choice",
      "rule_group": "施工缝·次梁1/3",
      "stem": "有主次梁的楼板，施工缝应留在哪里？选出正确、能得分的作答。",
      "model_answer": "施工缝留在次梁跨中1/3范围内（受剪力较小段）。",
      "options": [
        {
          "text": "施工缝留在次梁跨中1/3范围内，该段受剪力较小、便于施工。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "「次梁+跨中+1/3范围」三要素齐，位置采分满。",
          "option_id": "C01-html-practice-html-q5-5ecb69769696:option-1"
        },
        {
          "text": "施工缝留在次梁支座处，紧挨支座留缝、方便钢筋搭接和支模。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "支座处「结实」的错觉。",
          "loss_reason": "支座受剪力最大，恰是不该留缝的位置。",
          "fix": "留次梁跨中1/3范围内受剪力较小处。",
          "option_id": "C01-html-practice-html-q5-5ecb69769696:option-2"
        },
        {
          "text": "施工缝随便留在跨中某一点即可，不用限定1/3范围，跨中都行。",
          "is_correct": false,
          "source_error_code": "E03",
          "temptation": "知道跨中，但漏了1/3。",
          "loss_reason": "缺「1/3范围」关键词，范围不写清扣分。",
          "fix": "须写次梁跨中1/3范围内。",
          "option_id": "C01-html-practice-html-q5-5ecb69769696:option-3"
        },
        {
          "text": "有主次梁的楼板，施工缝留在主梁跨中1/3范围内，按主梁定位。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "主次梁认错，跟着大的走。",
          "loss_reason": "规定是次梁跨中1/3，构件对象错。",
          "fix": "是次梁跨中1/3，不是主梁。",
          "option_id": "C01-html-practice-html-q5-5ecb69769696:option-4"
        }
      ],
