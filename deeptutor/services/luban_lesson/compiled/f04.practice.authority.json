    {
      "answer_type": "single_choice",
      "rule_group": "附加层·顺序维",
      "stem": "阴阳角、管根、地漏等薄弱部位的防水做法与施工顺序，选出能得分的作答。",
      "model_answer": "阴阳角/管根/地漏等部位先做附加层、夹铺胎体增强材料，再施工大面卷材。",
      "options": [
        {
          "text": "在阴阳角、管根、地漏等部位先做附加层、夹铺胎体增强材料，再施工大面卷材。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "先做附加层＋夹胎体增强＋后铺大面，层序采分句齐。",
          "option_id": "F04-html-practice-html-q2-444042f4fae7:option-1"
        },
        {
          "text": "先铺完大面卷材，再在阴阳角、管根等薄弱处补做附加层。",
          "is_correct": false,
          "source_error_code": "E06",
          "temptation": "觉得大面先铺完、回头补节点更方便。",
          "loss_reason": "顺序反了，应先做节点附加层再铺大面，先大面后补＝程序错。",
          "fix": "先做节点附加层、再铺大面。",
          "option_id": "F04-html-practice-html-q2-444042f4fae7:option-2"
        },
        {
          "text": "阴阳角管根处把大面卷材延伸盖住即可，不单独做附加层。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "以为大面盖住就够。",
          "loss_reason": "漏了『先做附加层、夹胎体增强材料』这一采分点。",
          "fix": "薄弱节点先做附加层、夹铺胎体增强材料。",
          "option_id": "F04-html-practice-html-q2-444042f4fae7:option-3"
        },
        {
          "text": "附加层做在大面卷材外侧最上层，起面层保护作用。",
          "is_correct": false,
          "source_error_code": "M01",
          "temptation": "把附加层当保护面层。",
          "loss_reason": "附加层是节点处、大面之下的补强层，位置层序记反。",
          "fix": "附加层先做在节点、位于大面之下。",
          "option_id": "F04-html-practice-html-q2-444042f4fae7:option-4"
        }
      ],
      "variant_id": "F04-html-practice-html-q2-444042f4fae7",
