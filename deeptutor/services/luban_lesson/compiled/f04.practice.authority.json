    {
      "answer_type": "single_choice",
      "rule_group": "管根套管·数值维",
      "stem": "穿楼板管道套管处的防水做法，选出能得分的作答。",
      "model_answer": "管根密封，穿楼板套管与管道间用防水密封材料嵌填压实，套管高出装饰面≥20mm。",
      "options": [
        {
          "text": "管根密封，套管与管道间用防水密封材料嵌填压实，套管高出装饰面≥20mm。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "管根密封＋嵌填压实＋高出≥20mm，三处采分句齐。",
          "option_id": "F04-html-practice-html-q3-e7f6c23a2fca:option-1"
        },
        {
          "text": "套管与管道间嵌填密封，套管高出装饰面≥10mm即可。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "记得要高出、数值记成10。",
          "loss_reason": "数值错，规范是套管高出装饰面≥20mm。",
          "fix": "套管高出装饰面≥20mm。",
          "option_id": "F04-html-practice-html-q3-e7f6c23a2fca:option-2"
        },
        {
          "text": "套管与管道间用密封材料嵌填压实即可，管根、套管高出尺寸不必强调。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "抓住嵌填一项就以为够。",
          "loss_reason": "漏了管根密封和套管高出装饰面≥20mm两处采分点。",
          "fix": "补管根密封、套管高出装饰面≥20mm。",
          "option_id": "F04-html-practice-html-q3-e7f6c23a2fca:option-3"
        },
        {
          "text": "套管应低于装饰面、埋进面层里，避免外露磕碰。",
          "is_correct": false,
          "source_error_code": "M03",
          "temptation": "怕外露磕碰想埋进面层。",
          "loss_reason": "方向反了，套管要高出装饰面防漫水，不是埋低。",
          "fix": "套管应高出装饰面≥20mm。",
          "option_id": "F04-html-practice-html-q3-e7f6c23a2fca:option-4"
        }
      ],
