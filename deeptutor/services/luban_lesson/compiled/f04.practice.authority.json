  "items": [
    {
      "answer_type": "single_choice",
      "rule_group": "阴阳角·条件维",
      "stem": "屋面卷材防水施工，阴阳角基层的处理做法，选出最能得分的作答。",
      "model_answer": "阴阳角基层宜做圆弧或45度，使卷材平顺过渡、不翘空刺破；基层坚实平整无浮浆起砂裂缝。",
      "options": [
        {
          "text": "阴阳角基层做成圆弧或45度，使卷材平顺过渡、不翘空刺破。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "点出圆弧/45度＋卷材平顺，转角这块采分句写全。",
          "option_id": "F04-html-practice-html-q1-bd09304b7137:option-1"
        },
        {
          "text": "阴阳角基层做成规整的直角，卷材沿直角折压密实即可。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "直角看着规整、施工顺手。",
          "loss_reason": "直角处卷材翘空、应力集中最先开裂，不符合『宜做圆弧或45度』。",
          "fix": "阴阳角基层应做圆弧或45度。",
          "option_id": "F04-html-practice-html-q1-bd09304b7137:option-2"
        },
        {
          "text": "阴阳角处只把大面卷材多刷一遍涂料加厚，不改基层转角形状。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "以为多刷加厚就够。",
          "loss_reason": "没解决直角翘空的几何问题，也漏了圆弧/45度做法。",
          "fix": "先把基层阴阳角做成圆弧或45度。",
          "option_id": "F04-html-practice-html-q1-bd09304b7137:option-3"
        },
        {
          "text": "阴阳角做成向外凸的尖角，让卷材绷紧贴合更牢。",
          "is_correct": false,
          "source_error_code": "M03",
          "temptation": "把『处理阴阳角』误记成做尖角。",
          "loss_reason": "尖角同样应力集中、卷材更易破，概念反了。",
          "fix": "应做圆弧或45度过渡，不是做尖角。",
          "option_id": "F04-html-practice-html-q1-bd09304b7137:option-4"
        }
      ],
      "variant_id": "F04-html-practice-html-q1-bd09304b7137",
      "surface_id": "practice.html",
