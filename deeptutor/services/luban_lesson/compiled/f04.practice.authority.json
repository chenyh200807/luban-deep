    {
      "answer_type": "single_choice",
      "rule_group": "施工顺序·条件维",
      "stem": "屋面卷材防水施工顺序，下列说法正确的是。",
      "model_answer": "应先进行细部节点构造处理、再施工大面；门窗框/管道等部件安装完毕后再做防水。",
      "options": [
        {
          "text": "卷材防水应先施工细部节点、再施工大面；门窗框/管道等部件安装完毕后再做防水。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "先细部后大面＋部件装完再防水，顺序采分句齐。",
          "option_id": "F04-html-practice-html-q4-c3b5b6ab6b4c:option-1"
        },
        {
          "text": "为赶进度先铺大面卷材，节点等大面干后再回头处理。",
          "is_correct": false,
          "source_error_code": "E06",
          "temptation": "先铺大面显得进度快。",
          "loss_reason": "先后顺序错，应先细部后大面。",
          "fix": "先做细部节点、再施工大面。",
          "option_id": "F04-html-practice-html-q4-c3b5b6ab6b4c:option-2"
        },
        {
          "text": "大面与细部同时施工、谁快先做谁，先后无所谓。",
          "is_correct": false,
          "source_error_code": "M03",
          "temptation": "觉得都要做、无所谓先后。",
          "loss_reason": "规范明确先细部后大面，顺序是采分点。",
          "fix": "必须先细部后大面。",
          "option_id": "F04-html-practice-html-q4-c3b5b6ab6b4c:option-3"
        },
        {
          "text": "只要门窗框、管道装完就能防水，节点先后不用管。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "只记住『部件装完再防水』。",
          "loss_reason": "漏了『先细部后大面』这一核心顺序采分点。",
          "fix": "补『先做节点处理、再施工大面』。",
          "option_id": "F04-html-practice-html-q4-c3b5b6ab6b4c:option-4"
        }
      ],
