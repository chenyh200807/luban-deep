    },
    {
      "answer_type": "single_choice",
      "rule_group": "铺填·程序维",
      "stem": "对基础两侧（或周边）进行回填时，正确做法是？",
      "model_answer": "相对两侧或周边应对称、均衡回填，防止结构偏压。",
      "options": [
        {
          "text": "相对两侧（或周边）应对称、均衡回填，避免单侧受力使结构偏移。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "点出对称均衡+防偏压。",
          "option_id": "G02-html-practice-html-q4-9a0b35a1c05a:option-1"
        },
        {
          "text": "先把一侧回填压实到顶，再回填另一侧，逐侧完成效率高。",
          "is_correct": false,
          "source_error_code": "E06",
          "temptation": "觉得一侧干完再干一侧省事。",
          "loss_reason": "单侧回填致结构偏压移位。",
          "fix": "两侧应对称、均衡同步回填。",
          "option_id": "G02-html-practice-html-q4-9a0b35a1c05a:option-2"
        },
        {
          "text": "两侧分层回填即可，是否对称无所谓，压实达标就行。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "只记分层，忽略对称。",
          "loss_reason": "漏'对称'，单侧仍会偏压。",
          "fix": "必须相对两侧对称均衡回填。",
          "option_id": "G02-html-practice-html-q4-9a0b35a1c05a:option-3"
        },
        {
          "text": "哪侧空间大先填哪侧，方便机械进出。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "按施工便利决定顺序。",
          "loss_reason": "忽视结构受力对称要求。",
          "fix": "以结构受力为准，两侧对称回填。",
          "option_id": "G02-html-practice-html-q4-9a0b35a1c05a:option-4"
        }
      ],
      "variant_id": "G02-html-practice-html-q4-9a0b35a1c05a",
