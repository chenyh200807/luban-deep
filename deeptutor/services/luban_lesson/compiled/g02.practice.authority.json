    {
      "answer_type": "single_choice",
      "rule_group": "采分诊断·末题",
      "stem": "某学生就'振动压实机回填施工纠错'作答：②铺得太厚应薄一点；③压得太少多压几遍；④环刀取样送检没问题；①土料没看出问题。选出最准确的诊断与补写。",
      "model_answer": "②③方向对但缺数值（应250-350mm、3-4遍）；④多层环刀统一送检不妥、应标准击实法；①建筑垃圾未识别；四处都要补写。",
      "options": [
        {
          "text": "②③方向对但缺数值（应250-350mm、3-4遍）；④多层环刀统一送检不妥、应用标准击实法；①建筑垃圾未识别——四处都要补写。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "半命中补数值 + 两处漏点全揪出，这就是'会写答案'。",
          "option_id": "G02-html-practice-html-q16-d5e2e8aea5ac:option-1"
        },
        {
          "text": "作答基本正确，只是表述口语化，方向都对，可给满分。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "看方向对就以为拿满分。",
          "loss_reason": "缺数值=半分，且漏④环刀送检与①建筑垃圾两处。",
          "fix": "补数值 + 补④标准击实法、①清除建筑垃圾两处。",
          "option_id": "G02-html-practice-html-q16-d5e2e8aea5ac:option-2"
        },
        {
          "text": "只需把'薄一点''多压几遍'改成具体数值即可，其余都对。",
          "is_correct": false,
          "source_error_code": "E03",
          "temptation": "抓到缺数值一处。",
          "loss_reason": "漏诊④环刀统一送检、①建筑垃圾两处不妥。",
          "fix": "除补数值，还要指④用标准击实法、①清除建筑垃圾。",
          "option_id": "G02-html-practice-html-q16-d5e2e8aea5ac:option-3"
        },
        {
          "text": "环刀法本身违规，四处主要错在都用了环刀，改灌砂法即可。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "以为错在环刀法本身。",
          "loss_reason": "错在多层统一送检不分层，非环刀法被禁；且漏其他失分。",
          "fix": "④错在统一送检、应标准击实法逐层；另补数值与建筑垃圾。",
          "option_id": "G02-html-practice-html-q16-d5e2e8aea5ac:option-4"
        }
      ],
