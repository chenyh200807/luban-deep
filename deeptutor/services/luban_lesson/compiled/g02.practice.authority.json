  "items": [
    {
      "answer_type": "single_choice",
      "rule_group": "选料·条件维",
      "stem": "关于填方土料的选择，下列作答完整、能得分的是？",
      "model_answer": "尽量采用同类土；不得用淤泥、淤泥质土、有机质大于5%的土、含水量不符压实要求的黏性土；砂、碎石土可用。",
      "options": [
        {
          "text": "尽量采用同类土；淤泥、淤泥质土、有机质大于5%的土、含水量不符压实要求的黏性土不得用作填方。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "优选同类土 + 完整禁用四类，一句写全。",
          "option_id": "G02-html-practice-html-q2-613193ea6d75:option-1"
        },
        {
          "text": "只要不是淤泥就能填，砂、碎石、黏土随取随填省成本。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "以为只忌讳淤泥一种。",
          "loss_reason": "漏了淤泥质土/有机质>5%/含水量不符黏性土三类禁用。",
          "fix": "禁用四类写全，并点'尽量同类土'。",
          "option_id": "G02-html-practice-html-q2-613193ea6d75:option-2"
        },
        {
          "text": "填方土料越黏越密实，应优先选含水量高的黏性土回填。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "以为黏土密实、含水多好压。",
          "loss_reason": "含水量不符压实要求的黏性土恰是禁用项，概念反了。",
          "fix": "含水量不符要求的黏性土禁用，应选可压密的砂、碎石、同类土。",
          "option_id": "G02-html-practice-html-q2-613193ea6d75:option-3"
        },
        {
          "text": "淤泥、有机质土只要掺点石灰改良，都可直接用作填方无限制。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "以为掺灰改良就能随便用。",
          "loss_reason": "本考点口径淤泥/有机质>5%属禁用，不以'掺石灰'为由放开。",
          "fix": "按规范禁用四类，不随意放开。",
          "option_id": "G02-html-practice-html-q2-613193ea6d75:option-4"
        }
      ],
      "variant_id": "G02-html-practice-html-q2-613193ea6d75",
      "surface_id": "practice.html",
      "source_index": 1,
      "source_group": "Q",
