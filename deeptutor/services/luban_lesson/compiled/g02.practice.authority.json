    },
    {
      "answer_type": "single_choice",
      "rule_group": "铺填·程序维",
      "stem": "土方回填时，填土的起填位置与铺填方式，正确的是？",
      "model_answer": "填土从场地最低处开始，由下而上整个宽度分层铺填。",
      "options": [
        {
          "text": "填土从场地最低处开始，由下而上整个宽度分层铺填。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "起填位置+由下而上+整宽分层，一句齐。",
          "option_id": "G02-html-practice-html-q3-97671409244c:option-1"
        },
        {
          "text": "从场地最高处往低处赶，一次填到设计标高后再统一压实。",
          "is_correct": false,
          "source_error_code": "E06",
          "temptation": "觉得从高处推土顺势方便。",
          "loss_reason": "起填位置错、且不分层，下部压不实。",
          "fix": "应从最低处起、由下而上分层铺。",
          "option_id": "G02-html-practice-html-q3-97671409244c:option-2"
        },
        {
          "text": "从最低处开始铺即可，厚度铺到多少不影响，压一遍成活。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "记住最低处起就以为够了。",
          "loss_reason": "漏了分层与厚度控制。",
          "fix": "补'由下而上整宽分层'+按机具控厚度遍数。",
          "option_id": "G02-html-practice-html-q3-97671409244c:option-3"
        },
        {
          "text": "由上而下逐层挖填，边挖边填保证密实。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "把开挖顺序当回填顺序。",
          "loss_reason": "回填是由下而上，不是由上而下。",
          "fix": "回填应由下而上分层铺填。",
          "option_id": "G02-html-practice-html-q3-97671409244c:option-4"
        }
      ],
      "variant_id": "G02-html-practice-html-q3-97671409244c",
      "surface_id": "practice.html",
      "source_index": 2,
      "source_group": "Q",
