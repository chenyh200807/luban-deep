    {
      "answer_type": "single_choice",
      "rule_group": "虚铺·条件维",
      "stem": "每层虚铺厚度应依据什么确定？选出正确、能得分的作答。",
      "model_answer": "每层虚铺厚度应根据夯实机具确定，不按含水量。",
      "options": [
        {
          "text": "每层虚铺厚度应根据夯实机具（夯击能）确定，不按含水量确定。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "点明按夯实机具，且否定'按含水量'。",
          "option_id": "G02-html-practice-html-q5-7d9d763971e5:option-1"
        },
        {
          "text": "每层虚铺厚度应根据土的含水量确定，含水量越大铺得越薄。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "觉得土湿就该铺薄点，很顺手。",
          "loss_reason": "2016年真题经典反向陷阱——虚铺厚度按机具不按含水量。",
          "fix": "按夯实机具定，含水量只影响压实效果。",
          "option_id": "G02-html-practice-html-q5-7d9d763971e5:option-2"
        },
        {
          "text": "每层虚铺厚度按经验大致铺开就行，压实达标即可，无需固定依据。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "觉得凭经验铺差不多。",
          "loss_reason": "漏了'按夯实机具确定'这一采分依据。",
          "fix": "必须写'按夯实机具确定'。",
          "option_id": "G02-html-practice-html-q5-7d9d763971e5:option-3"
        },
        {
          "text": "每层虚铺厚度统一按300mm铺，任何机具都一样。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "记了个300mm就套所有机具。",
          "loss_reason": "厚度随机具不同，不能一刀切。",
          "fix": "按机具查表：平碾250-300、振动压实机250-350等。",
          "option_id": "G02-html-practice-html-q5-7d9d763971e5:option-4"
        }
      ],
      "variant_id": "G02-html-practice-html-q5-7d9d763971e5",
