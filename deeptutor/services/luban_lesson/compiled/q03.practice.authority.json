    },
    {
      "answer_type": "single_choice",
      "rule_group": "表面缺陷·成因",
      "stem": "构件出现蜂窝（石子成堆、空隙连片）与孔洞（局部贯穿）。选出成因分析能得分的作答。",
      "model_answer": "自由倾落过高致离析、漏振欠振、钢筋过密下料困难混凝土未振实，形成蜂窝孔洞。",
      "options": [
        {
          "text": "自由倾落过高致离析、漏振欠振、钢筋过密下料困难混凝土未振实，形成蜂窝、孔洞。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "离析·漏振·配筋过密都是宆窝孔洞的采分成因。",
          "option_id": "Q03-html-practice-html-q3-667eefb8bc7c:option-1"
        },
        {
          "text": "蜂窝孔洞是模板接缝漏浆、隔离剂不匀造成表面缺浆。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "套用麻面的模板成因。",
          "loss_reason": "模板漏浆致麻面；蜂窝孔洞主因是振捣离析与配筋过密。",
          "fix": "蜂窝孔洞归布料/振捣/配筋，不是模板缺浆。",
          "option_id": "Q03-html-practice-html-q3-667eefb8bc7c:option-2"
        },
        {
          "text": "蜂窝孔洞是养护不到位、后期强度不够被压出来的。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "把成因往养护上推。",
          "loss_reason": "养护影响强度/收缩，蜂窝孔洞是浇筑振捣阶段的密实度问题。",
          "fix": "成因写离析·漏振·配筋过密，不是养护。",
          "option_id": "Q03-html-practice-html-q3-667eefb8bc7c:option-3"
        },
        {
          "text": "蜂窝就是振捣不实一句话，写上就够了。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "只答一条省事。",
          "loss_reason": "漏了离析、下料过厚、配筋过密等采分点。",
          "fix": "补齐离析·下料过厚·钢筋过密等成因。",
          "option_id": "Q03-html-practice-html-q3-667eefb8bc7c:option-4"
        }
      ],
      "variant_id": "Q03-html-practice-html-q3-667eefb8bc7c",
      "surface_id": "practice.html",
      "source_index": 2,
