  "items": [
    {
      "answer_type": "single_choice",
      "rule_group": "表面缺陷·识别",
      "stem": "地下室墙板拆模后出现四种表面缺陷。选出把它们对号入座、能得分的作答。",
      "model_answer": "密布小凹点且钢筋不露=麻面；钢筋外露无保护层=露筋；石子成堆缺砂浆空隙连片=蜂窝；局部贯穿大洞=孔洞。",
      "options": [
        {
          "text": "密布小凹点=麻面、钢筋外露=露筋、石子成堆缺砂浆=蜂窝、局部贯穿大洞=孔洞，按形貌逐一命名。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "四种形貌逐一对应命名，是识别题的采分地基。",
          "option_id": "Q03-html-practice-html-q1-781a1a1452d0:option-1"
        },
        {
          "text": "表面缺陷都是振捣不实闹的，一律按蜂窝处理、成因都写漏振就行。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "觉得四种只是轻重不同、都怪振捣。",
          "loss_reason": "麻面主因在模板、露筋在保护层，一律叫蜂窝命名就错。",
          "fix": "按形貌分别命名：麻面/露筋/蜂窝/孔洞。",
          "option_id": "Q03-html-practice-html-q1-781a1a1452d0:option-2"
        },
        {
          "text": "凡是凹陷类都算孔洞，表面小凹点也归到孔洞里一起报。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "都是凹进去的，笼统归孔洞。",
          "loss_reason": "麻面是表面密布小凹点、孔洞是局部贯穿大洞，深浅范围完全不同。",
          "fix": "密布小凹点是麻面，贯穿大洞才是孔洞。",
          "option_id": "Q03-html-practice-html-q1-781a1a1452d0:option-3"
        },
        {
          "text": "先不管叫啥名，直接写防治措施加强振捣、加强养护就够拿分。",
          "is_correct": false,
          "source_error_code": "E05",
          "temptation": "想跳过识别直接答措施。",
          "loss_reason": "识别命名是采分地基，跳过=丢识别分。",
          "fix": "先逐图命名，再对应写成因与措施。",
          "option_id": "Q03-html-practice-html-q1-781a1a1452d0:option-4"
        }
      ],
