    },
    {
      "answer_type": "single_choice",
      "rule_group": "表面缺陷·成因",
      "stem": "构件拆模后表面出现麻面（密布小凹点、钢筋未外露）。选出成因分析能得分的作答。",
      "model_answer": "模板不光滑/接缝不严漏浆/浇筑前未湿润/隔离剂涂刷不匀，表面缺浆形成麻面。",
      "options": [
        {
          "text": "模板表面不光滑、接缝不严漏浆、浇筑前未湿润、隔离剂涂刷不匀，表面缺浆形成麻面。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "四个成因都落在模板与缺浆，正是麻面采分点。",
          "option_id": "Q03-html-practice-html-q2-cf369f4525c5:option-1"
        },
        {
          "text": "麻面是钢筋保护层垫块漏放、钢筋贴模造成的，属保护层不足。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "把麻面和露筋的成因搞混。",
          "loss_reason": "垫块漏放导致的是露筋不是麻面；麻面钢筋并未外露。",
          "fix": "麻面主因在模板与缺浆，露筋才是保护层不足。",
          "option_id": "Q03-html-practice-html-q2-cf369f4525c5:option-2"
        },
        {
          "text": "麻面是混凝土内部石子成堆、砂浆包裹不足造成的密实度问题。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "把麻面当蜂窝的成因来答。",
          "loss_reason": "石子成堆缺砂浆是蜂窝；麻面是表面缺浆、非内部离析。",
          "fix": "麻面归模板/缺浆，蜂窝才归振捣离析。",
          "option_id": "Q03-html-practice-html-q2-cf369f4525c5:option-3"
        },
        {
          "text": "麻面就是施工不认真、管理不到位造成的，加强管理确保质量即可。",
          "is_correct": false,
          "source_error_code": "E04",
          "temptation": "口号化、好写。",
          "loss_reason": "只喊加强管理没写具体成因（模板/漏浆/湿润/隔离剂），拿不到采分。",
          "fix": "写清模板不光滑·接缝漏浆·未湿润·隔离剂不匀。",
          "option_id": "Q03-html-practice-html-q2-cf369f4525c5:option-4"
        }
      ],
      "variant_id": "Q03-html-practice-html-q2-cf369f4525c5",
      "surface_id": "practice.html",
