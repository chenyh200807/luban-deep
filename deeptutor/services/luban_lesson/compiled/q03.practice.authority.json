    {
      "answer_type": "single_choice",
      "rule_group": "缺陷治理·工艺顺序",
      "stem": "孔洞缺陷需按工艺流程治理。选出流程顺序正确、能得分的作答。",
      "model_answer": "清理表面→支设模板→洒水湿润→涂混凝土界面剂→高一强度等级细石混凝土浇筑密实→保温保湿养护不少于7天。",
      "options": [
        {
          "text": "清理表面→支设模板→洒水湿润→涂界面剂→高一强度等级细石混凝土浇筑密实→保温保湿养护不少于7天。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "六步顺序正确、界面剂与高一强度与养护一个不漏。",
          "option_id": "Q03-html-practice-html-q4-52d43cc6a165:option-1"
        },
        {
          "text": "先浇筑高强细石混凝土填实，再清理表面、支模板、最后洒水湿润养护。",
          "is_correct": false,
          "source_error_code": "E06",
          "temptation": "觉得先填上要紧、顺序无所谓。",
          "loss_reason": "先浇后清、乱序=程序错，界面没处理浇了也白搭。",
          "fix": "必须先清理→支模→湿润→界面剂→再浇筑→养护。",
          "option_id": "Q03-html-practice-html-q4-52d43cc6a165:option-2"
        },
        {
          "text": "清理表面→支设模板→浇筑混凝土→然后养护即可。",
          "is_correct": false,
          "source_error_code": "E03",
          "temptation": "看着步骤挺全。",
          "loss_reason": "漏了洒水湿润、涂界面剂两个关键采分词。",
          "fix": "补洒水湿润与涂混凝土界面剂两步。",
          "option_id": "Q03-html-practice-html-q4-52d43cc6a165:option-3"
        },
        {
          "text": "清理→支模→湿润→界面剂→浇筑→养护，养护2天即可拆模交工。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "顺序对，只是养护天数随手填。",
          "loss_reason": "养护应不少于7天，写2天规范数值错。",
          "fix": "保温保湿养护不少于7天。",
          "option_id": "Q03-html-practice-html-q4-52d43cc6a165:option-4"
        }
      ],
