    {
      "answer_type": "single_choice",
      "rule_group": "洞口≥500·条件维",
      "stem": "楼板上短边 600mm 的竖向预留洞口，选出防护做法完整、能得分的作答。",
      "model_answer": "短边≥500mm 洞口临空侧设≥1.2m 防护栏杆并封闭、设挡脚板，必要时下挂安全平网。",
      "options": [
        {
          "text": "短边≥500mm，临空侧设≥1.2m 防护栏杆并封闭、设挡脚板，必要时下挂安全平网。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "判尺寸档 + 栏杆 + 封闭 + 挡脚板齐，够大的加平网。",
          "option_id": "S06-html-practice-html-q3-a8a6959fcd44:option-1"
        },
        {
          "text": "用一块木板把洞口盖住即可，600mm 的洞盖上就安全了。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "以为洞口「盖住就行」、不分尺寸。",
          "loss_reason": "短边≥500 人可整个坠落，盖板兜不住，必须围栏杆封闭。",
          "fix": "设 1.2m 栏杆并封闭、加挡脚板。",
          "option_id": "S06-html-practice-html-q3-a8a6959fcd44:option-2"
        },
        {
          "text": "25~500mm 用承重盖板，本洞 600 也按承重盖板可靠覆盖固定。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "记得盖板口径，却套错了尺寸段。",
          "loss_reason": "600≥500 属栏杆档；承重盖板是 25~500 档，尺寸配错措施。",
          "fix": "≥500 设栏杆 + 封闭 + 挡脚板。",
          "option_id": "S06-html-practice-html-q3-a8a6959fcd44:option-3"
        },
        {
          "text": "在洞口周边设警示标志、夜间加警示灯，提醒人员注意避让。",
          "is_correct": false,
          "source_error_code": "E04",
          "temptation": "觉得警示到位就算防护。",
          "loss_reason": "口号化，没有实体防护，人照样会踩空坠落。",
          "fix": "设 1.2m 栏杆并封闭、加挡脚板。",
          "option_id": "S06-html-practice-html-q3-a8a6959fcd44:option-4"
        }
      ],
