    {
      "answer_type": "single_choice",
      "rule_group": "栏杆构造·条件维",
      "stem": "关于临边防护栏杆的构造要求，选出参数完整、能得分的作答。",
      "model_answer": "上杆离地 1.2m、立杆间距≤2m、挡脚板≥180mm、能承受 1kN 任意方向外力、张挂密目立网。",
      "options": [
        {
          "text": "上杆离地 1.2m、立杆间距≤2m、挡脚板高≥180mm、能承受 1kN 任意方向外力、张挂密目立网。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "四个硬数字 + 密目网一次写全，正是高分密集区。",
          "option_id": "S06-html-practice-html-q2-f84743fdbc8b:option-1"
        },
        {
          "text": "上杆离地 0.9m、立杆间距≤2m、设挡脚板即可，能挡住人就行。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "把室内楼梯扶手 0.9m 套到临边栏杆上。",
          "loss_reason": "临边栏杆上杆是 1.2m；0.9m 是室内楼梯扶手，串章丢分。",
          "fix": "上杆改 1.2m，其余数字补齐。",
          "option_id": "S06-html-practice-html-q2-f84743fdbc8b:option-2"
        },
        {
          "text": "设防护栏杆，牢固可靠、高度足够，能防止人员坠落即可。",
          "is_correct": false,
          "source_error_code": "E03",
          "temptation": "觉得「牢固够高」意思到了。",
          "loss_reason": "漏 1.2m / 间距 / 挡脚板 / 1kN 全部硬数字，空泛。",
          "fix": "写 1.2m、≤2m、≥180mm、1kN。",
          "option_id": "S06-html-practice-html-q2-f84743fdbc8b:option-3"
        },
        {
          "text": "上杆 1.2m、张挂密目立网，其余参数按现场情况灵活掌握。",
          "is_correct": false,
          "source_error_code": "E03",
          "temptation": "记住主数字，其余想当然省了。",
          "loss_reason": "漏立杆间距≤2m、挡脚板≥180mm、承 1kN。",
          "fix": "补≤2m、≥180mm、1kN。",
          "option_id": "S06-html-practice-html-q2-f84743fdbc8b:option-4"
        }
      ],
