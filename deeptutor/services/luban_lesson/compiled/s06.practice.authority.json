    {
      "answer_type": "single_choice",
      "rule_group": "采分诊断·末题",
      "stem": "某学生答临边洞口防护：①临边挂警示牌提醒；②600mm 竖向洞口盖块木板；③防护栏杆高 0.9m。选出最准确的诊断与补写。",
      "model_answer": "①警示牌须改实体栏杆+密目网封闭；②竖向≥500 洞口须设 1.2m 栏杆封闭加挡脚板（25~500 才用承重盖板）；③栏杆高应 1.2m（0.9m 是室内扶手）。三处都要补写。",
      "options": [
        {
          "text": "三处均失分：①应改实体栏杆+密目网封闭；②≥500 洞口设 1.2m 栏杆封闭加挡脚板（25~500 才用盖板）；③栏杆上杆应 1.2m（0.9m 是室内扶手）。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "三处逐条补成采分句——这就是「会写答案」。",
          "option_id": "S06-html-practice-html-q16-30dcd356515c:option-1"
        },
        {
          "text": "基本正确，只是栏杆 0.9m 偏低，改成 1.0m 就达标，其余没问题。",
          "is_correct": false,
          "source_error_code": "E08",
          "temptation": "只挑出一处、还改错了数。",
          "loss_reason": "漏诊警示牌口号化、洞口盖板不分尺寸；栏杆应 1.2m 非 1.0m。",
          "fix": "三处都补，栏杆改 1.2m。",
          "option_id": "S06-html-practice-html-q16-30dcd356515c:option-2"
        },
        {
          "text": "只是栏杆高度问题，把 0.9m 改 1.2m 即可，警示牌和盖木板都行。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "抓到栏杆一处就收手。",
          "loss_reason": "警示牌替不了栏杆、≥500 洞口须设栏杆，漏两处。",
          "fix": "警示牌改栏杆+网、洞口设 1.2m 栏杆封闭。",
          "option_id": "S06-html-practice-html-q16-30dcd356515c:option-3"
        },
        {
          "text": "思路对、防护到位，加强现场管理、落实责任即可给分。",
          "is_correct": false,
          "source_error_code": "E04",
          "temptation": "整体表扬式带过。",
          "loss_reason": "三处实体措施都错或缺，纯口号不得分。",
          "fix": "实体栏杆+网、洞口按尺寸设栏杆、栏杆 1.2m 三处补写。",
          "option_id": "S06-html-practice-html-q16-30dcd356515c:option-4"
        }
      ],
