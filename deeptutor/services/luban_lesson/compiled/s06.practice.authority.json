    {
      "answer_type": "single_choice",
      "rule_group": "洞口25~500·条件维",
      "stem": "楼板上短边 300mm 的洞口，选出防护做法正确、能得分的作答。",
      "model_answer": "短边 25~500mm 洞口用承重盖板可靠覆盖、固定牢靠，防止盖板移位。",
      "options": [
        {
          "text": "25~500mm 洞口用承重盖板可靠覆盖、固定牢靠，防止盖板移位。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "尺寸档 + 承重盖板 + 固定防移位，一次到位。",
          "option_id": "S06-html-practice-html-q4-e42d54f368cb:option-1"
        },
        {
          "text": "300mm 洞口也要临空侧设 1.2m 防护栏杆并封闭、加挡脚板。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "以为「越严越好」，把栏杆档套到小洞口。",
          "loss_reason": "25~500 档用承重盖板即可，套栏杆档属规范适用错误。",
          "fix": "用承重盖板可靠覆盖、固定牢靠。",
          "option_id": "S06-html-practice-html-q4-e42d54f368cb:option-2"
        },
        {
          "text": "拿彩条布或警戒线把洞口围一下，提醒工人别踩。",
          "is_correct": false,
          "source_error_code": "E04",
          "temptation": "图省事，拿警戒线糊弄。",
          "loss_reason": "警戒线非承重、人踩即塌，属口号化。",
          "fix": "用承重盖板可靠覆盖、固定牢靠。",
          "option_id": "S06-html-practice-html-q4-e42d54f368cb:option-3"
        },
        {
          "text": "把洞口盖上就行，用什么盖、固不固定不重要。",
          "is_correct": false,
          "source_error_code": "E03",
          "temptation": "只记住「盖住」两个字。",
          "loss_reason": "漏「承重」「固定」关键词，普通板会塌或移位。",
          "fix": "承重盖板 + 可靠固定防移位。",
          "option_id": "S06-html-practice-html-q4-e42d54f368cb:option-4"
        }
      ],
