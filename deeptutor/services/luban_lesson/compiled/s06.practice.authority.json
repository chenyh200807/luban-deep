    {
      "answer_type": "single_choice",
      "rule_group": "临边触发·条件维",
      "stem": "某工程楼层临边作业，坠落高度基准面 2.3m。选出判定与做法最能得分的作答。",
      "model_answer": "坠落高度基准面 2m 及以上临边作业，临空一侧应设防护栏杆，并配密目式安全立网或工具式栏板封闭。",
      "options": [
        {
          "text": "坠落高度基准面 2m 及以上，临空一侧应设防护栏杆，并配密目式安全立网或工具式栏板封闭。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "2m 触发 + 临空侧栏杆 + 封闭三件齐，换个高度也不错。",
          "option_id": "S06-html-practice-html-q1-eefc330c48e6:option-1"
        },
        {
          "text": "设「当心坠落」警示标志、拉警戒线提醒工人注意即可。",
          "is_correct": false,
          "source_error_code": "E04",
          "temptation": "觉得提醒到位、看得见就安全。",
          "loss_reason": "警示标志是口号，没有实体隔离，临边必须设栏杆。",
          "fix": "临空侧设防护栏杆，配密目网或工具式栏板封闭。",
          "option_id": "S06-html-practice-html-q1-eefc330c48e6:option-2"
        },
        {
          "text": "高处临边要注意安全，做好临边防护措施，防止人员坠落。",
          "is_correct": false,
          "source_error_code": "E03",
          "temptation": "方向对、话也顺，像答到点了。",
          "loss_reason": "没写 2m 触发、没写栏杆/封闭具体措施，空泛不给分。",
          "fix": "写「2m 及以上临空侧设栏杆并封闭」。",
          "option_id": "S06-html-practice-html-q1-eefc330c48e6:option-3"
        },
        {
          "text": "坠落高度不足 5m 可不设防护，2.3m 未到 5m，本处无需设栏杆。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "误把 5m 当成临边触发线。",
          "loss_reason": "临边触发线是 2m，不是 5m，达线即须设防护。",
          "fix": "2m 及以上就设栏杆并封闭。",
          "option_id": "S06-html-practice-html-q1-eefc330c48e6:option-4"
        }
      ],
