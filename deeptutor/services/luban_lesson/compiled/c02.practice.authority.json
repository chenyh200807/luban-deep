      "answer_type": "single_choice",
      "rule_group": "预付款·计算表达维",
      "stem": "中标价 5800 万元，暂列金额 580 万元，主要材料占比 60%，预付款为造价 20%。计算工程预付款，选出能得分的列式与依据。",
      "model_answer": "预付款 =（合同价−暂列金额）× 预付比例 =（5800−580）×20% = 1044 万元；基数先扣暂列金。",
      "options": [
        {
          "text": "预付款 =（合同价−暂列金额）× 预付比例 =（5800−580）×20% = 1044 万元，基数先扣暂列金。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "先扣暂列金、再乘比例，公式+列式+数值带单位齐。",
          "option_id": "C02-html-practice-html-q2-b80a345f8d5b:option-1"
        },
        {
          "text": "预付款 = 合同价 × 预付比例 = 5800×20% = 1160 万元，直接以中标价作为计算基数。",
          "is_correct": false,
          "source_error_code": "E08",
          "temptation": "题面给了 5800，顺手就拿它当基数。",
          "loss_reason": "暂列金 580 未发包、不进预付款基数，基数错连锁全错。",
          "fix": "基数 = 5800−580 = 5220，预付款 = 5220×20% = 1044。",
          "option_id": "C02-html-practice-html-q2-b80a345f8d5b:option-2"
        },
        {
          "text": "预付款 =（合同价−暂列金）× 预付比例 × 材料占比 =（5800−580）×20%×60% = 626.4 万元。",
          "is_correct": false,
          "source_error_code": "E09",
          "temptation": "看到材料占比 60% 就想乘进预付款。",
          "loss_reason": "材料占比是起扣点的分母，不进预付款公式，多乘一项算错。",
          "fix": "预付款只 =（5800−580）×20% = 1044，占比留给起扣点。",
          "option_id": "C02-html-practice-html-q2-b80a345f8d5b:option-3"
        },
        {
          "text": "预付款 = 1044 万元，本题只需直接给出这个最终结果，无须再写出列式与计算依据。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "会算、直接写得数最省事。",
          "loss_reason": "只写得数没列式没依据，丢过程分。",
          "fix": "写全：（5800−580）×20% = 1044 万元。",
          "option_id": "C02-html-practice-html-q2-b80a345f8d5b:option-4"
        }
      ],
