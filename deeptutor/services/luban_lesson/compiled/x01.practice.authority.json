  "items": [
    {
      "answer_type": "single_choice",
      "rule_group": "设计原则·后果维",
      "stem": "施工总平面图设计应遵循哪些原则？选出最完整、能得分的作答。",
      "model_answer": "占地少、运输合理(减少二次搬运)、减少干扰、利用既有设施、分区设置、环保安全、遵守规定。",
      "options": [
        {
          "text": "遵循占地少、运输合理(减少二次搬运)、减少干扰、利用既有设施、分区设置、环保安全、遵守规定等原则。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "七条原则写全，每条都可判分，换背景数据也稳。",
          "option_id": "X01-html-practice-html-q1-4b2d37a0e490:option-1"
        },
        {
          "text": "本着科学规划、合理布置、统筹兼顾的思路，把现场安排得整齐美观、井然有序即可。",
          "is_correct": false,
          "source_error_code": "E04",
          "temptation": "这话听着很顺、像总结陈词。",
          "loss_reason": "全是口号，没有一条可判分的具体原则。",
          "fix": "写占地少、运输合理、减少干扰、分区设置等具体原则。",
          "option_id": "X01-html-practice-html-q1-4b2d37a0e490:option-2"
        },
        {
          "text": "主要就是分区设置这一条，把加工区、办公区分开，其余按现场情况灵活处理即可。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "分区确实是核心，容易只答这一条。",
          "loss_reason": "只答一条，漏占地少/运输合理/减少干扰等多条原则。",
          "fix": "补占地少、运输合理(减少二次搬运)、利用既有设施等。",
          "option_id": "X01-html-practice-html-q1-4b2d37a0e490:option-3"
        },
        {
          "text": "遵循先深后浅、先地下后地上、先主体后围护的施工顺序原则来布置平面。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "「原则」俩字沾边，像在答原则。",
          "loss_reason": "那是施工顺序原则，不是平面布置设计原则，答错方向。",
          "fix": "平面布置原则=占地少/运输合理/减少干扰/分区设置等。",
          "option_id": "X01-html-practice-html-q1-4b2d37a0e490:option-4"
        }
      ],
