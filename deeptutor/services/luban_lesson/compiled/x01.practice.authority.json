    {
      "answer_type": "single_choice",
      "rule_group": "塔吊·条件维",
      "stem": "布置塔式起重机应考虑哪些因素？选出最完整、能得分的作答。",
      "model_answer": "基础、环境、覆盖范围、吊重、运输堆放、附墙位置、拆除运输、群塔防撞。",
      "options": [
        {
          "text": "考虑基础、环境、覆盖范围、吊重、运输堆放、附墙位置、拆除运输、群塔防撞八项因素。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "八因素齐全，尤其群塔防撞与拆除运输别漏。",
          "option_id": "X01-html-practice-html-q5-b9876b29b5d2:option-1"
        },
        {
          "text": "放在场地中间，能覆盖到主楼、吊得起最重的构件就行。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "「覆盖 + 吊重」像抓住重点了。",
          "loss_reason": "漏基础/附墙/拆除运输/群塔防撞等多项因素。",
          "fix": "八因素补齐，尤其群塔防撞/附墙位置/拆除运输。",
          "option_id": "X01-html-practice-html-q5-b9876b29b5d2:option-2"
        },
        {
          "text": "考虑地基承载力、附墙位置、楼层通道、出入口防护门、防护围栏等因素。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "因素词很专业，像塔吊的。",
          "loss_reason": "那是施工升降机的布置因素，混搭到塔吊上了。",
          "fix": "塔吊八因素=基础/环境/覆盖/吊重/运输堆放/附墙/拆除/群塔防撞。",
          "option_id": "X01-html-practice-html-q5-b9876b29b5d2:option-3"
        },
        {
          "text": "主要保证塔吊基础牢固、不倾覆，其余现场看着来就行。",
          "is_correct": false,
          "source_error_code": "E03",
          "temptation": "抓住「基础」一项。",
          "loss_reason": "漏覆盖范围/群塔防撞等关键因素，关键词缺失。",
          "fix": "补覆盖范围/吊重/运输堆放/附墙/拆除/群塔防撞。",
          "option_id": "X01-html-practice-html-q5-b9876b29b5d2:option-4"
        }
      ],
