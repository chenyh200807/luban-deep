  "items": [
    {
      "answer_type": "single_choice",
      "rule_group": "养护时长·条件维",
      "stem": "某工程有普通硅酸盐水泥现浇柱、有抗渗要求的地下室墙、后浇带三部分。关于最短养护时间，选出完整、能得分的作答。",
      "model_answer": "普通硅酸盐水泥现浇≥7d；有抗渗要求的≥14d；后浇带养护≥14d。",
      "options": [
        {
          "text": "普通硅酸盐水泥现浇构件养护不少于 7d；有抗渗要求的不少于 14d；后浇带养护不少于 14d。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "按类别分档：普硅 7d、抗渗/后浇带 14d，一档不落。",
          "option_id": "Q01-html-practice-html-q1-9752d199a392:option-1"
        },
        {
          "text": "三部分统一养护 7d 即可，养护时间不必分类别。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "记了个 7d 就想一刀切省事。",
          "loss_reason": "抗渗与后浇带必须不少于 14d，统一 7d 违反规范。",
          "fix": "抗渗、后浇带养护≥14d，不能按 7d。",
          "option_id": "Q01-html-practice-html-q1-9752d199a392:option-2"
        },
        {
          "text": "普硅现浇 14d、抗渗 7d、后浇带 7d。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "记得有 7、14 两个数，随手一配。",
          "loss_reason": "7d/14d 张冠李戴，方向配反。",
          "fix": "普硅 7d、抗渗与后浇带 14d，别对调。",
          "option_id": "Q01-html-practice-html-q1-9752d199a392:option-3"
        },
        {
          "text": "只要洒水就行，养护天数不影响得分。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "觉得养护是走过场。",
          "loss_reason": "漏了养护时长这一采分点。",
          "fix": "写明普硅≥7d、抗渗/后浇带≥14d。",
          "option_id": "Q01-html-practice-html-q1-9752d199a392:option-4"
        }
      ],
      "variant_id": "Q01-html-practice-html-q1-9752d199a392",
      "surface_id": "practice.html",
      "source_index": 0,
      "source_group": "Q",
