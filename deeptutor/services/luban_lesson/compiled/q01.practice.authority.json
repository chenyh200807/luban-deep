    {
      "answer_type": "single_choice",
      "rule_group": "高温措施·程序维",
      "stem": "高温环境下混凝土防裂，下列哪一组作答完整、能得分？",
      "model_answer": "安排早间/晚间施工、喷雾降温保湿、连续浇筑；不采用吹风。",
      "options": [
        {
          "text": "安排早间或晚间施工，喷雾降温保湿，连续浇筑避免冷缝；不宜采用吹风。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "早晚施工+喷雾+连续浇筑，且点明不吹风。",
          "option_id": "Q01-html-practice-html-q4-c8005fb201fb:option-1"
        },
        {
          "text": "用鼓风机吹风给混凝土降温，加快散热防裂。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "觉得吹风能降温、跟散热挂钩。",
          "loss_reason": "吹风加速表面失水，是错误做法。",
          "fix": "改喷雾保湿，不吹风。",
          "option_id": "Q01-html-practice-html-q4-c8005fb201fb:option-2"
        },
        {
          "text": "安排在正午高温时段一次浇完。",
          "is_correct": false,
          "source_error_code": "E05",
          "temptation": "想着一鼓作气浇完。",
          "loss_reason": "应避开正午高温，安排早晚施工。",
          "fix": "避开正午，早间/晚间施工。",
          "option_id": "Q01-html-practice-html-q4-c8005fb201fb:option-3"
        },
        {
          "text": "只要多浇水就行，其他措施不必。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "以为浇水万能。",
          "loss_reason": "漏早晚施工、喷雾、连续浇筑等措施。",
          "fix": "补早晚施工、喷雾、连续浇筑。",
          "option_id": "Q01-html-practice-html-q4-c8005fb201fb:option-4"
        }
      ],
      "variant_id": "Q01-html-practice-html-q4-c8005fb201fb",
