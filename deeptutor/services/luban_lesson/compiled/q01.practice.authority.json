    },
    {
      "answer_type": "single_choice",
      "rule_group": "冬期温控·条件维",
      "stem": "冬期大体积混凝土温控，选出指标正确、能得分的作答。",
      "model_answer": "中心-表面温差≤25℃；表面-大气温差≤20℃；温降梯度≤3℃/d；养护≥14d。",
      "options": [
        {
          "text": "中心与表面温差不大于 25℃；表面与大气温差不大于 20℃；温降梯度不大于 3℃/d；养护不少于 14d。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "25/20/3/14 四数配对写全，方向别反。",
          "option_id": "Q01-html-practice-html-q3-eac52d2ed42f:option-1"
        },
        {
          "text": "表面与大气温差不大于 25℃、中心与表面不大于 20℃。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "两个温差都记得，就是配反了。",
          "loss_reason": "块内(中心-表面)是 25、对外界(表面-大气)是 20，方向写反。",
          "fix": "中心-表面≤25℃、表面-大气≤20℃。",
          "option_id": "Q01-html-practice-html-q3-eac52d2ed42f:option-2"
        },
        {
          "text": "温降梯度不大于 2℃/d。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "把大体积的 2℃/d 用到冬期。",
          "loss_reason": "冬期温降梯度是≤3℃/d，不是 2。",
          "fix": "冬期温降梯度≤3℃/d。",
          "option_id": "Q01-html-practice-html-q3-eac52d2ed42f:option-3"
        },
        {
          "text": "冬期只要保温覆盖即可，不必控温差。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "知道要保温就以为够了。",
          "loss_reason": "漏中心-表面 25、表面-大气 20、温降 3 等采分点。",
          "fix": "补三项温差/温降数值与养护≥14d。",
          "option_id": "Q01-html-practice-html-q3-eac52d2ed42f:option-4"
        }
      ],
      "variant_id": "Q01-html-practice-html-q3-eac52d2ed42f",
      "surface_id": "practice.html",
