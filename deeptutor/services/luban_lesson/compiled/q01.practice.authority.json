      "source_html_sha256": "63bdb0c19dde4192c004364818954b6c8f493e3d54230cddd09e1ac3151309f3"
    },
    {
      "answer_type": "single_choice",
      "rule_group": "大体积温控·条件维",
      "stem": "大体积混凝土底板测温控制，选出指标完整、能得分的作答。",
      "model_answer": "里表温差≤25℃；降温速率≤2.0℃/d；温升≤50℃；入模温度 5~30℃。",
      "options": [
        {
          "text": "里表温差不大于 25℃；降温速率不大于 2.0℃/d；温升不大于 50℃；入模温度控制在 5~30℃。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "里表 25、降温 2℃/d、温升 50、入模 5~30，四个数写全。",
          "option_id": "Q01-html-practice-html-q2-4a84fcba6b1e:option-1"
        },
        {
          "text": "里表温差不大于 20℃、降温速率不大于 3℃/d。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "把冬期的 20℃、3℃/d 搬到了大体积。",
          "loss_reason": "大体积是里表≤25℃、降温≤2℃/d，数值用串。",
          "fix": "大体积里表≤25℃、降温≤2.0℃/d。",
          "option_id": "Q01-html-practice-html-q2-4a84fcba6b1e:option-2"
        },
        {
          "text": "只要连续测温、发现异常处理即可，不必给具体指标。",
          "is_correct": false,
          "source_error_code": "E03",
          "temptation": "知道要测温，懒得报数。",
          "loss_reason": "缺 25/2/50 等关键数值，口号化不得分。",
          "fix": "补里表≤25℃、降温≤2℃/d、温升≤50℃。",
          "option_id": "Q01-html-practice-html-q2-4a84fcba6b1e:option-3"
        },
        {
          "text": "里表温差不大于 25℃即可，其余不用控制。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "记住了最有名的 25℃。",
          "loss_reason": "漏降温速率、温升、入模温度多个采分点。",
          "fix": "补降温≤2℃/d、温升≤50℃、入模 5~30℃。",
          "option_id": "Q01-html-practice-html-q2-4a84fcba6b1e:option-4"
        }
      ],
      "variant_id": "Q01-html-practice-html-q2-4a84fcba6b1e",
      "surface_id": "practice.html",
      "source_index": 1,
      "source_group": "Q",
