  "items": [
    {
      "answer_type": "single_choice",
      "rule_group": "选用总纲·条件维",
      "stem": "钢筋连接的方法有哪几种？其中机械连接最常用的形式是什么？选出最完整、能得分的作答。",
      "model_answer": "钢筋连接方法有焊接、机械连接、绑扎连接三种；机械连接中以剥肋滚压直螺纹套筒连接最为常用。",
      "options": [
        {
          "text": "钢筋连接方法有焊接、机械连接、绑扎连接三种；机械连接中以剥肋滚压直螺纹套筒连接最为常用。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "三类连接写全，再点出机械连接最常用形式是剥肋滚压直螺纹套筒，缺一都丢采分句。",
          "option_id": "C05-html-practice-html-q1-a8bb0089be20:option-1"
        },
        {
          "text": "钢筋连接方法有焊接、机械连接、绑扎连接三种；机械连接中以电渣压力焊连接最为常用。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "记得有电渣压力焊这个名词，顺手就填上。",
          "loss_reason": "电渣压力焊属焊接类，不是机械连接；机械连接最常用是剥肋滚压直螺纹套筒。",
          "fix": "机械连接最常用是剥肋滚压直螺纹套筒连接。",
          "option_id": "C05-html-practice-html-q1-a8bb0089be20:option-2"
        },
        {
          "text": "钢筋连接主要就是焊接和绑扎两种，机械连接用得少可以不单列，按现场习惯选即可。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "平时现场焊接、绑扎见得多，机械连接反倒少见。",
          "loss_reason": "漏了机械连接这一大类，采分点直接遗漏；机械连接恰恰是大直径/动力荷载首选。",
          "fix": "三类都要列：焊接、机械连接、绑扎连接。",
          "option_id": "C05-html-practice-html-q1-a8bb0089be20:option-3"
        },
        {
          "text": "连接方法就看哪种最牢，直接选焊接把钢筋熔成一体，其余两种都不如焊接可靠。",
          "is_correct": false,
          "source_error_code": "E05",
          "temptation": "觉得熔成一体最结实，凭经验选最牢的。",
          "loss_reason": "题问方法种类不是问哪种最牢；且焊接有热影响区、动力荷载还不宜。",
          "fix": "先列三类方法，机械连接以剥肋滚压直螺纹套筒最常用。",
          "option_id": "C05-html-practice-html-q1-a8bb0089be20:option-4"
        }
      ],
