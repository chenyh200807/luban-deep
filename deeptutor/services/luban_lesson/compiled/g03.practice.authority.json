    {
      "answer_type": "single_choice",
      "rule_group": "锤击方式·条件维",
      "stem": "锤击法沉桩宜采用何种落锤方式？选出正确作答。",
      "model_answer": "宜重锤低击或低锤重打，避免桩头损坏、桩身开裂。",
      "options": [
        {
          "text": "宜采用重锤低击或低锤重打，减小冲击峰值、保桩身完整。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "重锤低击/低锤重打，规范落锤方式，得分。",
          "option_id": "G03-html-practice-html-q4-8082ee20ea91:option-1"
        },
        {
          "text": "宜采用重锤高击，锤举高、能量大，沉桩更快。",
          "is_correct": false,
          "source_error_code": "M03",
          "temptation": "以为锤举越高越快。",
          "loss_reason": "高落距冲击峰值超混凝土抗压，桩头碎裂、桩身纵裂。",
          "fix": "应重锤低击，不是重锤高击。",
          "option_id": "G03-html-practice-html-q4-8082ee20ea91:option-2"
        },
        {
          "text": "宜采用轻锤高击，靠高频轻打逐渐把桩打入。",
          "is_correct": false,
          "source_error_code": "M03",
          "temptation": "觉得轻打不伤桩。",
          "loss_reason": "轻锤高击有效贯入能量不足、桩头反复受冲击也易损。",
          "fix": "应重锤低击或低锤重打。",
          "option_id": "G03-html-practice-html-q4-8082ee20ea91:option-3"
        },
        {
          "text": "落锤方式对桩身无影响，按机械默认落距施打即可。",
          "is_correct": false,
          "source_error_code": "M10",
          "temptation": "以为落锤方式无所谓。",
          "loss_reason": "落锤方式直接影响桩头/桩身完整，须控制。",
          "fix": "宜重锤低击或低锤重打。",
          "option_id": "G03-html-practice-html-q4-8082ee20ea91:option-4"
        }
      ],
      "variant_id": "G03-html-practice-html-q4-8082ee20ea91",
      "surface_id": "practice.html",
