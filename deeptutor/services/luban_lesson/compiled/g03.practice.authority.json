  "items": [
    {
      "answer_type": "single_choice",
      "rule_group": "定性·条件维",
      "stem": "某工程采用灌注桩基础。判定灌注桩按成孔工法的分类，选出完整、能得分的作答。",
      "model_answer": "灌注桩按成孔工法分泥浆护壁、沉管、长螺旋钻孔压灌、干作业成孔四类，先定性再查工艺要求。",
      "options": [
        {
          "text": "灌注桩按成孔工法分泥浆护壁、沉管、长螺旋钻孔压灌、干作业成孔四类，先定性再查要求。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "四类工法列全、并点出先定性再查要求，这是答题地基。",
          "option_id": "G03-html-practice-html-q1-eea4184844be:option-1"
        },
        {
          "text": "灌注桩主要就是泥浆护壁和沉管两种，其余工艺按现场情况灵活确定即可。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "只记住最常见两种。",
          "loss_reason": "漏长螺旋钻孔压灌与干作业成孔，工法分类不全。",
          "fix": "补全四类：泥浆护壁/沉管/长螺旋钻孔压灌/干作业成孔。",
          "option_id": "G03-html-practice-html-q1-eea4184844be:option-2"
        },
        {
          "text": "灌注桩按受力分端承桩、摩擦桩两类，据受力性状直接确定成孔工艺。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "端承/摩擦听着像分类。",
          "loss_reason": "端承/摩擦是受力性状，不是成孔工法分类，答错维度。",
          "fix": "成孔工法=泥浆护壁/沉管/长螺旋/干作业，别用受力分类替代。",
          "option_id": "G03-html-practice-html-q1-eea4184844be:option-3"
        },
        {
          "text": "灌注桩与预制桩一样，先看锤击还是静压，据此确定成孔工法。",
          "is_correct": false,
          "source_error_code": "E05",
          "temptation": "把预制桩打法套到灌注桩。",
          "loss_reason": "锤击/静压是预制桩沉桩方式，灌注桩看成孔工法，审题错位。",
          "fix": "灌注桩按成孔工法定性，不用锤击/静压。",
          "option_id": "G03-html-practice-html-q1-eea4184844be:option-4"
        }
      ],
      "variant_id": "G03-html-practice-html-q1-eea4184844be",
      "surface_id": "practice.html",
