    {
      "answer_type": "single_choice",
      "rule_group": "静压·终止·主体维",
      "stem": "静力压桩施工与终止沉桩控制，下列作答正确的是？",
      "model_answer": "试压桩不应少于3根；不得边压边挖；终止沉桩摩擦桩以标高为主、端承桩以压力为主。",
      "options": [
        {
          "text": "试压桩不应少于3根；不得边压边挖；终止沉桩摩擦桩以标高为主、端承桩以压力为主。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "试压桩根数、不得边压边挖、终止标准按桩型，三项齐，得分。",
          "option_id": "G03-html-practice-html-q5-a89c9f731582:option-1"
        },
        {
          "text": "试压桩不应少于3根；可边压边挖以便及时纠偏；终止沉桩一律以压力为主。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "觉得边压边挖能纠偏、压力控制最直观。",
          "loss_reason": "边压边挖破坏土体，且终止标准摩擦桩应以标高为主，答混。",
          "fix": "不得边压边挖；摩擦桩以标高为主、端承桩以压力为主。",
          "option_id": "G03-html-practice-html-q5-a89c9f731582:option-2"
        },
        {
          "text": "试验桩1根即可；终止沉桩摩擦桩以压力为主、端承桩以标高为主。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "根数记少、终止标准配反。",
          "loss_reason": "试压桩≥3根；终止标准摩擦↔端承互换错误。",
          "fix": "试压桩≥3根；摩擦看标高、端承看压力。",
          "option_id": "G03-html-practice-html-q5-a89c9f731582:option-3"
        },
        {
          "text": "静压桩以压桩力大于机架配重即可，不必设试压桩。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "只盯压桩力。",
          "loss_reason": "漏试压桩要求；最大压桩力还应小于机架配重×0.9。",
          "fix": "补试压桩≥3根，压桩力<(机架+配重)×0.9。",
          "option_id": "G03-html-practice-html-q5-a89c9f731582:option-4"
        }
      ],
      "variant_id": "G03-html-practice-html-q5-a89c9f731582",
      "surface_id": "practice.html",
