    {
      "answer_type": "single_choice",
      "rule_group": "屋面·定级",
      "stem": "某工程屋面防水设计。关于屋面防水的分级与设防道数，选出正确、能得分的作答。",
      "model_answer": "屋面防水分一、二、三级共三级；一级不少于3道(卷材≥1道)、二级不少于2道(卷材≥1道)、三级不少于1道。",
      "options": [
        {
          "text": "屋面防水与地下工程采用相同分级，同样分一、二、三、四级共四级，并按四级分别对应各级的设防道数配置。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "屋面地下都叫防水，顺手记成同一套分级。",
          "loss_reason": "屋面是三级、地下才四级，分级数记混，等级一错道数全跟着错。",
          "fix": "屋面防水分三级；四级是地下工程防水等级。",
          "option_id": "F03-html-practice-html-q1-a1e8c37d3095:option-1"
        },
        {
          "text": "屋面防水分一、二、三级共三级；一级不少于3道(其中卷材≥1道)、二级不少于2道、三级不少于1道。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "分级数写「三级」并把各级道数配套点出，一句到位。",
          "option_id": "F03-html-practice-html-q1-a1e8c37d3095:option-2"
        },
        {
          "text": "屋面防水虽分为三级，但各级具体设防道数无须逐一记忆，只要答出分级即算完整。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "记住「三级」就以为够了，懒得背道数。",
          "loss_reason": "漏了各级设防道数这组采分点，只答分级不给全分。",
          "fix": "补写一级≥3道(卷材≥1道)、二级≥2道、三级≥1道。",
          "option_id": "F03-html-practice-html-q1-a1e8c37d3095:option-3"
        },
        {
          "text": "屋面防水分三级，其中一级不少于2道、二级不少于1道，卷材与涂料任选、不作配套要求。",
          "is_correct": false,
          "source_error_code": "E03",
          "temptation": "分级对，道数凭印象往小了写。",
          "loss_reason": "一级道数写少、且漏了「卷材≥1道」这个关键配套，数字错位。",
          "fix": "一级≥3道且卷材≥1道、二级≥2道、三级≥1道。",
          "option_id": "F03-html-practice-html-q1-a1e8c37d3095:option-4"
        }
      ],
