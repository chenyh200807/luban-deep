    {
      "answer_type": "single_choice",
      "rule_group": "屋面·基本要求",
      "stem": "关于屋面防水的基本要求，选出完整、能得分的作答。",
      "model_answer": "屋面防水以防为主、以排为辅；设计工作年限不少于20年；天沟、檐沟、变形缝、泛水等部位设附加层。",
      "options": [
        {
          "text": "屋面防水以排为主、以防为辅；设计工作年限不少于20年；天沟、泛水等部位加设附加层。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "觉得屋面靠排水、「以排为主」顺口。",
          "loss_reason": "原则写反了，屋面是「以防为主、以排为辅」，方针错要扣。",
          "fix": "是以防为主、以排为辅，别把主辅颠倒。",
          "option_id": "F03-html-practice-html-q3-3ad2bfdbadc0:option-1"
        },
        {
          "text": "屋面防水以防为主、以排为辅；设计工作年限不少于20年；各薄弱部位构造做法相同、无须分别区别处理。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "原则年限都对，就漏了细部。",
          "loss_reason": "漏了天沟/檐沟/变形缝/泛水设附加层这组采分点。",
          "fix": "补写泛水等薄弱部位加设附加层。",
          "option_id": "F03-html-practice-html-q3-3ad2bfdbadc0:option-2"
        },
        {
          "text": "屋面防水以防为主、以排为辅；设计工作年限不少于10年；天沟、泛水等部位加设附加层。",
          "is_correct": false,
          "source_error_code": "E03",
          "temptation": "原则附加层都对，年限凭印象写10年。",
          "loss_reason": "年限数字写小，屋面防水设计工作年限应≥20年。",
          "fix": "设计工作年限不少于20年，不是10年。",
          "option_id": "F03-html-practice-html-q3-3ad2bfdbadc0:option-3"
        },
        {
          "text": "屋面防水以防为主、以排为辅；设计工作年限不少于20年；天沟、檐沟、变形缝、泛水等部位加设附加层。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "排水原则+年限+附加层三件齐，采分句到位。",
          "option_id": "F03-html-practice-html-q3-3ad2bfdbadc0:option-4"
        }
      ],
