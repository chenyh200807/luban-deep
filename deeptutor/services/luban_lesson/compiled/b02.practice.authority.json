    {
      "answer_type": "single_choice",
      "rule_group": "专项方案·程序维",
      "stem": "关于基坑专项施工方案的编制与论证程序，选出正确、能得分的作答。",
      "model_answer": "专项方案由施工单位编制、报监理审批；开挖≥5m 危大基坑须组织专家论证后实施。",
      "options": [
        {
          "text": "专项施工方案由施工单位编制、报监理审批；开挖深度≥5m 的危大基坑，还须组织专家论证后实施。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "编制主体、审批、危大论证三步齐，程序分清。",
          "option_id": "B02-html-practice-html-q2-2bddaf1e1e6a:option-1"
        },
        {
          "text": "专项方案由监理单位编制、施工单位执行，深基坑由建设单位直接组织论证。",
          "is_correct": false,
          "source_error_code": "E06",
          "temptation": "分不清编制主体。",
          "loss_reason": "编制主体答反、论证组织错。",
          "fix": "施工单位编、报监理审批，危大再专家论证。",
          "option_id": "B02-html-practice-html-q2-2bddaf1e1e6a:option-2"
        },
        {
          "text": "施工单位编制后即可施工，危大工程也无需专家论证，加强技术交底即可。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "想省掉论证环节。",
          "loss_reason": "漏危大专家论证采分点。",
          "fix": "≥5m 危大须专家论证方可实施。",
          "option_id": "B02-html-practice-html-q2-2bddaf1e1e6a:option-3"
        },
        {
          "text": "所有基坑无论深浅都须先专家论证、后编制方案。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "以为都要论证且顺序在前。",
          "loss_reason": "论证限危大(≥5m)、且程序颠倒。",
          "fix": "先编方案，≥5m 危大才须专家论证。",
          "option_id": "B02-html-practice-html-q2-2bddaf1e1e6a:option-4"
        }
      ],
