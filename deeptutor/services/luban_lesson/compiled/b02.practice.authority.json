    {
      "answer_type": "single_choice",
      "rule_group": "专项方案·记录维",
      "stem": "基坑施工前应编制专项施工方案。选出内容列举最完整、能得分的作答。",
      "model_answer": "专项方案含支护、降水（地下水控制）、土方开挖、工艺流程、安全、应急、监测；开挖≥5m 属危大须专家论证。",
      "options": [
        {
          "text": "专项方案应含支护、降水、土方开挖、工艺流程、安全、应急、监测七项；开挖深度≥5m 的基坑属危大工程，须专家论证。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "七项内容 + 危大≥5m 专家论证一并写全，正是采分点。",
          "option_id": "B02-html-practice-html-q1-f2000b14039d:option-1"
        },
        {
          "text": "编制支护和土方开挖两部分即可，降水与监测由现场随机应变，不必写进方案。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "觉得支护、开挖是主体，其余临时定。",
          "loss_reason": "漏降水、监测、应急等多项采分点。",
          "fix": "补齐降水、工艺、安全、应急、监测，共七项。",
          "option_id": "B02-html-practice-html-q1-f2000b14039d:option-2"
        },
        {
          "text": "方案写清支护、降水、开挖即可，无需注明危大工程与专家论证的要求。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "三大件齐了就以为够。",
          "loss_reason": "漏'开挖≥5m 属危大、须专家论证'采分点。",
          "fix": "补'开挖≥5m 属危大、须专家论证'。",
          "option_id": "B02-html-practice-html-q1-f2000b14039d:option-3"
        },
        {
          "text": "浅基坑不必编专项方案，直接按经验开挖，只有深基坑才编制方案。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "以为浅坑可免方案。",
          "loss_reason": "基坑施工前均应编专项方案，违反规范。",
          "fix": "施工前均应编专项方案，≥5m 另须专家论证。",
          "option_id": "B02-html-practice-html-q1-f2000b14039d:option-4"
        }
      ],
      "variant_id": "B02-html-practice-html-q1-f2000b14039d",
