    {
      "answer_type": "single_choice",
      "rule_group": "支护选型·条件维",
      "stem": "某深基坑安全等级为一级。选出支护结构选型正确、能得分的作答。",
      "model_answer": "一级宜选灌注桩排桩、地下连续墙、型钢水泥土搅拌墙等刚度大的支护。",
      "options": [
        {
          "text": "安全等级一级宜选灌注桩排桩、地下连续墙或型钢水泥土搅拌墙等刚度大的支护结构。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "一级对应排桩/地连墙/型钢搅拌墙，刚度大控制变形。",
          "option_id": "B02-html-practice-html-q3-8bd7bbd12396:option-1"
        },
        {
          "text": "一级基坑可采用土钉墙支护，施工快、造价低，适合各类深基坑。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "土钉墙常见就直接套用。",
          "loss_reason": "土钉墙限二三级，用于一级越界。",
          "fix": "一级用排桩/地连墙/型钢搅拌墙。",
          "option_id": "B02-html-practice-html-q3-8bd7bbd12396:option-2"
        },
        {
          "text": "一级基坑宜选水泥土重力式围护墙，靠自重挡土稳定可靠。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "重力墙听着稳当。",
          "loss_reason": "重力墙属二三级、且限淤泥质≤7m。",
          "fix": "一级用排桩/地连墙等；重力墙限二三级。",
          "option_id": "B02-html-practice-html-q3-8bd7bbd12396:option-3"
        },
        {
          "text": "支护类型与安全等级无关，按造价最低的方案选即可。",
          "is_correct": false,
          "source_error_code": "E01",
          "temptation": "只顾省造价。",
          "loss_reason": "忽略安全等级这道首轮筛选。",
          "fix": "先按安全等级筛，一级用排桩/地连墙。",
          "option_id": "B02-html-practice-html-q3-8bd7bbd12396:option-4"
        }
      ],
