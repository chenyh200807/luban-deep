    {
      "answer_type": "single_choice",
      "rule_group": "井点选型·计算表达维",
      "stem": "某基坑降水深度约 8m，场地上部为填土层。按降水深度与土质选井点，选出能得分的作答。",
      "model_answer": "排除集水明排(>3m)、轻型(≤6m)、管井(填土不宜)，宜选喷射井点(降水深度 8~20m)。",
      "options": [
        {
          "text": "深 8m 超轻型≤6m、填土不宜管井，宜选喷射井点，其降水深度 8~20m 覆盖本工况。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "逐条卡深度与土质排除，落到喷射并回判 8m∈8~20m，判据完整。",
          "option_id": "G01-html-practice-html-q2-56338410f994:option-1"
        },
        {
          "text": "选轻型井点，轻型构造简单、布置方便，配合多级还能加深，用于本 8m 基坑最稳妥。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "轻型最常见、构造简单，顺手就选。",
          "loss_reason": "轻型井点降水深度≤6m（多级 6~10m 需分级），单级 8m 够不着。",
          "fix": "8m 超轻型单级，应选喷射井点(8~20m)。",
          "option_id": "G01-html-practice-html-q2-56338410f994:option-2"
        },
        {
          "text": "选降水管井，管井出水量大、对深度不敏感，8m 填土用管井降水效率最高最省事。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "以为管井深度大、出水多就通用。",
          "loss_reason": "管井要求渗透系数较大（砂砾），填土渗透系数小、出水寥寥，不宜用管井。",
          "fix": "填土不宜管井；按深度 8m 选喷射井点。",
          "option_id": "G01-html-practice-html-q2-56338410f994:option-3"
        },
        {
          "text": "选集水明排，沿坑底挖排水沟、设集水井把地下水引流抽走，明排对 8m 基坑也够用。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "明排看着简单便宜。",
          "loss_reason": "明排只适用≤3m 且软土；8m 深坑必须井点降水。",
          "fix": "深 8m 用井点（喷射），不是集水明排。",
          "option_id": "G01-html-practice-html-q2-56338410f994:option-4"
        }
      ],
