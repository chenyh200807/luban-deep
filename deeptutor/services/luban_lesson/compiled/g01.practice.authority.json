    {
      "answer_type": "single_choice",
      "rule_group": "轻型井点·条件维",
      "stem": "关于轻型井点的降水深度，选出表述正确、能得分的作答。",
      "model_answer": "轻型井点降水深度单级≤6m，多级可达 6~10m。",
      "options": [
        {
          "text": "轻型井点单级降水深度≤6m，需要更深时采用多级轻型井点，可达 6~10m。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "分清单级≤6m 与多级 6~10m，数字与条件都齐。",
          "option_id": "G01-html-practice-html-q3-413c0fb7959f:option-1"
        },
        {
          "text": "轻型井点降水深度 8~20m，适用于较深基坑，是深层降水的主力方法。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "把轻型和喷射的深度记混。",
          "loss_reason": "8~20m 是喷射井点的范围，轻型单级≤6m。",
          "fix": "轻型单级≤6m、多级 6~10m；8~20m 是喷射。",
          "option_id": "G01-html-practice-html-q3-413c0fb7959f:option-2"
        },
        {
          "text": "轻型井点降水深度不受限制，加长井管即可任意加深，深基坑也能一级到位。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "以为加管就能无限加深。",
          "loss_reason": "轻型受真空吸程限制，单级≤6m，不是不受限。",
          "fix": "单级≤6m，更深需多级或改喷射/真空。",
          "option_id": "G01-html-practice-html-q3-413c0fb7959f:option-3"
        },
        {
          "text": "轻型井点降水深度>6m 且要求渗透系数>1e-6、管径≥200mm，用于大渗透系数土层。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "把真空降水井管的参数安到轻型头上。",
          "loss_reason": ">6m·渗透系数>1e-6·管径≥200 是真空降水井管的条件。",
          "fix": "轻型单级≤6m；>6m 大渗透用真空降水井管。",
          "option_id": "G01-html-practice-html-q3-413c0fb7959f:option-4"
        }
      ],
