      "options": [
        {
          "text": "渗透系数较大的砂砾、砂卵石层，出水量大，宜用降水管井降水。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "抓住渗透系数较大→管井这一条件采分句。",
          "option_id": "G01-html-practice-html-q5-0d346ee673dc:option-1"
