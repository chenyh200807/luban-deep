  "items": [
    {
      "answer_type": "single_choice",
      "rule_group": "降水分流·条件维",
      "stem": "某基坑开挖深度 4m，场地为软土、地下水丰富。问降水方案怎么选，选出最完整、能得分的作答。",
      "model_answer": "深度>3m 应井点降水；综合地质水文环境支护，危及周边截水回灌、有承压水验算突涌。",
      "options": [
        {
          "text": "深度>3m 应采用井点降水；并综合地质、水文、环境、支护，危及周边时截水或回灌。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "先按深度分流定井点，再补综合因素与周边保护，判据链完整。",
          "option_id": "G01-html-practice-html-q1-dda33aea0861:option-1"
        },
        {
          "text": "有地下水就用集水明排、挖排水沟设集水井靠重力排走，简单经济即可满足降水。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "一见地下水就想到最常见的集水明排。",
          "loss_reason": "深度 4m 已>3m，明排压不住；集水明排只适用≤3m 且软土。",
          "fix": "深度>3m 应改井点降水，集水明排仅≤3m 软土。",
          "option_id": "G01-html-practice-html-q1-dda33aea0861:option-2"
        },
        {
          "text": "不看深度直接选降水管井，管井出水量大、适应性强，任何土质基坑都能可靠降水。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "觉得管井出水大、万能。",
          "loss_reason": "管井要求渗透系数较大（砂砾），软土/填土/黏土不宜；且未按深度分流。",
          "fix": "先按深度分流用井点，再按渗透系数与土质选井点类型。",
          "option_id": "G01-html-practice-html-q1-dda33aea0861:option-3"
        },
        {
          "text": "只要写采取降水措施把水位降下去即可，具体哪种方法现场看着定不必写死。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "图省事、笼统写降水。",
          "loss_reason": "没有可判分的方法与依据，采分点全落空。",
          "fix": "写明>3m 井点降水+综合因素+周边保护+承压水验算。",
          "option_id": "G01-html-practice-html-q1-dda33aea0861:option-4"
        }
      ],
      "variant_id": "G01-html-practice-html-q1-dda33aea0861",
