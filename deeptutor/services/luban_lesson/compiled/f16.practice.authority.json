  "items": [
    {
      "answer_type": "single_choice",
      "rule_group": "分档·条件维",
      "stem": "某屋面卷材防水层出现起鼓，鼓泡直径有 80mm、160mm 两类。选出最完整、能得分的处置方案。",
      "model_answer": "按 100mm 直径分档：直径＜100mm 用抽气灌胶法；≥100mm 需斜十字形割开、清理、吹干、重贴（新贴方形卷材）。",
      "options": [
        {
          "text": "两类鼓泡不作分档，一律用刀割开、清理干净后重贴新卷材，认为割补最彻底、可一步到位处理完毕。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "觉得割补最彻底，小鼓大鼓一起割省得复发。",
          "loss_reason": "小鼓＜100mm 抽气灌胶即可，一律割开是把完好防水层豁开大口子，违反 100mm 分档。",
          "fix": "Ø80 用抽气灌胶法，只有 ≥100mm 才走割补。",
          "option_id": "F16-html-practice-html-q1-b160745e065e:option-1"
        },
        {
          "text": "按 100mm 直径分档：Ø80 小鼓抽气灌胶，Ø160 大鼓斜十字割开、清理吹干后重贴方形卷材。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "分档界 100mm + 两路治法配套写全，这就是判分眼。",
          "option_id": "F16-html-practice-html-q1-b160745e065e:option-2"
        },
        {
          "text": "两类鼓泡不作分档，一律采用抽气灌胶法，认为既不破坏原有卷材又省时省料、施工最为简便。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "抽气灌胶听着稳妥又不动刀，像「保守正确」。",
          "loss_reason": "Ø160 大鼓胶结料大面积失效，只抽气治标不治本、原地复发；分档用错档。",
          "fix": "≥100mm 大鼓必须割补：割开、清理、吹干、重贴。",
          "option_id": "F16-html-practice-html-q1-b160745e065e:option-3"
        },
        {
          "text": "按 300mm 直径分档：直径＜300mm 的抽气灌胶，≥300mm 的割开重贴，两类据此分开处理。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "记得「按直径分档」这个动作，界值却记串了。",
          "loss_reason": "分档界是 100mm，写 300mm 属规范数字混淆，两类鼓泡全被分错档。",
          "fix": "分档界=100mm：＜100 抽气灌胶、≥100 割补。",
          "option_id": "F16-html-practice-html-q1-b160745e065e:option-4"
        }
      ],
