    {
      "answer_type": "single_choice",
      "rule_group": "地面·石材流程",
      "stem": "石材楼地面施工，选出流程与铺前预处理完整、能得分的作答。",
      "model_answer": "基层处理→放线→试拼→铺砂浆→铺石材→养护→勾缝；铺设前浸湿晾干防吸水空鼓。",
      "options": [
        {
          "text": "流程为基层处理、放线、试拼、铺砂浆、铺石材、养护、勾缝；铺设前石材浸湿晾干，防吸水空鼓。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "流程+浸湿晾干防空鼓，主干与预处理都齐。",
          "option_id": "D14-html-practice-html-q6-19297bc52e05:option-1"
        },
        {
          "text": "先铺砂浆再放线、试拼，石材干铺压实即可，浸湿会打滑不必做。",
          "is_correct": false,
          "source_error_code": "E06",
          "temptation": "觉得干铺压实更牢、放线可后补。",
          "loss_reason": "顺序颠倒且漏浸湿；干石材吸水会致空鼓。",
          "fix": "先放线试拼后铺浆，铺前浸湿晾干。",
          "option_id": "D14-html-practice-html-q6-19297bc52e05:option-2"
        },
        {
          "text": "基层处理、铺砂浆、铺石材、勾缝即可，试拼、养护现场看情况省略。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "只记主干四步。",
          "loss_reason": "漏试拼、养护，且未写浸湿防空鼓。",
          "fix": "补试拼、养护、铺前浸湿晾干。",
          "option_id": "D14-html-practice-html-q6-19297bc52e05:option-3"
        },
        {
          "text": "石材和瓷砖一样先泡透再铺，铺后无需养护、自然干即可。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "把石材当瓷砖处理。",
          "loss_reason": "石材是浸湿晾干（非泡透），铺后仍需养护。",
          "fix": "石材浸湿晾干、铺后养护。",
          "option_id": "D14-html-practice-html-q6-19297bc52e05:option-4"
        }
      ],
