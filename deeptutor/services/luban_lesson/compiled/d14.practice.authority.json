    {
      "answer_type": "single_choice",
      "rule_group": "吊顶·工序排序",
      "stem": "暗龙骨吊顶施工工序，选出顺序正确、能得分的作答。",
      "model_answer": "放线→画龙骨分档线→安装水电管线→主龙骨→副龙骨→罩面板→压条；水电管线先于骨架。",
      "options": [
        {
          "text": "放线、画分档线、安装水电管线、装主龙骨、装副龙骨、装罩面板、最后压条；水电先于骨架。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "水电先于主副龙骨、罩面板压条收尾，顺序全对。",
          "option_id": "D14-html-practice-html-q5-b20c276b031f:option-1"
        },
        {
          "text": "放线、装主龙骨、装副龙骨、装罩面板后，再穿水电管线、最后压条。",
          "is_correct": false,
          "source_error_code": "E06",
          "temptation": "以为先搭架封板、再穿管方便。",
          "loss_reason": "水电管线应先于骨架，后穿会破坏已成型骨架。",
          "fix": "水电管线排在主、副龙骨前。",
          "option_id": "D14-html-practice-html-q5-b20c276b031f:option-2"
        },
        {
          "text": "放线、装主龙骨、装罩面板、装副龙骨、穿水电、压条，边装边调最省事。",
          "is_correct": false,
          "source_error_code": "E06",
          "temptation": "凭印象排顺序。",
          "loss_reason": "罩面板排到副龙骨前、水电放最后，多处颠倒。",
          "fix": "副龙骨在罩面板前、水电在骨架前。",
          "option_id": "D14-html-practice-html-q5-b20c276b031f:option-3"
        },
        {
          "text": "先装龙骨再封板即可，放线、分档线、压条属次要步骤可省略不写。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "只记住“搭架封板”主干。",
          "loss_reason": "漏放线/分档线/压条，且未点水电顺序。",
          "fix": "放线分档线在前、压条收尾、水电先于骨架都要写。",
          "option_id": "D14-html-practice-html-q5-b20c276b031f:option-4"
        }
      ],
