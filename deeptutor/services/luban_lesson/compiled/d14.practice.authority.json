    },
    {
      "answer_type": "single_choice",
      "rule_group": "吊顶·吊杆超长",
      "stem": "某吊顶吊杆较长，并遇梁、风管。选出吊杆超长处理与吊挂构造完整、能得分的作答。",
      "model_answer": "吊杆>1500mm设反支撑，>2500mm设钢结构转换层；遇梁、风管处设横担，不得直接吊挂于设备，灯具风口设附加龙骨。",
      "options": [
        {
          "text": "吊杆>1500mm设反支撑，>2500mm设钢结构转换层；遇梁风管设横担、不得吊挂于设备、灯具风口设附加龙骨。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "两道门槛+横担+不吊挂设备+灯口附加龙骨，全写才拿满。",
          "option_id": "D14-html-practice-html-q2-0adfdf5445c9:option-1"
        },
        {
          "text": "吊杆超长时按比例加密吊杆、多吊几根即可保证牢固，不必另设支撑构造。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "把超长稳定问题当成数量问题。",
          "loss_reason": "吊杆超长是侧向失稳，加密解决不了，须设反支撑/转换层。",
          "fix": ">1500反支撑、>2500转换层，不是加密。",
          "option_id": "D14-html-practice-html-q2-0adfdf5445c9:option-2"
        },
        {
          "text": "吊杆>1500mm一律设钢结构转换层，2500mm 只是参考值、可不区分。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "记得有个门槛，却把两道并成一道。",
          "loss_reason": "混淆两道门槛：>1500反支撑、>2500才转换层。",
          "fix": "分清 1500 反支撑、2500 转换层两道门槛。",
          "option_id": "D14-html-practice-html-q2-0adfdf5445c9:option-3"
        },
        {
          "text": "吊杆可直接吊挂在风管、设备上就近固定，遇梁绕开即可，省去横担。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "就近固定看着省事。",
          "loss_reason": "不得直接吊挂于设备，遇梁风管应设横担。",
          "fix": "遇梁风管设横担，不得吊挂于设备。",
          "option_id": "D14-html-practice-html-q2-0adfdf5445c9:option-4"
        }
      ],
      "variant_id": "D14-html-practice-html-q2-0adfdf5445c9",
