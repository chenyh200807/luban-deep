    {
      "answer_type": "single_choice",
      "rule_group": "吊顶·顶棚防裂",
      "stem": "某石膏板顶棚出现裂缝。选出防裂原因与措施完整、能得分的作答。",
      "model_answer": "按防裂五点：吊筋间距≤1200、拼缝错缝不密拼、螺钉固定牢固、转角加强、嵌缝饱满。",
      "options": [
        {
          "text": "从五点治理：吊筋间距≤1200、拼缝错缝且不密拼、螺钉固定牢固、转角加强、嵌缝饱满。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "吊筋·错缝·螺钉·转角·嵌缝五点全写，对应五个断点。",
          "option_id": "D14-html-practice-html-q4-6967b3b24577:option-1"
        },
        {
          "text": "裂缝铲除后重新刷腻子、刷两遍乳胶漆找平，把面层做光就不裂了。",
          "is_correct": false,
          "source_error_code": "E04",
          "temptation": "把裂缝当面层问题。",
          "loss_reason": "口号化治标，没回到骨架、缝、钉、角、嵌缝。",
          "fix": "按防裂五点治理，不是只刷漆。",
          "option_id": "D14-html-practice-html-q4-6967b3b24577:option-2"
        },
        {
          "text": "主要保证吊筋间距≤1200、螺钉固定牢固两条，其余现场把控即可。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "只记两点就下笔。",
          "loss_reason": "漏拼缝错缝不密拼、转角加强、嵌缝饱满三点。",
          "fix": "补错缝不密拼、转角加强、嵌缝饱满。",
          "option_id": "D14-html-practice-html-q4-6967b3b24577:option-3"
        },
        {
          "text": "裂缝多在拼缝处，把板密拼、缝挤紧不留缝，就不会从缝里裂。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "以为密拼更严实。",
          "loss_reason": "应拼缝错缝、不密拼；密拼反而应力集中开裂。",
          "fix": "拼缝要错缝、不密拼。",
          "option_id": "D14-html-practice-html-q4-6967b3b24577:option-4"
        }
      ],
