    {
      "answer_type": "single_choice",
      "rule_group": "吊顶·石膏板固定",
      "stem": "纸面石膏板罩面板的固定，选出方向与要求完整、能得分的作答。",
      "model_answer": "从板中间向四周自由固定，长边沿纵向铺设，螺钉间距150-170mm，钉眼防锈，双层板接缝错开。",
      "options": [
        {
          "text": "从板中间向四周自由固定、长边沿纵向铺，螺钉间距150-170mm、钉眼防锈、双层板接缝错开。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "固定方向+钉距+防锈+错缝四件齐，缺一扣一。",
          "option_id": "D14-html-practice-html-q3-680f21e9359a:option-1"
        },
        {
          "text": "从板四边先固定牢再向中间收，钉距150-170mm、钉眼防锈、双层接缝错开。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "觉得先钉牢四边更稳。",
          "loss_reason": "方向反了：应从中间向四周自由固定，让板释放变形。",
          "fix": "从中间向四周固定，不是从四边向中间。",
          "option_id": "D14-html-practice-html-q3-680f21e9359a:option-2"
        },
        {
          "text": "从中间向四周固定即可，钉距、钉眼防锈、错缝属细节，现场看着办。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "只记住固定方向一条。",
          "loss_reason": "漏钉距150-170、钉眼防锈、双层错缝三处采分。",
          "fix": "补钉距150-170、防锈、双层错缝。",
          "option_id": "D14-html-practice-html-q3-680f21e9359a:option-3"
        },
        {
          "text": "顶棚裂了主要靠面层：重新刷腻子、刷漆找平即可，固定方式不影响开裂。",
          "is_correct": false,
          "source_error_code": "E04",
          "temptation": "把裂缝当表面问题。",
          "loss_reason": "口号化、避开固定与骨架，裂缝根子在固定与骨架。",
          "fix": "回到中间向四周固定+防裂五点，不是只刷漆。",
          "option_id": "D14-html-practice-html-q3-680f21e9359a:option-4"
        }
      ],
      "variant_id": "D14-html-practice-html-q3-680f21e9359a",
