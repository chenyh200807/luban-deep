  "items": [
    {
      "answer_type": "single_choice",
      "rule_group": "吊顶·龙骨参数",
      "stem": "暗龙骨吊顶的主、次龙骨，选出间距与构造要求完整、能得分的作答。",
      "model_answer": "主龙骨间距≤1200mm、悬臂≤300mm、接头错开；次龙骨间距≤600mm、不得搭接，洞口周边设附加龙骨。",
      "options": [
        {
          "text": "主龙骨间距≤1200mm、悬臂段≤300mm且接头错开；次龙骨间距≤600mm、不得搭接，洞口周边设附加龙骨。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "主次间距、悬臂、接头、洞口四件齐，正是采分点。",
          "option_id": "D14-html-practice-html-q1-dc70ba7f710c:option-1"
        },
        {
          "text": "主龙骨间距≤600mm、次龙骨间距≤1200mm，主密次疏排布，把两个数记住即可。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "主次间距数值记得，却把谁密谁疏记反。",
          "loss_reason": "主≤1200、次≤600，此项主次值张冠李戴。",
          "fix": "主龙骨≤1200、次龙骨≤600，别记反。",
          "option_id": "D14-html-practice-html-q1-dc70ba7f710c:option-2"
        },
        {
          "text": "主龙骨间距≤1200mm即可，悬臂、接头、洞口这些细节现场灵活掌握不必写。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "只记住主间距一个数就下笔。",
          "loss_reason": "漏悬臂≤300、接头错开、次≤600不搭接、洞口附加龙骨。",
          "fix": "补悬臂≤300、次≤600不搭接、洞口设附加龙骨。",
          "option_id": "D14-html-practice-html-q1-dc70ba7f710c:option-3"
        },
        {
          "text": "次龙骨可搭接加长以增强刚度，间距≤600mm，洞口周边无需额外处理。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "以为搭接更结实、洞口不用管。",
          "loss_reason": "次龙骨不得搭接、洞口必须设附加龙骨，两处均错。",
          "fix": "次龙骨不得搭接，洞口周边设附加龙骨。",
          "option_id": "D14-html-practice-html-q1-dc70ba7f710c:option-4"
        }
      ],
      "variant_id": "D14-html-practice-html-q1-dc70ba7f710c",
