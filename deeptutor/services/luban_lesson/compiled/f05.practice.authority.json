    {
      "answer_type": "single_choice",
      "rule_group": "裂缝治理·概念",
      "stem": "「多道设防、刚柔结合」，哪种理解能对应得分作答？",
      "model_answer": "刚性混凝土自防水与柔性卷材/涂膜多道叠合，一道破损仍有其余道设防挡水。",
      "options": [
        {
          "text": "刚性混凝土自防水与柔性卷材/涂膜多道叠合，一道破损仍有其余道挡水，形成冗余。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
