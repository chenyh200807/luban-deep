    {
      "answer_type": "single_choice",
      "rule_group": "穿墙治理·概念",
      "stem": "穿墙管处为何要设置止水环？选出表述准确的作答。",
      "model_answer": "止水环沿管壁延长水的渗径、增加渗流阻力，阻断水沿管壁渗入。",
      "options": [
        {
          "text": "止水环沿管壁延长水的渗径、增加渗流阻力，从而阻断水沿管壁渗入。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "点明'延长渗径、增加阻力'的机理，是采分句。",
          "option_id": "F05-html-practice-html-q6-38da71f9263e:option-1"
        },
        {
          "text": "止水环是固定管道、防止管道晃动的支架构件。",
          "is_correct": false,
          "source_error_code": "M03",
          "temptation": "'环'像个卡箍，容易当成固定件。",
          "loss_reason": "止水环功能是止水延长渗径，非固定支架，概念错误。",
          "fix": "止水环延长渗径、增加渗流阻力止水。",
          "option_id": "F05-html-practice-html-q6-38da71f9263e:option-2"
        },
        {
          "text": "设不设止水环都行，关键把灌浆量灌足就能堵住。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "觉得灌浆足够就够，忽略止水环。",
          "loss_reason": "漏掉止水环这一关键采分句。",
          "fix": "必须设止水环延长渗径，再灌浆堵漏。",
          "option_id": "F05-html-practice-html-q6-38da71f9263e:option-3"
        },
        {
          "text": "止水环就是管道外包的保温层，起隔热保温作用。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "和管道保温层长得像，容易混。",
          "loss_reason": "止水环是止水构件，非保温层，概念混淆。",
          "fix": "止水环延长渗径止水，不是保温。",
          "option_id": "F05-html-practice-html-q6-38da71f9263e:option-4"
        }
