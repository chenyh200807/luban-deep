    {
      "answer_type": "single_choice",
      "rule_group": "穿墙治理·程序维",
      "stem": "管道穿墙部位渗漏。其治理措施按流程组织，选出能得分的作答。",
      "model_answer": "清理管道表面→设置止水环→振捣密实→避免振动→灌浆堵漏，按序不漏步。",
      "options": [
        {
          "text": "清理管道表面→设置止水环→振捣密实→避免振动→灌浆堵漏，按此流程组织不漏步。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "五步顺序齐全，止水环与灌浆堵漏都在，程序箭头链完整。",
          "option_id": "F05-html-practice-html-q5-fc674c9a61fa:option-1"
        },
        {
          "text": "直接对渗水处灌浆堵漏，把水封住即可，简单有效。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "觉得堵漏就是灌浆，一步到位。",
          "loss_reason": "漏了清理管面、止水环、振捣密实、避免振动等前置，采分点遗漏。",
          "fix": "补清理管面→止水环→振捣密实→避免振动→灌浆堵漏。",
          "option_id": "F05-html-practice-html-q5-fc674c9a61fa:option-2"
        },
        {
          "text": "先灌浆堵漏，再回头清理管道表面、补设止水环。",
          "is_correct": false,
          "source_error_code": "E06",
          "temptation": "以为先把水堵住再收拾其他，顺手。",
          "loss_reason": "止水环、振捣需在灌浆前，顺序颠倒，程序错误。",
          "fix": "按清理→止水环→振捣密实→避免振动→灌浆堵漏的顺序。",
          "option_id": "F05-html-practice-html-q5-fc674c9a61fa:option-3"
        },
        {
          "text": "按卷材流淌的切割法、钉钉子法处理穿墙渗漏部位。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "记了不少治理法，随手抓一个套上。",
          "loss_reason": "切割法/钉钉子法是卷材流淌治理，用于穿墙属张冠李戴。",
          "fix": "穿墙用清理→止水环→振捣→避振→灌浆堵漏。",
          "option_id": "F05-html-practice-html-q5-fc674c9a61fa:option-4"
        }
      ],
