    {
      "answer_type": "single_choice",
      "rule_group": "裂缝治理·记录维",
      "stem": "防水混凝土墙体出现裂缝渗漏。其治理措施选出最完整、能得分的作答。",
      "model_answer": "及时保湿养护；采取多道设防、刚柔结合；确保防水层及保护层质量。",
      "options": [
        {
          "text": "只需加强防水、及时做好养护，把渗漏部位大致处理妥当，整体治理便算基本到位。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "'加强防水''养护'听着对，容易觉得够了。",
          "loss_reason": "漏了核心采分句'多道设防、刚柔结合'与保护层质量。",
          "fix": "补'多道设防、刚柔结合'和确保防水层保护层质量。",
          "option_id": "F05-html-practice-html-q3-faf7f765deab:option-1"
        },
        {
          "text": "及时保湿养护，采取多道设防、刚柔结合的防水做法，并确保防水层及保护层质量。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "养护 + 多道设防刚柔结合 + 保护层质量三件齐，关键句'多道设防、刚柔结合'不丢。",
          "option_id": "F05-html-practice-html-q3-faf7f765deab:option-2"
        },
        {
          "text": "沿裂缝先设置止水环，再灌浆堵漏将裂缝逐段封死，即可完成这道裂缝的治理。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "止水环+灌浆是穿墙治理，套到裂缝上像是能堵。",
          "loss_reason": "止水环+灌浆是管道穿墙的治理，用于裂缝属方法张冠李戴。",
          "fix": "裂缝治理写养护 + 多道设防刚柔结合 + 保护层质量。",
          "option_id": "F05-html-practice-html-q3-faf7f765deab:option-3"
        },
        {
          "text": "把防水一次做扎实、彻底杜绝渗漏，全面确保整体工程质量长期合格。",
          "is_correct": false,
          "source_error_code": "E04",
          "temptation": "口号顺口、像总结陈词。",
          "loss_reason": "没有可判分的具体措施，全是口号。",
          "fix": "写养护 + 多道设防刚柔结合 + 保护层质量。",
          "option_id": "F05-html-practice-html-q3-faf7f765deab:option-4"
        }
      ],
