    {
      "answer_type": "single_choice",
      "rule_group": "裂缝治理·概念",
      "stem": "「多道设防、刚柔结合」，哪种理解能对应得分作答？",
      "model_answer": "刚性混凝土自防水与柔性卷材/涂膜多道叠合，一道破损仍有其余道设防挡水。",
      "options": [
        {
          "text": "刚性混凝土自防水与柔性卷材/涂膜多道叠合，一道破损仍有其余道挡水，形成冗余。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "点出刚柔搭配 + 多道冗余 + 一道破别道挡，理解到位。",
          "option_id": "F05-html-practice-html-q4-5abd48b93a15:option-1"
        },
        {
          "text": "只要一道防水层做得够厚够好就行，多做几道是浪费材料。",
          "is_correct": false,
          "source_error_code": "M03",
          "temptation": "觉得做厚一道更省更牢。",
          "loss_reason": "单道一处破即漏，与多道设防要求相悖，概念错误。",
          "fix": "要多道设防、刚柔结合，一道破仍有别道挡。",
          "option_id": "F05-html-practice-html-q4-5abd48b93a15:option-2"
        },
        {
          "text": "刚柔结合指先做刚性面层再做柔性找平层的抹灰施工顺序。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "把'刚柔'理解成抹灰工序顺序。",
          "loss_reason": "刚柔结合指刚性与柔性防水层搭配，非抹灰顺序，概念混淆。",
          "fix": "刚性自防水 + 柔性卷材/涂膜多道搭配。",
          "option_id": "F05-html-practice-html-q4-5abd48b93a15:option-3"
        },
        {
          "text": "多道设防就是同一种防水涂料多刷几遍加厚。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "'多道'字面理解成多刷几遍。",
          "loss_reason": "漏了'刚柔结合'——多道要刚性柔性搭配，非同料多刷。",
          "fix": "补'刚柔结合'：刚性自防水配柔性卷材涂膜。",
          "option_id": "F05-html-practice-html-q4-5abd48b93a15:option-4"
        }
      ],
