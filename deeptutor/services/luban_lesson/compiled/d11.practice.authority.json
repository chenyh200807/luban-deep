    {
      "answer_type": "single_choice",
      "rule_group": "交接防裂·条件维",
      "stem": "不同材料基体交接处已设加强网。关于加强网与各基体的搭接宽度，选出能得分的作答。",
      "model_answer": "加强网与各基体的搭接宽度不应小于 100mm。",
      "options": [
        {
          "text": "加强网与各基体的搭接宽度均不应小于 100mm。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "关键词“与各基体搭接”+数值“不小于100mm”都在。",
          "option_id": "D11-html-practice-html-q4-0e12bc15f773:option-1"
        },
        {
          "text": "加强网与各基体的搭接宽度不应小于 50mm。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "50mm 是最常见的设错值。",
          "loss_reason": "50mm 不够，规范是不小于 100mm。",
          "fix": "搭接宽度不应小于 100mm。",
          "option_id": "D11-html-practice-html-q4-0e12bc15f773:option-2"
        },
        {
          "text": "加强网搭接宽度不小于 80mm 即可。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "80 接近 100，容易当成合格。",
          "loss_reason": "数值不足，规范定的是 100mm。",
          "fix": "不小于 100mm，80mm 不达标。",
          "option_id": "D11-html-practice-html-q4-0e12bc15f773:option-3"
        },
        {
          "text": "加强网搭接够宽就行，具体多少看现场情况定。",
          "is_correct": false,
          "source_error_code": "E03",
          "temptation": "知道要搭接却不肯给数字。",
          "loss_reason": "漏了“不小于 100mm”这个关键数值。",
          "fix": "写明搭接宽度≥100mm。",
          "option_id": "D11-html-practice-html-q4-0e12bc15f773:option-4"
        }
      ],
