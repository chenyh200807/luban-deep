    {
      "answer_type": "single_choice",
      "rule_group": "控厚度·条件维",
      "stem": "内墙普通抹灰与高级抹灰的抹灰层平均总厚度上限，选出正确作答。",
      "model_answer": "内墙普通抹灰层平均总厚度≤20mm；高级抹灰层≤25mm。",
      "options": [
        {
          "text": "内墙普通抹灰层平均总厚度不大于 20mm，高级抹灰层平均总厚度不大于 25mm。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "普通 20、高级 25，对象与数值一一对应，不对调。",
          "option_id": "D11-html-practice-html-q2-f9d8018fa2c8:option-1"
        },
        {
          "text": "内墙普通抹灰层平均总厚度不大于 25mm，高级抹灰层平均总厚度不大于 30mm。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "两个数都往上记大了一档。",
          "loss_reason": "20/25 记成了 25/30，规范数值整体记高。",
          "fix": "普通≤20mm、高级≤25mm。",
          "option_id": "D11-html-practice-html-q2-f9d8018fa2c8:option-2"
        },
        {
          "text": "内墙普通抹灰层不大于 25mm，高级抹灰层不大于 20mm。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "数值都见过，顺手把两档对调了。",
          "loss_reason": "普通/高级对象与数值张冠李戴。",
          "fix": "普通≤20、高级≤25，别把两档对调。",
          "option_id": "D11-html-practice-html-q2-f9d8018fa2c8:option-3"
        },
        {
          "text": "这里的 20mm、25mm 指底层、中层、面层每一单层的厚度上限。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "把“平均总厚度”理解成单层厚度。",
          "loss_reason": "题问的是抹灰层平均总厚度，不是底/中/面单层。",
          "fix": "是抹灰层平均总厚度，非底中面单层。",
          "option_id": "D11-html-practice-html-q2-f9d8018fa2c8:option-4"
        }
      ],
