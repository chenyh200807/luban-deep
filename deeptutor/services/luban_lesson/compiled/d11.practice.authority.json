  "items": [
    {
      "answer_type": "single_choice",
      "rule_group": "控厚度·条件维",
      "stem": "内墙一般抹灰，某处抹灰总厚度达到 38mm。关于是否采取加强措施，选出正确且能得分的作答。",
      "model_answer": "抹灰总厚度≥35mm 时应采取加强措施（分层抹灰、设加强网）；38mm 已达阈值，须加强。",
      "options": [
        {
          "text": "抹灰总厚度≥35mm 即应采取加强措施，38mm 已达标准，应分层抹灰并设加强网。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "阈值 35mm + 加强做法（分层+挂网）齐全，换个厚度数也不会错。",
          "option_id": "D11-html-practice-html-q1-9d9c40421eea:option-1"
        },
        {
          "text": "抹灰总厚度超过 50mm 才需要加强，38mm 尚未到 50mm，可正常一次抹灰不必加强。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "凭印象觉得更厚（50mm）才加强。",
          "loss_reason": "加强阈值是 35mm 不是 50mm，规范数字记错就漏了加强这一步。",
          "fix": "总厚≥35mm 即须加强，38mm 已达。",
          "option_id": "D11-html-practice-html-q1-9d9c40421eea:option-2"
        },
        {
          "text": "厚度大了容易开裂，做加强处理一下就行，具体到多少毫米无所谓。",
          "is_correct": false,
          "source_error_code": "E03",
          "temptation": "知道要加强，但嫌记数字麻烦。",
          "loss_reason": "漏了“≥35mm”这个关键阈值，采分点落不到数字上。",
          "fix": "写明总厚≥35mm 须加强，并给出分层+挂网。",
          "option_id": "D11-html-practice-html-q1-9d9c40421eea:option-3"
        },
        {
          "text": "只要控制每一遍抹灰不超过 8mm 薄涂，总厚多少都不用加强。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "把单遍薄抹当成免加强的理由。",
          "loss_reason": "混淆了单遍控制与总厚加强——总厚到 35mm 仍须加强。",
          "fix": "总厚≥35mm 一律加强，与单遍厚薄无关。",
          "option_id": "D11-html-practice-html-q1-9d9c40421eea:option-4"
        }
      ],
      "variant_id": "D11-html-practice-html-q1-9d9c40421eea",
      "surface_id": "practice.html",
      "source_index": 0,
      "source_group": "Q",
