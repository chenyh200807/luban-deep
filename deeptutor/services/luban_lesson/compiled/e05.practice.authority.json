    {
      "answer_type": "single_choice",
      "rule_group": "三值构成·概念维",
      "stem": "ACWP（已完成工作实际成本）的构成式是哪一个？选出定义准确的作答。",
      "model_answer": "ACWP = 已完成工程量 × 实际单价（已经花出去的钱）。",
      "options": [
        {
          "text": "ACWP = 已完成工程量 × 实际单价，就是已完成部分实际花出去的钱。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "量取「已完成」、价取「实际」，ACWP 是真金白银的实际支出。",
          "option_id": "E05-html-practice-html-q2-0f20ede257a0:option-1"
        },
        {
          "text": "ACWP = 已完成工程量 × 预算单价，按预算价核算已完成部分的成本。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "「已完成」对了，价却配成「预算」。",
          "loss_reason": "价用错：已完成量×预算单价是 BCWP（挣值），不是 ACWP；ACWP 必须用实际单价。",
          "fix": "ACWP=已完成量×实际单价；已完成量×预算单价那是 BCWP。",
          "option_id": "E05-html-practice-html-q2-0f20ede257a0:option-2"
        },
        {
          "text": "ACWP = 计划工程量 × 实际单价，按实际价核算原计划工程量的成本。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "「实际价」对了，量却配成「计划」。",
          "loss_reason": "量用错：ACWP 的量是「已完成」，不是「计划」；计划量×任何价都不是 ACWP。",
          "fix": "ACWP=已完成量×实际单价，量取已完成、不取计划量。",
          "option_id": "E05-html-practice-html-q2-0f20ede257a0:option-3"
        },
        {
          "text": "ACWP = 预算总成本，即项目开工前编制的全部预算金额。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "「实际成本」听着像个总额，误当预算总账。",
          "loss_reason": "ACWP 是到检查点「已完成部分」的实际支出，不是全项目预算总额。",
          "fix": "ACWP=已完成量×实际单价，只算已干部分的实际花费。",
          "option_id": "E05-html-practice-html-q2-0f20ede257a0:option-4"
        }
      ],
