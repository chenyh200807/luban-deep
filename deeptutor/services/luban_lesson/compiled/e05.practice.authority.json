  "items": [
    {
      "answer_type": "single_choice",
      "rule_group": "三值构成·概念维",
      "stem": "挣值法三个基本参数中，BCWP（挣值）的构成式是哪一个？选出定义准确的作答。",
      "model_answer": "BCWP（已完成工作预算成本／挣值）= 已完成工程量 × 预算单价。",
      "options": [
        {
          "text": "BCWP = 已完成工程量 × 预算单价（已完成的量，按预算价计），即挣得的价值标尺。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "量取「已完成」、价取「预算」，BCWP 是把已干的活按预算价折算的挣值。",
          "option_id": "E05-html-practice-html-q1-368ca609e03b:option-1"
        },
        {
          "text": "BCWP = 已完成工程量 × 实际单价（已完成的量，按实际花的价计），反映实际挣得。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "「已完成」对了，顺手把价也配成「实际」。",
          "loss_reason": "价用错：已完成量×实际单价是 ACWP，不是 BCWP；BCWP 必须用预算单价隔离价格波动。",
          "fix": "BCWP=已完成量×预算单价；已完成量×实际单价那是 ACWP。",
          "option_id": "E05-html-practice-html-q1-368ca609e03b:option-2"
        },
        {
          "text": "BCWP = 计划工程量 × 预算单价（计划的量，按预算价计），代表计划应挣的价值。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "「预算价」对了，量却配成「计划」。",
          "loss_reason": "量用错：计划量×预算单价是 BCWS，不是 BCWP；BCWP 的量必须是「已完成」。",
          "fix": "BCWP=已完成量×预算单价；计划量×预算单价那是 BCWS。",
          "option_id": "E05-html-practice-html-q1-368ca609e03b:option-3"
        },
        {
          "text": "BCWP = 计划工程量 × 实际单价（计划的量，按实际价计），综合计划与实际。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "把「计划」「实际」拼在一起，看着「兼顾两头」。",
          "loss_reason": "量和价全错，且这个组合不对应任何一个基本参数，纯干扰项。",
          "fix": "BCWP=已完成量×预算单价，量取已完成、价取预算，不掺计划量或实际价。",
          "option_id": "E05-html-practice-html-q1-368ca609e03b:option-4"
        }
      ],
