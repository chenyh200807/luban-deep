    {
      "answer_type": "single_choice",
      "rule_group": "检验批划分·条件维",
      "stem": "检验批可按哪些条件划分？（题干已给「楼层」）选出补充完整、能得分的作答。",
      "model_answer": "检验批可按工程量、楼层、施工段、变形缝等划分。",
      "options": [
        {
          "text": "还可按工程量、施工段、变形缝划分，与楼层并列作为检验批的划分依据。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "补齐工程量 / 施工段 / 变形缝，边缘项不漏。",
          "option_id": "A01-html-practice-html-q2-ecc97aac95bb:option-1"
        },
        {
          "text": "还可按主要工种、材料、施工工艺、设备类别划分，与楼层并列作为检验批依据。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "依据看着都沾边，把分项的四类搬来凑。",
          "loss_reason": "工种 / 材料 / 工艺 / 设备是分项工程划分依据，不是检验批。",
          "fix": "检验批按工程量 / 楼层 / 施工段 / 变形缝。",
          "option_id": "A01-html-practice-html-q2-ecc97aac95bb:option-2"
        },
        {
          "text": "楼层已能唯一确定检验批，工程量、施工段、变形缝均不再作为划分依据。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "以为给了楼层就够、其余多余。",
          "loss_reason": "把单一维度当全部，漏工程量 / 施工段 / 变形缝三项。",
          "fix": "补工程量、施工段、变形缝，与楼层并列。",
          "option_id": "A01-html-practice-html-q2-ecc97aac95bb:option-3"
        },
        {
          "text": "还可按专业性质与工程部位划分，与楼层并列作为检验批的划分依据。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "把分部的划分依据错接到检验批上。",
          "loss_reason": "专业性质 / 工程部位是分部工程划分依据，层级归错。",
          "fix": "检验批按工程量 / 楼层 / 施工段 / 变形缝。",
          "option_id": "A01-html-practice-html-q2-ecc97aac95bb:option-4"
        }
      ],
