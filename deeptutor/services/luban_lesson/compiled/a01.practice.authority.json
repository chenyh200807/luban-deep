    {
      "answer_type": "single_choice",
      "rule_group": "分项划分·条件维",
      "stem": "分项工程按哪些条件划分？选出完整、能得分的作答。",
      "model_answer": "分项工程按主要工种、材料、施工工艺、设备类别划分。",
      "options": [
        {
          "text": "按主要工种、材料、施工工艺、设备类别划分。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "四类依据齐全，别与检验批条件混。",
          "option_id": "A01-html-practice-html-q3-1b552c4bae9d:option-1"
        },
        {
          "text": "按工程量、楼层、施工段、变形缝等条件来划分各分项工程。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "依据串档，把检验批那套搬到分项。",
          "loss_reason": "工程量 / 楼层 / 施工段 / 变形缝是检验批划分依据，分项归错类。",
          "fix": "分项按工种 / 材料 / 工艺 / 设备类别。",
          "option_id": "A01-html-practice-html-q3-1b552c4bae9d:option-2"
        },
        {
          "text": "分项工程只按主要工种和所用材料两类依据划分，工艺与设备类别不计。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "记住前两类就当成全部。",
          "loss_reason": "漏施工工艺、设备类别两类，依据不全。",
          "fix": "补施工工艺、设备类别，共四类。",
          "option_id": "A01-html-practice-html-q3-1b552c4bae9d:option-3"
        },
        {
          "text": "按专业性质和工程部位来划分各分项工程，与工种材料并列。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "把分部的依据错接到分项。",
          "loss_reason": "专业性质 / 工程部位是分部工程划分依据，层级归错。",
          "fix": "分项按工种 / 材料 / 工艺 / 设备类别。",
          "option_id": "A01-html-practice-html-q3-1b552c4bae9d:option-4"
        }
      ],
