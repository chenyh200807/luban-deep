  "items": [
    {
      "answer_type": "single_choice",
      "rule_group": "验收层级·程序维",
      "stem": "建筑工程质量验收分哪几级？验收方向如何？选出最完整、能得分的作答。",
      "model_answer": "分检验批、分项工程、分部工程、单位工程四级，自下而上逐级累积验收，下一级合格是上一级前提。",
      "options": [
        {
          "text": "分检验批、分项工程、分部工程、单位工程四级，自下而上逐级累积验收，下一级合格是上一级前提。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "层级名 + 自下而上方向 + 逐级前提，三件齐。",
          "option_id": "A01-html-practice-html-q1-112344cf0ec0:option-1"
        },
        {
          "text": "分单位工程、分部工程、分项工程、检验批四级，自上而下逐级分解验收，上一级合格是下一级前提。",
          "is_correct": false,
          "source_error_code": "E06",
          "temptation": "名头都对，方向顺手写成从大到小。",
          "loss_reason": "方向与前提整体倒装——应自下而上累积，倒着验的「合格」建在没验的地基上。",
          "fix": "检验批、分项、分部、单位，自下而上逐级验。",
          "option_id": "A01-html-practice-html-q1-112344cf0ec0:option-2"
        },
        {
          "text": "分检验批、分项工程、分部工程、单位工程四级，自上而下验收，先定单位工程合格再核对下级。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "层级顺序抄对了，验收方向想反了。",
          "loss_reason": "层级名对但方向错——先定上级再核下级，逻辑颠倒。",
          "fix": "自下而上：下级全合格才验上级。",
          "option_id": "A01-html-practice-html-q1-112344cf0ec0:option-3"
        },
        {
          "text": "分分项工程、分部工程、单位工程三级，自下而上验收，检验批并入分项一并核定不单列。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "以为检验批太小可并进分项。",
          "loss_reason": "漏检验批这一最小验收单元，层级少一级。",
          "fix": "检验批必须单列，共四级。",
          "option_id": "A01-html-practice-html-q1-112344cf0ec0:option-4"
        }
      ],
      "variant_id": "A01-html-practice-html-q1-112344cf0ec0",
