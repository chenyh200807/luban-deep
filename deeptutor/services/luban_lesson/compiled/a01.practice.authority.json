    {
      "answer_type": "single_choice",
      "rule_group": "合格判定·条件维",
      "stem": "检验批主控项目、一般项目的合格标准分别是什么？选出能得分的作答。",
      "model_answer": "主控项目应全部合格；一般项目合格率≥80%且最大偏差不超过规定值。",
      "options": [
        {
          "text": "主控项目必须全部合格；一般项目合格率≥80%、且最大偏差不超过规定值。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "主控全合格（否决）+ 一般≥80%（容差），两条性质分清。",
          "option_id": "A01-html-practice-html-q4-2492e71aec61:option-1"
        },
        {
          "text": "主控项目与一般项目的合格率均达到 80% 以上、偏差不超规定值即合格。",
          "is_correct": false,
          "source_error_code": "E10",
          "temptation": "把两类项目当成同一个百分比门槛。",
          "loss_reason": "主控是否决项、须全部合格，套 80% 就错。",
          "fix": "主控全部合格，只有一般项目才讲≥80%。",
          "option_id": "A01-html-practice-html-q4-2492e71aec61:option-2"
        },
        {
          "text": "主控项目合格率达 80% 以上即可；一般项目则必须全部合格、无一例外。",
          "is_correct": false,
          "source_error_code": "E07",
          "temptation": "记得有全合格和 80% 两档，却对调了。",
          "loss_reason": "两档张冠李戴——主控才是全合格、一般才是≥80%。",
          "fix": "主控全合格、一般≥80%，别对调。",
          "option_id": "A01-html-practice-html-q4-2492e71aec61:option-3"
        },
        {
          "text": "只要主控项目全部合格，检验批即判合格，一般项目不再另设合格率要求。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "以为主控过了就万事大吉。",
          "loss_reason": "漏一般项目合格率≥80%、偏差不超规定值这一道门。",
          "fix": "补一般项目合格率≥80%、偏差不超规定值。",
          "option_id": "A01-html-practice-html-q4-2492e71aec61:option-4"
        }
      ],
