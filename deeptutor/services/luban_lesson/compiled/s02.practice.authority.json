    {
      "answer_type": "single_choice",
      "rule_group": "危大判定·两层门槛",
      "stem": "某常规塔式起重机吊装，单件起吊重量 150kN。是否需要专家论证？选出能得分的作答。",
      "model_answer": "150≥10 属危大须专项方案；但专家论证须「非常规设备/方法」，常规设备的 150kN 够不到，不需论证。",
      "options": [
        {
          "text": "150kN 属危大须专项方案；但为常规设备、未达「非常规且≥100kN」，不需专家论证。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "两阶写清：先 ≥10 判危大，再核「非常规+100/300/200」判论证。",
          "option_id": "S02-html-practice-html-q2-9492e6b106f9:option-1"
        },
        {
          "text": "150kN≥100kN，须专家论证。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "只比 100kN 数字，忽略「非常规设备/方法」前置。",
          "loss_reason": "专家论证前置是非常规设备，常规 150kN 不触发论证。",
          "fix": "属危大编专项方案，常规设备不需论证。",
          "option_id": "S02-html-practice-html-q2-9492e6b106f9:option-2"
        },
        {
          "text": "150kN<300kN，不属危大。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "拿总重 300kN 门槛去比单件。",
          "loss_reason": "混淆单件与总重口径；单件 ≥10 已属危大。",
          "fix": "单件 150≥10，属危大。",
          "option_id": "S02-html-practice-html-q2-9492e6b106f9:option-3"
        },
        {
          "text": "先开吊，专项方案随后补办。",
          "is_correct": false,
          "source_error_code": "E02",
          "temptation": "赶工期，先干后补。",
          "loss_reason": "危大须先编专项方案并审批，漏方案=重大失分。",
          "fix": "属危大，先编专项方案再作业。",
          "option_id": "S02-html-practice-html-q2-9492e6b106f9:option-4"
        }
      ],
      "variant_id": "S02-html-practice-html-q2-9492e6b106f9",
