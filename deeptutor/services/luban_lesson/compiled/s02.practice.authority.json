  "items": [
    {
      "answer_type": "single_choice",
      "rule_group": "危大判定·门槛",
      "stem": "某工程一构件单件起吊重量 80kN，用塔式起重机吊装。关于危大等级，选出能得分的作答。",
      "model_answer": "起重吊装单件≥10kN 即属危大工程，须编专项施工方案；80≥10，属危大（未达 100kN，不需专家论证）。",
      "options": [
        {
          "text": "起重吊装单件起吊重量≥10kN 即属危大工程，须编专项施工方案；80kN 已超 10kN，属危大工程。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "引门槛 10kN + 结论「属危大」+ 须专项方案，三件齐。",
          "option_id": "S02-html-practice-html-q1-dafe371b0b60:option-1"
        },
        {
          "text": "80kN 不到 100kN，不属危大工程，按一般作业组织即可。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "记成「起重吊装够 100kN 才算危大」。",
          "loss_reason": "把超危大论证线 100kN 当成危大下限——危大门槛是 10kN。",
          "fix": "≥10kN 即属危大，80kN 早已达标。",
          "option_id": "S02-html-practice-html-q1-dafe371b0b60:option-2"
        },
        {
          "text": "80kN 属危大且须专家论证。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "一见危大就联想到专家论证。",
          "loss_reason": "专家论证要「非常规且单件≥100kN」（或总重≥300/高≥200），80kN 够不到。",
          "fix": "属危大编专项方案即可，不需专家论证。",
          "option_id": "S02-html-practice-html-q1-dafe371b0b60:option-3"
        },
        {
          "text": "较重，注意加强现场安全即可，等级不必判。",
          "is_correct": false,
          "source_error_code": "M09",
          "temptation": "图省事跳过判等级。",
          "loss_reason": "不判危大等级=丢结论采分，且漏专项方案。",
          "fix": "明确 ≥10kN 属危大、须专项方案。",
          "option_id": "S02-html-practice-html-q1-dafe371b0b60:option-4"
        }
      ],
      "variant_id": "S02-html-practice-html-q1-dafe371b0b60",
