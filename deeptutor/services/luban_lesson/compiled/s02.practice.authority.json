    {
      "answer_type": "single_choice",
      "rule_group": "危大判定·超危大",
      "stem": "双机抬吊一构件，构件总重 320kN。判定危大等级，选出能得分的作答。",
      "model_answer": "总重≥300kN 达超危大，须专家论证（并编专项方案）。",
      "options": [
        {
          "text": "构件总重 320kN≥300kN，达超危大工程，须组织专家论证（并编专项方案）。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "抓「总重≥300kN」这条独立论证门槛。",
          "option_id": "S02-html-practice-html-q3-21f675bf5b89:option-1"
        },
        {
          "text": "每台起重机各分担 160kN，均<300kN，不需论证。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "按每台分担去规避总重门槛。",
          "loss_reason": "总重口径按构件总重 320 算，已≥300kN。",
          "fix": "总重≥300kN，须专家论证。",
          "option_id": "S02-html-practice-html-q3-21f675bf5b89:option-2"
        },
        {
          "text": "320kN 属危大，编专项方案即可，不必论证。",
          "is_correct": false,
