    {
      "answer_type": "single_choice",
      "rule_group": "承托板尺寸·数字陷阱",
      "stem": "关于幕墙防火构造承托板，下列写法数值与单位都正确、能得分的是？",
      "model_answer": "钢质承托板厚度≥1.5mm（毫米）；写成1.5m是其1000倍，幕墙构造无1.5m厚承托板。",
      "options": [
        {
          "text": "防火层承托板应采用厚度≥1.5mm 的镀锌钢板，此处 1.5mm 是毫米，不是 1.5m。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "数值+单位都点死(1.5mm毫米)，并主动排除1.5m单位陷阱。",
          "option_id": "D13-html-practice-html-q3-9fa02e489ab8:option-1"
        },
        {
          "text": "防火层承托板应采用厚度≥1.5m 的钢板承托，1.5 米厚的钢板足以承受火灾高温不变形。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "顺手把 mm 写成 m，或以为越厚越保险。",
          "loss_reason": "单位错——1.5m 是 1.5mm 的 1000 倍，幕墙上没有 1.5m 厚的承托钢板。",
          "fix": "写≥1.5mm（毫米），不是1.5m。",
          "option_id": "D13-html-practice-html-q3-9fa02e489ab8:option-2"
        },
        {
          "text": "防火层承托板应采用厚度≥15mm 的钢板承托，够厚才托得住岩棉、火中不塌。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "和防火涂料 15mm 之类的数字串了。",
          "loss_reason": "承托板是≥1.5mm，不是15mm；数字记错同样丢分。",
          "fix": "承托板厚度≥1.5mm镀锌钢板。",
          "option_id": "D13-html-practice-html-q3-9fa02e489ab8:option-3"
        },
        {
          "text": "防火层承托板只要是钢质、能托住岩棉就行，厚度不用写具体数值，注明「钢板承托」即可。",
          "is_correct": false,
          "source_error_code": "E03",
          "temptation": "知道要钢板，觉得材料对了就够。",
          "loss_reason": "漏关键数值≥1.5mm，阅卷缺数值不给该分。",
          "fix": "补厚度≥1.5mm，写「≥1.5mm镀锌钢板承托」。",
          "option_id": "D13-html-practice-html-q3-9fa02e489ab8:option-4"
        }
      ],
