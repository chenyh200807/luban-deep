!artifacts/luban_case_family_assets/diagram_microlesson/finished/P40_N03/audio/**/*.mp3
.gstack/

# Backup .env snapshots may contain rotated secrets (e.g. prod service-role keys)
.env.bak.*
.env.backup.*

# Environment-suffixed dotenvs. `*.env` only matches names ENDING in `.env`, and
# the bare `.env` rule only matches that exact name, so `.env.production` and
# friends were slipping through. These are listed explicitly rather than as
# `.env.*` so the `!.env.example` un-ignore above keeps working untouched.
.env.production
.env.prod
.env.staging
.env.development
.env.dev
.env.test

# Private key material must never be committed. The WeChat Pay merchant key in
# particular lives at `secrets/wechat-pay/apiclient_key.pem` — docker-compose.yml
# bind-mounts `./secrets/wechat-pay` into the container, so on any checkout that
# runs compose locally the merchant private key sits INSIDE the work tree.
secrets/
*.pem
*.p12
*.pfx
*.p8
*.key
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
*_rsa
credentials.json
*serviceAccount*.json
.deeptutor_eval_key

# No negations here on purpose. A `!*_cert.pem`-style re-allow would also reopen
# merchant/CA cert paths outside `secrets/`, and nothing in the tree needs it.
# If a public cert ever must be tracked, force it explicitly with `git add -f`.

# Local runtime workspace (logs, cached envs, scratch state)
.local-runs/

# Offline compiler outputs; review artifacts must never enter git.
/artifacts/
# Exception: case_family assets need version control (owner/reviewer/rollback rely on git history).
!/artifacts/
/artifacts/*
!/artifacts/luban_case_family_assets/
# 内容线补锚工单(267 条空 source_anchor 的人审起点,签发闸前置输入)需入库流转。
!/artifacts/pass_readiness_anchor_backfill_worklist.json
!/artifacts/pass_readiness_scoring_point_naming_worklist.json

# Official billing exports may contain API-key-level cost details.
data/user/official_billing/
var/official_billing/

# Claude Code agent workspace: scratch state (transcripts, worktrees, loop.md,
# settings.local.json) stays local, but the deterministic enforcement layer
# (settings.json + hooks/) ships with the repo for every Claude Code user.
# gitignore semantics: excluding the directory itself (`.claude/`) would make
# child negations no-ops, so use `.claude/*` + explicit re-includes.
.claude/*
!.claude/settings.json
!.claude/hooks/

# Browser/Playwright session dumps — transient debug scratch, never commit.
.playwright-cli/

# Raw source data: multi-GB PDFs and a nested git clone (2026_副本 carries its own .git).
# Far too large for this repo; keep out of history.
docs/原始数据/PDF/
docs/原始数据/2026_副本/

# Video-first prototype renders are regenerable (remotion) and ship via CDN, not git.
*.remotion.mp4
