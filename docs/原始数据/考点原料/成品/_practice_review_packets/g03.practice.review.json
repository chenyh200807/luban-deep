    {
      "variant_id": "G03-html-practice-html-q2-aae75cddc48d",
      "surface_id": "practice.html",
      "stem": "预制混凝土桩的吊运与打桩，对桩身混凝土强度有何要求？选出数字准确的作答。",
      "options": [
        {
          "text": "混凝土强度达设计值≥70%方可起吊、≥100%方可运输和打桩；两点吊吊点距桩端0.2L。",
          "is_correct": true,
          "source_error_code": "",
          "temptation": "",
          "loss_reason": "",
          "fix": "70%/100%两档写准，并带吊点0.2L，未达强度吊运致断桩的前提也点到。",
          "option_id": "G03-html-practice-html-q2-aae75cddc48d:option-1"
        },
        {
          "text": "混凝土强度达设计值≥100%方可起吊、达70%即可运输和打桩，先运后强度补足。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "记得有70与100，配反了。",
          "loss_reason": "70%/100%配反：起吊受力小≥70%即可，运输打桩受力大须≥100%。",
          "fix": "≥70%起吊、≥100%运输打桩，别配反。",
          "option_id": "G03-html-practice-html-q2-aae75cddc48d:option-2"
        },
        {
          "text": "预制桩只要脱模成型、外观完好就能起吊运输，强度按现场经验掌握即可。",
          "is_correct": false,
          "source_error_code": "M10",
          "temptation": "凭手感觉得结实就行。",
          "loss_reason": "用常识替代规范阈值，未达强度吊运会断桩。",
          "fix": "按规范≥70%起吊、≥100%运输打桩。",
          "option_id": "G03-html-practice-html-q2-aae75cddc48d:option-3"
        },
        {
          "text": "混凝土强度达设计值≥75%即可起吊、≥90%即可运输和打桩。",
          "is_correct": false,
          "source_error_code": "M08",
          "temptation": "记了个大概的数。",
          "loss_reason": "数值错位，规范是70%与100%。",
          "fix": "起吊≥70%、运输打桩≥100%。",
          "option_id": "G03-html-practice-html-q2-aae75cddc48d:option-4"
        }
      ],
      "model_answer": "混凝土强度达设计≥70%可起吊、≥100%可运输和打桩；两点吊吊点距桩端0.2L。",
      "rule_group": "预制桩强度·条件维",
