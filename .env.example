# ============================================
# DeepTutor Environment Template
# ============================================
# Copy this file to `.env` and fill in your values.
# Core runtime settings are grouped as:
# ports / llm / embedding / search / docker-cloud / security

# --------------------------------------------
# Ports
# --------------------------------------------
BACKEND_PORT=8001
FRONTEND_PORT=3782

# --------------------------------------------
# LLM (Required)
# --------------------------------------------
LLM_BINDING=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-xxx
LLM_HOST=https://api.deepseek.com/v1
LLM_API_VERSION=
# LLM_FAST_MODEL=  # optional light-tier model on the SAME provider endpoint (e.g. qwen3.6-flash); empty = always primary

# Optional: usage/cost attribution scope
LLM_USAGE_RUNTIME_ENVIRONMENT=production
LLM_USAGE_COST_CENTER=prod_user_chat
DEEPSEEK_BILLING_KEY_ID=
DEEPSEEK_BILLING_KEY_LABEL=
DEEPSEEK_BILLING_MASKED_KEY=

# Optional: official billing reconciliation
DEEPSEEK_BILLING_API_KEY=
DEEPSEEK_BILLING_BASE_URL=https://api.deepseek.com
DEEPSEEK_BILLING_USAGE_EXPORT_DIR=
DEEPSEEK_BILLING_EXPORT_MAX_BYTES=10485760

# --------------------------------------------
# Embedding (Required for knowledge base features)
# --------------------------------------------
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_HOST=https://api.openai.com/v1
EMBEDDING_DIMENSION=3072
EMBEDDING_API_VERSION=

# --------------------------------------------
# Supabase RAG feature flags (default off)
# --------------------------------------------
SUPABASE_RAG_ENABLED=false
SUPABASE_RAG_COMPILED_TRUTH_ENABLED=false
SUPABASE_RAG_PROVENANCE_BOOST_ENABLED=false

# --------------------------------------------
# Web Search (Optional)
# --------------------------------------------
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_BASE_URL=

# --------------------------------------------
# Docker / Cloud deployment (Optional)
# --------------------------------------------
# Public backend URL used by the frontend when deployed remotely.
NEXT_PUBLIC_API_BASE_EXTERNAL=
# Alternative direct API base URL.
NEXT_PUBLIC_API_BASE=
# --------------------------------------------
# Invite-test application storage (Optional)
# --------------------------------------------
# Database URL for public.invite_test_applications.
INVITE_TEST_DATABASE_URL=
# Optional CA cert for DB providers whose pooler presents a private chain.
INVITE_TEST_DATABASE_CA_CERT=

# --------------------------------------------
# Security / Networking (Optional)
# --------------------------------------------
# Keep this false in production.
DISABLE_SSL_VERIFY=false

# --------------------------------------------
# Learner State: Attempt Ref Signing (Required in production)
# --------------------------------------------
# Required in production. Used by deeptutor/services/learner_state/attempt_refs.py
# to sign opaque attempt_ref tokens. Module import fails if missing in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEEPTUTOR_ATTEMPT_REF_SECRET=

# --------------------------------------------
# Learning Report v2 feature gates (default off)
# --------------------------------------------
# Enable only after Supabase RLS and staging smoke gates pass.
# 复习模块(双轮 §6 回炉屏)灰度: review-due 投影 / station_completed 信号 /
# mistake_book review_due_at 读侧派生。默认关(fail-closed 空投影)。
LUBAN_REVIEW_MODULE_ENABLED=false
# 变体判断题消费接线灰度(错后当场确认 + D+3/D+7 抽查); 供给经绿灯签发闸;
# 默认关 = confirm 入口不亮 / review 退 compiled MCQ 不空窗。
LUBAN_VARIANT_PROBE_ENABLED=false
# 讲懂卡托管基址(未设=卡入口降级隐藏); 生产示例 https://test2.yousenjiaoyu.com/luban-preview
LUBAN_LESSON_CARD_BASE=
# 交接时刻「明天见」次日复测订阅消息模板 ID(双轮 §9-D12); owner 小程序后台申请后填;
# 未设=""=链路建成前合法态(服务端 degraded_red_dot 降级, 不阻断闭环); 客户端同值填
# yousenwebview/packageDeeptutor/utils/subscribe-message.js TEMPLATE_IDS.nextDayRetest
WECHAT_SUBSCRIBE_TMPL_NEXT_DAY_RETEST=
DEEPTUTOR_MISTAKE_BOOK_ENABLED=false
DEEPTUTOR_MISTAKE_BOOK_WRITE_ENABLED=false
DEEPTUTOR_HOME_PERSONALIZATION_ENABLED=false
# home 生命周期融合面总开关(融合计划 §3):off=旧静态分+无 next_step;
# on=「下一步」仲裁(到期复>活跃练>下一学>fallback) + mastery 证据 blend 一起生效
DEEPTUTOR_HOME_NEXT_STEP_ENABLED=false

# --------------------------------------------
# Runtime / release identity (Optional)
# --------------------------------------------
DEEPTUTOR_ENV=local
DEEPTUTOR_SERVICE_VERSION=
DEEPTUTOR_GIT_SHA=
DEEPTUTOR_RELEASE_ID=
DEEPTUTOR_METRICS_TOKEN=

# --------------------------------------------
# Turn / context runtime feature gates
# --------------------------------------------
DEEPTUTOR_CONTEXT_ORCHESTRATION_ENABLED=true
DEEPTUTOR_CANCEL_GRACE_S=2
QUESTION_LIFECYCLE_DECISION_AUTHORITY=true

# --------------------------------------------
# Answer citations feature gate (default off)
# --------------------------------------------
DEEPTUTOR_ANSWER_CITATIONS_ENABLED=false

# --------------------------------------------
# Billing / wallet / payment gates (default off)
# --------------------------------------------
DEEPTUTOR_BILLING_ENFORCEMENT_ENABLED=false
DEEPTUTOR_BILLING_USAGE_5H_LIMIT_POINTS=
DEEPTUTOR_BILLING_USAGE_WEEKLY_LIMIT_POINTS=
DEEPTUTOR_BILLING_INCLUDE_LEGACY_LEDGER=false
DEEPTUTOR_BILLING_SHADOW_COMPARE_LEGACY_WALLET=false
DEEPTUTOR_ALLOW_LOCAL_WALLET_FALLBACK=false
DEEPTUTOR_PAYMENT_GATEWAY_URL=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com

# --------------------------------------------
# RAG rollout safety flags (must stay false for launch unless a signed baseline approves them)
# --------------------------------------------
SUPABASE_RAG_COMPILED_TRUTH_ENABLED=false
SUPABASE_RAG_PROVENANCE_BOOST_ENABLED=false

# --------------------------------------------
# Observability smoke tokens (Optional)
# --------------------------------------------
# Comma-separated public HTTPS API bases allowed to produce release truth.
# Generic QA/WeChat/local URLs are intentionally not inherited.
DEEPTUTOR_OBSERVABILITY_GOVERNED_API_BASE_URLS=
DEEPTUTOR_UNIFIED_WS_SMOKE_TOKEN=
DEEPTUTOR_WS_SMOKE_TOKEN=
