/* pages/report/report.wxss — 学习报告页样式 */

.report-page {
  height: 100vh;
  background: var(--bg-primary);
  overflow: hidden;
}

/* ── 导航栏 ──────────────────────────────────────── */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: rgba(10, 10, 10, 0.9);
  border-bottom: 1rpx solid var(--border);
}

.nav-content {
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 0;
  gap: 16rpx;
}

/* 返回按钮 */
.nav-back {
  display: flex; align-items: center; gap: 4rpx;
  margin-left: 20rpx; padding: 8rpx 12rpx 8rpx 4rpx;
  border-radius: 8rpx;
}
.nav-back:active { background: rgba(255,255,255,0.08); }
.nav-back-arrow {
  font-size: 40rpx; color: #818cf8; font-weight: 300;
  line-height: 1; margin-top: -4rpx;
}
.nav-back-txt { font-size: 28rpx; color: #818cf8; font-weight: 500; }

.nav-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.nav-badge {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.08);
}

.nav-badge.badge-good {
  background: rgba(52, 211, 153, 0.15);
}

.nav-badge-txt {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.badge-good .nav-badge-txt {
  color: #34d399;
}

/* ── 页面滚动区 ──────────────────────────────────── */
.page-scroll {
  position: fixed;
  left: 0;
  right: 0;
  overflow-y: auto;
}

.page-inner {
  padding: 24rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.overview-hero {
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  background:
    radial-gradient(circle at top right, rgba(56, 189, 248, 0.16), transparent 34%),
    linear-gradient(145deg, rgba(99, 102, 241, 0.18), rgba(15, 23, 42, 0.12));
}

.overview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.overview-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.overview-kicker {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #7dd3fc;
}

.overview-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.overview-score-wrap {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.overview-score {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
  color: #7dd3fc;
}

.overview-score-unit {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(125, 211, 252, 0.8);
}

.overview-tip {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.focus-summary {
  padding: 18rpx;
  border-radius: 14rpx;
  background: rgba(15, 23, 42, 0.28);
  border: 1rpx solid rgba(148, 163, 184, 0.12);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.focus-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #93c5fd;
}

.focus-text {
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 800;
  color: var(--text-primary);
}

.overview-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.metric-chip {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  padding: 20rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.metric-chip-warn {
  background: rgba(248, 113, 113, 0.08);
  border-color: rgba(248, 113, 113, 0.12);
}

.metric-chip-progress {
  border-color: rgba(56, 189, 248, 0.18);
}

.metric-chip-hover {
  opacity: 0.82;
}

.metric-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.metric-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.insight-strip {
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  border-left: 6rpx solid #60a5fa;
}

.insight-kicker {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #60a5fa;
  text-transform: uppercase;
}

.insight-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-primary);
}

.primary-training-cta {
  margin-top: 2rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: rgba(6, 78, 59, 0.18);
  border: 1rpx solid rgba(52, 211, 153, 0.22);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.primary-training-title,
.primary-training-sub {
  display: block;
}

.primary-training-title {
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 800;
  color: var(--text-primary);
}

.primary-training-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: var(--text-muted);
}

.primary-training-btn {
  flex-shrink: 0;
  padding: 9rpx 14rpx;
  border-radius: 10rpx;
  background: rgba(52, 211, 153, 0.14);
  color: #6ee7b7;
  font-size: 21rpx;
  font-weight: 800;
}

.degraded-hint {
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(251, 191, 36, 0.1);
  border: 1rpx solid rgba(251, 191, 36, 0.18);
}

.degraded-hint-text {
  font-size: 22rpx;
  line-height: 1.45;
  color: #fbbf24;
}

/* ── 学情主页：少量结论 + 可点击细节 ───────────── */
.report-home-shell {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.home-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 4rpx;
}

.home-section-kicker,
.home-section-title {
  display: block;
}

.home-section-kicker {
  margin-bottom: 6rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #7dd3fc;
}

.home-section-title {
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 800;
  color: var(--text-primary);
}

.home-section-note {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--text-muted);
}

.report-module-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.report-module-card {
  min-height: 214rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  background: rgba(15, 23, 42, 0.56);
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  overflow: hidden;
}

.report-module-card-pressed {
  opacity: 0.86;
  transform: scale(0.99);
}

.module-evidence {
  background:
    linear-gradient(145deg, rgba(8, 145, 178, 0.22), rgba(15, 23, 42, 0.72));
}

.module-map {
  background:
    linear-gradient(145deg, rgba(79, 70, 229, 0.2), rgba(15, 23, 42, 0.72));
}

.module-training {
  background:
    linear-gradient(145deg, rgba(5, 150, 105, 0.2), rgba(15, 23, 42, 0.72));
}

.module-progress {
  background:
    linear-gradient(145deg, rgba(217, 119, 6, 0.2), rgba(15, 23, 42, 0.72));
}

.module-card-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.module-card-kicker,
.module-card-title,
.module-card-desc {
  display: block;
}

.module-card-kicker {
  margin-bottom: 5rpx;
  font-size: 19rpx;
  line-height: 1.3;
  font-weight: 700;
  color: rgba(226, 232, 240, 0.66);
}

.module-card-title {
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 850;
  color: #fff;
}

.module-card-arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.42);
}

.module-card-desc {
  min-height: 54rpx;
  font-size: 21rpx;
  line-height: 1.35;
  color: rgba(226, 232, 240, 0.72);
}

.module-mini-stats,
.module-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.module-mini-stats text,
.module-chip-row text {
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  font-size: 19rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.76);
}

.mini-evidence-flow {
  height: 22rpx;
  display: flex;
  align-items: center;
}

.mini-evidence-node {
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: rgba(103, 232, 249, 0.54);
}

.mini-evidence-node.active {
  background: #34d399;
  box-shadow: 0 0 0 8rpx rgba(52, 211, 153, 0.08);
}

.mini-evidence-line {
  flex: 1;
  height: 2rpx;
  background: rgba(125, 211, 252, 0.24);
}

.mini-radar {
  position: relative;
  width: 112rpx;
  height: 86rpx;
  margin-top: -4rpx;
}

.mini-radar-ring,
.mini-radar-dot {
  position: absolute;
  border-radius: 50%;
}

.mini-radar-ring {
  left: 18rpx;
  top: 2rpx;
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid rgba(129, 140, 248, 0.28);
}

.mini-radar-ring.ring-two {
  left: 34rpx;
  top: 18rpx;
  width: 40rpx;
  height: 40rpx;
}

.mini-radar-dot {
  width: 9rpx;
  height: 9rpx;
  background: #7dd3fc;
}

.mini-radar-dot.dot-one { left: 52rpx; top: 7rpx; }
.mini-radar-dot.dot-two { left: 83rpx; top: 42rpx; background: #a78bfa; }
.mini-radar-dot.dot-three { left: 24rpx; top: 58rpx; background: #34d399; }

.mini-bars {
  height: 46rpx;
  display: flex;
  align-items: flex-end;
  gap: 9rpx;
}

.mini-bar {
  width: 22rpx;
  border-radius: 8rpx 8rpx 3rpx 3rpx;
  background: rgba(251, 191, 36, 0.68);
}

.mini-bar.today { height: 27rpx; }
.mini-bar.recent { height: 42rpx; background: rgba(125, 211, 252, 0.78); }
.mini-bar.streak { height: 34rpx; background: rgba(52, 211, 153, 0.72); }

/* ── 二级详情页头图与图表 ───────────────────── */
.report-detail-hero {
  padding: 26rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border-color: rgba(148, 163, 184, 0.16);
}

.detail-evidence {
  background:
    linear-gradient(145deg, rgba(8, 145, 178, 0.24), rgba(15, 23, 42, 0.72));
}

.detail-map {
  background:
    linear-gradient(145deg, rgba(79, 70, 229, 0.24), rgba(15, 23, 42, 0.72));
}

.detail-training {
  background:
    linear-gradient(145deg, rgba(5, 150, 105, 0.24), rgba(15, 23, 42, 0.72));
}

.detail-progress {
  background:
    linear-gradient(145deg, rgba(217, 119, 6, 0.22), rgba(15, 23, 42, 0.72));
}

.detail-hero-kicker,
.detail-hero-title,
.detail-hero-sub {
  display: block;
}

.detail-hero-kicker {
  font-size: 22rpx;
  font-weight: 800;
  color: #7dd3fc;
}

.detail-hero-title {
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 850;
  color: var(--text-primary);
}

.detail-hero-sub {
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--text-secondary);
}

.detail-metric-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.detail-metric-row > view {
  padding: 15rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.detail-metric-num,
.detail-metric-label {
  display: block;
}

.detail-metric-num {
  font-size: 32rpx;
  line-height: 1.1;
  font-weight: 850;
  color: #7dd3fc;
}

.detail-metric-label {
  margin-top: 5rpx;
  font-size: 19rpx;
  color: rgba(226, 232, 240, 0.66);
}

.report-map-summary {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.map-summary-label,
.map-summary-num {
  display: block;
}

.map-summary-label {
  font-size: 20rpx;
  color: rgba(226, 232, 240, 0.62);
}

.map-summary-num {
  margin-top: 2rpx;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 850;
  color: #7dd3fc;
}

.map-summary-bars {
  height: 18rpx;
  display: flex;
  gap: 6rpx;
}

.map-summary-bar {
  height: 18rpx;
  border-radius: 99rpx;
}

.map-summary-bar.strong { width: 120rpx; background: #34d399; }
.map-summary-bar.normal { width: 90rpx; background: #7dd3fc; }
.map-summary-bar.weak { width: 54rpx; background: #fb7185; }

.training-route {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.training-route-line {
  flex: 1;
  height: 2rpx;
  background: rgba(110, 231, 183, 0.24);
}

.training-route-step {
  min-width: 92rpx;
  height: 46rpx;
  padding: 0 12rpx;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.training-route-step.active {
  background: rgba(52, 211, 153, 0.16);
  border-color: rgba(52, 211, 153, 0.28);
}

.training-route-step text {
  font-size: 21rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.78);
}

.detail-training-list {
  padding: 22rpx;
}

.progress-panel {
  padding: 24rpx;
}

.progress-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.progress-item {
  padding: 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.progress-item-label,
.progress-item-value,
.progress-item-detail {
  display: block;
}

.progress-item-label {
  font-size: 20rpx;
  color: rgba(226, 232, 240, 0.62);
}

.progress-item-value {
  font-size: 30rpx;
  line-height: 1.1;
  font-weight: 850;
  color: #7dd3fc;
}

.progress-item-value.tone-good { color: #34d399; }
.progress-item-value.tone-warn { color: #fb7185; }
.progress-item-value.tone-accent { color: #7dd3fc; }

.progress-item-detail {
  font-size: 20rpx;
  line-height: 1.35;
  color: rgba(226, 232, 240, 0.62);
}

.progress-chart-card {
  padding: 16rpx 12rpx 8rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.07);
}

.progress-chart-bars {
  height: 132rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  gap: 18rpx;
}

.progress-chart-bar {
  width: 82rpx;
  border-radius: 14rpx 14rpx 6rpx 6rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 10rpx;
  background: rgba(251, 191, 36, 0.7);
}

.progress-chart-bar.today { height: 74rpx; }
.progress-chart-bar.recent { height: 116rpx; background: rgba(125, 211, 252, 0.78); }
.progress-chart-bar.streak { height: 94rpx; background: rgba(52, 211, 153, 0.72); }

.progress-chart-bar text {
  font-size: 18rpx;
  font-weight: 800;
  color: rgba(15, 23, 42, 0.82);
}

/* ── Learning Engine Evidence Fusion ───────────── */
.learning-engine-panel {
  position: relative;
  overflow: hidden;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  border-color: rgba(56, 189, 248, 0.22);
  background:
    linear-gradient(135deg, rgba(14, 116, 144, 0.22), rgba(15, 23, 42, 0.78)),
    radial-gradient(circle at 92% 0%, rgba(52, 211, 153, 0.18), transparent 34%);
}

.engine-panel-rail {
  position: absolute;
  left: 20rpx;
  top: 22rpx;
  bottom: 22rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #67e8f9, rgba(103, 232, 249, 0.08));
}

.engine-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding-left: 18rpx;
}

.engine-kicker {
  display: block;
  margin-bottom: 5rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #67e8f9;
}

.engine-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 900;
  color: var(--text-primary);
}

.engine-summary {
  flex-shrink: 0;
  max-width: 236rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(8, 145, 178, 0.16);
  border: 1rpx solid rgba(103, 232, 249, 0.2);
  font-size: 19rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #a5f3fc;
  text-align: right;
}

.engine-subtitle {
  display: block;
  padding-left: 18rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--text-muted);
}

.engine-source-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  padding-left: 18rpx;
}

.engine-source-card {
  min-height: 108rpx;
  padding: 14rpx;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 5rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.075);
}

.engine-source-card.source-active {
  border-color: rgba(103, 232, 249, 0.18);
  background: rgba(8, 145, 178, 0.1);
}

.engine-source-label {
  font-size: 20rpx;
  line-height: 1.25;
  color: #cbd5e1;
}

.engine-source-value {
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 900;
  color: var(--text-primary);
}

.engine-source-status {
  font-size: 18rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #94a3b8;
}

.source-active .engine-source-status {
  color: #67e8f9;
}

/* ── Learning State Inference ───────────────────── */
.learning-state-section {
  position: relative;
  overflow: hidden;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  box-shadow: 0 18rpx 48rpx rgba(2, 8, 23, 0.24);
}

.learning-state-section-rail {
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: rgba(96, 165, 250, 0.7);
}

.prescription-section {
  background:
    linear-gradient(135deg, rgba(6, 95, 70, 0.32), rgba(12, 28, 38, 0.78)),
    radial-gradient(circle at 88% 8%, rgba(52, 211, 153, 0.16), transparent 36%);
  border-color: rgba(52, 211, 153, 0.24);
}

.prescription-rail {
  background: #34d399;
}

.three-layer-state {
  background:
    linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(30, 41, 59, 0.76)),
    radial-gradient(circle at 8% 0%, rgba(125, 211, 252, 0.12), transparent 34%);
  border-color: rgba(125, 211, 252, 0.18);
}

.scoring-point-map-section {
  background:
    linear-gradient(135deg, rgba(30, 27, 75, 0.36), rgba(15, 23, 42, 0.82)),
    radial-gradient(circle at 90% 4%, rgba(129, 140, 248, 0.12), transparent 36%);
  border-color: rgba(129, 140, 248, 0.2);
}

.mistake-history-section {
  background:
    linear-gradient(135deg, rgba(69, 26, 3, 0.28), rgba(15, 23, 42, 0.82)),
    radial-gradient(circle at 90% 0%, rgba(251, 146, 60, 0.13), transparent 36%);
  border-color: rgba(251, 146, 60, 0.2);
}

.mistake-rail {
  background: #fb923c;
}

.scoring-rail {
  background: #818cf8;
}

.learning-state-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.learning-state-section-title {
  display: block;
  font-size: 25rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.learning-state-section-tag {
  flex-shrink: 0;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.065);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  font-size: 18rpx;
  font-weight: 700;
  color: #c7d2fe;
}

.learning-state-section-subtitle {
  display: block;
  font-size: 31rpx;
  line-height: 1.32;
  font-weight: 900;
  color: var(--text-primary);
}

.prescription-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.prescription-meta-chip {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(52, 211, 153, 0.12);
  border: 1rpx solid rgba(52, 211, 153, 0.18);
  font-size: 19rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #a7f3d0;
}

.learning-state-section-desc {
  display: block;
  margin-top: -4rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--text-muted);
}

.learning-state-steps {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.learning-state-step {
  min-height: 44rpx;
  padding: 9rpx 13rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.learning-state-step-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #bfdbfe;
}

.learning-state-cta {
  min-height: 58rpx;
  justify-content: center;
  border-color: rgba(52, 211, 153, 0.3);
  background: rgba(6, 95, 70, 0.24);
}

.learning-state-cta-label {
  font-size: 23rpx;
  font-weight: 800;
  color: #6ee7b7;
}

.learning-state-layer {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.learning-state-layer-label {
  font-size: 21rpx;
  font-weight: 800;
  color: #7dd3fc;
}

.learning-state-row {
  padding: 18rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.learning-state-row-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.learning-state-row-title {
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 850;
  color: var(--text-primary);
}

.learning-state-row-meta {
  font-size: 20rpx;
  line-height: 1.35;
  color: var(--text-muted);
}

.learning-state-row-action {
  margin-top: 3rpx;
  font-size: 21rpx;
  line-height: 1.38;
  color: #bae6fd;
}

.learning-state-row-status {
  flex-shrink: 0;
  max-width: 132rpx;
  padding: 7rpx 10rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
  color: #cbd5e1;
  background: rgba(148, 163, 184, 0.12);
}

.learning-state-row.state-warn {
  border-color: rgba(251, 191, 36, 0.18);
  background: rgba(251, 191, 36, 0.055);
}

.learning-state-row.state-warn .learning-state-row-status {
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.12);
}

.learning-state-row.state-good {
  border-color: rgba(52, 211, 153, 0.18);
  background: rgba(52, 211, 153, 0.055);
}

.learning-state-row.state-good .learning-state-row-status {
  color: #6ee7b7;
  background: rgba(52, 211, 153, 0.12);
}

.scoring-point-row {
  padding: 17rpx;
  border-radius: 16rpx;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 8rpx 12rpx;
  align-items: start;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.scoring-point-badge {
  padding: 5rpx 9rpx;
  border-radius: 9rpx;
  background: rgba(96, 165, 250, 0.1);
  color: #93c5fd;
  font-size: 18rpx;
  font-weight: 800;
}

.scoring-point-name {
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 800;
  color: var(--text-primary);
}

.scoring-point-miss {
  grid-column: 2;
  font-size: 20rpx;
  font-weight: 800;
  color: #fca5a5;
}

.scoring-point-empty {
  padding: 18rpx;
  border-radius: 14rpx;
  background: rgba(99, 102, 241, 0.08);
  border: 1rpx dashed rgba(129, 140, 248, 0.22);
  font-size: 23rpx;
  line-height: 1.45;
  color: #cbd5e1;
}

.mistake-history-card {
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(15, 23, 42, 0.42);
  border: 1rpx solid rgba(251, 146, 60, 0.16);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.mistake-history-card:active {
  opacity: 0.84;
}

.mistake-history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mistake-history-time {
  font-size: 21rpx;
  font-weight: 800;
  color: #fdba74;
}

.mistake-history-result {
  padding: 5rpx 10rpx;
  border-radius: 9rpx;
  background: rgba(248, 113, 113, 0.14);
  font-size: 20rpx;
  font-weight: 800;
  color: #fca5a5;
}

.mistake-history-question {
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 800;
  color: var(--text-primary);
}

.mistake-history-row {
  display: grid;
  grid-template-columns: 120rpx 1fr;
  gap: 14rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(148, 163, 184, 0.12);
}

.mistake-history-label {
  font-size: 21rpx;
  font-weight: 800;
  color: #94a3b8;
}

.mistake-history-value {
  font-size: 22rpx;
  line-height: 1.5;
  color: #cbd5e1;
}

.mistake-history-value.strong {
  color: #fed7aa;
}

.mistake-history-cta {
  align-self: flex-start;
  margin-top: 2rpx;
  padding: 7rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(251, 146, 60, 0.12);
  border: 1rpx solid rgba(251, 146, 60, 0.18);
  font-size: 21rpx;
  font-weight: 800;
  color: #fdba74;
}

/* ── Learning Brain ─────────────────────────────── */
.learning-review-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.learning-brain {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.learning-brain-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.learning-brain-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.learning-brain-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.learning-brain-stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.brain-stat {
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(96, 165, 250, 0.12);
  border: 1rpx solid rgba(96, 165, 250, 0.18);
  font-size: 20rpx;
  color: #93c5fd;
}

.learning-brain-loading {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.brain-skel {
  height: 44rpx;
  width: 100%;
}

.brain-skel.short {
  width: 68%;
}

.learning-brain-state {
  padding: 8rpx 0 4rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.learning-brain-state-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.learning-brain-state-desc {
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--text-muted);
}

.brain-retry {
  align-self: flex-start;
  margin-top: 4rpx;
  padding: 10rpx 22rpx;
  border-radius: 10rpx;
  background: rgba(99, 102, 241, 0.14);
  border: 1rpx solid rgba(129, 140, 248, 0.24);
}

.brain-retry-txt {
  font-size: 23rpx;
  font-weight: 600;
  color: #a5b4fc;
}

.learning-brain-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.brain-column {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.brain-column-title {
  font-size: 23rpx;
  font-weight: 700;
  color: #7dd3fc;
}

.brain-column-sub {
  margin-top: -4rpx;
  font-size: 21rpx;
  color: var(--text-muted);
}

.brain-review-hero {
  padding: 22rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(14, 165, 233, 0.16), rgba(15, 23, 42, 0.16));
  border: 1rpx solid rgba(125, 211, 252, 0.16);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.brain-review-kicker {
  font-size: 21rpx;
  font-weight: 700;
  color: #7dd3fc;
}

.brain-review-title {
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 800;
  color: var(--text-primary);
}

.brain-review-desc {
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--text-secondary);
}

.brain-review-metrics {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.brain-review-metric {
  min-width: 0;
  padding: 14rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(15, 23, 42, 0.26);
  border: 1rpx solid rgba(148, 163, 184, 0.12);
}

.brain-review-metric.warn {
  border-color: rgba(248, 113, 113, 0.2);
}

.brain-review-num {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #e0f2fe;
}

.brain-review-label {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}

.brain-diagnosis-row,
.brain-timeline-row {
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.065);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.attempt-card {
  padding: 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.065);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.attempt-card:active,
.brain-next-action:active {
  opacity: 0.82;
}

.attempt-card.attempt-wrong {
  border-color: rgba(248, 113, 113, 0.2);
  background: rgba(127, 29, 29, 0.12);
}

.attempt-card.attempt-correct {
  border-color: rgba(52, 211, 153, 0.2);
  background: rgba(6, 78, 59, 0.12);
}

.attempt-head,
.brain-diagnosis-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.attempt-time,
.brain-diagnosis-count {
  display: block;
  margin-bottom: 4rpx;
  font-size: 21rpx;
  color: var(--text-muted);
}

.attempt-result,
.brain-diagnosis-level {
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(125, 211, 252, 0.12);
  color: #bae6fd;
  font-size: 20rpx;
  font-weight: 700;
}

.result-wrong {
  background: rgba(248, 113, 113, 0.13);
  color: #fecaca;
}

.result-correct {
  background: rgba(52, 211, 153, 0.13);
  color: #bbf7d0;
}

.attempt-title,
.brain-diagnosis-title {
  display: block;
  font-size: 27rpx;
  line-height: 1.45;
  font-weight: 800;
  color: var(--text-primary);
}

.attempt-answer,
.brain-diagnosis-detail,
.brain-timeline-line {
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.attempt-diagnosis,
.brain-diagnosis-text,
.brain-diagnosis-action {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-muted);
}

.brain-diagnosis-action {
  color: #93c5fd;
  font-weight: 700;
}

.attempt-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding-top: 2rpx;
}

.attempt-action {
  padding: 7rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(96, 165, 250, 0.12);
  border: 1rpx solid rgba(96, 165, 250, 0.18);
  font-size: 21rpx;
  font-weight: 700;
  color: #bfdbfe;
}

.bookmark-action.cloud {
  background: rgba(148, 163, 184, 0.1);
  border-color: rgba(148, 163, 184, 0.22);
  color: var(--text-muted);
}

.bookmark-action.saved {
  opacity: 0.72;
}

.brain-timeline-title {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.timeline-wrong {
  border-left: 6rpx solid rgba(248, 113, 113, 0.7);
}

.timeline-correct {
  border-left: 6rpx solid rgba(52, 211, 153, 0.7);
}

.brain-truth-row,
.brain-edge-row,
.brain-training-row,
.brain-next-action,
.brain-chain-row {
  padding: 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.brain-truth-row {
  display: flex;
  gap: 12rpx;
}

.brain-level {
  flex-shrink: 0;
  min-width: 92rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(148, 163, 184, 0.12);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
}

.brain-level-text {
  font-size: 19rpx;
  font-weight: 700;
  color: #cbd5e1;
}

.level-L1_repeated {
  background: rgba(251, 191, 36, 0.12);
  border-color: rgba(251, 191, 36, 0.22);
}

.level-L1_repeated .brain-level-text {
  color: #fbbf24;
}

.level-L2_confirmed {
  background: rgba(52, 211, 153, 0.12);
  border-color: rgba(52, 211, 153, 0.22);
}

.level-L2_confirmed .brain-level-text {
  color: #34d399;
}

.brain-row-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.brain-row-title,
.brain-training-title {
  font-size: 25rpx;
  line-height: 1.45;
  color: var(--text-primary);
}

.brain-row-meta,
.brain-training-meta,
.brain-edge-path,
.brain-edge-event {
  font-size: 21rpx;
  line-height: 1.4;
  color: var(--text-muted);
}

.brain-event-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.brain-event {
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(15, 23, 42, 0.28);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  font-size: 19rpx;
  color: #bfdbfe;
}

.brain-edge-row,
.brain-training-row,
.brain-next-action,
.brain-chain-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.brain-next-action {
  border-color: rgba(52, 211, 153, 0.18);
  background: rgba(6, 78, 59, 0.16);
}

.brain-next-cta {
  align-self: flex-start;
  margin-top: 6rpx;
  padding: 7rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(52, 211, 153, 0.13);
  font-size: 21rpx;
  font-weight: 700;
  color: #6ee7b7;
}

.brain-chain-row {
  border-color: rgba(96, 165, 250, 0.18);
  background: rgba(37, 99, 235, 0.08);
}

.chain-improved {
  border-color: rgba(52, 211, 153, 0.24);
  background: rgba(16, 185, 129, 0.09);
}

.chain-not-improved {
  border-color: rgba(251, 191, 36, 0.24);
  background: rgba(245, 158, 11, 0.09);
}

.brain-chain-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.brain-chain-step {
  font-size: 21rpx;
  line-height: 1.4;
  color: var(--text-muted);
}

.brain-chain-outcome {
  align-self: flex-start;
  margin-top: 2rpx;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(15, 23, 42, 0.22);
  font-size: 20rpx;
  font-weight: 700;
  color: #bfdbfe;
}

.chain-improved .brain-chain-outcome {
  color: #34d399;
}

.chain-not-improved .brain-chain-outcome {
  color: #fbbf24;
}

.brain-edge-type {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.brain-training-cta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(37, 99, 235, 0.16);
  border: 1rpx solid rgba(96, 165, 250, 0.2);
}

.brain-training-cta-text {
  font-size: 21rpx;
  font-weight: 800;
  color: #bfdbfe;
}

.brain-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding-top: 2rpx;
}

.brain-footer-text {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* ── Section Headers ─────────────────────────────── */
.section-header {
  padding: 8rpx 4rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.sub-header {
  margin-top: 24rpx;
  margin-bottom: 8rpx;
}

.section-title-sm {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

/* ── 空状态 / 加载 ───────────────────────────────── */
.loading-card {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-card {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 64rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.5;
}

.empty-btn {
  margin-top: 16rpx;
  padding: 14rpx 40rpx;
  background: rgba(99, 102, 241, 0.15);
  border: 1rpx solid rgba(99, 102, 241, 0.3);
  border-radius: var(--radius-full);
}

.empty-btn:active {
  opacity: 0.7;
}

.empty-btn-txt {
  font-size: 26rpx;
  font-weight: 600;
  color: #818cf8;
}

/* ── 雷达图 Canvas ───────────────────────────────── */
.radar-canvas-wrap {
  display: flex;
  justify-content: center;
  padding: 32rpx 0 16rpx;
}

.radar-canvas {
  width: 560rpx;
  height: 560rpx;
  max-width: 100%;
}

.radar-image {
  width: 560rpx;
  height: 560rpx;
  max-width: 100%;
}

/* ── 雷达统计 ────────────────────────────────────── */
.radar-summary {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 16rpx;
}

.radar-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-bottom: 4rpx;
}

.dot-strong { background: #34d399; }
.dot-normal { background: #fbbf24; }
.dot-weak   { background: #f87171; }

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ── 维度列表 ────────────────────────────────────── */
.dim-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dim-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}

.dim-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rank-strong { background: rgba(52, 211, 153, 0.15); }
.rank-normal { background: rgba(251, 191, 36, 0.15); }
.rank-weak   { background: rgba(248, 113, 113, 0.15); }

.dim-rank-txt {
  font-size: 24rpx;
  font-weight: 700;
}

.rank-strong .dim-rank-txt { color: #34d399; }
.rank-normal .dim-rank-txt { color: #fbbf24; }
.rank-weak   .dim-rank-txt { color: #f87171; }

.dim-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}

.dim-bar {
  width: 120rpx;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 5rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.dim-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.6s ease;
}

.dim-pct {
  font-size: 26rpx;
  font-weight: 600;
  min-width: 64rpx;
  text-align: right;
}

/* ── 掌握度大数字 ────────────────────────────────── */
.mastery-hero {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.mastery-score-wrap {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.mastery-score {
  font-size: 96rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.score-good { color: #34d399; }
.score-mid  { color: #fbbf24; }
.score-low  { color: #f87171; }

.mastery-unit {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-muted);
}

.mastery-label {
  font-size: 24rpx;
  color: var(--text-muted);
}

.mastery-sub-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 16rpx;
}

.mastery-sub-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.mastery-sub-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.mastery-sub-warn {
  color: #f87171;
}

.mastery-sub-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.mastery-sub-divider {
  width: 1rpx;
  height: 40rpx;
  background: var(--border);
}

/* ── 科目掌握度分组 ──────────────────────────────── */
.mastery-group {
  padding: 24rpx;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.group-avg {
  font-size: 26rpx;
  font-weight: 700;
}

.avg-good { color: #34d399; }
.avg-mid  { color: #fbbf24; }
.avg-low  { color: #f87171; }

.group-chapters {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.chapter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ch-name {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ch-bar {
  width: 120rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 4rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.ch-bar-fill {
  height: 100%;
  border-radius: 4rpx;
}

.ch-pct {
  font-size: 22rpx;
  font-weight: 600;
  min-width: 56rpx;
  text-align: right;
}

/* ── 易错热点 ────────────────────────────────────── */
.hotspot-list {
  padding: 8rpx 0;
}

.hotspot-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border-subtle);
}

.hotspot-item:last-child {
  border-bottom: none;
}

.hotspot-topic {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}

.hotspot-rate {
  font-size: 24rpx;
  font-weight: 600;
  color: #f87171;
  flex-shrink: 0;
}


/* ── 摸底测试入口 ────────────────────────────────── */
.assess-entry {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 24rpx; margin-top: 16rpx;
}
.assess-entry:active { opacity: 0.8; }
.assess-entry-left { display: flex; align-items: center; gap: 20rpx; }
.assess-entry-icon {
  width: 72rpx; height: 72rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(139,92,246,0.2));
  border: 1rpx solid rgba(99,102,241,0.25);
  display: flex; align-items: center; justify-content: center;
}
.assess-entry-icon-txt { font-size: 26rpx; font-weight: 800; color: #60a5fa; }
.assess-entry-info { display: flex; flex-direction: column; gap: 4rpx; }
.assess-entry-title { font-size: 30rpx; font-weight: 600; color: #fff; }
.assess-entry-sub { font-size: 22rpx; color: rgba(255,255,255,0.4); }
.assess-entry-arrow { font-size: 32rpx; color: rgba(255,255,255,0.3); }

/* ── 摸底报告入口卡片 ────────────────────────────── */
.report-entry {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 24rpx; margin-top: 48rpx;
}
.report-entry:active { opacity: 0.8; }
.report-entry-left { display: flex; align-items: center; gap: 20rpx; }
.report-entry-icon {
  width: 72rpx; height: 72rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(139,92,246,0.2));
  border: 1rpx solid rgba(99,102,241,0.25);
  display: flex; align-items: center; justify-content: center;
}
.report-entry-icon-txt { font-size: 26rpx; font-weight: 800; color: #60a5fa; }
.report-entry-info { display: flex; flex-direction: column; gap: 4rpx; }
.report-entry-title { font-size: 30rpx; font-weight: 600; color: #fff; }
.report-entry-sub { font-size: 22rpx; color: rgba(255,255,255,0.4); }
.report-entry-arrow { font-size: 32rpx; color: rgba(255,255,255,0.3); }

/* ═══════════════════════════════════════════════
   ★ 亮色模式
   ═══════════════════════════════════════════════ */

/* ── CSS 变量覆盖 ──────────────────────────── */
.report-page.light {
  --primary-400: #5e8cff;
  --primary-500: #2f6bff;
  --primary-600: #2557d8;
  --bg-primary: linear-gradient(180deg, #f7faff 0%, #eef4ff 52%, #f8fbff 100%);
  --bg-secondary: #ffffff;
  --bg-tertiary: #eef4ff;
  --bg-card: rgba(255, 255, 255, 0.92);
  --bg-elevated: rgba(255, 255, 255, 0.98);
  --text-primary: #111827;
  --text-secondary: #334155;
  --text-tertiary: #516174;
  --text-muted: #7b8799;
  --border-subtle: rgba(219, 230, 245, 0.65);
  --border-light: #dbe6f5;
  --border-medium: #d1def4;
  --border: #dbe6f5;
  --shadow-sm: 0 6rpx 18rpx rgba(126, 147, 185, 0.08);
  --shadow-md: 0 14rpx 34rpx rgba(126, 147, 185, 0.12);
}

/* ── 导航栏 ────────────────────────────────── */
.report-page.light .nav-bar {
  background: rgba(248, 250, 255, 0.96);
  border-color: #dbe6f5;
  box-shadow: 0 10rpx 28rpx rgba(126, 147, 185, 0.10);
}

.report-page.light .overview-hero {
  background:
    radial-gradient(circle at top right, rgba(56, 189, 248, 0.16), transparent 34%),
    linear-gradient(145deg, rgba(47, 107, 255, 0.12), rgba(255, 255, 255, 0.86));
}

.report-page.light .metric-chip {
  background: rgba(255, 255, 255, 0.82);
  border-color: rgba(209, 222, 244, 0.85);
}

.report-page.light .metric-chip-warn {
  background: rgba(248, 113, 113, 0.08);
  border-color: rgba(248, 113, 113, 0.14);
}
.report-page.light .brain-stat {
  background: rgba(47, 107, 255, 0.08);
  border-color: rgba(47, 107, 255, 0.16);
  color: #2557d8;
}
.report-page.light .brain-column-title { color: #2563eb; }
.report-page.light .brain-truth-row,
.report-page.light .brain-edge-row,
.report-page.light .brain-training-row,
.report-page.light .brain-chain-row {
  background: rgba(255, 255, 255, 0.76);
  border-color: rgba(209, 222, 244, 0.82);
}
.report-page.light .brain-event {
  background: #eef4ff;
  border-color: #dbe6f5;
  color: #2557d8;
}
.report-page.light .brain-retry {
  background: #eef4ff;
  border-color: #c6d8ff;
}
.report-page.light .brain-retry-txt { color: #2f6bff; }
.report-page.light .nav-back:active { background: rgba(0,0,0,0.04); }
.report-page.light .nav-back-arrow { color: #4f46e5; }
.report-page.light .nav-back-txt { color: #4f46e5; }

/* ── 进度条背景 ────────────────────────────── */
.report-page.light .dim-bar { background: #edf2fb; }
.report-page.light .ch-bar { background: #edf2fb; }
.report-page.light .empty-btn {
  background: #eef4ff;
  border-color: #c6d8ff;
}
.report-page.light .empty-btn-txt { color: #2f6bff; }

/* ── 入口卡片文字 ──────────────────────────── */
.report-page.light .report-entry-title { color: #0f172a; }
.report-page.light .report-entry-sub { color: #7b8799; }
.report-page.light .report-entry-arrow { color: #64748b; }
.report-page.light .assess-entry-title { color: #0f172a; }
.report-page.light .assess-entry-sub { color: #7b8799; }
.report-page.light .assess-entry-arrow { color: #64748b; }
.report-page.light .report-entry-icon,
.report-page.light .assess-entry-icon {
  background: linear-gradient(135deg, #eef4ff, #f8fbff);
  border-color: #cfe0ff;
}
.report-page.light .report-entry-icon-txt,
.report-page.light .assess-entry-icon-txt { color: #2f6bff; }

.report-page.light .report-module-card,
.report-page.light .report-detail-hero {
  border-color: rgba(209, 222, 244, 0.82);
  box-shadow: 0 16rpx 38rpx rgba(47, 107, 255, 0.08);
}

.report-page.light .module-evidence,
.report-page.light .detail-evidence {
  background: linear-gradient(145deg, rgba(14, 165, 233, 0.12), rgba(255, 255, 255, 0.94));
}

.report-page.light .module-map,
.report-page.light .detail-map {
  background: linear-gradient(145deg, rgba(79, 70, 229, 0.12), rgba(255, 255, 255, 0.94));
}

.report-page.light .module-training,
.report-page.light .detail-training {
  background: linear-gradient(145deg, rgba(16, 185, 129, 0.12), rgba(255, 255, 255, 0.94));
}

.report-page.light .module-progress,
.report-page.light .detail-progress {
  background: linear-gradient(145deg, rgba(245, 158, 11, 0.12), rgba(255, 255, 255, 0.94));
}

.report-page.light .home-section-title,
.report-page.light .module-card-title,
.report-page.light .detail-hero-title {
  color: #0f172a;
}

.report-page.light .home-section-note,
.report-page.light .module-card-desc,
.report-page.light .detail-hero-sub,
.report-page.light .progress-item-detail {
  color: #64748b;
}

.report-page.light .module-card-kicker,
.report-page.light .detail-metric-label,
.report-page.light .map-summary-label,
.report-page.light .progress-item-label {
  color: #7b8799;
}

.report-page.light .module-mini-stats text,
.report-page.light .module-chip-row text,
.report-page.light .detail-metric-row > view,
.report-page.light .training-route-step,
.report-page.light .progress-chart-card,
.report-page.light .progress-item {
  background: rgba(241, 245, 249, 0.72);
  border-color: rgba(209, 222, 244, 0.8);
  color: #475569;
}

.report-page.light .module-card-arrow {
  color: #94a3b8;
}

.report-page.light .training-route-step text {
  color: #475569;
}

.report-page.light .progress-chart-bar text {
  color: #0f172a;
}
