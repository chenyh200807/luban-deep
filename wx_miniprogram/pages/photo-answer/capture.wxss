.page { padding: 32rpx; min-height: 100vh; background: #f6f7f9; box-sizing: border-box; }
.header { margin-bottom: 24rpx; }
.title { font-size: 40rpx; font-weight: 600; color: #1a1a1a; }
.subtitle { font-size: 26rpx; color: #888; margin-top: 8rpx; }
.error { background: #fdecea; color: #c0392b; padding: 16rpx 24rpx; border-radius: 12rpx; font-size: 26rpx; margin-bottom: 16rpx; }
.grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.thumb { position: relative; width: 210rpx; height: 280rpx; border-radius: 16rpx; overflow: hidden; background: #fff; }
.thumb-img { width: 100%; height: 100%; }
.badge { position: absolute; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; color: #fff; }
.page-no { left: 8rpx; top: 8rpx; background: rgba(0,0,0,0.55); }
.status { right: 8rpx; top: 8rpx; }
.status.uploading { background: #3498db; }
.status.failed { background: #e74c3c; }
.status.warn { background: #e67e22; top: 48rpx; }
.remove { position: absolute; right: 8rpx; bottom: 8rpx; width: 44rpx; height: 44rpx; line-height: 40rpx; text-align: center; background: rgba(0,0,0,0.55); color: #fff; border-radius: 50%; font-size: 32rpx; }
.thumb.add { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #bbb; background: #fff; }
.add-icon { font-size: 56rpx; color: #999; }
.add-text { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.tips { margin: 32rpx 0; font-size: 24rpx; color: #999; line-height: 1.9; }
.submit-btn { background: #2f6df6; color: #fff; border-radius: 16rpx; font-size: 32rpx; }
.submit-btn[disabled] { background: #b9cdf8; color: #fff; }
