.attempt-detail-page {
  height: 100vh;
  overflow: hidden;
  background: #050910;
  color: #f8fafc;
}

.detail-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: rgba(5, 9, 16, 0.94);
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.14);
}

.detail-nav-inner {
  height: 96rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 24rpx;
}

.detail-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-width: 128rpx;
  padding: 10rpx 10rpx 10rpx 0;
}

.detail-back-arrow {
  font-size: 44rpx;
  line-height: 1;
  color: #93c5fd;
}

.detail-back-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #93c5fd;
}

.detail-nav-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #f8fafc;
}

.detail-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
}

.detail-inner {
  padding: 26rpx 30rpx 48rpx;
}

.detail-hero {
  padding: 24rpx 0 18rpx;
}

.detail-result {
  display: inline-flex;
  margin-bottom: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.result-bad,
.result-danger {
  color: #fecaca;
  background: rgba(248, 113, 113, 0.16);
}

.result-good {
  color: #bbf7d0;
  background: rgba(34, 197, 94, 0.16);
}

.detail-title {
  display: block;
  font-size: 42rpx;
  line-height: 1.22;
  font-weight: 900;
  color: #f8fafc;
}

.detail-subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.detail-summary {
  margin: 16rpx 0 28rpx;
  border-top: 1rpx solid rgba(148, 163, 184, 0.16);
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.16);
}

.summary-row {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.1);
}

.summary-row:last-child {
  border-bottom: 0;
}

.summary-label {
  width: 96rpx;
  flex: none;
  font-size: 22rpx;
  color: #64748b;
}

.summary-value {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.45;
  color: #e2e8f0;
}

.detail-error,
.detail-loading {
  margin-bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #cbd5e1;
}

.section-kicker {
  display: block;
  margin: 8rpx 0 18rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #7dd3fc;
}

.explanation-section {
  margin: 26rpx 0 32rpx;
}

.explanation-card {
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(125, 211, 252, 0.18);
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(15, 23, 42, 0.96), rgba(8, 47, 73, 0.52));
}

.explanation-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 23rpx;
  font-weight: 900;
  color: #7dd3fc;
}

.explanation-content {
  display: block;
  white-space: pre-wrap;
  font-size: 28rpx;
  line-height: 1.68;
  color: #f1f5f9;
}

.turn {
  margin-bottom: 22rpx;
}

.turn-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #94a3b8;
}

.turn-content {
  display: block;
  white-space: pre-wrap;
  font-size: 29rpx;
  line-height: 1.72;
  color: #e5e7eb;
}

.turn-student .turn-content {
  padding-left: 24rpx;
  border-left: 4rpx solid #60a5fa;
  color: #f8fafc;
}

.turn-system .turn-content {
  color: #cbd5e1;
}

.detail-next {
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(148, 163, 184, 0.14);
}

.next-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  color: #e2e8f0;
}
