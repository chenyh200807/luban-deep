/* 首跑剧本 — 学情页蓝黑青体系（owner 指定版 artifact 2a91a06d） */
.fr-page {
  min-height: 100vh;
  background:
    radial-gradient(1600rpx 860rpx at 50% -240rpx, rgba(34, 211, 238, 0.13), transparent 65%),
    radial-gradient(1200rpx 780rpx at 100% 115%, rgba(251, 146, 60, 0.06), transparent 60%),
    #0a0f1a;
  color: #ffffff;
  padding: 0 36rpx 52rpx;
  box-sizing: border-box;
}

/* 入场动画（纯 transform/opacity） */
@keyframes frUp {
  from {
    opacity: 0;
    transform: translateY(22rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
.fr-act {
  animation: frUp 0.42s cubic-bezier(0.2, 0.7, 0.3, 1) both;
}
.fr-opt.anim {
  animation: frUp 0.45s cubic-bezier(0.2, 0.7, 0.3, 1) both;
}

/* 顶栏 */
.fr-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 4rpx 20rpx;
  gap: 16rpx;
}
.fr-brand {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.fr-logo {
  width: 40rpx;
  height: 40rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #22d3ee, #0e7490);
  color: #04222e;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fr-prog {
  display: flex;
  gap: 8rpx;
}
.fr-dot {
  width: 26rpx;
  height: 8rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
}
.fr-dot.on {
  background: #22d3ee;
}
.fr-skip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.48);
  font-weight: 600;
  padding: 12rpx 0 12rpx 24rpx;
}

.fr-act {
  padding-top: 16rpx;
}

/* 标题/引导 */
.fr-chip {
  display: inline-block;
  font-size: 23rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #67e8f9;
  background: rgba(34, 211, 238, 0.08);
  border: 1rpx solid rgba(34, 211, 238, 0.25);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin: 16rpx 0;
}
.fr-chip.warm {
  color: #fb923c;
  background: rgba(251, 146, 60, 0.1);
  border-color: rgba(251, 146, 60, 0.38);
}
.fr-title {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.38;
  margin: 16rpx 0;
  white-space: pre-line;
}
.fr-title.small {
  font-size: 38rpx;
}
.fr-title.center {
  text-align: center;
}
.fr-title .hi {
  color: #67e8f9;
}
.fr-lead {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.7;
  margin: 0 0 36rpx;
}
.fr-eyebrow {
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  margin: 40rpx 0 12rpx;
}
.fr-eyebrow.cyan {
  color: #22d3ee;
}
.fr-eyebrow.orange {
  color: #fb923c;
}
.fr-note {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.48);
  margin-top: 18rpx;
  line-height: 1.6;
  text-align: center;
}
.fr-note.left {
  text-align: left;
  margin: 8rpx 0 12rpx;
}
.fr-inter-note {
  font-size: 24rpx;
  color: #fb923c;
  font-weight: 600;
  margin: 0 0 32rpx;
}

/* 选项 */
.fr-opts {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.fr-opt {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 32rpx 30rpx 32rpx 26rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(103, 232, 249, 0.13);
  background: linear-gradient(165deg, #14283a, #0d1723);
  box-shadow: 0 8rpx 28rpx rgba(2, 8, 20, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  font-size: 30rpx;
  line-height: 1.45;
  color: #ffffff;
}
.fr-opt:active {
  transform: scale(0.98);
  border-color: rgba(34, 211, 238, 0.55);
  background: linear-gradient(165deg, #16324a, #0e1c2c);
}
.fr-opt.itl {
  border-color: rgba(251, 146, 60, 0.22);
}
.fr-opt.itl:active {
  border-color: rgba(251, 146, 60, 0.55);
}
.fr-opt-tx {
  flex: 1;
  min-width: 0;
  font-weight: 600;
}
.fr-arrow {
  flex: 0 0 auto;
  font-size: 38rpx;
  line-height: 1;
  color: rgba(103, 232, 249, 0.45);
  font-weight: 700;
  margin-left: 8rpx;
}
.fr-arrow.warm {
  color: rgba(251, 146, 60, 0.5);
}
.fr-opt-key {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(34, 211, 238, 0.3);
  background: rgba(34, 211, 238, 0.09);
  color: #67e8f9;
  font-size: 26rpx;
  font-weight: 800;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fr-opt-key.warm {
  color: #fb923c;
  border-color: rgba(251, 146, 60, 0.32);
  background: rgba(251, 146, 60, 0.1);
}

/* 摸底页底部预告条 */
.fr-meta {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 44rpx;
}
.fr-meta-chip {
  font-size: 23rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

/* 题面 */
.fr-badges {
  display: flex;
  gap: 14rpx;
  align-items: center;
  flex-wrap: wrap;
  margin: 24rpx 0;
}
.fr-badge {
  display: inline-flex;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 8rpx 18rpx;
  letter-spacing: 1rpx;
}
.fr-badge.cyan {
  color: #67e8f9;
  background: rgba(34, 211, 238, 0.1);
  border: 1rpx solid rgba(34, 211, 238, 0.25);
}
.fr-badge.orange {
  color: #fb923c;
  background: rgba(251, 146, 60, 0.1);
  border: 1rpx solid rgba(251, 146, 60, 0.28);
}
.fr-badge.right {
  margin-left: auto;
}
.fr-case {
  background: linear-gradient(165deg, #122330, #0d1723);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  border-radius: 32rpx;
  padding: 28rpx 30rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.75;
  margin: 0 0 26rpx;
}
.fr-stem {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.5;
  margin: 0 0 8rpx;
}
.fr-hint {
  font-size: 25rpx;
  color: #22d3ee;
  font-weight: 600;
  margin: 4rpx 0 20rpx;
}

/* 判分 verdict */
.fr-verdict {
  display: flex;
  align-items: center;
  gap: 26rpx;
  background: linear-gradient(160deg, #14283a, #0c1826);
  border: 1rpx solid rgba(34, 211, 238, 0.25);
  border-radius: 36rpx;
  padding: 30rpx 32rpx;
  margin: 4rpx 0 24rpx;
  box-shadow: 0 24rpx 72rpx rgba(2, 8, 20, 0.6);
}
.fr-ring {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 8rpx solid #fb923c;
  background: #0c1826;
}
.fr-ring.good {
  border-color: #34d399;
}
.fr-ring.big {
  width: 148rpx;
  height: 148rpx;
  border-color: #fde8c8;
}
.fr-ring-tx {
  font-size: 26rpx;
  font-weight: 800;
  color: #67e8f9;
}
.fr-fb-head-tx {
  flex: 1;
  min-width: 0;
}
.fr-fb-title {
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.4;
}
.fr-fb-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.72);
  margin-top: 6rpx;
  line-height: 1.55;
}

/* 面板卡 */
.fr-panel {
  background: linear-gradient(165deg, #122330, #0d1723);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  border-radius: 32rpx;
  padding: 26rpx 30rpx;
  margin: 0 0 22rpx;
}
.fr-panel.mnemo {
  border-color: rgba(251, 191, 36, 0.3);
  background: linear-gradient(160deg, rgba(251, 191, 36, 0.1), rgba(251, 191, 36, 0.02));
}
.fr-ph {
  font-size: 23rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin: 0 0 16rpx;
}
.fr-ph.cyan {
  color: #22d3ee;
}
.fr-ph.gold {
  color: #fbbf24;
}

/* 逐项拆解 */
.fr-ans {
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}
.fr-ans:first-of-type {
  border-top: none;
  padding-top: 8rpx;
}
.fr-ans-l1 {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-wrap: wrap;
}
.fr-ans-key {
  width: 46rpx;
  height: 46rpx;
  border-radius: 16rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  color: rgba(255, 255, 255, 0.48);
  background: rgba(255, 255, 255, 0.03);
}
.fr-ans.good .fr-ans-key {
  background: rgba(52, 211, 153, 0.14);
  color: #34d399;
  border-color: rgba(52, 211, 153, 0.4);
}
.fr-ans.bad .fr-ans-key {
  background: rgba(251, 113, 133, 0.14);
  color: #fb7185;
  border-color: rgba(251, 113, 133, 0.4);
}
.fr-ans-tx {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.4;
  flex: 1;
  min-width: 320rpx;
}
.fr-ans.good .fr-ans-tx,
.fr-ans.bad .fr-ans-tx {
