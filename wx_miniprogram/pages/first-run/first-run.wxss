}
.fr-kk.orange {
  color: #fb923c;
}
.fr-kk.cyan {
  color: #22d3ee;
}
.fr-kt {
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.4;
  margin: 0 0 6rpx;
}
.fr-ks {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.72);
