}
.fr-st {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
}
.fr-st.ok {
  background: rgba(52, 211, 153, 0.12);
  color: #34d399;
  border: 1rpx solid rgba(52, 211, 153, 0.3);
}
.fr-st.no {
  background: rgba(251, 146, 60, 0.12);
  color: #fb923c;
  border: 1rpx solid rgba(251, 146, 60, 0.3);
}
.fr-grid-nm {
  color: rgba(255, 255, 255, 0.9);
  flex: 1;
  font-weight: 600;
}
.fr-grid-tg {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.48);
}

/* 口诀 chips */
.fr-mnchips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 8rpx;
}
.fr-mnchip {
  font-size: 24rpx;
  font-weight: 700;
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.1);
  border: 1rpx solid rgba(251, 191, 36, 0.25);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}

/* 收尾 */
.fr-final {
  text-align: center;
  padding-top: 120rpx;
}
