  font-weight: 700;
}
.fr-ans-tags {
  display: flex;
  gap: 10rpx;
  margin-left: auto;
}
.fr-stag {
  font-size: 21rpx;
  font-weight: 800;
  border-radius: 16rpx;
  padding: 6rpx 16rpx;
}
.fr-stag.ok {
  color: #34d399;
  background: rgba(52, 211, 153, 0.1);
  border: 1rpx solid rgba(52, 211, 153, 0.3);
}
.fr-stag.mine {
  color: #fb7185;
  background: rgba(251, 113, 133, 0.1);
  border: 1rpx solid rgba(251, 113, 133, 0.3);
}
.fr-stag.trap {
  color: #fb923c;
  background: rgba(251, 146, 60, 0.1);
  border: 1rpx solid rgba(251, 146, 60, 0.3);
}
.fr-ans-rs {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.48);
  line-height: 1.6;
  margin: 12rpx 0 0 64rpx;
}
.fr-ans.good .fr-ans-rs,
.fr-ans.bad .fr-ans-rs {
  color: rgba(255, 255, 255, 0.72);
}

/* 编译库判分卡 */
.fr-libtx {
  font-size: 27rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.65;
}
.fr-termlab {
  font-size: 23rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.48);
  margin: 20rpx 0 14rpx;
}
.fr-termchips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.fr-tchip {
  font-size: 25rpx;
  font-weight: 700;
  color: #67e8f9;
  background: rgba(34, 211, 238, 0.08);
  border: 1rpx solid rgba(34, 211, 238, 0.25);
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
}
.fr-tchip.hit {
  color: #34d399;
  background: rgba(52, 211, 153, 0.1);
  border-color: rgba(52, 211, 153, 0.35);
}
.fr-tchip.miss {
  color: #fb7185;
  background: rgba(251, 113, 133, 0.08);
  border-color: rgba(251, 113, 133, 0.3);
}
.fr-libscale {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.48);
  margin-top: 22rpx;
  line-height: 1.5;
}
.fr-libscale .ic {
  color: #67e8f9;
}

/* 口诀 */
.fr-mn-big {
  font-size: 37rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
  text-align: center;
  color: #fbbf24;
  margin: 10rpx 0 14rpx;
}
.fr-mn-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.72);
  text-align: center;
  line-height: 1.7;
}

/* CTA */
.fr-cta {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #67e8f9, #22d3ee);
  color: #062a38;
  font-size: 31rpx;
  font-weight: 800;
  text-align: center;
  border-radius: 30rpx;
  padding: 30rpx;
  box-shadow: 0 12rpx 44rpx rgba(34, 211, 238, 0.3);
}
.fr-cta:active {
  transform: scale(0.985);
}
.fr-cta.warm {
  background: none;
  border: 1rpx solid rgba(251, 146, 60, 0.4);
  color: #fb923c;
  box-shadow: none;
  font-weight: 700;
  margin-top: 20rpx;
}

/* 画像揭晓 */
.fr-typecard {
  background: linear-gradient(160deg, rgba(251, 146, 60, 0.16), rgba(251, 191, 36, 0.05));
  border: 1rpx solid rgba(251, 146, 60, 0.35);
  border-radius: 40rpx;
  padding: 44rpx 36rpx;
  margin: 20rpx 0 28rpx;
  text-align: center;
  box-shadow: 0 24rpx 72rpx rgba(2, 8, 20, 0.6);
}
.fr-tk {
  font-size: 23rpx;
  font-weight: 800;
  color: #fb923c;
  letter-spacing: 6rpx;
  margin: 0 0 20rpx;
}
.fr-tn {
  font-size: 54rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  line-height: 1.3;
  background: linear-gradient(100deg, #fb923c, #67e8f9);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.fr-td {
  font-size: 27rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.7;
  margin: 20rpx 0 0;
}
.fr-type-tags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 28rpx 0 0;
}
.fr-ttag {
  font-size: 24rpx;
  font-weight: 700;
  color: #fb923c;
  background: rgba(251, 146, 60, 0.1);
  border: 1rpx solid rgba(251, 146, 60, 0.3);
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
}

/* 指南行 */
.fr-guide-row {
  display: flex;
  gap: 22rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}
.fr-guide-row:first-of-type {
  border-top: none;
}
.fr-guide-ic {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: rgba(34, 211, 238, 0.08);
  border: 1rpx solid rgba(34, 211, 238, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.fr-guide-t {
  font-size: 27rpx;
  font-weight: 800;
  margin: 0 0 4rpx;
}
.fr-guide-t .loc {
  color: #67e8f9;
}
.fr-guide-s {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.6;
}

/* 报告 hero */
.fr-hero {
  background: linear-gradient(160deg, #14283a, #0c1826);
  border: 1rpx solid rgba(34, 211, 238, 0.25);
  border-radius: 40rpx;
  padding: 34rpx;
  margin: 16rpx 0 24rpx;
  box-shadow: 0 24rpx 72rpx rgba(2, 8, 20, 0.6);
  display: flex;
  gap: 28rpx;
  align-items: center;
}
.fr-hero-lft {
  flex: 1;
  min-width: 0;
}
.fr-hero-eb {
  font-size: 24rpx;
  font-weight: 800;
  color: #fb923c;
  letter-spacing: 3rpx;
  margin: 0 0 12rpx;
}
.fr-hero-rx {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.35;
  margin: 0 0 12rpx;
}
.fr-hero-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.6;
}
.fr-hero-ring {
  text-align: center;
  flex: 0 0 auto;
}
.fr-rlab {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.48);
  margin-top: 12rpx;
  font-weight: 600;
}

/* 瓷砖 */
.fr-tiles {
  display: flex;
  gap: 18rpx;
  margin: 0 0 12rpx;
}
.fr-tile {
  flex: 1;
  background: linear-gradient(165deg, #122330, #0d1723);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  border-radius: 30rpx;
  padding: 24rpx;
}
.fr-tile-cap {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.48);
  font-weight: 600;
  margin: 0 0 10rpx;
}
.fr-tile-n {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.2;
}
.fr-tile-n .u {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.48);
  margin-left: 6rpx;
}

/* 结论卡 */
.fr-kcard {
  background: linear-gradient(165deg, #122330, #0d1723);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  border-radius: 32rpx;
  padding: 26rpx 30rpx;
  margin: 16rpx 0;
  display: flex;
  align-items: center;
