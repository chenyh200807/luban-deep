  border-radius: 20rpx;
  padding: 12rpx 22rpx;
}

/* 四道题的账 */
.fr-grid-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
