.manual-page { min-height:100vh; background:linear-gradient(180deg,#10214c 0%,#0b1635 34%,#070d1d 66%,#04070e 100%); position:relative; overflow:hidden; }
.page-shell { position:relative; z-index:1; min-height:100vh; }
.sky-wash { position:fixed; top:-10%; left:-12%; right:-12%; height:56vh; pointer-events:none; z-index:0; background:radial-gradient(circle at 16% 8%,rgba(255,255,255,0.60) 0%,rgba(199,220,255,0.34) 22%,rgba(91,135,235,0.16) 42%,transparent 66%),radial-gradient(circle at 84% 6%,rgba(77,126,255,0.20) 0%,transparent 36%),radial-gradient(circle at 50% 46%,rgba(19,44,105,0.18) 0%,transparent 56%); }
.body { position:relative; z-index:1; min-height:100vh; }
.nav-row { padding:8rpx 44rpx 0; }
.nav-back { display:inline-flex; align-items:center; gap:6rpx; color:rgba(226,232,240,0.72); }
.nav-back-arrow { font-size:34rpx; line-height:1; }
.nav-back-txt { font-size:23rpx; font-weight:560; }
.hero { padding:48rpx 48rpx 20rpx; }
.title-row { display:flex; align-items:center; gap:14rpx; }
.title-logo { height:52rpx; display:block; }
.title-main { font-size:34rpx; font-weight:740; color:rgba(255,255,255,0.96); letter-spacing:0.2rpx; white-space:nowrap; }
.hero-title { display:block; margin-top:30rpx; font-size:52rpx; line-height:1.05; font-weight:760; color:#ffffff; letter-spacing:0.2rpx; }
.hero-sub { display:block; margin-top:16rpx; max-width:84%; font-size:24rpx; line-height:1.55; color:rgba(226,232,240,0.58); }
.sheet { margin:14rpx 44rpx 0; padding:22rpx 22rpx 26rpx; border-radius:24rpx; background:linear-gradient(180deg, rgba(8,17,38,0.54) 0%, rgba(5,10,24,0.74) 100%); border:1rpx solid rgba(185,207,255,0.08); box-shadow:0 18rpx 48rpx rgba(0,0,0,0.20), inset 0 1rpx 0 rgba(255,255,255,0.05); backdrop-filter:blur(22rpx); }
.mode-switch { display:flex; gap:6rpx; padding:5rpx; border-radius:20rpx; background:rgba(255,255,255,0.035); box-shadow:inset 0 0 0 1rpx rgba(255,255,255,0.04); }
.mode-pill { flex:1; min-height:64rpx; border-radius:17rpx; display:flex; align-items:center; justify-content:center; transition:all 180ms ease; }
.mode-pill-active { background:linear-gradient(180deg, rgba(76,129,239,0.34) 0%, rgba(45,89,178,0.28) 100%); box-shadow:inset 0 0 0 1rpx rgba(138,184,255,0.20), 0 8rpx 18rpx rgba(10,22,54,0.18); }
.mode-pill-txt { font-size:24rpx; font-weight:640; color:rgba(226,232,240,0.48); }
.mode-pill-active .mode-pill-txt { color:#f7fbff; }
.err { margin:18rpx 0 0; padding:14rpx 18rpx; border-radius:16rpx; background:rgba(127,29,29,0.22); border:1rpx solid rgba(239,68,68,0.14); }
.err-txt { font-size:24rpx; color:#fecaca; text-align:center; display:block; }
.manual-form { display:flex; flex-direction:column; gap:14rpx; margin-top:18rpx; }
.inp-group { display:flex; align-items:center; background:rgba(255,255,255,0.045); border:1rpx solid rgba(188,211,255,0.09); border-radius:18rpx; overflow:hidden; }
.inp-group:focus-within { border-color:rgba(118,169,255,0.34); background:rgba(255,255,255,0.06); }
.inp-icon { display:flex; align-items:center; justify-content:center; min-width:82rpx; height:82rpx; border-right:1rpx solid rgba(255,255,255,0.055); }
.inp-icon-txt { font-size:22rpx; font-weight:680; color:rgba(226,232,240,0.44); letter-spacing:0.4rpx; }
.inp { flex:1; height:82rpx; padding:0 22rpx; font-size:28rpx; color:#f8fbff; background:transparent; border:none; box-sizing:border-box; }
.inp-phone { letter-spacing:1.5rpx; }
.inp-code { letter-spacing:7rpx; font-weight:520; }
.ph { color:rgba(226,232,240,0.32); font-size:27rpx; }
.code-row { display:flex; gap:12rpx; align-items:stretch; }
.code-input { flex:1; }
.btn-send { min-width:184rpx; height:82rpx; margin:0; padding:0 18rpx; border:none; border-radius:18rpx; display:flex; align-items:center; justify-content:center; background:rgba(54,89,170,0.18); box-shadow:inset 0 0 0 1rpx rgba(109,156,255,0.20); }
.btn-send::after { border:none; }
.btn-send-txt { font-size:24rpx; font-weight:650; color:#9ac0ff; }
.btn-send-counting { background:rgba(255,255,255,0.03); box-shadow:inset 0 0 0 1rpx rgba(255,255,255,0.06); }
.btn-send-counting .btn-send-txt { color:rgba(255,255,255,0.34); }
.btn-send-off { opacity:0.42; }
.eye { padding:0 24rpx; display:flex; align-items:center; height:82rpx; }
.eye-txt { font-size:24rpx; color:rgba(146,190,255,0.74); }
.btn-manual { width:360rpx; max-width:100%; margin:12rpx auto 0; height:84rpx; padding:0 30rpx; border-radius:22rpx; border:none; display:flex; align-items:center; justify-content:center; box-sizing:border-box; background:linear-gradient(90deg, #2d79ff 0%, #5a99ff 52%, #9abdfc 100%); box-shadow:0 16rpx 34rpx rgba(37,99,235,0.26), inset 0 1rpx 0 rgba(255,255,255,0.18); }
.btn-manual::after { border:none; }
.btn-manual.off { opacity:0.5; }
.btn-manual-txt { display:block; font-size:27rpx; line-height:1; font-weight:720; color:#f8fbff; letter-spacing:0.2rpx; white-space:nowrap; transform:translateY(1rpx); }
.foot { display:flex; justify-content:center; margin-top:18rpx; }
.foot-link { font-size:23rpx; color:rgba(114,174,255,0.82); }
