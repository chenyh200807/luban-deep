# ============================================
# DeepTutor Docker Ignore File
# ============================================
# Excludes files and directories from the Docker build context
# to improve build speed and reduce image size
# ============================================

# ============================================
# Git
# ============================================
.git
.gitignore
.gitattributes

# ============================================
# Documentation
# ============================================
*.md
!README.md
docs/
assets/gifs/
assets/figs/
assets/README/

# ============================================
# Python
# ============================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
MANIFEST

# Virtual environments
.env
*.env
!.env.example
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/
DeepTutor.env

# Pytest cache
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ============================================
# Node.js
# ============================================
node_modules/
**/node_modules/
web/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
**/*.tsbuildinfo

# Next.js
.next/
web/.next/
out/
web/out/

# ============================================
# IDE and Editor
# ============================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ============================================
# Docker
# ============================================
Dockerfile*
docker-compose*.yml
.docker/
.dockerignore

# ============================================
# User Data (will be mounted as volumes)
# ============================================
data/user/
data/knowledge_bases/
run_code_workspace/
artifacts/

# ============================================
# Development and Testing
# ============================================
develop/
.codegraph/
.gstack/
.local-runs/
.playwright-cli/
playwright-report*/
**/playwright-report*/
scripts/extract_numbered_items.sh
test-results*/
**/test-results*/
*.log
logs/
*.bak
*.tmp

# ============================================
# Temporary and Cache Files
# ============================================
.cache/
cache/
**/cache/
tmp/
temp/
*.tmp
*.temp

