@import "/packageDeeptutor/theme.wxss";
@import "/packageDeeptutor/styles/paper-ink.wxss";

.mistake-book-page {
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
  overflow: hidden;
}

.mb-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: rgba(10, 10, 10, 0.92);
  border-bottom: 1rpx solid var(--border);
}

.mb-nav-inner {
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 0;
  gap: 16rpx;
}

.mb-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: 20rpx;
  padding: 8rpx 12rpx 8rpx 4rpx;
  border-radius: 8rpx;
}

.mb-back:active {
  background: rgba(255, 255, 255, 0.08);
}

.mb-back-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: #818cf8;
  font-weight: 300;
  margin-top: -4rpx;
}

.mb-back-text {
  font-size: 28rpx;
  color: #818cf8;
  font-weight: 500;
}

.mb-nav-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.mb-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  overflow-y: auto;
}

.mb-inner {
  padding: 28rpx 24rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.mb-hero,
.ai-panel,
.chart-card,
.mistake-card,
.empty-card,
.mb-error {
  border-radius: 22rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  background: rgba(15, 23, 42, 0.62);
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.22);
}

.mb-hero {
  padding: 28rpx 24rpx;
  background:
    radial-gradient(circle at top right, rgba(56, 189, 248, 0.18), transparent 36%),
    linear-gradient(145deg, rgba(14, 165, 233, 0.18), rgba(5, 150, 105, 0.12), rgba(15, 23, 42, 0.72));
}

.mb-hero-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.mb-kicker,
.ai-kicker {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #7dd3fc;
}

.mb-title {
  display: block;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 850;
  color: #fff;
}

.mb-score {
  flex-shrink: 0;
  min-width: 116rpx;
  text-align: right;
}

.mb-score-num {
  display: block;
  font-size: 68rpx;
  line-height: 1;
  font-weight: 900;
  color: #67e8f9;
}

.mb-score-label {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: rgba(226, 232, 240, 0.72);
}

.mb-hero-desc {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(226, 232, 240, 0.76);
}

.mb-stats {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.mb-stat {
  flex: 1;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.mb-stat.warn {
  background: rgba(251, 191, 36, 0.08);
  border-color: rgba(251, 191, 36, 0.14);
}

.mb-stat.good {
  background: rgba(52, 211, 153, 0.08);
  border-color: rgba(52, 211, 153, 0.14);
}

.mb-stat-num,
.mb-stat-label {
  display: block;
}

.mb-stat-num {
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 850;
  color: #fff;
}

.mb-stat-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: rgba(226, 232, 240, 0.64);
}

.ai-panel {
  padding: 24rpx;
  background:
    linear-gradient(145deg, rgba(8, 145, 178, 0.2), rgba(15, 23, 42, 0.72));
}

.ai-title {
  display: block;
  font-size: 31rpx;
  line-height: 1.32;
  font-weight: 850;
  color: #fff;
}

.ai-summary {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.58;
  color: rgba(226, 232, 240, 0.78);
}

.ai-bullets {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 16rpx;
}

.ai-bullet {
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
  font-size: 23rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.82);
}

.ai-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #34d399;
}

.chart-grid,
.mistake-list,
.mb-loading {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.mb-list-hint {
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(45, 212, 191, 0.08);
  border: 1rpx solid rgba(45, 212, 191, 0.14);
}

.mb-list-hint text {
  display: block;
  font-size: 22rpx;
  line-height: 1.35;
  color: rgba(153, 246, 228, 0.84);
}

.chart-card {
  padding: 22rpx;
}

.chart-title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  font-weight: 850;
  color: #fff;
}

.chart-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 12rpx;
}

.chart-row-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.chart-label {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.3;
  color: rgba(226, 232, 240, 0.82);
}

.chart-count {
  flex-shrink: 0;
  font-size: 22rpx;
  color: rgba(226, 232, 240, 0.58);
}

.chart-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  overflow: hidden;
}

.chart-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #38bdf8, #34d399);
}

.chart-fill.error {
  background: linear-gradient(90deg, #f59e0b, #f87171);
}

.chart-fill.fill-focus {
  opacity: 0.78;
}

.chart-fill.fill-calm {
  opacity: 0.58;
}

.mb-filter {
  display: flex;
  gap: 10rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.filter-chip {
  flex: 1;
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: rgba(226, 232, 240, 0.68);
}

.filter-chip.active {
  background: rgba(56, 189, 248, 0.16);
  color: #7dd3fc;
}

.mistake-card {
  overflow: hidden;
}

.mistake-card.state-due {
  border-color: rgba(251, 191, 36, 0.28);
}

.mistake-card.state-mastered {
  border-color: rgba(52, 211, 153, 0.2);
}

.mistake-card-main {
  padding: 22rpx;
}

.mistake-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.mistake-date {
  font-size: 22rpx;
  color: rgba(226, 232, 240, 0.58);
}

.mistake-state {
  flex-shrink: 0;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(56, 189, 248, 0.12);
  font-size: 20rpx;
  font-weight: 800;
  color: #7dd3fc;
}

.state-due .mistake-state {
  background: rgba(251, 191, 36, 0.12);
  color: #fbbf24;
}

.state-mastered .mistake-state {
  background: rgba(52, 211, 153, 0.12);
  color: #6ee7b7;
}

.mistake-title {
  display: block;
  margin-top: 12rpx;
  font-size: 29rpx;
  line-height: 1.36;
  font-weight: 850;
  color: #fff;
}

.mistake-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.mistake-tags text {
  padding: 7rpx 11rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  font-size: 21rpx;
  line-height: 1.25;
  color: rgba(255, 255, 255, 0.78);
}

.mistake-note,
.mistake-review {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.5;
}

.mistake-note {
  color: rgba(226, 232, 240, 0.72);
}

.mistake-review {
  color: rgba(125, 211, 252, 0.78);
}

.mistake-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 0 22rpx 22rpx;
}

.mistake-action {
  min-height: 54rpx;
  padding: 0 16rpx;
  border-radius: 13rpx;
  background: rgba(255, 255, 255, 0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.76);
}

.mistake-action.primary {
  background: rgba(56, 189, 248, 0.14);
  color: #7dd3fc;
}

.mistake-action.danger {
  color: #fca5a5;
}

.empty-card,
.mb-error {
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 850;
  color: #fff;
}

.empty-desc,
.mb-error text {
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(226, 232, 240, 0.68);
}

.mb-retry {
  margin-top: 6rpx;
  width: 128rpx;
  min-height: 56rpx;
  border-radius: 14rpx;
  background: rgba(56, 189, 248, 0.14);
  color: #7dd3fc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
}

.mb-skel {
  height: 42rpx;
}

.mb-skel.short {
  width: 62%;
}

.mb-skel.card {
  height: 220rpx;
}

/* ── 亮色模式 ───────────────────────────────── */
.mistake-book-page.light {
  background:
    radial-gradient(circle at top right, rgba(37, 99, 235, 0.10), transparent 34%),
    linear-gradient(180deg, #f8fafc 0%, #eef4ff 52%, #f8fbff 100%);
}

.mistake-book-page.light .mb-nav {
  background: rgba(248, 250, 255, 0.96);
  border-bottom-color: #dbe6f5;
  box-shadow: 0 10rpx 28rpx rgba(126, 147, 185, 0.10);
}

.mistake-book-page.light .mb-back:active {
  background: rgba(37, 99, 235, 0.08);
}

.mistake-book-page.light .mb-back-arrow,
.mistake-book-page.light .mb-back-text {
  color: #2563eb;
}

.mistake-book-page.light .mb-nav-title,
.mistake-book-page.light .mb-title,
.mistake-book-page.light .ai-title,
.mistake-book-page.light .chart-title,
.mistake-book-page.light .mistake-title,
.mistake-book-page.light .empty-title {
  color: #0f172a;
}

.mistake-book-page.light .mb-hero,
.mistake-book-page.light .ai-panel,
.mistake-book-page.light .chart-card,
.mistake-book-page.light .mistake-card,
.mistake-book-page.light .empty-card,
.mistake-book-page.light .mb-error {
  background: rgba(255, 255, 255, 0.96);
  border-color: #dbe6f5;
  box-shadow: 0 14rpx 34rpx rgba(126, 147, 185, 0.12);
}

.mistake-book-page.light .mb-hero {
  background:
    radial-gradient(circle at top right, rgba(37, 99, 235, 0.12), transparent 38%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(239, 245, 255, 0.96));
}

.mistake-book-page.light .ai-panel {
  background: linear-gradient(145deg, #ffffff, #f0f9ff);
}

.mistake-book-page.light .mb-kicker,
.mistake-book-page.light .ai-kicker {
  color: #0369a1;
}

.mistake-book-page.light .mb-score-num {
  color: #2563eb;
}

.mistake-book-page.light .mb-score-label,
.mistake-book-page.light .mb-hero-desc,
.mistake-book-page.light .ai-summary,
.mistake-book-page.light .chart-label,
.mistake-book-page.light .mistake-note,
.mistake-book-page.light .empty-desc,
.mistake-book-page.light .mb-error text {
  color: #475569;
}

.mistake-book-page.light .mb-stat {
  background: #f8fbff;
  border-color: #dbe6f5;
}

.mistake-book-page.light .mb-stat.warn {
  background: #fffbeb;
  border-color: #fde68a;
}

.mistake-book-page.light .mb-stat.good {
  background: #ecfdf5;
  border-color: #a7f3d0;
}

.mistake-book-page.light .mb-stat-num {
  color: #0f172a;
}

.mistake-book-page.light .mb-stat-label,
.mistake-book-page.light .chart-count,
.mistake-book-page.light .mistake-date {
  color: #64748b;
}

.mistake-book-page.light .ai-bullet {
  color: #334155;
}

.mistake-book-page.light .ai-dot {
  background: #059669;
}

.mistake-book-page.light .mb-list-hint {
  background: #ecfeff;
  border-color: #bae6fd;
}

.mistake-book-page.light .mb-list-hint text {
  color: #075985;
}

.mistake-book-page.light .chart-track {
  background: #e5edf8;
}

.mistake-book-page.light .chart-fill {
  background: linear-gradient(90deg, #2563eb, #059669);
}

.mistake-book-page.light .chart-fill.error {
  background: linear-gradient(90deg, #b45309, #dc2626);
}

.mistake-book-page.light .mb-filter {
  background: #eef4ff;
  border-color: #dbe6f5;
}

.mistake-book-page.light .filter-chip {
  color: #64748b;
}

.mistake-book-page.light .filter-chip.active {
  background: #ffffff;
  color: #2563eb;
  box-shadow: 0 8rpx 18rpx rgba(126, 147, 185, 0.12);
}

.mistake-book-page.light .mistake-card.state-due {
  border-color: rgba(180, 83, 9, 0.28);
}

.mistake-book-page.light .mistake-card.state-mastered {
  border-color: rgba(5, 150, 105, 0.24);
}

.mistake-book-page.light .mistake-state {
  background: #eff6ff;
  color: #2563eb;
}

.mistake-book-page.light .state-due .mistake-state {
  background: #fffbeb;
  color: #b45309;
}

.mistake-book-page.light .state-mastered .mistake-state {
  background: #ecfdf5;
  color: #047857;
}

.mistake-book-page.light .mistake-tags text {
  background: #eef4ff;
  color: #334155;
}

.mistake-book-page.light .mistake-review {
  color: #2563eb;
}

.mistake-book-page.light .mistake-action {
  background: #eef4ff;
  color: #334155;
}

.mistake-book-page.light .mistake-action.primary {
  background: #dbeafe;
  color: #1d4ed8;
}

.mistake-book-page.light .mistake-action.danger {
  background: #fef2f2;
  color: #dc2626;
}

.mistake-book-page.light .mb-retry {
  background: #dbeafe;
  color: #1d4ed8;
}

.mistake-book-page.light .skel-block {
  background: linear-gradient(90deg, #eef4ff 0%, #f8fbff 50%, #eef4ff 100%);
  background-size: 200% 100%;
}

/* ── 五模块纸墨壳：错题本归复习，信息结构不变，palette 收归 paper-ink ── */
.mistake-book-page.paper {
  background-color: var(--pk-paper);
  background-image: radial-gradient(var(--pk-dot) 1.3rpx, transparent 1.3rpx);
  background-size: 34rpx 34rpx;
  color: var(--pk-t1);
}
.mistake-book-page.paper .mb-nav {
  background: var(--pk-paper);
  border-color: var(--pk-bd);
  box-shadow: none;
}
.mistake-book-page.paper .mb-back-arrow,
.mistake-book-page.paper .mb-back-text,
.mistake-book-page.paper .ai-kicker { color: var(--pk-grn); }
.mistake-book-page.paper .mb-nav-title,
.mistake-book-page.paper .mb-title,
.mistake-book-page.paper .mb-score-num,
.mistake-book-page.paper .ai-title,
.mistake-book-page.paper .chart-title,
.mistake-book-page.paper .chart-label,
.mistake-book-page.paper .mistake-title,
.mistake-book-page.paper .empty-title { color: var(--pk-t1); }
.mistake-book-page.paper .mb-hero,
.mistake-book-page.paper .ai-panel,
.mistake-book-page.paper .mb-stat,
.mistake-book-page.paper .chart-card,
.mistake-book-page.paper .mb-filter,
.mistake-book-page.paper .mistake-card {
  background: var(--pk-card);
  border-color: var(--pk-bd);
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
}
.mistake-book-page.paper .mb-hero-desc,
.mistake-book-page.paper .ai-summary,
.mistake-book-page.paper .ai-bullet,
.mistake-book-page.paper .mb-list-hint text,
.mistake-book-page.paper .mistake-date,
.mistake-book-page.paper .mistake-note { color: var(--pk-t2); }
.mistake-book-page.paper .chart-track { background: var(--pk-gauge); }
.mistake-book-page.paper .chart-fill,
.mistake-book-page.paper .chart-fill.fill-focus,
.mistake-book-page.paper .chart-fill.fill-calm { background: var(--pk-grn); }
.mistake-book-page.paper .chart-fill.error { background: var(--pk-warn); }
.mistake-book-page.paper .filter-chip,
.mistake-book-page.paper .mistake-tags text,
.mistake-book-page.paper .mistake-action {
  background: var(--pk-gauge);
  border-color: var(--pk-bd);
  color: var(--pk-t2);
}
.mistake-book-page.paper .filter-chip.active { background: rgba(72, 128, 106, 0.12); border-color: var(--pk-grn); color: var(--pk-grn); }
.mistake-book-page.paper .mistake-action.primary { background: var(--pk-ink-btn); color: var(--pk-ink-btn-t); }
.mistake-book-page.paper .mistake-action.danger { background: transparent; border-color: var(--pk-warn); color: var(--pk-warn); }
