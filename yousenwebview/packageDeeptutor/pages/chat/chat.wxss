  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
}
.page.paper .ctx-chip-icon {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  background-repeat: no-repeat;
