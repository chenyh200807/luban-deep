.page.paper .workflow-step-badge-compose { color: var(--pk-grn); background: var(--pk-accent-soft); }
.page.paper .workflow-step-badge-calc { color: #a07f2e; background: rgba(201, 159, 61, 0.14); }
.page.paper:not(.light) .workflow-step-badge-calc { color: #e2b264; }
.page.paper .workflow-step-badge-retry { color: var(--pk-warn); background: rgba(194, 101, 85, 0.12); }

/* ════ 10d 对话面精修(2026-07-18,追加于 paper 收口层之后故同权重取胜) ════ */

/* ① 处理摘要完成态 → 一行思考细条(10d):沙色左轨 + 紧凑行高 */
.page.paper .workflow-card {
  position: relative;
  margin-top: 16rpx;
  padding: 14rpx 18rpx 14rpx 24rpx;
  border-radius: 16rpx;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  box-shadow: none;
}
.page.paper .workflow-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14rpx;
  bottom: 14rpx;
  width: 5rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: var(--pk-sand);
}
.page.paper .workflow-card-head {
  margin-bottom: 0;
}
.page.paper .workflow-card-label {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--pk-t2);
}
.page.paper .workflow-card-badge {
  padding: 3rpx 10rpx;
  font-size: 18rpx;
}
.page.paper .workflow-card-sub {
  margin-top: 10rpx;
}
.page.paper .workflow-meta-text {
  margin-top: 6rpx;
}

/* ② 结论/要点/技巧 callout → 竹青左轨软卡(10d 步骤卡语言);警告=赭轨 */
.page.paper .md-callout-conclusion,
.page.paper .md-callout-highlight,
.page.paper .md-callout-tip {
  position: relative;
  border: 1rpx solid var(--pkx-grn-bd);
  border-left-width: 1rpx;
  border-radius: 20rpx;
  background: var(--pkx-grn-bg);
  padding: 18rpx 22rpx 18rpx 28rpx;
  overflow: hidden;
}
.page.paper .md-callout-warning {
  position: relative;
  border: 1rpx solid var(--pkx-warn-bd);
  border-left-width: 1rpx;
  border-radius: 20rpx;
  background: var(--pkx-warn-bg);
  padding: 18rpx 22rpx 18rpx 28rpx;
  overflow: hidden;
}
.page.paper .md-callout-conclusion::before,
.page.paper .md-callout-highlight::before,
.page.paper .md-callout-tip::before,
.page.paper .md-callout-warning::before {
  content: "";
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 6rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: var(--pk-grn);
}
.page.paper .md-callout-warning::before {
  background: var(--pk-warn);
}
.page.paper .callout-tag-conclusion,
.page.paper .callout-tag-highlight,
.page.paper .callout-tag-tip {
  background: var(--pkx-grn-chip);
  border: none;
  color: var(--pk-grn);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}
.page.paper .callout-tag-warning {
  background: var(--pkx-warn-chip);
  border: none;
  color: var(--pk-warn);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

/* ③ 引用块 → 金句卡:宣纸点阵舞台 + 复制语义(10d 可背句块) */
.page.paper .md-blockquote {
  border-left: none;
  border: 1rpx solid var(--pk-bd);
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  background-color: var(--pk-paper);
  background-image: radial-gradient(var(--pk-dot) 1.3rpx, transparent 1.3rpx);
  background-size: 24rpx 24rpx;
  color: var(--pk-t1);
}
/* bq-line 是引用正文唯一渲染节点(chat.wxml blockquote 分支),金句卡只换舞台
   不得藏正文——曾误写 display:none 致引用全篇消失,review CONFIRMED 后修正。 */
.page.paper .md-blockquote .bq-line {
  display: block;
  color: var(--pk-t1);
}

/* ④ 发送钮 → 墨色圆钮(10d 输入坞) */
.page.paper .send-btn {
  border-radius: 50%;
}
.page.paper .send-icon {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
}

/* ⑤ 输入卡与列表节奏微调 */
.page.paper .bottom-input-card {
  border-radius: 28rpx;
}

/* ⑥ callout 裸章(无正文的小节标签):去卡壳只留胶囊;有正文才是软卡 */
.page.paper .md-callout-bare {
  border: none;
  background: transparent;
  padding: 8rpx 0 0;
  box-shadow: none;
}
.page.paper .md-callout-bare::before {
  display: none;
}

/* ⑦ 列表项 rich 渲染(加粗/行内码不再裸露 **) */
.page.paper .md-li-rich {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--pk-t1);
}

/* ⑧ 10d 助手消息:朱红章头像行 + 层次 */
.ai-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}
.ai-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: #cf4436;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  box-shadow: 0 6rpx 18rpx rgba(207, 68, 54, 0.28);
}
.ai-avatar-img {
  width: 34rpx;
  height: 34rpx;
}
.page.paper .ai-row .bubble-ai {
  flex: 1;
  min-width: 0;
  max-width: none;
  border-radius: 8rpx 32rpx 32rpx 32rpx;
  box-shadow: 0 2rpx 12rpx var(--pk-shadow), 0 10rpx 32rpx rgba(38, 36, 31, 0.05);
}
/* 操作行与导练卡缩进对齐气泡(避开头像列),形成三级纵向层次 */
.page.paper .msg.ai .msg-actions-left,
.page.paper .msg .nba-card {
  margin-left: 78rpx;
}

/* ⑨ 10d 步骤头:「第N步·标题」竹青徽章行(确定性升格,模型分步即触发) */
.page.paper .md-step-head {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 18rpx 0 6rpx;
  padding: 12rpx 16rpx 12rpx 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--pk-accent-border);
  background: var(--pk-accent-soft);
}
.page.paper .md-step-head::before {
  content: "";
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 6rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: var(--pk-grn);
}
.page.paper .md-step-badge {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--pk-grn);
  font-size: 20rpx;
  font-weight: 800;
  color: #ffffff;
}
.page.paper .md-step-title {
  font-size: 27rpx;
  font-weight: 800;
  color: var(--pk-t1);
}
