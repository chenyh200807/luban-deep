/* ═══════════════════════════════════════════════
   ★ 动画 — GPU 合成，低端机友好
   ═══════════════════════════════════════════════ */

/* 消息入场 — 方向感 */
.msg.user { animation: msgUserIn 0.25s ease-out; }
.msg.ai { animation: msgAiIn 0.28s ease-out; }
@keyframes msgUserIn {
  from { opacity: 0; transform: translateX(20rpx) scale(0.97); }
  to { opacity: 1; transform: translateX(0) scale(1); }
}
@keyframes msgAiIn {
  from { opacity: 0; transform: translateX(-16rpx) scale(0.97); }
  to { opacity: 1; transform: translateX(0) scale(1); }
}

/* Hero 问候入场 — 交错编排 */
.greeting { animation: fadeUp 0.5s ease-out; }
.greeting-sub { animation: fadeUp 0.5s ease-out 0.1s both; }
.focus-bar { animation: fadeUp 0.4s ease-out 0.2s both; }
.input-card { animation: fadeUp 0.4s ease-out 0.3s both; }
.example-label { animation: fadeUp 0.3s ease-out 0.4s both; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 焦点 banner 脉冲 */
.focus-bar { position: relative; }
.focus-bar::after {
  content: "";
  position: absolute; top: 0; right: 0; bottom: 0; left: 0; border-radius: 999rpx;
  border: 1rpx solid rgba(96,165,250,0.20);
  animation: focusPulse 2.5s ease-in-out infinite;
}
@keyframes focusPulse {
  0%, 100% { opacity: 0.3; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.02); }
}

/* 示例卡片 — 逐张入场 */
.example-card {
  opacity: 0; animation: cardIn 0.3s ease-out forwards;
  transition: transform 0.15s, border-color 0.15s;
}
.example-card:nth-child(1) { animation-delay: 0.46s; }
.example-card:nth-child(2) { animation-delay: 0.54s; }
.example-card:nth-child(3) { animation-delay: 0.62s; }
.example-card:nth-child(4) { animation-delay: 0.70s; }
@keyframes cardIn {
  from { opacity: 0; transform: translateY(16rpx) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.example-card:active { transform: scale(0.97); border-color: rgba(96,165,250,0.24); }

/* MCQ — 选中弹跳 */
.mcq-opt { transition: transform 0.15s, border-color 0.15s, background 0.15s; }
.mcq-opt:active { transform: scale(0.98); }
.mcq-opt.sel { animation: mcqPop 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
@keyframes mcqPop {
  0% { transform: scale(1); }
  40% { transform: scale(1.03); }
  100% { transform: scale(1); }
}

/* 发送按钮 */
.send-btn { transition: background 0.2s, transform 0.1s; }
.send-btn:active { transform: scale(0.88); }
.send-btn.on { animation: sendReady 0.25s ease-out; }
@keyframes sendReady {
  from { transform: scale(0.92); opacity: 0.6; }
  to { transform: scale(1); opacity: 1; }
}

/* 模式切换 — 触摸反馈 */
.mode-pill { transition: background 0.15s, border-color 0.15s, transform 0.1s; }
.mode-pill:active { transform: scale(0.95); }

/* 底部输入栏滑入 */
.bottom-bar { animation: barSlideUp 0.25s ease-out; }
@keyframes barSlideUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 全局触摸增强 */
.avatar:active { transform: scale(0.92); }
.focus-bar:active { transform: scale(0.98); }
.ua-btn { transition: transform 0.1s, opacity 0.15s; }

