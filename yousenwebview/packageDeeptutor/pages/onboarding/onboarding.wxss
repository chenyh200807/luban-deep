/* onboarding.wxss — 「先体验导学」宣纸晨光 · Light is coming(纸墨朱竹版)
   世界观：与登录页/正式主页同族的夜宣纸；地平线朱红晨光弧随页面推进
   缓缓上升、天际晨光逐页升温(竹青夜→赭金→朱红→宣纸亮)——黑夜将明 = 备考上岸。
   节奏：文字幕 Apple 式慢而准；判分弹分 Nike 式蓄力爆发。
   红线：补间只用 transform/opacity（小面积文字高亮的颜色动画除外）。 */

.onboarding-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  color: #f0ede1;
  background: linear-gradient(180deg, #14120d 0%, #1c1a15 52%, #26231d 100%);
}

/* —— 天际黎明光：每页一种色温，交叉淡入 + 涌入动势 —— */
.dawn {
  position: fixed;
  left: -30%;
  right: -30%;
  bottom: -6%;
  height: 92%;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transform: translateY(7%) scale(1.06);
  /* visibility 延迟到淡出结束再 hidden：让非活动层释放合成器纹理 */
  transition:
    opacity 1100ms ease,
    transform 1100ms cubic-bezier(0.22, 1, 0.36, 1),
    visibility 0s linear 1100ms;
}

.dawn-hook {
  background: radial-gradient(ellipse at 50% 100%, rgba(127, 185, 157, 0.22) 0%, rgba(127, 185, 157, 0.1) 36%, transparent 64%);
}

.dawn-p1 {
  background: radial-gradient(ellipse at 50% 100%, rgba(201, 159, 61, 0.32) 0%, rgba(201, 159, 61, 0.15) 38%, transparent 66%);
}

.dawn-p2 {
  background: radial-gradient(ellipse at 50% 100%, rgba(207, 68, 54, 0.3) 0%, rgba(178, 96, 60, 0.16) 38%, transparent 66%);
}

.dawn-p3 {
  background: radial-gradient(ellipse at 50% 100%, rgba(244, 241, 230, 0.5) 0%, rgba(226, 178, 100, 0.26) 36%, transparent 66%);
}

.act-wave .dawn-hook,
.act-hook .dawn-hook,
.act-p1 .dawn-p1,
.act-p2 .dawn-p2,
.act-p3 .dawn-p3 {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
  transition:
    opacity 1100ms ease,
    transform 1100ms cubic-bezier(0.22, 1, 0.36, 1),
    visibility 0s;
}

/* —— 地平线光弧（bolt SVG 配方，性能版）——
   2 个元素替代 5 层巨型圆：环带用 box-shadow spread 画在星球盘上，
   外层 .horizon-clip 视口裁剪把合成纹理压到屏幕大小。 —— */
.horizon-clip {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
}

.horizon {
  position: absolute;
  left: 50%;
  top: 82vh;
  width: 2700rpx;
  height: 2700rpx;
  border-radius: 50%;
  transform: translateX(-50%);
  transition: transform 1100ms cubic-bezier(0.22, 1, 0.36, 1);
}

/* 星球盘 + 弧光环带：白核(6rpx) → 亮蓝 → 实蓝，渐薄渐淡 */
.horizon-disc {
  background: #14120d;
  box-shadow:
    0 0 0 6rpx #fffdf8,
    0 0 0 15rpx #e8c87a,
    0 0 0 28rpx rgba(207, 68, 54, 0.95);
}

/* 蓝色外晕（softBlue/wideBlue 双层），呼吸明暗 */
.horizon-halo {
  box-shadow:
    0 -18rpx 70rpx 38rpx rgba(207, 68, 54, 0.55),
    0 -60rpx 220rpx 68rpx rgba(201, 159, 61, 0.32);
  opacity: 0.7;
  animation: horizonBreathe 4600ms ease-in-out infinite alternate;
}

@keyframes horizonBreathe {
  to { opacity: 1; }
}

/* 光弧随页面推进上升：黑夜将明 */
.act-p1 .horizon {
  transform: translateX(-50%) translateY(-3vh);
}

.act-p2 .horizon {
  transform: translateX(-50%) translateY(-6vh);
}

.act-p3 .horizon {
  transform: translateX(-50%) translateY(-9vh);
}

.grain {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  opacity: 0.06;
  background-image: url("data:image/png;base64,");
  background-size: 110rpx 110rpx;
}

/* —— 入场夜幕：进入瞬间全暗，随即拉开 —— */
.night-veil {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  pointer-events: none;
  background: #14120d;
  opacity: 1;
}

.night-veil.lift {
  animation: veilLift 760ms ease both;
}

@keyframes veilLift {
  to { opacity: 0; }
}

/* —— 骨架 —— */
.page-shell {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding-left: 38rpx;
  padding-right: 38rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.topbar {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-mark {
  width: 56rpx;
  height: 56rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  background: #cf4436;
  border: none;
  box-shadow: 0 6rpx 18rpx rgba(207, 68, 54, 0.3);
  box-sizing: border-box;
}

.brand-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.05;
  font-weight: 800;
  color: #f0ede1;
}

.brand-sub {
  display: block;
  margin-top: 5rpx;
  color: rgba(183, 178, 162, 0.75);
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 0.08em;
}

.progress-row {
  height: 34rpx;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-pill {
  width: 34rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  transition: width 320ms ease, background 320ms ease;
}

.progress-pill.on {
  background: rgba(232, 200, 122, 0.6);
}

.progress-pill.current {
  width: 72rpx;
  background: #e8c87a;
}

/* —— 幕 1: 垂直词轮播 → 品牌宣言 —— */
.hook-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.roller-zone {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.roller {
  position: relative;
  height: 450rpx;
  overflow: hidden;
  opacity: 0;
}

.hook-stage.play .roller {
  animation: softIn 620ms ease both;
}

.roller-track {
  display: flex;
  flex-direction: column;
  transition: transform 540ms cubic-bezier(0.22, 1, 0.36, 1);
}

.roller-word {
  height: 150rpx;
  display: flex;
  align-items: center;
}

.roller-word text {
  font-size: 96rpx;
  font-weight: 900;
  line-height: 1;
  color: rgba(240, 237, 225, 0.16);
  letter-spacing: 0.02em;
  transform: scale(0.94);
  transform-origin: left center;
  transition: color 440ms ease, transform 440ms cubic-bezier(0.22, 1, 0.36, 1), text-shadow 440ms ease;
}

.roller-word.cur text {
  color: #f0ede1;
  transform: scale(1);
}

.roller-word.final text {
  color: #e8c87a;
  text-shadow: 0 0 36rpx rgba(232, 200, 122, 0.45);
}

/* 品牌宣言：坐在天际光上 */
.hook-brand {
  padding-bottom: 250rpx;
}

.hook-brand.fx-pop.on {
  animation: softIn 640ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.hook-brand-mark {
  width: 76rpx;
  height: 76rpx;
  padding: 14rpx;
  border-radius: 22rpx;
  background: #cf4436;
  border: none;
  box-sizing: border-box;
  box-shadow: 0 14rpx 36rpx rgba(207, 68, 54, 0.35);
}

.hook-brand-mark image {
  width: 100%;
  height: 100%;
}

.hook-brand-title {
  display: block;
  margin-top: 24rpx;
  color: #f0ede1;
  font-family: "Songti SC", "STSong", "Source Han Serif SC", serif;
  font-size: 46rpx;
  line-height: 1.25;
  font-weight: 900;
}

.hook-brand-desc {
  display: block;
  margin-top: 14rpx;
  color: rgba(183, 178, 162, 0.85);
  font-size: 27rpx;
  line-height: 1.6;
  font-weight: 500;
}

/* —— 逐字 mask-rise —— */
.rise-line {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  overflow: hidden;
  padding-bottom: 8rpx;
}

.rise-char {
  display: block;
  opacity: 0;
  transform: translateY(112%);
  font-family: "Songti SC", "STSong", "Source Han Serif SC", serif;
  font-weight: 900;
  color: #f0ede1;
  font-size: 82rpx;
  line-height: 1.22;
  letter-spacing: 0.01em;
}

.play .rise-char {
  animation: charRise 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes charRise {
  from {
    opacity: 0;
    transform: translateY(112%);
  }
  55% {
    opacity: 1;
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.rise-char.is-accent {
  color: #e8c87a;
  text-shadow: 0 0 32rpx rgba(232, 200, 122, 0.4);
}

/* —— 幕 2/3/4 容器 —— */
.act-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 110rpx;
}

.story-copy {
  min-height: 200rpx;
}

.title-char {
  font-size: 64rpx;
}

/* —— 说明与标签 —— */
.act-desc-wrap {
  margin-top: 30rpx;
}

.act-desc {
  display: block;
  color: rgba(183, 178, 162, 0.85);
  font-size: 27rpx;
  line-height: 1.66;
  font-weight: 500;
}

.act-desc-wrap.fx-pop.on {
  animation: softIn 560ms ease both;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 30rpx;
}

.tag {
  opacity: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.tag-row.on .tag {
  animation: tagPop 520ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.tag text {
  color: rgba(240, 237, 225, 0.78);
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 0.04em;
}

@keyframes tagPop {
  from {
    opacity: 0;
    transform: translateY(16rpx) scale(0.94);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* —— 深色玻璃卡（产品时刻）—— */
.product-stage {
  margin-top: 32rpx;
  padding: 26rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  box-shadow: 0 34rpx 90rpx rgba(10, 9, 6, 0.6);
  animation: stageLand 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes stageLand {
  from {
    opacity: 0;
    transform: translateY(46rpx) scale(0.97) rotateX(7deg);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1) rotateX(0);
  }
}

.product-stage.fx-hold {
  animation: none;
  opacity: 0;
}

.product-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.product-title {
  color: rgba(240, 237, 225, 0.9);
  font-size: 28rpx;
  line-height: 1.1;
  font-weight: 800;
}

.score-pill {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(127, 185, 157, 0.16);
  border: 1rpx solid rgba(127, 185, 157, 0.28);
  color: #7fb99d;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.score-pill.pop {
  animation: scorePop 480ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.answer-paper {
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.045);
  color: rgba(235, 231, 219, 0.85);
  font-size: 26rpx;
  line-height: 1.62;
  font-weight: 500;
}

.fx-pop {
  opacity: 0;
}

.answer-paper.fx-pop.on {
  animation: softIn 520ms ease both;
}

@keyframes softIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.mark,
.miss {
  display: inline;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  color: inherit;
  background: transparent;
}

.answer-paper.scan .mark {
  animation: markIn 480ms ease both;
}

.answer-paper.scan .miss {
  animation: missIn 480ms ease both;
}

@keyframes markIn {
  to {
    color: #7fb99d;
    background: rgba(127, 185, 157, 0.16);
  }
}

@keyframes missIn {
  to {
    color: #e2b264;
    background: rgba(201, 159, 61, 0.18);
  }
}

.point-row {
  min-height: 64rpx;
  margin-top: 14rpx;
  padding: 0 16rpx;
  border-radius: 18rpx;
  display: grid;
  grid-template-columns: 40rpx 1fr auto;
  align-items: center;
  gap: 14rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  animation: rowIn 540ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes rowIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.point-row.fx-hold {
  animation: none;
  opacity: 0;
}

.point-row.fx-hold .point-score {
  animation: none;
}

.point-tag {
  width: 38rpx;
  height: 38rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #101613;
  background: #7fb99d;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 900;
}

.point-row.warn .point-tag {
  color: #1d1204;
  background: #e2b264;
}

.point-text {
  min-width: 0;
  color: rgba(235, 231, 219, 0.85);
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 600;
}

.point-score {
  color: #7fb99d;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 18rpx rgba(127, 185, 157, 0.45);
  animation: scorePop 560ms cubic-bezier(0.16, 1, 0.3, 1) 240ms both;
}

.point-row.warn .point-score {
  color: #e2b264;
  text-shadow: 0 0 18rpx rgba(201, 159, 61, 0.4);
}

@keyframes scorePop {
  from {
    opacity: 0;
    transform: translateY(18rpx) scale(1.34);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* —— 幕 4: 错因闭环 —— */
.product-stage.fx-hold .weak-item {
  animation: none;
  opacity: 0;
}

.product-stage.fx-hold .weak-bar view {
  animation: none;
  width: 0 !important;
}

.weak-item {
  position: relative;
  padding: 18rpx 18rpx 30rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  animation: rowIn 540ms ease both;
}

.weak-title {
  color: rgba(235, 231, 219, 0.86);
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 700;
}

.weak-bar {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 14rpx;
  height: 6rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.14);
}

.weak-bar view {
  height: 100%;
  border-radius: inherit;
  background: #7fb99d;
  animation: barGrow 900ms cubic-bezier(0.22, 1, 0.36, 1) 180ms both;
}

@keyframes barGrow {
  from { width: 0; }
}

.task-box {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(207, 68, 54, 0.16), rgba(201, 159, 61, 0.12));
  border: 1rpx solid rgba(232, 200, 122, 0.24);
}

.task-box.fx-pop.on {
  animation: taskIn 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes taskIn {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.task-label {
  display: block;
  color: #e8c87a;
  font-size: 21rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.task-title {
  display: block;
  margin-top: 10rpx;
  color: #f0ede1;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 700;
}

/* —— 出场：星球本体作为转场载具——携弧光上升吞没屏幕，落入登录页夜空 —— */
.exiting .horizon {
  transform: translateX(-50%) translateY(-92vh) scale(1.3);
  /* 760ms 与 onboarding.js 的 EXIT_MS(800=760+40 余量) 绑定；改任一处必须同步另一处 */
  transition: transform 760ms cubic-bezier(0.45, 0, 0.2, 1);
}

.exiting .horizon-halo {
  opacity: 1;
}

.exiting .page-shell {
  opacity: 0;
  transition: opacity 340ms ease;
}

.exiting .dawn {
  opacity: 0;
  transition: opacity 500ms ease;
}

/* —— 行动区 —— */
.bottom-actions {
  margin-top: auto;
  padding-top: 16rpx;
  display: flex;
  align-items: center;
}

.primary-btn {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0ede1;
  box-shadow: 0 24rpx 60rpx rgba(207, 68, 54, 0.28);
}

.primary-btn.fx-pop.on {
  animation: taskIn 560ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.primary-text {
  color: #26241f;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.primary-btn:active {
  transform: scale(0.985);
}

/* —— 右下角浮动跳过 —— */
.skip-float {
  position: fixed;
  right: 38rpx;
  z-index: 70;
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  box-shadow: 0 10rpx 28rpx rgba(10, 9, 6, 0.4);
}

.skip-float text {
  color: rgba(240, 237, 225, 0.72);
  font-size: 24rpx;
  line-height: 1;
  font-weight: 600;
}

.skip-float:active {
  transform: scale(0.96);
}

/* —— 小屏适配 —— */
@media (max-height: 760px) {
  .roller-word text {
    font-size: 76rpx;
  }

  .rise-char {
    font-size: 64rpx;
  }

  .title-char {
    font-size: 52rpx;
  }

  .hook-stage,
  .act-stage {
    padding-bottom: 80rpx;
  }

  .product-stage {
    padding: 20rpx;
  }
}
