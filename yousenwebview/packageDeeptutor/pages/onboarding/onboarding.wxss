/* onboarding.wxss — 「先体验导学」白昼青蓝 · 电影感 motion 设计系统（视频2 配色同源）
   语言：白底 + 底部青蓝辉光 + 胶片颗粒 + 垂直词轮播 + 宋体逐字 mask-rise + 品牌蓝点亮
   节奏：文字幕 Apple 式慢而准；判分弹分 Nike 式蓄力爆发
   红线：补间只用 transform/opacity（小面积文字高亮的颜色动画除外） */

.onboarding-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  color: #0b1f3a;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 55%, #eef7ff 100%);
}

/* —— 背景：底部青蓝辉光 + 轻极光 + 颗粒 —— */
.aurora {
  position: fixed;
  pointer-events: none;
}

.a1 {
  width: 760rpx;
  height: 760rpx;
  top: -300rpx;
  left: -280rpx;
  opacity: 0.5;
  background: radial-gradient(circle, rgba(56, 182, 255, 0.14) 0%, rgba(56, 182, 255, 0.05) 40%, transparent 66%);
  animation: drift1 18s ease-in-out infinite alternate;
}

.a2 {
  left: -22%;
  right: -22%;
  bottom: -34%;
  height: 86%;
  width: auto;
  opacity: 0.9;
  background: radial-gradient(ellipse at 50% 100%, rgba(31, 143, 255, 0.5) 0%, rgba(86, 182, 255, 0.3) 36%, rgba(160, 216, 255, 0.14) 58%, transparent 78%);
  animation: glowBreathe 9s ease-in-out infinite alternate;
}

.a3 {
  width: 700rpx;
  height: 700rpx;
  top: 30%;
  right: -360rpx;
  opacity: 0.4;
  background: radial-gradient(circle, rgba(31, 143, 255, 0.1) 0%, transparent 62%);
  animation: drift3 24s ease-in-out infinite alternate;
}

@keyframes drift1 {
  to { transform: translate3d(110rpx, 70rpx, 0) scale(1.12); }
}

@keyframes glowBreathe {
  to { transform: translateY(-40rpx) scale(1.05); opacity: 1; }
}

@keyframes drift3 {
  to { transform: translate3d(-130rpx, 60rpx, 0) scale(1.06); }
}

.grain {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  opacity: 0.04;
  background-image: url("data:image/png;base64,");
  background-size: 110rpx 110rpx;
}

/* —— 骨架 —— */
.page-shell {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding-left: 38rpx;
  padding-right: 38rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.topbar {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-mark {
  width: 56rpx;
  height: 56rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  background: #0b1f3a;
  box-sizing: border-box;
  box-shadow: 0 14rpx 30rpx rgba(11, 31, 58, 0.16);
}

.brand-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.05;
  font-weight: 800;
  color: #0b1f3a;
}

.brand-sub {
  display: block;
  margin-top: 5rpx;
  color: rgba(11, 31, 58, 0.45);
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 0.08em;
}

.skip-btn {
  min-width: 76rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(11, 31, 58, 0.08);
}

.skip-text {
  color: rgba(11, 31, 58, 0.55);
  font-size: 24rpx;
  font-weight: 600;
}

.progress-row {
  height: 34rpx;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-pill {
  width: 34rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(11, 31, 58, 0.12);
  transition: width 320ms ease, background 320ms ease;
}

.progress-pill.on {
  background: rgba(31, 143, 255, 0.45);
}

.progress-pill.current {
  width: 72rpx;
  background: #1f8fff;
}

/* —— 幕 1: 垂直词轮播（视频2 语言）—— */
.hook-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 140rpx;
}

.roller {
  position: relative;
  height: 450rpx;
  overflow: hidden;
  opacity: 0;
}

.hook-stage.play .roller {
  animation: softIn 620ms ease both;
}

.roller-track {
  display: flex;
  flex-direction: column;
  transition: transform 540ms cubic-bezier(0.22, 1, 0.36, 1);
}

.roller-word {
  height: 150rpx;
  display: flex;
  align-items: center;
}

.roller-word text {
  font-size: 96rpx;
  font-weight: 900;
  line-height: 1;
  color: rgba(11, 31, 58, 0.12);
  letter-spacing: 0.02em;
  transform: scale(0.94);
  transform-origin: left center;
  transition: color 440ms ease, transform 440ms cubic-bezier(0.22, 1, 0.36, 1), text-shadow 440ms ease;
}

.roller-word.cur text {
  color: #0b1f3a;
  transform: scale(1);
}

.roller-word.final text {
  color: #1f8fff;
  text-shadow: 0 0 34rpx rgba(31, 143, 255, 0.32);
}

.roller-fade-top,
.roller-fade-bottom {
  position: absolute;
  left: 0;
  right: 0;
  height: 132rpx;
  pointer-events: none;
}

.roller-fade-top {
  top: 0;
  background: linear-gradient(180deg, #ffffff, rgba(255, 255, 255, 0));
}

.roller-fade-bottom {
  bottom: 0;
  background: linear-gradient(0deg, #ffffff, rgba(255, 255, 255, 0));
}

/* —— 逐字 mask-rise（幕 2/3 标题与 CTA）—— */
.rise-line {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  overflow: hidden;
  padding-bottom: 8rpx;
}

.rise-char {
  display: block;
  opacity: 0;
  transform: translateY(112%);
  font-family: "Songti SC", "STSong", "Source Han Serif SC", serif;
  font-weight: 900;
  color: #0b1f3a;
  font-size: 82rpx;
  line-height: 1.22;
  letter-spacing: 0.01em;
}

.play .rise-char {
  animation: charRise 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes charRise {
  from {
    opacity: 0;
    transform: translateY(112%);
  }
  55% {
    opacity: 1;
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.rise-char.is-accent {
  color: #1f8fff;
  text-shadow: 0 0 30rpx rgba(31, 143, 255, 0.25);
}

/* —— 幕 2/3 容器 —— */
.act-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 110rpx;
}

.story-copy {
  min-height: 200rpx;
}

.scene-kicker {
  display: flex;
  align-items: center;
  gap: 16rpx;
  opacity: 0;
  margin-bottom: 22rpx;
}

.scene-kicker::before {
  content: "";
  width: 46rpx;
  height: 2rpx;
  background: linear-gradient(90deg, #1f8fff, rgba(31, 143, 255, 0));
}

.scene-kicker text {
  color: rgba(11, 31, 58, 0.5);
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 0.22em;
}

.story-copy.play .scene-kicker,
.cta-stage.play .scene-kicker {
  animation: kickIn 640ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes kickIn {
  from {
    opacity: 0;
    transform: translateX(-22rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.title-char {
  font-size: 64rpx;
}

/* —— 白色悬浮卡（产品时刻）—— */
.product-stage {
  margin-top: 38rpx;
  padding: 26rpx;
  border-radius: 30rpx;
  background: #ffffff;
  border: 1rpx solid rgba(11, 31, 58, 0.06);
  box-shadow: 0 30rpx 80rpx rgba(31, 108, 255, 0.12);
  animation: stageLand 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes stageLand {
  from {
    opacity: 0;
    transform: translateY(46rpx) scale(0.97) rotateX(7deg);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1) rotateX(0);
  }
}

.product-stage.fx-hold {
  animation: none;
  opacity: 0;
}

.product-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.product-title {
  color: #0b1f3a;
  font-size: 28rpx;
  line-height: 1.1;
  font-weight: 800;
}

.score-pill {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(31, 143, 255, 0.1);
  border: 1rpx solid rgba(31, 143, 255, 0.18);
  color: #1271d8;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.score-pill.pop {
  animation: scorePop 480ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.answer-paper {
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(11, 31, 58, 0.035);
  color: rgba(11, 31, 58, 0.78);
  font-size: 26rpx;
  line-height: 1.62;
  font-weight: 500;
}

.fx-pop {
  opacity: 0;
}

.answer-paper.fx-pop.on {
  animation: softIn 520ms ease both;
}

@keyframes softIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.mark,
.miss {
  display: inline;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  color: inherit;
  background: transparent;
}

.answer-paper.scan .mark {
  animation: markIn 480ms ease both;
}

.answer-paper.scan .miss {
  animation: missIn 480ms ease both;
}

@keyframes markIn {
  to {
    color: #07705c;
    background: rgba(0, 168, 148, 0.14);
  }
}

@keyframes missIn {
  to {
    color: #94560a;
    background: rgba(242, 184, 73, 0.22);
  }
}

.point-row {
  min-height: 64rpx;
  margin-top: 14rpx;
  padding: 0 16rpx;
  border-radius: 18rpx;
  display: grid;
  grid-template-columns: 40rpx 1fr auto;
  align-items: center;
  gap: 14rpx;
  background: #f5faff;
  border: 1rpx solid rgba(11, 31, 58, 0.05);
  animation: rowIn 540ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes rowIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.point-row.fx-hold {
  animation: none;
  opacity: 0;
}

.point-row.fx-hold .point-score {
  animation: none;
}

.point-tag {
  width: 38rpx;
  height: 38rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #0fae8d;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 900;
}

.point-row.warn .point-tag {
  color: #4a2e00;
  background: #f2b849;
}

.point-text {
  min-width: 0;
  color: rgba(11, 31, 58, 0.82);
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 600;
}

.point-score {
  color: #0a9c80;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  animation: scorePop 560ms cubic-bezier(0.16, 1, 0.3, 1) 240ms both;
}

.point-row.warn .point-score {
  color: #b86a00;
}

@keyframes scorePop {
  from {
    opacity: 0;
    transform: translateY(18rpx) scale(1.34);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* —— 幕 3: 错因闭环 —— */
.product-stage.fx-hold .weak-item {
  animation: none;
  opacity: 0;
}

.product-stage.fx-hold .weak-bar view {
  animation: none;
  width: 0 !important;
}

.weak-item {
  position: relative;
  padding: 18rpx 18rpx 30rpx;
  border-radius: 20rpx;
  background: #f5faff;
  border: 1rpx solid rgba(11, 31, 58, 0.05);
  animation: rowIn 540ms ease both;
}

.weak-title {
  color: rgba(11, 31, 58, 0.84);
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 700;
}

.weak-bar {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 14rpx;
  height: 6rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(11, 31, 58, 0.08);
}

.weak-bar view {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #2f9bff, #38d3c6);
  animation: barGrow 900ms cubic-bezier(0.22, 1, 0.36, 1) 180ms both;
}

@keyframes barGrow {
  from { width: 0; }
}

.task-box {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(31, 143, 255, 0.1), rgba(56, 211, 198, 0.1));
  border: 1rpx solid rgba(31, 143, 255, 0.14);
}

.task-box.fx-pop.on {
  animation: taskIn 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes taskIn {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.task-label {
  display: block;
  color: #1271d8;
  font-size: 21rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.task-title {
  display: block;
  margin-top: 10rpx;
  color: #0b1f3a;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 700;
}

/* —— 幕 4: CTA —— */
.cta-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 40rpx;
}

.cta-kicker {
  margin-bottom: 26rpx;
}

.cta-char {
  font-size: 84rpx;
  line-height: 1.18;
}

/* —— 转场色浪（青蓝，视频2 冲刷色）—— */
.wave-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: -6%;
  bottom: -6%;
  z-index: 60;
  pointer-events: none;
  background: linear-gradient(180deg, #0e63c8 0%, #3aa0ff 32%, #9bd6ff 68%, #eaf7ff 100%);
}

.wave-overlay.recede {
  animation: waveOff 680ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

@keyframes waveOff {
  to { transform: translateY(-112%); }
}

/* —— 行动区 —— */
.bottom-actions {
  margin-top: auto;
  padding-top: 16rpx;
  display: flex;
  align-items: center;
}

.primary-btn {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(100deg, #5ab2ff 0%, #1f8fff 100%);
  box-shadow: 0 22rpx 54rpx rgba(31, 143, 255, 0.35);
}

.primary-btn.fx-pop.on {
  animation: taskIn 560ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.primary-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.login-link {
  align-self: center;
  min-height: 42rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-link.fx-pop.on {
  animation: softIn 460ms ease 140ms both;
}

.login-link-text {
  color: rgba(11, 31, 58, 0.5);
  font-size: 24rpx;
  font-weight: 600;
}

.primary-btn:active,
.skip-btn:active,
.login-link:active {
  transform: scale(0.985);
}

/* —— 小屏适配 —— */
@media (max-height: 760px) {
  .roller-word text {
    font-size: 76rpx;
  }

  .rise-char {
    font-size: 64rpx;
  }

  .title-char {
    font-size: 52rpx;
  }

  .cta-char {
    font-size: 66rpx;
  }

  .hook-stage,
  .act-stage {
    padding-bottom: 80rpx;
  }

  .product-stage {
    padding: 20rpx;
  }
}
