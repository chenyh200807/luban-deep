/* onboarding.wxss — 「先体验导学」深夜蓝黑 · 电影感 motion 设计系统
   语言：aurora 极光慢漂 + 细颗粒 grain + 宋体大字逐字 mask-rise + 金色辉光关键词
   节奏：文字幕 Apple 式慢而准；判分弹分 Nike 式蓄力爆发
   红线：补间只用 transform/opacity（小面积文字高亮的颜色动画除外） */

.onboarding-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  color: #f2f5fb;
  background: linear-gradient(180deg, #0d1633 0%, #0a1228 42%, #070d1d 100%);
}

/* —— 背景：极光 + 颗粒 —— */
.aurora {
  position: fixed;
  width: 920rpx;
  height: 920rpx;
  pointer-events: none;
  opacity: 0.6;
}

.a1 {
  top: -260rpx;
  left: -280rpx;
  background: radial-gradient(circle, rgba(58, 110, 255, 0.5) 0%, rgba(58, 110, 255, 0.16) 38%, transparent 66%);
  animation: drift1 16s ease-in-out infinite alternate;
}

.a2 {
  bottom: -340rpx;
  right: -320rpx;
  background: radial-gradient(circle, rgba(0, 201, 167, 0.34) 0%, rgba(0, 201, 167, 0.1) 40%, transparent 68%);
  animation: drift2 20s ease-in-out infinite alternate;
}

.a3 {
  top: 30%;
  right: -380rpx;
  background: radial-gradient(circle, rgba(232, 181, 77, 0.2) 0%, rgba(232, 181, 77, 0.06) 38%, transparent 64%);
  animation: drift3 24s ease-in-out infinite alternate;
}

@keyframes drift1 {
  to { transform: translate3d(130rpx, 90rpx, 0) scale(1.18); }
}

@keyframes drift2 {
  to { transform: translate3d(-110rpx, -120rpx, 0) scale(1.12); }
}

@keyframes drift3 {
  to { transform: translate3d(-150rpx, 60rpx, 0) scale(1.08); }
}

.grain {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  opacity: 0.05;
  background-image: url("data:image/png;base64,");
  background-size: 110rpx 110rpx;
}

/* —— 骨架 —— */
.page-shell {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding-left: 38rpx;
  padding-right: 38rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.topbar {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-mark {
  width: 56rpx;
  height: 56rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
}

.brand-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.05;
  font-weight: 800;
  color: #f2f5fb;
}

.brand-sub {
  display: block;
  margin-top: 5rpx;
  color: rgba(208, 222, 248, 0.5);
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 0.08em;
}

.skip-btn {
  min-width: 76rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.skip-text {
  color: rgba(220, 232, 252, 0.62);
  font-size: 24rpx;
  font-weight: 600;
}

.progress-row {
  height: 34rpx;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-pill {
  width: 34rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  transition: width 320ms ease, background 320ms ease;
}

.progress-pill.on {
  background: rgba(138, 176, 255, 0.55);
}

.progress-pill.current {
  width: 72rpx;
  background: #e8b54d;
}

/* —— 逐字 mask-rise（电影标题语言）—— */
.rise-line {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  overflow: hidden;
  padding-bottom: 8rpx;
}

.rise-char {
  display: block;
  opacity: 0;
  transform: translateY(112%);
  font-family: "Songti SC", "STSong", "Source Han Serif SC", serif;
  font-weight: 900;
  color: #f2f5fb;
  font-size: 82rpx;
  line-height: 1.22;
  letter-spacing: 0.01em;
}

.play .rise-char {
  animation: charRise 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes charRise {
  from {
    opacity: 0;
    transform: translateY(112%);
  }
  55% {
    opacity: 1;
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.rise-char.is-accent {
  color: #f2f5fb;
}

/* 关键词点金：升起完成后整词辉光浮起（Nike 式蓄力→爆发的「点睛」） */
.accent-on .rise-char.is-accent {
  color: #e8b54d;
  text-shadow: 0 0 28rpx rgba(232, 181, 77, 0.4);
  animation: accentGlow 860ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes accentGlow {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  45% {
    transform: translateY(-6rpx) scale(1.1);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1.04);
  }
}

/* —— 幕 1: Hook —— */
.hook-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 140rpx;
}

/* —— 幕 2/3 容器 —— */
.act-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 110rpx;
}

.story-copy {
  min-height: 200rpx;
}

.scene-kicker {
  display: flex;
  align-items: center;
  gap: 16rpx;
  opacity: 0;
  margin-bottom: 22rpx;
}

.scene-kicker::before {
  content: "";
  width: 46rpx;
  height: 2rpx;
  background: linear-gradient(90deg, #e8b54d, rgba(232, 181, 77, 0));
}

.scene-kicker text {
  color: rgba(170, 196, 255, 0.66);
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 0.22em;
}

.story-copy.play .scene-kicker,
.cta-stage.play .scene-kicker {
  animation: kickIn 640ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes kickIn {
  from {
    opacity: 0;
    transform: translateX(-22rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.title-char {
  font-size: 64rpx;
}

/* —— 深色玻璃卡（产品时刻）—— */
.product-stage {
  margin-top: 38rpx;
  padding: 26rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 34rpx 90rpx rgba(2, 6, 18, 0.55);
  animation: stageLand 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes stageLand {
  from {
    opacity: 0;
    transform: translateY(46rpx) scale(0.97) rotateX(7deg);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1) rotateX(0);
  }
}

.product-stage.fx-hold {
  animation: none;
  opacity: 0;
}

.product-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.product-title {
  color: rgba(228, 238, 252, 0.85);
  font-size: 28rpx;
  line-height: 1.1;
  font-weight: 800;
}

.score-pill {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 201, 167, 0.14);
  border: 1rpx solid rgba(0, 201, 167, 0.22);
  color: #6fe3c2;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.score-pill.pop {
  animation: scorePop 480ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.answer-paper {
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  color: rgba(222, 232, 246, 0.8);
  font-size: 26rpx;
  line-height: 1.62;
  font-weight: 500;
}

.fx-pop {
  opacity: 0;
}

.answer-paper.fx-pop.on {
  animation: softIn 520ms ease both;
}

@keyframes softIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.mark,
.miss {
  display: inline;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  color: inherit;
  background: transparent;
}

.answer-paper.scan .mark {
  animation: markIn 480ms ease both;
}

.answer-paper.scan .miss {
  animation: missIn 480ms ease both;
}

@keyframes markIn {
  to {
    color: #6fe3c2;
    background: rgba(0, 201, 167, 0.16);
  }
}

@keyframes missIn {
  to {
    color: #f0b15c;
    background: rgba(232, 148, 58, 0.16);
  }
}

.point-row {
  min-height: 64rpx;
  margin-top: 14rpx;
  padding: 0 16rpx;
  border-radius: 18rpx;
  display: grid;
  grid-template-columns: 40rpx 1fr auto;
  align-items: center;
  gap: 14rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  animation: rowIn 540ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes rowIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.point-row.fx-hold {
  animation: none;
  opacity: 0;
}

.point-row.fx-hold .point-score {
  animation: none;
}

.point-tag {
  width: 38rpx;
  height: 38rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #04110d;
  background: #2bd4ab;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 900;
}

.point-row.warn .point-tag {
  color: #1d1204;
  background: #e8a64d;
}

.point-text {
  min-width: 0;
  color: rgba(226, 235, 248, 0.84);
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 600;
}

.point-score {
  color: #6fe3c2;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 18rpx rgba(43, 212, 171, 0.45);
  animation: scorePop 560ms cubic-bezier(0.16, 1, 0.3, 1) 240ms both;
}

.point-row.warn .point-score {
  color: #f0b15c;
  text-shadow: 0 0 18rpx rgba(232, 166, 77, 0.4);
}

@keyframes scorePop {
  from {
    opacity: 0;
    transform: translateY(18rpx) scale(1.34);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* —— 幕 3: 错因闭环 —— */
.product-stage.fx-hold .weak-item {
  animation: none;
  opacity: 0;
}

.product-stage.fx-hold .weak-bar view {
  animation: none;
  width: 0 !important;
}

.weak-item {
  position: relative;
  padding: 18rpx 18rpx 30rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  animation: rowIn 540ms ease both;
}

.weak-title {
  color: rgba(226, 235, 248, 0.86);
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 700;
}

.weak-bar {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 14rpx;
  height: 6rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.1);
}

.weak-bar view {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #3a6eff, #00c9a7);
  animation: barGrow 900ms cubic-bezier(0.22, 1, 0.36, 1) 180ms both;
}

@keyframes barGrow {
  from { width: 0; }
}

.task-box {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(58, 110, 255, 0.14), rgba(0, 201, 167, 0.12));
  border: 1rpx solid rgba(120, 160, 255, 0.16);
}

.task-box.fx-pop.on {
  animation: taskIn 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes taskIn {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.task-label {
  display: block;
  color: #8ab0ff;
  font-size: 21rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.task-title {
  display: block;
  margin-top: 10rpx;
  color: #f2f5fb;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 700;
}

/* —— 幕 4: CTA —— */
.cta-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 40rpx;
}

.cta-kicker {
  margin-bottom: 26rpx;
}

.cta-char {
  font-size: 84rpx;
  line-height: 1.18;
}

.cta-char.is-accent {
  color: #e8b54d;
  text-shadow: 0 0 30rpx rgba(232, 181, 77, 0.35);
}

/* —— 转场色浪（与登录页 guest-wave 同一渐变语言）—— */
.wave-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: -6%;
  bottom: -6%;
  z-index: 60;
  pointer-events: none;
  background: linear-gradient(180deg, #f7c96b 0%, #5aa2ff 38%, #2a63ff 72%, #0b2a66 100%);
}

.wave-overlay.recede {
  animation: waveOff 680ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

@keyframes waveOff {
  to { transform: translateY(-112%); }
}

/* —— 行动区 —— */
.bottom-actions {
  margin-top: auto;
  padding-top: 16rpx;
  display: flex;
  align-items: center;
}

.primary-btn {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(100deg, #f2c866 0%, #79b4ff 46%, #2474ff 100%);
  box-shadow: 0 22rpx 54rpx rgba(36, 116, 255, 0.32);
}

.primary-btn.fx-pop.on {
  animation: taskIn 560ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.primary-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.login-link {
  align-self: center;
  min-height: 42rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-link.fx-pop.on {
  animation: softIn 460ms ease 140ms both;
}

.login-link-text {
  color: rgba(208, 222, 248, 0.55);
  font-size: 24rpx;
  font-weight: 600;
}

.primary-btn:active,
.skip-btn:active,
.login-link:active {
  transform: scale(0.985);
}

/* —— 小屏适配 —— */
@media (max-height: 760px) {
  .rise-char {
    font-size: 64rpx;
  }

  .title-char {
    font-size: 52rpx;
  }

  .cta-char {
    font-size: 66rpx;
  }

  .hook-stage,
  .act-stage {
    padding-bottom: 80rpx;
  }

  .product-stage {
    padding: 20rpx;
  }
}
