/* onboarding.wxss — 「先体验导学」黎明将至 · Light is coming 设计系统
   世界观：与登录页/正式主页同族的深夜宇宙；地平线光弧（bolt.new 式）随页面推进
   缓缓上升、天际黎明光逐页升温——黑夜将明 = 备考上岸的隐喻。
   节奏：文字幕 Apple 式慢而准；判分弹分 Nike 式蓄力爆发。
   红线：补间只用 transform/opacity（小面积文字高亮的颜色动画除外）。 */

.onboarding-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  color: #f2f6ff;
  background: linear-gradient(180deg, #04081a 0%, #081127 52%, #0d1633 100%);
}

/* —— 天际黎明光：每页一种色温，交叉淡入 + 涌入动势 —— */
.dawn {
  position: fixed;
  left: -30%;
  right: -30%;
  bottom: -6%;
  height: 92%;
  pointer-events: none;
  opacity: 0;
  transform: translateY(7%) scale(1.06);
  transition: opacity 1100ms ease, transform 1100ms cubic-bezier(0.22, 1, 0.36, 1);
}

.dawn-hook {
  background: radial-gradient(ellipse at 50% 100%, rgba(64, 124, 230, 0.4) 0%, rgba(52, 102, 200, 0.2) 36%, transparent 64%);
}

.dawn-p1 {
  background: radial-gradient(ellipse at 50% 100%, rgba(72, 150, 255, 0.52) 0%, rgba(58, 120, 230, 0.26) 38%, transparent 66%);
}

.dawn-p2 {
  background: radial-gradient(ellipse at 50% 100%, rgba(56, 186, 232, 0.55) 0%, rgba(48, 140, 220, 0.26) 38%, transparent 66%);
}

.dawn-p3 {
  background: radial-gradient(ellipse at 50% 100%, rgba(168, 214, 255, 0.6) 0%, rgba(96, 168, 250, 0.3) 36%, transparent 66%);
}

.act-wave .dawn-hook,
.act-hook .dawn-hook,
.act-p1 .dawn-p1,
.act-p2 .dawn-p2,
.act-p3 .dawn-p3 {
  opacity: 1;
  transform: translateY(0) scale(1);
}

/* —— 地平线光弧（bolt.new 式）：黑色星球上缘一道白心蓝晕弧光 —— */
.horizon-glow,
.horizon-body {
  position: fixed;
  left: 50%;
  top: 82vh;
  width: 2700rpx;
  height: 2700rpx;
  border-radius: 50%;
  pointer-events: none;
  transform: translateX(-50%);
  transition: transform 1100ms cubic-bezier(0.22, 1, 0.36, 1);
}

.horizon-glow {
  box-shadow:
    0 -4rpx 18rpx 2rpx rgba(240, 248, 255, 0.85),
    0 -18rpx 70rpx 10rpx rgba(130, 190, 255, 0.55),
    0 -50rpx 180rpx 30rpx rgba(64, 130, 240, 0.3);
  opacity: 0.55;
  animation: horizonBreathe 4600ms ease-in-out infinite alternate;
}

@keyframes horizonBreathe {
  to { opacity: 1; }
}

.horizon-body {
  background: #02060f;
}

/* 光弧随页面推进上升：黑夜将明 */
.act-p1 .horizon-glow,
.act-p1 .horizon-body {
  transform: translateX(-50%) translateY(-3vh);
}

.act-p2 .horizon-glow,
.act-p2 .horizon-body {
  transform: translateX(-50%) translateY(-6vh);
}

.act-p3 .horizon-glow,
.act-p3 .horizon-body {
  transform: translateX(-50%) translateY(-9vh);
}

.act-p2 .horizon-glow {
  opacity: 0.75;
}

.act-p3 .horizon-glow {
  opacity: 0.95;
}

.grain {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  opacity: 0.06;
  background-image: url("data:image/png;base64,");
  background-size: 110rpx 110rpx;
}

/* —— 入场夜幕：进入瞬间全暗，随即拉开 —— */
.night-veil {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  pointer-events: none;
  background: #02060f;
  opacity: 1;
}

.night-veil.lift {
  animation: veilLift 760ms ease both;
}

@keyframes veilLift {
  to { opacity: 0; }
}

/* —— 骨架 —— */
.page-shell {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding-left: 38rpx;
  padding-right: 38rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.topbar {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-mark {
  width: 56rpx;
  height: 56rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.09);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-sizing: border-box;
}

.brand-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.05;
  font-weight: 800;
  color: #f2f6ff;
}

.brand-sub {
  display: block;
  margin-top: 5rpx;
  color: rgba(205, 222, 250, 0.55);
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 0.08em;
}

.progress-row {
  height: 34rpx;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-pill {
  width: 34rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  transition: width 320ms ease, background 320ms ease;
}

.progress-pill.on {
  background: rgba(143, 194, 255, 0.6);
}

.progress-pill.current {
  width: 72rpx;
  background: #8fc2ff;
}

/* —— 幕 1: 垂直词轮播 → 品牌宣言 —— */
.hook-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.roller-zone {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.roller {
  position: relative;
  height: 450rpx;
  overflow: hidden;
  opacity: 0;
}

.hook-stage.play .roller {
  animation: softIn 620ms ease both;
}

.roller-track {
  display: flex;
  flex-direction: column;
  transition: transform 540ms cubic-bezier(0.22, 1, 0.36, 1);
}

.roller-word {
  height: 150rpx;
  display: flex;
  align-items: center;
}

.roller-word text {
  font-size: 96rpx;
  font-weight: 900;
  line-height: 1;
  color: rgba(255, 255, 255, 0.14);
  letter-spacing: 0.02em;
  transform: scale(0.94);
  transform-origin: left center;
  transition: color 440ms ease, transform 440ms cubic-bezier(0.22, 1, 0.36, 1), text-shadow 440ms ease;
}

.roller-word.cur text {
  color: #f2f6ff;
  transform: scale(1);
}

.roller-word.final text {
  color: #6db4ff;
  text-shadow: 0 0 36rpx rgba(109, 180, 255, 0.45);
}

/* 品牌宣言：坐在天际光上 */
.hook-brand {
  padding-bottom: 70rpx;
}

.hook-brand.fx-pop.on {
  animation: softIn 640ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.hook-brand-mark {
  width: 76rpx;
  height: 76rpx;
  padding: 14rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-sizing: border-box;
  box-shadow: 0 14rpx 36rpx rgba(2, 6, 18, 0.5);
}

.hook-brand-mark image {
  width: 100%;
  height: 100%;
}

.hook-brand-title {
  display: block;
  margin-top: 24rpx;
  color: #f2f6ff;
  font-family: "Songti SC", "STSong", "Source Han Serif SC", serif;
  font-size: 46rpx;
  line-height: 1.25;
  font-weight: 900;
}

.hook-brand-desc {
  display: block;
  margin-top: 14rpx;
  color: rgba(214, 228, 250, 0.66);
  font-size: 27rpx;
  line-height: 1.6;
  font-weight: 500;
}

/* —— 逐字 mask-rise —— */
.rise-line {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  overflow: hidden;
  padding-bottom: 8rpx;
}

.rise-char {
  display: block;
  opacity: 0;
  transform: translateY(112%);
  font-family: "Songti SC", "STSong", "Source Han Serif SC", serif;
  font-weight: 900;
  color: #f2f6ff;
  font-size: 82rpx;
  line-height: 1.22;
  letter-spacing: 0.01em;
}

.play .rise-char {
  animation: charRise 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes charRise {
  from {
    opacity: 0;
    transform: translateY(112%);
  }
  55% {
    opacity: 1;
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.rise-char.is-accent {
  color: #6db4ff;
  text-shadow: 0 0 32rpx rgba(109, 180, 255, 0.4);
}

/* —— 幕 2/3/4 容器 —— */
.act-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 110rpx;
}

.story-copy {
  min-height: 200rpx;
}

.scene-kicker {
  display: flex;
  align-items: center;
  gap: 16rpx;
  opacity: 0;
  margin-bottom: 22rpx;
}

.scene-kicker::before {
  content: "";
  width: 46rpx;
  height: 2rpx;
  background: linear-gradient(90deg, #6db4ff, rgba(109, 180, 255, 0));
}

.scene-kicker text {
  color: rgba(170, 200, 255, 0.7);
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 0.22em;
}

.story-copy.play .scene-kicker {
  animation: kickIn 640ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes kickIn {
  from {
    opacity: 0;
    transform: translateX(-22rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.title-char {
  font-size: 64rpx;
}

/* —— 说明与标签 —— */
.act-desc-wrap {
  margin-top: 30rpx;
}

.act-desc {
  display: block;
  color: rgba(214, 228, 250, 0.66);
  font-size: 27rpx;
  line-height: 1.66;
  font-weight: 500;
}

.act-desc-wrap.fx-pop.on {
  animation: softIn 560ms ease both;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 30rpx;
}

.tag {
  opacity: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.tag-row.on .tag {
  animation: tagPop 520ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.tag text {
  color: rgba(228, 238, 255, 0.78);
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 0.04em;
}

@keyframes tagPop {
  from {
    opacity: 0;
    transform: translateY(16rpx) scale(0.94);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* —— 深色玻璃卡（产品时刻）—— */
.product-stage {
  margin-top: 32rpx;
  padding: 26rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  box-shadow: 0 34rpx 90rpx rgba(2, 6, 18, 0.6);
  animation: stageLand 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes stageLand {
  from {
    opacity: 0;
    transform: translateY(46rpx) scale(0.97) rotateX(7deg);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1) rotateX(0);
  }
}

.product-stage.fx-hold {
  animation: none;
  opacity: 0;
}

.product-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.product-title {
  color: rgba(232, 240, 252, 0.88);
  font-size: 28rpx;
  line-height: 1.1;
  font-weight: 800;
}

.score-pill {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 201, 167, 0.16);
  border: 1rpx solid rgba(0, 201, 167, 0.26);
  color: #6fe3c2;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.score-pill.pop {
  animation: scorePop 480ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.answer-paper {
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.045);
  color: rgba(222, 232, 248, 0.82);
  font-size: 26rpx;
  line-height: 1.62;
  font-weight: 500;
}

.fx-pop {
  opacity: 0;
}

.answer-paper.fx-pop.on {
  animation: softIn 520ms ease both;
}

@keyframes softIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.mark,
.miss {
  display: inline;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  color: inherit;
  background: transparent;
}

.answer-paper.scan .mark {
  animation: markIn 480ms ease both;
}

.answer-paper.scan .miss {
  animation: missIn 480ms ease both;
}

@keyframes markIn {
  to {
    color: #6fe3c2;
    background: rgba(0, 201, 167, 0.16);
  }
}

@keyframes missIn {
  to {
    color: #f0b15c;
    background: rgba(232, 148, 58, 0.16);
  }
}

.point-row {
  min-height: 64rpx;
  margin-top: 14rpx;
  padding: 0 16rpx;
  border-radius: 18rpx;
  display: grid;
  grid-template-columns: 40rpx 1fr auto;
  align-items: center;
  gap: 14rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  animation: rowIn 540ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes rowIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.point-row.fx-hold {
  animation: none;
  opacity: 0;
}

.point-row.fx-hold .point-score {
  animation: none;
}

.point-tag {
  width: 38rpx;
  height: 38rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #04110d;
  background: #2bd4ab;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 900;
}

.point-row.warn .point-tag {
  color: #1d1204;
  background: #e8a64d;
}

.point-text {
  min-width: 0;
  color: rgba(226, 236, 250, 0.85);
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 600;
}

.point-score {
  color: #6fe3c2;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 18rpx rgba(43, 212, 171, 0.45);
  animation: scorePop 560ms cubic-bezier(0.16, 1, 0.3, 1) 240ms both;
}

.point-row.warn .point-score {
  color: #f0b15c;
  text-shadow: 0 0 18rpx rgba(232, 166, 77, 0.4);
}

@keyframes scorePop {
  from {
    opacity: 0;
    transform: translateY(18rpx) scale(1.34);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* —— 幕 4: 错因闭环 —— */
.product-stage.fx-hold .weak-item {
  animation: none;
  opacity: 0;
}

.product-stage.fx-hold .weak-bar view {
  animation: none;
  width: 0 !important;
}

.weak-item {
  position: relative;
  padding: 18rpx 18rpx 30rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  animation: rowIn 540ms ease both;
}

.weak-title {
  color: rgba(226, 236, 250, 0.86);
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 700;
}

.weak-bar {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 14rpx;
  height: 6rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.14);
}

.weak-bar view {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #3a8eff, #38d3c6);
  animation: barGrow 900ms cubic-bezier(0.22, 1, 0.36, 1) 180ms both;
}

@keyframes barGrow {
  from { width: 0; }
}

.task-box {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(58, 142, 255, 0.18), rgba(56, 211, 198, 0.14));
  border: 1rpx solid rgba(120, 170, 255, 0.2);
}

.task-box.fx-pop.on {
  animation: taskIn 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes taskIn {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.task-label {
  display: block;
  color: #8fc2ff;
  font-size: 21rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.task-title {
  display: block;
  margin-top: 10rpx;
  color: #f2f6ff;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 700;
}

/* —— 出场：破晓光浪从地平线涌起，淹没屏幕后落到登录页夜空 —— */
.cta-wave {
  position: fixed;
  left: 0;
  right: 0;
  top: -6%;
  bottom: -6%;
  z-index: 90;
  pointer-events: none;
  transform: translateY(104%);
  background:
    radial-gradient(ellipse at 50% 0%, rgba(244, 250, 255, 0.95) 0%, rgba(168, 210, 255, 0.85) 24%, rgba(61, 125, 255, 0.8) 52%, rgba(16, 33, 76, 0) 78%),
    linear-gradient(0deg, #0b1635 0%, #10214c 100%);
}

.cta-wave.play {
  animation: ctaWaveUp 460ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}

@keyframes ctaWaveUp {
  to {
    transform: translateY(0);
  }
}

/* —— 行动区 —— */
.bottom-actions {
  margin-top: auto;
  padding-top: 16rpx;
  display: flex;
  align-items: center;
}

.primary-btn {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  box-shadow: 0 24rpx 60rpx rgba(64, 130, 240, 0.35);
}

.primary-btn.fx-pop.on {
  animation: taskIn 560ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.primary-text {
  color: #0b1f3a;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.primary-btn:active {
  transform: scale(0.985);
}

/* —— 右下角浮动跳过 —— */
.skip-float {
  position: fixed;
  right: 38rpx;
  z-index: 70;
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  box-shadow: 0 10rpx 28rpx rgba(2, 6, 18, 0.4);
}

.skip-float text {
  color: rgba(232, 240, 255, 0.72);
  font-size: 24rpx;
  line-height: 1;
  font-weight: 600;
}

.skip-float:active {
  transform: scale(0.96);
}

/* —— 小屏适配 —— */
@media (max-height: 760px) {
  .roller-word text {
    font-size: 76rpx;
  }

  .rise-char {
    font-size: 64rpx;
  }

  .title-char {
    font-size: 52rpx;
  }

  .hook-stage,
  .act-stage {
    padding-bottom: 80rpx;
  }

  .product-stage {
    padding: 20rpx;
  }
}
