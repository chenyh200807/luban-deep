@import "/packageDeeptutor/styles/paper-ink.wxss";

/* register.wxss — 创建账号(纸墨朱竹单层,root 挂 paper light) */

.scene { height: 100vh; background-color: var(--pk-paper); background-image: radial-gradient(var(--pk-dot) 1.3rpx, transparent 1.3rpx); background-size: 34rpx 34rpx; position: relative; overflow: hidden; }
.page-shell { position: relative; z-index: 1; height: 100vh; display: flex; flex-direction: column; }
.sky-wash { position: fixed; top: -6%; left: -10%; right: -8%; height: 64vh; pointer-events: none; z-index: 0; background: radial-gradient(circle at 28% 14%, rgba(255, 253, 248, 0.9) 0%, rgba(201, 159, 61, 0.06) 30%, transparent 58%), radial-gradient(circle at 64% 18%, rgba(72, 128, 106, 0.07) 0%, transparent 56%), radial-gradient(circle at 78% 42%, rgba(207, 68, 54, 0.04) 0%, transparent 42%); }
.body { position: relative; z-index: 1; flex: 1; overflow-y: auto; }
.spacer { height: 16vh; min-height: 140rpx; }

.title-row { display: flex; align-items: center; gap: 18rpx; padding: 0 32rpx 0 48rpx; margin-bottom: 10rpx; }
.title-logo { height: 44rpx; width: 58rpx; padding: 9rpx; box-sizing: content-box; flex: 0 0 auto; display: block; background: var(--pk-red); border-radius: 14rpx; box-shadow: 0 6rpx 18rpx rgba(207, 68, 54, 0.26); }
.title-main { display: block; transform: translateY(2rpx); font-size: 46rpx; font-weight: 800; }
.headline { display: flex; align-items: baseline; gap: 8rpx; padding: 6rpx 32rpx 0 48rpx; line-height: 1.16; }
/* 类名沿革自旧深蓝版(h-white/h-blue);纸墨语义=墨字 + 书法朱红点睛 */
.h-white { color: var(--pk-t1); font-size: 58rpx; line-height: 1.16; font-weight: 800; letter-spacing: -1rpx; }
.h-blue { color: var(--pk-red); font-family: "Long Cang", "Kaiti SC", "STKaiti", "KaiTi", "楷体", cursive; font-size: 62rpx; line-height: 1.16; letter-spacing: 2rpx; }

.subtitle-wrap { padding: 14rpx 48rpx 0; }
.subtitle { font-size: 24rpx; line-height: 1.65; color: var(--pk-t2); }

.form { margin: 26rpx 32rpx 0; display: flex; flex-direction: column; gap: 16rpx; }
.inp-group { display: flex; align-items: center; min-height: 92rpx; border-radius: 20rpx; background: var(--pk-card); border: 1rpx solid var(--pk-bd); box-sizing: border-box; padding: 0 22rpx 0 0; box-shadow: 0 2rpx 8rpx var(--pk-shadow); }
.inp-icon { width: 104rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.inp-icon-tag { font-size: 22rpx; font-weight: 800; letter-spacing: 1rpx; color: var(--pk-t3); }
.inp { flex: 1; min-width: 0; height: 92rpx; font-size: 27rpx; color: var(--pk-t1); }
.ph { color: var(--pk-t3); }
.eye { flex-shrink: 0; padding: 8rpx 6rpx; }
.eye-txt { font-size: 22rpx; font-weight: 700; color: var(--pk-grn); }
.form-tip { padding: 2rpx 8rpx 0; }
.form-tip-txt { font-size: 22rpx; line-height: 1.5; color: var(--pk-t3); }

.notice-panel { margin: 22rpx 32rpx 0; padding: 22rpx 24rpx; border-radius: 24rpx; background: var(--pk-accent-soft); border: 1rpx solid var(--pk-accent-border); }
.notice-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 10rpx; }
.notice-kicker { font-size: 26rpx; font-weight: 800; color: var(--pk-t1); }
.notice-link { font-size: 23rpx; font-weight: 700; color: var(--pk-grn); }
.notice-intro { display: block; font-size: 22rpx; line-height: 1.55; color: var(--pk-t2); margin-bottom: 10rpx; }
.notice-list { display: flex; flex-direction: column; gap: 10rpx; }
.notice-item { display: flex; align-items: flex-start; gap: 12rpx; }
.notice-dot { flex: 0 0 10rpx; width: 10rpx; height: 10rpx; margin-top: 12rpx; border-radius: 50%; background: var(--pk-grn); }
.notice-text { flex: 1; font-size: 22rpx; line-height: 1.6; color: var(--pk-t2); }

.action-panel { padding: 26rpx 32rpx 0; }
.err { margin-bottom: 18rpx; padding: 12rpx 20rpx; background: rgba(194, 101, 85, 0.1); border: 1rpx solid rgba(194, 101, 85, 0.3); border-radius: 14rpx; }
.err-txt { display: block; text-align: center; font-size: 23rpx; color: var(--pk-warn); }

.btn-main { width: 100%; height: 96rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; border: none; border-radius: 22rpx; background: var(--pk-ink-btn); box-shadow: 0 8rpx 20rpx var(--pk-shadow); }
.btn-main::after { border: none; }
.btn-main:active { transform: scale(0.985); opacity: 0.92; }
.btn-main.off { opacity: 0.55; }
.btn-main-full { width: 100%; }
.btn-txt { font-size: 28rpx; font-weight: 800; letter-spacing: 2rpx; color: var(--pk-ink-btn-t); }

.foot { margin-top: 22rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.foot-muted { font-size: 23rpx; color: var(--pk-t3); }
.foot-link { font-size: 23rpx; font-weight: 700; color: var(--pk-grn); }
.scroll-safe-space { height: 80rpx; }

/* ── 夜宣纸:天光暗态收口 ── */
.scene.paper:not(.light) .sky-wash { opacity: 0.35; }
