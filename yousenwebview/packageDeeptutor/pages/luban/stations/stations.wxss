@import "/packageDeeptutor/theme.wxss";

.luban-page {
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
  overflow: hidden;
}

.lb-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: rgba(10, 10, 10, 0.92);
  border-bottom: 1rpx solid var(--border);
}

.lb-nav-inner {
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 0;
  gap: 16rpx;
}

.lb-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: 20rpx;
  padding: 8rpx 12rpx 8rpx 4rpx;
  border-radius: 8rpx;
}

.lb-back:active {
  background: rgba(255, 255, 255, 0.08);
}

.lb-back-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: #818cf8;
  font-weight: 300;
  margin-top: -4rpx;
}

.lb-back-text {
  font-size: 28rpx;
  color: #818cf8;
  font-weight: 500;
}

.lb-nav-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.lb-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  overflow-y: auto;
}

.lb-inner {
  padding: 28rpx 24rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.lb-hero,
.lb-station-card,
.lb-empty,
.lb-error {
  border-radius: 22rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  background: rgba(15, 23, 42, 0.62);
}

.lb-hero {
  padding: 28rpx 24rpx;
  background:
    radial-gradient(circle at top right, rgba(56, 189, 248, 0.18), transparent 36%),
    linear-gradient(145deg, rgba(14, 165, 233, 0.18), rgba(5, 150, 105, 0.12), rgba(15, 23, 42, 0.72));
}

.lb-kicker {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #7dd3fc;
}

.lb-title {
  display: block;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 850;
  color: #fff;
}

.lb-station-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
}

.lb-station-card:active {
  background: rgba(30, 41, 59, 0.85);
}

.lb-station-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.lb-station-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.lb-station-id {
  font-size: 22rpx;
  color: var(--text-muted);
}

.lb-station-arrow {
  font-size: 44rpx;
  color: #818cf8;
  font-weight: 300;
}

.lb-loading,
.lb-empty {
  padding: 40rpx 24rpx;
  text-align: center;
}

.lb-loading-text,
.lb-empty text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.lb-error {
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 26rpx;
  color: #fca5a5;
}

.lb-retry {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(129, 140, 248, 0.18);
  color: #a5b4fc;
  font-size: 26rpx;
  font-weight: 600;
}
