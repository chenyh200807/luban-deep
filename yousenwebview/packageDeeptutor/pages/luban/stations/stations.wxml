<!-- 提分路线 · 纸墨朱竹书法海报路线图(五模块第 10 轮定稿) -->
<view class="paper {{isDark ? '' : 'light'}} sr-page pk-paper-bg">
  <view class="sr-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="sr-nav-inner">
      <view class="sr-back" bindtap="goBack">
        <text class="sr-back-arrow">‹</text>
        <text class="sr-back-text">返回</text>
      </view>
      <text class="sr-nav-title">提分路线</text>
    </view>
  </view>

  <scroll-view class="sr-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="top: {{navHeight}}px">
    <view class="sr-inner">
      <view class="sr-hero">
        <text class="pk-kicker">鲁班学习双轮</text>
        <text class="sr-title">你的提分路线 · 每天走一站</text>
        <text class="sr-lit">已点亮 {{litCount}} / {{packUniverse}} 站</text>
      </view>

      <view class="sr-error" wx:if="{{errorText}}">
        <text>{{errorText}}</text>
        <view class="sr-retry pk-btn-ghost" bindtap="retry">重试</view>
      </view>

      <view class="sr-loading" wx:if="{{loading}}">
        <text class="sr-loading-text">正在为你铺路…</text>
      </view>

      <block wx:if="{{!loading && !errorText}}">
        <!-- 书法海报网格三态 -->
        <view class="sr-grid" wx:if="{{posters.length}}">
          <view
            wx:for="{{posters}}"
            wx:key="pack_id"
            class="pk-poster pk-poster--{{item.state}} sr-poster"
            bindtap="openStation"
            data-pack-id="{{item.pack_id}}"
            data-green="{{item.green}}"
          >
            <text class="pk-poster__name">{{item.name}}</text>
            <view class="pk-poster__slot sr-slot--{{item.state}}">{{item.slot}}</view>
            <view class="pk-poster__foot">
              <text class="sr-tag sr-tag--{{item.state}}">{{item.recommended ? '匹配薄弱' : (item.state === 'ink' ? '已学完' : (item.locked ? '会员解锁' : '未学'))}}</text>
              <!-- 副标题:考点卡首卡 front 真源;无卡的站留空(fail-closed) -->
              <text wx:if="{{item.subtitle}}" class="pk-poster__sub">{{item.subtitle}}</text>
            </view>
            <view class="pk-poster__bar"></view>
          </view>
        </view>

        <view class="sr-empty" wx:if="{{!posters.length}}">
          <text>站点正在建设中,很快就能开走第一站。</text>
        </view>
      </block>

      <view class="sr-bottom-space"></view>
    </view>
  </scroll-view>
</view>
