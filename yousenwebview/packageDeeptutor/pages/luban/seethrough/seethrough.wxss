@import "/packageDeeptutor/styles/paper-ink.wxss";

/* F16 看穿 5天体验 · 纸墨朱竹暖色(宣纸亮) */
.st-page { position: fixed; inset: 0; background: #f4efe6; color: #2b2620; }
.st-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 10; background: #f4efe6; box-shadow: 0 1rpx 0 rgba(0,0,0,0.05); }
.st-nav-inner { height: 88rpx; display: flex; align-items: center; padding: 0 24rpx; }
.st-back { font-size: 30rpx; color: #8a4b3a; }
.st-nav-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: 600; margin-right: 90rpx; }
.st-days { white-space: nowrap; padding: 8rpx 16rpx 12rpx; }
.st-day-chip { display: inline-block; padding: 8rpx 22rpx; margin-right: 12rpx; border-radius: 28rpx; background: #eae2d3; color: #7a6f5e; font-size: 24rpx; }
.st-day-chip.active { background: #8a2b20; color: #fff; }
.st-day-chip.done { color: #4a7a4a; }
.st-day-chip.active.done { color: #fff; }

.st-scroll { position: fixed; left: 0; right: 0; bottom: 0; }
.st-inner { padding: 24rpx 28rpx 120rpx; }
.st-loading, .st-error { text-align: center; color: #8a7f6e; padding: 80rpx 0; font-size: 28rpx; }

.st-day-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16rpx; }
.st-day-no { font-size: 26rpx; color: #8a2b20; font-weight: 600; }
.st-competency { font-size: 22rpx; color: #a99; }

.st-banner { background: #efe6d2; border-left: 6rpx solid #c99; padding: 18rpx 22rpx; border-radius: 12rpx; font-size: 26rpx; color: #6a5f4e; margin-bottom: 20rpx; }

.st-card { background: #fffdf8; border-radius: 20rpx; padding: 32rpx 28rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 16rpx rgba(120,90,60,0.06); }
.st-kicker { display: block; font-size: 24rpx; color: #8a2b20; margin-bottom: 14rpx; letter-spacing: 2rpx; }
.st-cut-text { display: block; font-size: 38rpx; line-height: 1.5; font-weight: 600; color: #2b2620; }
.st-stem { display: block; font-size: 32rpx; line-height: 1.6; margin-bottom: 24rpx; }
.st-section { display: block; font-size: 28rpx; font-weight: 600; color: #8a2b20; margin-bottom: 18rpx; }

.st-options { display: flex; flex-direction: column; gap: 16rpx; }
.st-opt { display: flex; align-items: flex-start; padding: 22rpx 20rpx; border-radius: 14rpx; background: #f6f1e8; border: 2rpx solid transparent; }
.st-opt-id { flex: none; width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; border-radius: 50%; background: #e6dcc9; color: #6a5f4e; font-size: 26rpx; margin-right: 16rpx; }
.st-opt-text { flex: 1; font-size: 28rpx; line-height: 1.5; color: #3b342b; }
.st-opt.right { background: #e8f3e6; border-color: #7aab7a; }
.st-opt.right .st-opt-id { background: #4a8a4a; color: #fff; }
.st-opt.wrong { background: #f7ece8; border-color: #d0a08a; }
.st-opt.wrong .st-opt-id { background: #b6614a; color: #fff; }

.st-feedback { padding: 22rpx 24rpx; border-radius: 14rpx; font-size: 28rpx; line-height: 1.5; margin-bottom: 20rpx; }
.st-feedback.good { background: #e8f3e6; color: #3a6a3a; }
.st-feedback.warm { background: #f7ece8; color: #8a4b3a; }

.st-textarea { width: 100%; min-height: 240rpx; background: #f6f1e8; border-radius: 14rpx; padding: 22rpx; font-size: 28rpx; line-height: 1.6; box-sizing: border-box; }

.st-insight .st-seg { margin-bottom: 20rpx; }
.st-seg-k { display: inline-block; font-size: 22rpx; color: #8a2b20; background: #f2e3df; padding: 4rpx 14rpx; border-radius: 8rpx; margin-bottom: 8rpx; }
.st-seg-v { display: block; font-size: 29rpx; line-height: 1.6; color: #3b342b; }

.st-evidence .st-ev-chunk { padding: 14rpx 0; border-bottom: 1rpx dashed #e0d6c4; }
.st-ev-ref { display: block; font-size: 25rpx; color: #6a5f4e; }
.st-ev-ext { display: inline-block; margin-top: 8rpx; font-size: 22rpx; color: #8a6b3a; background: #f5ecd8; padding: 4rpx 12rpx; border-radius: 8rpx; }

.st-sp { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx dashed #e0d6c4; }
.st-sp-mark { flex: none; font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 8rpx; margin-right: 16rpx; }
.st-sp.hit .st-sp-mark { background: #e8f3e6; color: #3a6a3a; }
.st-sp.miss .st-sp-mark { background: #f7ece8; color: #b6614a; }
.st-sp-label { flex: 1; font-size: 27rpx; color: #3b342b; }
.st-honesty { margin-top: 18rpx; padding: 16rpx 18rpx; background: #f2efe6; border-radius: 10rpx; font-size: 22rpx; line-height: 1.5; color: #8a7f6e; }

.st-warm { background: linear-gradient(180deg, #fff9f0 0%, #fffdf8 100%); }
.st-warm-text { display: block; font-size: 31rpx; line-height: 1.7; color: #3b342b; margin-bottom: 18rpx; }
.st-replay { display: block; font-size: 26rpx; line-height: 1.6; color: #8a2b20; margin-bottom: 18rpx; }
.st-safety { display: block; font-size: 27rpx; line-height: 1.6; color: #6a7a5a; }

.st-promise-text { display: block; font-size: 32rpx; line-height: 1.7; color: #2b2620; }

.st-primary { margin: 16rpx 0 8rpx; height: 92rpx; line-height: 92rpx; text-align: center; background: #8a2b20; color: #fff; border-radius: 46rpx; font-size: 32rpx; font-weight: 600; box-shadow: 0 6rpx 20rpx rgba(138,43,32,0.25); }
.st-primary.disabled { background: #cbb; box-shadow: none; }

/* 已有暖色布局收归共享 palette，避免相似但不同的第三套“米色版”。 */
.st-page.paper { background-color: var(--pk-paper); color: var(--pk-t1); }
.st-page.paper .st-nav { background: var(--pk-paper); border-color: var(--pk-bd); box-shadow: none; }
.st-page.paper .st-back,
.st-page.paper .st-day-no,
.st-page.paper .st-kicker,
.st-page.paper .st-section,
.st-page.paper .st-replay { color: var(--pk-grn); }
.st-page.paper .st-day-chip,
.st-page.paper .st-opt,
.st-page.paper .st-textarea,
.st-page.paper .st-honesty { background: var(--pk-gauge); color: var(--pk-t2); }
.st-page.paper .st-day-chip.active { background: var(--pk-ink-btn); color: var(--pk-ink-btn-t); }
.st-page.paper .st-card,
.st-page.paper .st-warm { background: var(--pk-card); border: 1rpx solid var(--pk-bd); box-shadow: 0 2rpx 12rpx var(--pk-shadow); }
.st-page.paper .st-cut-text,
.st-page.paper .st-stem,
.st-page.paper .st-opt-text,
.st-page.paper .st-seg-v,
.st-page.paper .st-sp-label,
.st-page.paper .st-warm-text,
.st-page.paper .st-promise-text { color: var(--pk-t1); }
.st-page.paper .st-loading,
.st-page.paper .st-error,
.st-page.paper .st-competency,
.st-page.paper .st-ev-ref { color: var(--pk-t3); }
.st-page.paper .st-opt.right,
.st-page.paper .st-feedback.good,
.st-page.paper .st-sp.hit .st-sp-mark { background: rgba(72, 128, 106, 0.12); border-color: var(--pk-grn); color: var(--pk-grn); }
.st-page.paper .st-opt.wrong,
.st-page.paper .st-feedback.warm,
.st-page.paper .st-sp.miss .st-sp-mark { background: rgba(194, 101, 85, 0.10); border-color: var(--pk-warn); color: var(--pk-warn); }
.st-page.paper .st-primary { background: var(--pk-ink-btn); color: var(--pk-ink-btn-t); box-shadow: 0 8rpx 20rpx var(--pk-shadow); }
