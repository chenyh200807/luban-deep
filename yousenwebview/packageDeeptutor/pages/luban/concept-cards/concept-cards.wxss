@import "/packageDeeptutor/styles/paper-ink.wxss";

/* 考点卡翻卡页 · 纸墨朱竹（--pk-* token 单一权威，禁第二套 token 词汇） */

.cc-page {
  min-height: 100vh;
  font-family: -apple-system, "PingFang SC", sans-serif;
  color: var(--pk-t1);
}

/* ── 导航（与 review 同构） ─────────────────── */
.cc-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: var(--pk-card);
  border-bottom: 1rpx solid var(--pk-bd);
}
.cc-nav-inner {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.cc-back {
  position: absolute;
  left: 26rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--pk-t2);
}
.cc-back-arrow { font-size: 40rpx; line-height: 1; }
.cc-back-text { font-size: 26rpx; }
.cc-nav-title { font-size: 30rpx; font-weight: 800; color: var(--pk-t1); }

/* ── 滚动 ── */
.cc-scroll { position: fixed; left: 0; right: 0; bottom: 0; }
.cc-inner {
  padding: 24rpx 24rpx 0;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  box-sizing: border-box;
}

/* ── 错误 / 加载 / 空态 ─────────────────────── */
.cc-error {
  border-radius: 22rpx;
  border: 1rpx solid var(--pk-bd);
  background: var(--pk-card);
  padding: 26rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 26rpx;
  color: var(--pk-warn);
}
.cc-retry {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--pk-bd);
  color: var(--pk-t2);
  font-size: 26rpx;
  font-weight: 600;
}
.cc-loading {
  padding: 40rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--pk-t3);
}
.cc-empty {
  padding: 40rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  text-align: center;
  align-items: center;
}
.cc-empty-title { font-size: 32rpx; font-weight: 800; color: var(--pk-t1); }
.cc-empty-desc { font-size: 25rpx; line-height: 1.7; color: var(--pk-t2); }
.cc-empty-cta { margin-top: 10rpx; width: 70%; }

/* ── 顶栏 + 站点条 ──────────────────────────── */
.cc-head {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 8rpx 4rpx 0;
}
.cc-head-sub { font-size: 24rpx; color: var(--pk-t3); }
.cc-packs {
  white-space: nowrap;
  width: 100%;
}
.cc-pack-chip {
  display: inline-flex;
  align-items: center;
  margin-right: 14rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--pk-bd);
  background: var(--pk-card);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pk-t2);
}
.cc-pack-chip.active {
  background: var(--pk-ink-btn);
  border-color: var(--pk-ink-btn);
  color: var(--pk-ink-btn-t);
}

/* ── 进度 ───────────────────────────────────── */
.cc-progress-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 6rpx;
}
.cc-progress-text { font-size: 26rpx; font-weight: 800; color: var(--pk-t1); }
.cc-progress-hint { font-size: 24rpx; color: var(--pk-t3); }

/* ── 翻卡主体 ───────────────────────────────── */
.cc-card {
  min-height: 560rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  justify-content: center;
}
.cc-card-kicker {
  font-size: 24rpx;
  letter-spacing: 3rpx;
  font-weight: 700;
  color: var(--pk-t3);
}
.cc-card-front {
  font-size: 44rpx;
  line-height: 1.45;
  font-weight: 850;
  color: var(--pk-t1);
  font-family: "Long Cang", "Kaiti SC", "STKaiti", "KaiTi", "楷体", cursive;
}
.cc-card-prompt { font-size: 26rpx; line-height: 1.6; color: var(--pk-t2); }
.cc-card-fliphint {
  margin-top: 26rpx;
  font-size: 24rpx;
  color: var(--pk-t3);
  text-align: center;
}

/* 翻面：教材原文并排（竹青左轨 = 正向权威） */
.cc-quote {
  border-left: 6rpx solid var(--pk-grn);
  background: var(--pk-paper);
  border-radius: 0 18rpx 18rpx 0;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.cc-quote-label {
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--pk-grn);
}
.cc-quote-text {
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--pk-t1);
}
.cc-quote-source {
  font-size: 24rpx;
  color: var(--pk-t3);
  word-break: break-all;
}
.cc-gist {
  border-radius: 18rpx;
  border: 1rpx dashed var(--pk-bd);
  padding: 18rpx 22rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.cc-gist-label {
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--pk-t3);
}
.cc-gist-text { font-size: 26rpx; line-height: 1.65; color: var(--pk-t2); }

/* ── 两枚按钮（纯本地牌序） ─────────────────── */
.cc-actions {
  display: flex;
  gap: 18rpx;
}
.cc-btn-again { flex: 1; }
.cc-btn-got { flex: 1.4; }
.cc-btn-again.dim,
.cc-btn-got.dim { opacity: 0.4; }
.cc-actions-note {
  font-size: 24rpx;
  color: var(--pk-t3);
  text-align: center;
}

/* ── 完场 ───────────────────────────────────── */
.cc-done {
  padding: 44rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  text-align: center;
}
.cc-done-title { font-size: 34rpx; font-weight: 850; color: var(--pk-t1); }
.cc-done-desc { font-size: 25rpx; line-height: 1.7; color: var(--pk-t2); }
.cc-done-actions {
  margin-top: 12rpx;
  width: 100%;
  display: flex;
  gap: 18rpx;
}
.cc-done-restart { flex: 1.4; }
.cc-done-back { flex: 1; }

/* ── 记忆面结构化（2026-07-12 精妙排版版）───────────────── */
.cc-sec-label {
  display: block;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: var(--pk-red);
  margin: 26rpx 0 14rpx;
}

/* 流程链：口诀石链 */
.cc-chain-flow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  row-gap: 14rpx;
}
.cc-chain-stone {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: #efecdf;
  border-radius: 16rpx;
  padding: 12rpx 18rpx 12rpx 10rpx;
  max-width: 100%;
}
.cc-chain-idx {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--pk-red);
  color: #fffdf8;
  font-size: 21rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}
.cc-chain-tx {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--pk-t1);
  line-height: 1.3;
}
.cc-chain-arrow {
  color: var(--pk-t3);
  font-size: 26rpx;
  font-weight: 700;
}

/* 谁做什么：主体签章 + 动作行 */
.cc-roster-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 0;
  border-top: 1rpx dashed var(--pk-bd);
}
.cc-roster-row:first-of-type {
  border-top: none;
  padding-top: 4rpx;
}
.cc-roster-actor {
  flex: 0 0 auto;
  font-size: 22rpx;
  font-weight: 800;
  color: var(--pk-grn);
  background: rgba(72, 128, 106, 0.1);
  border: 1rpx solid rgba(72, 128, 106, 0.26);
  border-radius: 12rpx;
  padding: 6rpx 14rpx;
  margin-top: 2rpx;
  white-space: nowrap;
}
.cc-roster-mark {
  flex: 0 0 auto;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--pk-t3);
  margin-top: 6rpx;
}
.cc-roster-body {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: var(--pk-t2);
  line-height: 1.6;
}

/* 关键数：数字瓷砖 */
.cc-nums-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.cc-num-tile {
  background: #efecdf;
  border-radius: 18rpx;
  padding: 16rpx 22rpx 14rpx;
  min-width: 130rpx;
}
.cc-num-line {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}
.cc-num-big {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--pk-red);
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}
.cc-num-unit {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--pk-t2);
}
.cc-num-ctx {
  display: block;
  font-size: 21rpx;
  color: var(--pk-t3);
  margin-top: 6rpx;
  line-height: 1.4;
}

/* 原文开关：默认收拢 */
.cc-quote-toggle {
  margin: 24rpx 0 0;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--pk-bd);
  border-radius: 16rpx;
  background: rgba(255, 253, 248, 0.72);
  color: var(--pk-t2);
  font-size: 24rpx;
  font-weight: 700;
}
.cc-quote-toggle:active {
  background: #f8f5ec;
}

/* ── 形态学v2(2026-07-12): 规则牌/句读要点/红线句/错因回路 ── */
.cc-rule-flow {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.cc-rule-cond {
  background: #efecdf;
  border-radius: 16rpx;
  padding: 16rpx 22rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--pk-t1);
  line-height: 1.4;
}
.cc-rule-arrow {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--pk-t3);
}
.cc-rule-result {
  background: rgba(72, 128, 106, 0.1);
  border: 1rpx solid rgba(72, 128, 106, 0.3);
  border-radius: 16rpx;
  padding: 16rpx 22rpx;
  font-size: 27rpx;
  font-weight: 800;
  color: var(--pk-grn);
  line-height: 1.4;
}
.cc-rule-result.ban {
  background: rgba(207, 68, 54, 0.07);
  border: 2rpx solid rgba(207, 68, 54, 0.5);
  color: var(--pk-red);
  letter-spacing: 2rpx;
}
.cc-roster-body.ban {
  color: var(--pk-red);
  font-weight: 700;
}
.cc-clause-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 10rpx 0;
}
.cc-clause-dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  border-radius: 4rpx;
  background: var(--pk-grn);
  margin-top: 14rpx;
}
.cc-clause-tx {
  flex: 1;
  font-size: 26rpx;
  color: var(--pk-t2);
  line-height: 1.6;
}
.cc-redline {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  background: rgba(207, 68, 54, 0.06);
  border: 1rpx solid rgba(207, 68, 54, 0.24);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
}
.cc-redline-seal {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid var(--pk-red);
  border-radius: 10rpx;
  color: var(--pk-red);
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-6deg);
}
.cc-redline-tx {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--pk-t1);
  line-height: 1.6;
}
.cc-eb-link {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(194, 101, 85, 0.07);
  border: 1rpx dashed rgba(194, 101, 85, 0.32);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
}
.cc-eb-link-tx {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pk-warn);
}
.cc-eb-link-arrow {
  font-size: 30rpx;
  color: var(--pk-warn);
  font-weight: 700;
}

/* ── v3 精致化(2026-07-12): 站牌/抽屉/骨牌/形状徽标/正面重排/完场账目 ── */

/* 站牌 + 下一站 */
.cc-pack-bar {
  display: flex;
  gap: 14rpx;
  margin: 4rpx 0 20rpx;
}
.cc-pack-now {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 3rpx 12rpx var(--pk-shadow);
}
.cc-pack-now:active {
  background: #f8f5ec;
}
.cc-pack-now-title {
  font-size: 29rpx;
  font-weight: 800;
  color: var(--pk-t1);
  flex-shrink: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cc-pack-now-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  color: var(--pk-t3);
  flex: 0 0 auto;
}
.cc-pack-now-arrow {
  margin-left: auto;
  flex: 0 0 auto;
  font-size: 24rpx;
  color: var(--pk-t3);
}
.cc-pack-next {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  padding: 0 26rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--pk-bd);
  background: rgba(255, 253, 248, 0.72);
  font-size: 25rpx;
  font-weight: 700;
  color: var(--pk-t2);
}
.cc-pack-next:active {
  background: #f8f5ec;
}
.cc-pack-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--pk-red);
  flex: 0 0 auto;
}

/* 进度骨牌 */
.cc-dominoes {
  display: flex;
  gap: 8rpx;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.cc-domino {
  flex: 1;
  max-width: 40rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: var(--pk-gauge);
}
.cc-domino.done {
  background: var(--pk-grn);
}
.cc-domino.now {
  background: var(--pk-red);
}

/* 正面: 回忆预告 + 翻面章 */
.cc-front-face {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.cc-shape-hint {
  margin-top: 22rpx;
  font-size: 23rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}
.cc-shape-hint.tone-red {
  color: var(--pk-red);
  background: rgba(207, 68, 54, 0.07);
  border: 1rpx solid rgba(207, 68, 54, 0.22);
}
.cc-shape-hint.tone-grn {
  color: var(--pk-grn);
  background: rgba(72, 128, 106, 0.08);
  border: 1rpx solid rgba(72, 128, 106, 0.22);
}
.cc-shape-hint.tone-warn {
  color: var(--pk-warn);
  background: rgba(194, 101, 85, 0.08);
  border: 1rpx solid rgba(194, 101, 85, 0.24);
}
.cc-shape-hint.tone-ink {
  color: var(--pk-t2);
  background: #efecdf;
  border: 1rpx solid transparent;
}
.cc-fliphint-seal {
  align-self: center;
  margin-top: 40rpx;
  border: 2rpx solid rgba(207, 68, 54, 0.4);
  color: var(--pk-red);
  border-radius: 14rpx;
  padding: 10rpx 28rpx;
  font-size: 23rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  transform: rotate(-2deg);
}

/* 翻面: 头行 + 形状徽标 + 入场 */
.cc-back-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 6rpx;
}
.cc-shape-badge {
  flex: 0 0 auto;
  font-size: 21rpx;
  font-weight: 800;
  border-radius: 12rpx;
  padding: 6rpx 14rpx;
  letter-spacing: 1rpx;
}
.cc-shape-badge.tone-red {
  color: var(--pk-red);
  background: rgba(207, 68, 54, 0.07);
  border: 1rpx solid rgba(207, 68, 54, 0.24);
}
.cc-shape-badge.tone-grn {
  color: var(--pk-grn);
  background: rgba(72, 128, 106, 0.08);
  border: 1rpx solid rgba(72, 128, 106, 0.24);
}
.cc-shape-badge.tone-warn {
  color: var(--pk-warn);
  background: rgba(194, 101, 85, 0.08);
  border: 1rpx solid rgba(194, 101, 85, 0.26);
}
.cc-shape-badge.tone-ink {
  color: var(--pk-t2);
  background: #efecdf;
  border: 1rpx solid transparent;
}
@keyframes ccUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
.cc-reveal {
  animation: ccUp 0.32s cubic-bezier(0.2, 0.7, 0.3, 1) both;
}

/* 卡片形状色缘(左缘细条呼应徽标色) */
.cc-card.shape-red {
  border-left: 6rpx solid rgba(207, 68, 54, 0.5);
}
.cc-card.shape-grn {
  border-left: 6rpx solid rgba(72, 128, 106, 0.45);
}
.cc-card.shape-warn {
  border-left: 6rpx solid rgba(194, 101, 85, 0.45);
}

/* 完场账目 */
.cc-done-tally {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 44rpx;
  margin: 24rpx 0 8rpx;
}
.cc-tally-item {
  text-align: center;
}
.cc-tally-n {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: var(--pk-t1);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}
.cc-tally-n.grn {
  color: var(--pk-grn);
}
.cc-tally-k {
  font-size: 22rpx;
  color: var(--pk-t3);
  font-weight: 600;
}
.cc-tally-divider {
  width: 1rpx;
  height: 64rpx;
  background: var(--pk-bd);
}

/* 选站抽屉 */
.cc-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(38, 36, 31, 0.32);
  z-index: 20;
}
.cc-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  background: var(--pk-paper);
  border-radius: 32rpx 32rpx 0 0;
  padding: 18rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 48rpx rgba(38, 36, 31, 0.18);
  max-height: 68vh;
  display: flex;
  flex-direction: column;
}
.cc-sheet-grip {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--pk-gauge);
  margin: 0 auto 18rpx;
}
.cc-sheet-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--pk-t1);
}
.cc-sheet-sub {
  font-size: 22rpx;
  color: var(--pk-t3);
  margin: 6rpx 0 18rpx;
}
.cc-sheet-scroll {
  flex: 1;
  min-height: 0;
}
.cc-sheet-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 8rpx;
}
.cc-sheet-cell {
  flex: 0 0 calc(50% - 8rpx);
  box-sizing: border-box;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
}
.cc-sheet-cell:active {
  background: #f8f5ec;
}
.cc-sheet-cell.active {
  border: 2rpx solid rgba(72, 128, 106, 0.5);
}
.cc-sheet-cell-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}
.cc-sheet-cell-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--pk-t1);
  line-height: 1.35;
  min-width: 0;
}
.cc-sheet-cell-meta {
  display: block;
  font-size: 21rpx;
  color: var(--pk-t3);
  margin-top: 8rpx;
}

/* 进度行间距修正 */
.cc-progress-text {
  margin-left: 16rpx;
  margin-right: 12rpx;
  flex: 0 0 auto;
}
.cc-progress-hint {
  flex: 0 0 auto;
}
