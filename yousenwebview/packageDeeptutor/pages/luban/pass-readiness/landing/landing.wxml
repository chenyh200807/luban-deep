<!-- 过线体检 · 落地页(§4.1 六要素, 单 CTA)
     视觉与学习首页同基因:纸墨朱竹 token + 品牌红章 + 宣纸点阵舞台 + 错峰上浮入场。
     纯呈现层改版:六要素绑定 / 登录车道 / 埋点零改动;副标与样例标题用 WXS
     在呈现层拆分(copy 源字符串不动, 合同测试仍断言原绑定)。 -->
<wxs module="fmt">
var TRIM = getRegExp("^\\s+|\\s+$", "g");
function parts(str) {
  var s = "" + (str || "");
  var raw = s.split("·");
  var out = [];
  for (var i = 0; i < raw.length; i++) {
    var t = raw[i].replace(TRIM, "");
    if (t) out.push(t);
  }
  return out;
}
function head(str) {
  var p = parts(str);
  return p.length ? p[0] : "";
}
function tail(str) {
  var p = parts(str);
  return p.length > 1 ? p.slice(1).join(" · ") : "";
}
module.exports = { parts: parts, head: head, tail: tail };
</wxs>

<view class="pr-page paper {{isDark?'':'light'}} pk-paper-bg">

  <view class="pr-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="pr-nav-inner">
      <view class="pr-nav-back" bindtap="goBack"><text class="pr-nav-arrow">‹</text></view>
      <view class="pr-nav-brand">
        <view class="pr-nav-seal pk-seal">
          <image class="pr-nav-logo" src="/packageDeeptutor/images/logo-mark-white.png" mode="aspectFit" />
        </view>
        <text class="pr-nav-title">{{copy.productName}}</text>
      </view>
    </view>
  </view>

  <scroll-view class="pr-body" scroll-y style="top:{{navHeight}}px">
    <view class="pr-landing">

      <!-- 要素 2: H1 -->
      <text class="pr-h1 pr-rise">{{copy.h1}}</text>

      <!-- 要素 3: 副标(呈现层拆三枚 chip, 文案零改动) -->
      <view class="pr-chips pr-rise pr-rise--d1">
        <view class="pr-chip" wx:for="{{fmt.parts(copy.subtitle)}}" wx:key="*this">
          <text class="pr-chip-txt">{{item}}</text>
        </view>
      </view>

      <!-- 要素 4: 防心测声明(竹青批注条) -->
      <view class="pr-antiquiz pk-card pr-rise pr-rise--d2">
        <view class="pr-antiquiz-mark"><text class="pr-antiquiz-glyph">证</text></view>
        <text class="pr-antiquiz-txt">{{copy.antiQuizLine}}</text>
      </view>

      <!-- 要素 5: 样例报告缩略图(宣纸舞台:分数带 vs 过线线, 证据卡模糊) -->
      <view class="pr-sample pk-card pr-rise pr-rise--d3">
        <view class="pr-sample-stage">
          <view class="pr-sample-badge"><text>{{fmt.head(copy.sampleReportCaption)}}</text></view>
          <text class="pr-sample-cap">{{fmt.tail(copy.sampleReportCaption)}}</text>
          <view class="pr-scale">
            <text class="pr-scale-passnum">96</text>
            <view class="pr-scale-track">
              <view class="pr-scale-tick" style="left:25%"></view>
              <view class="pr-scale-tick" style="left:50%"></view>
              <view class="pr-scale-tick" style="left:75%"></view>
              <view class="pr-scale-band"></view>
            </view>
            <view class="pr-scale-passline"></view>
          </view>
        </view>
        <view class="pr-sample-foot">
          <view class="pr-evidence-row">
            <view class="pr-evc">
              <view class="pr-evc-blur">
                <view class="pr-evc-head"><view class="pr-evc-dot"></view><view class="pr-evc-bar"></view></view>
                <view class="pr-evc-line pr-w72"></view>
                <view class="pr-evc-line pr-w48"></view>
              </view>
            </view>
            <view class="pr-evc">
              <view class="pr-evc-blur">
                <view class="pr-evc-head"><view class="pr-evc-dot pr-evc-dot--warn"></view><view class="pr-evc-bar"></view></view>
                <view class="pr-evc-line pr-w60"></view>
                <view class="pr-evc-line pr-w80"></view>
              </view>
            </view>
            <view class="pr-evc">
              <view class="pr-evc-blur">
                <view class="pr-evc-head"><view class="pr-evc-dot"></view><view class="pr-evc-bar"></view></view>
                <view class="pr-evc-line pr-w80"></view>
                <view class="pr-evc-line pr-w40"></view>
              </view>
            </view>
          </view>
          <text class="pr-sample-note">证据卡在你的报告里逐条可点开</text>
        </view>
      </view>

      <view style="height:32rpx"></view>
    </view>
  </scroll-view>

  <!-- 要素 6: 单 CTA(登录按钮) -->
  <view class="pr-action" style="padding-bottom: {{safeBottom + 24}}px">
    <view class="pr-err" wx:if="{{errorMsg}}"><text class="pr-err-txt">{{errorMsg}}</text></view>

    <block wx:if="{{loggedIn}}">
      <button class="pr-cta pk-btn-ink" bindtap="onStartTap" disabled="{{logging}}">
        <text>{{copy.ctaLoggedIn}}</text>
      </button>
      <view class="pr-last-report" wx:if="{{lastDiagnostic.completed}}" bindtap="onViewLastReport">
        <text class="pr-last-report-txt">查看上次报告 ›</text>
      </view>
    </block>
    <block wx:else>
      <button
        wx:if="{{privacyChecked}}"
        class="pr-cta pk-btn-ink {{logging ? 'off' : ''}}"
        open-type="getPhoneNumber"
        bindgetphonenumber="handlePhoneNumber"
        disabled="{{logging}}"
      >
        <text>{{logging ? '正在进入…' : copy.ctaLogin}}</text>
      </button>
      <button
        wx:else
        class="pr-cta pk-btn-ink"
        bindtap="handlePrivacyRequiredTap"
        disabled="{{logging}}"
      >
        <text>{{copy.ctaLogin}}</text>
      </button>

      <!-- 授权理由(§5.1 逐字): 卖资产绑定, 不设第二按钮/不挽留 -->
      <text class="pr-auth-reason">{{copy.phoneAuthReason}}</text>

      <view class="pr-privacy-row" wx:if="{{!privacyChecked}}">
        <button
          class="pr-privacy-agree"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="handlePrivacyAgreementAuthorized"
        >
          <view class="pr-privacy-box"></view>
          <text class="pr-privacy-copy">我已阅读并同意</text>
        </button>
        <text class="pr-privacy-link" catchtap="openPrivacyGuide">{{privacyContractName}}</text>
      </view>
    </block>
  </view>
</view>
