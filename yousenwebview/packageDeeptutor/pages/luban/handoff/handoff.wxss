@import "/packageDeeptutor/theme.wxss";

.luban-page {
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
  overflow: hidden;
}

.lb-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: rgba(10, 10, 10, 0.92);
  border-bottom: 1rpx solid var(--border);
}

.lb-nav-inner {
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 0;
  gap: 16rpx;
}

.lb-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: 20rpx;
  padding: 8rpx 12rpx 8rpx 4rpx;
  border-radius: 8rpx;
}

.lb-back:active {
  background: rgba(255, 255, 255, 0.08);
}

.lb-back-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: #818cf8;
  font-weight: 300;
  margin-top: -4rpx;
}

.lb-back-text {
  font-size: 28rpx;
  color: #818cf8;
  font-weight: 500;
}

.lb-nav-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.lb-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  overflow-y: auto;
}

.lb-inner {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.ho-hero {
  border-radius: 26rpx;
  border: 1rpx solid rgba(52, 211, 153, 0.22);
  background:
    radial-gradient(circle at top right, rgba(52, 211, 153, 0.16), transparent 42%),
    linear-gradient(150deg, rgba(5, 150, 105, 0.16), rgba(15, 23, 42, 0.72));
  padding: 56rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  text-align: center;
}

.ho-badge {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: rgba(52, 211, 153, 0.18);
  color: #34d399;
  font-size: 52rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ho-title {
  font-size: 40rpx;
  font-weight: 850;
  color: #fff;
}

.ho-desc {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.ho-reddot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(248, 113, 113, 0.24);
  background: rgba(248, 113, 113, 0.08);
  font-size: 26rpx;
  color: var(--text-secondary);
}

.ho-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #f87171;
  flex-shrink: 0;
}

.ho-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 8rpx;
}

.ho-btn {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.ho-btn.primary {
  background: linear-gradient(135deg, #059669, #2563eb);
  color: #fff;
}

.ho-btn.primary.done {
  opacity: 0.6;
}

.ho-btn.primary:active {
  opacity: 0.85;
}

.ho-btn.ghost {
  border: 1rpx solid rgba(148, 163, 184, 0.3);
  color: var(--text-secondary);
  background: transparent;
}

.ho-btn.ghost:active {
  background: rgba(255, 255, 255, 0.06);
}
