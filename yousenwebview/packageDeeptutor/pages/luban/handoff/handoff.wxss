@import "/packageDeeptutor/theme.wxss";
@import "/packageDeeptutor/styles/paper-ink.wxss";

.luban-page {
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
  overflow: hidden;
}

.lb-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: rgba(10, 10, 10, 0.92);
  border-bottom: 1rpx solid var(--border);
}

.lb-nav-inner {
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 0;
  gap: 16rpx;
}

.lb-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: 20rpx;
  padding: 8rpx 12rpx 8rpx 4rpx;
  border-radius: 8rpx;
}

.lb-back:active {
  background: rgba(255, 255, 255, 0.08);
}

.lb-back-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: #818cf8;
  font-weight: 300;
  margin-top: -4rpx;
}

.lb-back-text {
  font-size: 28rpx;
  color: #818cf8;
  font-weight: 500;
}

.lb-nav-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.lb-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  overflow-y: auto;
}

.lb-inner {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.ho-hero {
  border-radius: 26rpx;
  border: 1rpx solid rgba(52, 211, 153, 0.22);
  background:
    radial-gradient(circle at top right, rgba(52, 211, 153, 0.16), transparent 42%),
    linear-gradient(150deg, rgba(5, 150, 105, 0.16), rgba(15, 23, 42, 0.72));
  padding: 56rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  text-align: center;
}

.ho-title {
  font-size: 40rpx;
  font-weight: 850;
  color: #fff;
}

.ho-desc {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.ho-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 8rpx;
}

.ho-btn {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.ho-btn.ghost {
  border: 1rpx solid rgba(148, 163, 184, 0.3);
  color: var(--text-secondary);
  background: transparent;
}

.ho-btn.ghost:active {
  background: rgba(255, 255, 255, 0.06);
}

/* 讲懂→练→明天见的交接页与学习/复习共用纸墨壳。 */
.luban-page.paper {
  background-color: var(--pk-paper);
  background-image: radial-gradient(var(--pk-dot) 1.3rpx, transparent 1.3rpx);
  background-size: 34rpx 34rpx;
  color: var(--pk-t1);
}
.luban-page.paper .lb-nav { background: var(--pk-paper); border-color: var(--pk-bd); box-shadow: none; }
.luban-page.paper .lb-back-arrow,
.luban-page.paper .lb-back-text { color: var(--pk-grn); }
.luban-page.paper .lb-nav-title,
.luban-page.paper .ho-title { color: var(--pk-t1); }
.luban-page.paper .ho-desc { color: var(--pk-t2); }
.luban-page.paper .ho-hero { background: var(--pk-card); border-color: var(--pk-bd); box-shadow: 0 2rpx 12rpx var(--pk-shadow); }
.luban-page.paper .ho-btn { background: var(--pk-ink-btn); color: var(--pk-ink-btn-t); box-shadow: 0 8rpx 20rpx var(--pk-shadow); }
.luban-page.paper .ho-btn.ghost { background: transparent; border-color: var(--pk-bd); color: var(--pk-t2); box-shadow: none; }
