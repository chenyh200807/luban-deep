<!-- 变体轻练/复测 · 纸墨版(单题聚焦流) -->
<!-- 结构: 纸墨壳 → 墨点进度 → 当前题卡(题面/二选) → 印章反馈(门道+教材原文join卡) → 收据 -->
<!-- 数据红线: 全部字段=签发投影(surface/correct_statement/anchor/textbook), 前端零造词 -->
<view class="paper {{isDark ? '' : 'light'}} rt-page pk-paper-bg">
  <view class="rt-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="rt-nav-inner">
      <view class="rt-back" bindtap="goBack">
        <text class="rt-back-arrow">‹</text>
      </view>
      <view class="rt-nav-titles">
        <text class="rt-nav-title">{{navTitle}}</text>
        <text class="rt-nav-sub">{{title || packId}}</text>
      </view>
      <text class="rt-nav-count" wx:if="{{total && !showReceipt && !bridgeMode}}">{{currentIndex + 1}} / {{total}}</text>
    </view>
  </view>

  <scroll-view class="rt-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="top: {{navHeight}}px">
    <view class="rt-inner">

      <view class="rt-error pk-card" wx:if="{{errorText}}">
        <text>{{errorText}}</text>
        <view class="rt-retry pk-btn-ghost" bindtap="retry">重试</view>
      </view>

      <view class="rt-loading" wx:if="{{loading}}">
        <text>{{loadingText}}</text>
      </view>

      <block wx:if="{{!loading && !errorText}}">
        <view class="rt-empty pk-card" wx:if="{{!items.length}}">
          <text>{{emptyText}}</text>
        </view>

        <view class="rt-loading pk-card" wx:if="{{items.length && bridgeMode && !showReceipt}}">
          <text>{{syncStatus === 'error' ? syncError : '正在按成品五题作答进行服务端复核并写入学习证据…'}}</text>
          <view class="rt-retry pk-btn-ghost" wx:if="{{syncStatus === 'error'}}" bindtap="retryCompletion">重试保存</view>
        </view>

        <block wx:if="{{items.length && !showReceipt && !bridgeMode}}">
          <!-- 开场一句(只在第一题未答时) -->
          <view class="rt-hero" wx:if="{{currentIndex === 0 && !items[0].answered}}">
            <text class="rt-kicker">{{heroKicker}}</text>
            <text class="rt-title">{{heroTitle}}</text>
            <!-- 题池规模(签发真值): 换皮是刻意设计不是就这几题 -->
            <text class="rt-pool" wx:if="{{pool && practiceSource === 'compiled_html'}}">本节固定 5 题 · {{pool.rule_groups_total}} 个关键维度 · 答案由服务端判定</text>
            <text class="rt-pool" wx:elif="{{pool}}">本站题池 {{pool.core_total}} 道 · {{pool.rule_groups_total}} 种考法 · 每天换着考</text>
          </view>

          <!-- 墨点进度: 未答=空点 / 当前=墨环 / 对=竹青 / 错=赭 -->
          <view class="rt-dots">
            <view
              wx:for="{{items}}"
              wx:key="key"
              class="rt-dot {{index === currentIndex && !item.answered ? 'now' : ''}} {{item.answered ? (item.correct === true ? 'good' : (item.correct === false ? 'warm' : 'picked')) : ''}}"
            ></view>
          </view>

          <!-- 当前题卡(单题聚焦) -->
          <view class="rt-card pk-card">
            <view class="rt-card-head">
              <text class="pk-kicker">第 {{currentIndex + 1}} 题</text>
              <text class="rt-card-hint" wx:if="{{!items[currentIndex].answered}}">同一个考点 · 换了身皮</text>
            </view>
            <text class="rt-surface">{{items[currentIndex].stem || items[currentIndex].surface}}</text>

            <view class="rt-choices mcq" wx:if="{{items[currentIndex].answer_type === 'single_choice'}}">
              <view
                wx:for="{{items[currentIndex].options}}"
                wx:for-item="option"
                wx:key="option_id"
                class="rt-choice mcq-option {{items[currentIndex].selectedOptionId === option.option_id ? 'selected' : ''}}"
                hover-class="rt-choice-press"
                data-index="{{currentIndex}}"
                data-option-id="{{option.option_id}}"
                bindtap="onOptionTap"
              >
                <text class="rt-choice-letter">{{index + 1}}</text>
                <text>{{option.text}}</text>
              </view>
            </view>

            <view class="rt-choices" wx:elif="{{!items[currentIndex].answered}}">
              <view class="rt-choice ok" hover-class="rt-choice-press" data-index="{{currentIndex}}" data-choice="ok" bindtap="onChoiceTap">
                <text>这样做妥当</text>
              </view>
              <view class="rt-choice not-ok" hover-class="rt-choice-press" data-index="{{currentIndex}}" data-choice="not_ok" bindtap="onChoiceTap">
                <text>不妥当</text>
              </view>
            </view>

            <!-- 印章反馈(答后滑入) -->
            <view class="rt-pending" wx:if="{{items[currentIndex].answer_type === 'single_choice' && items[currentIndex].answered}}">
              <text>已选。五题答完后由服务器统一判分并写入学习证据。</text>
              <view class="pk-btn-ink rt-next" bindtap="nextQuestion">
                {{currentIndex + 1 < total ? '下一题' : (syncStatus === 'syncing' ? '正在判分并保存…' : (syncStatus === 'error' ? '重试保存' : '查看结果'))}}
              </view>
              <text class="rt-anchor" wx:if="{{syncError}}">{{syncError}}</text>
            </view>

            <view class="rt-verdict {{items[currentIndex].correct ? 'good' : 'warm'}}" wx:if="{{items[currentIndex].answered && items[currentIndex].answer_type !== 'single_choice'}}">
              <view class="rt-seal-row">
                <view class="rt-seal {{items[currentIndex].correct ? 'good' : 'warm'}}">
                  <text>{{items[currentIndex].correct ? '本题答对' : '差一步'}}</text>
                </view>
                <view class="rt-seal-copy">
                  <text class="rt-verdict-main">{{items[currentIndex].correct ? '本题答对——看解析巩固' : '就差一步——门道在这'}}</text>
                  <text class="rt-verdict-sub">{{items[currentIndex].correct ? '这是本轮作答结果' : '差的不是能力，是下面这句'}}</text>
                </view>
              </view>

              <!-- 门道 = 签发 correct_statement 逐字 -->
              <view class="rt-truth">
                <text class="rt-truth-label">门道</text>
                <text class="rt-truth-text">{{items[currentIndex].correct_statement}}</text>
              </view>

              <!-- 教材原文并排卡(仅 anchor join 命中签发考点卡时出现, 逐字透传) -->
              <view class="rt-book" wx:if="{{items[currentIndex].textbook}}">
                <view class="rt-book-spine"></view>
                <view class="rt-book-body">
                  <text class="rt-book-kicker">教材原文 · 阅卷认的这句</text>
                  <text class="rt-book-quote">{{items[currentIndex].textbook.quote}}</text>
                  <view class="rt-book-foot">
                    <text class="rt-book-label" wx:if="{{items[currentIndex].textbook.label}}">{{items[currentIndex].textbook.label}}</text>
                    <text class="rt-book-page" wx:if="{{items[currentIndex].textbook.page_num}}">教材 P{{items[currentIndex].textbook.page_num}}</text>
                  </view>
                </view>
              </view>

              <!-- 原文卡在场时不再露 kc 坐标(信息重复); 无原文时保留定位可溯 -->
              <text class="rt-anchor" wx:if="{{items[currentIndex].anchor && !items[currentIndex].textbook}}">定位 {{items[currentIndex].anchor}}</text>

              <view class="pk-btn-ink rt-next" bindtap="nextQuestion">
                {{currentIndex + 1 < total ? '下一题' : (syncStatus === 'syncing' ? '正在保存…' : (syncStatus === 'error' ? '重试保存' : '看今日收据'))}}
              </view>
              <text class="rt-anchor" wx:if="{{syncError}}">{{syncError}}</text>
            </view>
          </view>
        </block>

        <!-- 完场收据(纸墨) -->
        <view class="rt-receipt pk-card" wx:if="{{showReceipt}}">
          <view class="rt-receipt-head">
            <text class="rt-receipt-kicker">{{doneTitlePrefix}}</text>
            <view class="rt-receipt-score">
              <text class="rt-receipt-big">{{correctCount}}</text>
              <text class="rt-receipt-slash">/ {{total}}</text>
            </view>
          </view>
          <view class="rt-receipt-rows">
            <view class="rt-receipt-row">
              <text class="rt-receipt-k">记录状态</text>
              <text class="rt-receipt-v">{{receiptSyncText}}</text>
            </view>
            <view class="rt-receipt-row">
              <text class="rt-receipt-k">学习状态</text>
              <text class="rt-receipt-v">{{receiptStateText}}</text>
            </view>
            <view class="rt-receipt-row">
              <text class="rt-receipt-k">考法覆盖</text>
              <text class="rt-receipt-v">{{ruleGroupCount}} 种考法各来了一题</text>
            </view>
            <view class="rt-receipt-row" wx:if="{{textbookCount}}">
              <text class="rt-receipt-k">教材原文</text>
              <text class="rt-receipt-v">翻出 {{textbookCount}} 句阅卷认的原文</text>
            </view>
          </view>

          <!-- 错题再看一眼(签发门道逐字, 不复述你的错) -->
          <view class="rt-review-list" wx:if="{{wrongItems.length}}">
            <text class="rt-review-label">这 {{wrongItems.length}} 道错题已写入学习证据，先把门道看清</text>
            <view class="rt-review-item" wx:for="{{wrongItems}}" wx:key="key">
              <view class="rt-review-dot"></view>
              <view class="rt-review-copy">
                <text class="rt-review-text">{{item.correct_statement}}</text>
                <!-- 四层错项诊断(全部服务端签发字段, 缺失整行隐藏) -->
                <text class="rt-review-detail" wx:if="{{item.selectedOptionText}}">你选了：{{item.selectedOptionText}}</text>
                <text class="rt-review-detail" wx:if="{{item.feedback && item.feedback.temptation}}">为什么它看起来像对的：{{item.feedback.temptation}}</text>
                <text class="rt-review-detail" wx:if="{{item.feedback && item.feedback.loss_reason}}">考试为什么不给分：{{item.feedback.loss_reason}}</text>
                <text class="rt-review-fix" wx:if="{{item.feedback && item.feedback.fix}}">下次这样答：{{item.feedback.fix}}</text>
              </view>
            </view>
          </view>
          <text class="rt-receipt-clean" wx:if="{{!wrongItems.length && total}}">本轮五题全对，已经记录；是否稳定，等下一次换皮验证。</text>

          <!-- 错后当场确认(变体判断题消费点1): 有 immediate_confirm 供给的错题才亮; 纯导航零第二权威 -->
          <view class="rt-cc-link" wx:if="{{showConfirmEntry}}" catchtap="goConfirmFacts">
            <text class="rt-cc-link-tx">把刚才做错的 {{confirmEntryFacts.length}} 个考点 · 换身皮当场再确认</text>
            <text class="rt-cc-link-arrow">›</text>
          </view>

          <!-- 三角回路: 复测→考点卡(错了去背给分词;全对去巩固) 纯导航零第二权威 -->
          <view class="rt-cc-link" catchtap="goConceptCards">
            <text class="rt-cc-link-tx">{{wrongItems.length ? '翻这一站的考点卡 · 把给分词背上' : '翻这一站的考点卡 · 趁热再巩固'}}</text>
            <text class="rt-cc-link-arrow">›</text>
          </view>

          <view class="rt-stamp-row">
            <view class="rt-stamp">
              <text>{{mode === 'forward' ? '轻练已记录' : '回炉完成'}}</text>
            </view>
            <text class="rt-stamp-note">{{receiptNextText || doneDesc}}</text>
          </view>

          <view class="pk-btn-ink rt-next" bindtap="continueAfterReceipt">{{mode === 'forward' ? '返回提分路线' : '回到复习'}}</view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
