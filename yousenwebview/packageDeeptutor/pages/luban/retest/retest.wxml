<view class="luban-page {{isDark ? '' : 'light'}}">
  <view class="lb-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="lb-nav-inner">
      <view class="lb-back" bindtap="goBack">
        <text class="lb-back-arrow">‹</text>
        <text class="lb-back-text">路线</text>
      </view>
      <text class="lb-nav-title">{{navTitle}}</text>
    </view>
  </view>

  <scroll-view class="lb-scroll" scroll-y enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}" style="top: {{navHeight}}px">
    <view class="lb-inner">
      <view class="rt-hero">
        <text class="rt-kicker">{{heroKicker}}</text>
        <text class="rt-title">{{heroTitle}}</text>
      </view>

      <view class="rt-error" wx:if="{{errorText}}">
        <text>{{errorText}}</text>
        <view class="rt-retry" bindtap="retry">重试</view>
      </view>

      <view class="rt-loading" wx:if="{{loading}}">
        <text>{{loadingText}}</text>
      </view>

      <block wx:if="{{!loading && !errorText}}">
        <view class="rt-empty" wx:if="{{!items.length}}">
          <text>{{emptyText}}</text>
        </view>

        <view class="rt-card" wx:for="{{items}}" wx:key="key">
          <text class="rt-index">第 {{index + 1}} 题 · 共 {{total}} 题</text>
          <text class="rt-surface">{{item.surface}}</text>

          <view class="rt-choices" wx:if="{{!item.answered}}">
            <view
              class="rt-choice ok"
              data-index="{{index}}"
              data-choice="ok"
              bindtap="onChoiceTap"
            >
              <text>这样做妥当</text>
            </view>
            <view
              class="rt-choice not-ok"
              data-index="{{index}}"
              data-choice="not_ok"
              bindtap="onChoiceTap"
            >
              <text>不妥当</text>
            </view>
          </view>

          <view class="rt-feedback {{item.correct ? 'good' : 'warm'}}" wx:if="{{item.answered}}">
            <block wx:if="{{item.correct}}">
              <text class="rt-feedback-main">对——你是真懂了</text>
              <!-- 答对也给门道:正确说法不只在错时出现(签发 correct_statement 真值) -->
              <text class="rt-feedback-why">门道 · {{item.correct_statement}}</text>
            </block>
            <block wx:else>
              <text class="rt-feedback-main">差一步——门道在这</text>
              <text class="rt-feedback-why">{{item.correct_statement}}</text>
            </block>
            <text class="rt-anchor-chip" wx:if="{{item.anchor}}">定位 {{item.anchor}}</text>
          </view>
        </view>

        <view class="rt-done" wx:if="{{done}}">
          <text class="rt-done-title">{{doneTitlePrefix}} {{correctCount}}/{{total}}</text>
          <view class="rt-done-break">
            <text class="rt-done-chip good">答对 {{correctCount}}</text>
            <text class="rt-done-chip warm" wx:if="{{total - correctCount}}">再看一眼 {{total - correctCount}}</text>
          </view>
          <text class="rt-done-desc">{{doneDesc}}</text>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
