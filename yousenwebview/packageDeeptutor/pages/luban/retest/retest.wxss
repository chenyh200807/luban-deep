@import "/packageDeeptutor/theme.wxss";

.luban-page {
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
  overflow: hidden;
}

.lb-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: rgba(10, 10, 10, 0.92);
  border-bottom: 1rpx solid var(--border);
}

.lb-nav-inner {
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 0;
  gap: 16rpx;
}

.lb-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: 20rpx;
  padding: 8rpx 12rpx 8rpx 4rpx;
  border-radius: 8rpx;
}

.lb-back:active {
  background: rgba(255, 255, 255, 0.08);
}

.lb-back-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: #818cf8;
  font-weight: 300;
  margin-top: -4rpx;
}

.lb-back-text {
  font-size: 28rpx;
  color: #818cf8;
  font-weight: 500;
}

.lb-nav-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.lb-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  overflow-y: auto;
}

.lb-inner {
  padding: 28rpx 24rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rt-hero,
.rt-card,
.rt-empty,
.rt-error,
.rt-done {
  border-radius: 22rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  background: rgba(15, 23, 42, 0.62);
}

.rt-hero {
  padding: 28rpx 24rpx;
  background:
    radial-gradient(circle at top right, rgba(129, 140, 248, 0.18), transparent 40%),
    linear-gradient(145deg, rgba(79, 70, 229, 0.16), rgba(15, 23, 42, 0.72));
}

.rt-kicker {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #a5b4fc;
}

.rt-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 850;
  color: #fff;
}

.rt-card {
  padding: 26rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rt-index {
  font-size: 22rpx;
  color: var(--text-muted);
}

.rt-surface {
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--text-primary);
}

.rt-choices {
  display: flex;
  gap: 18rpx;
}

.rt-choice {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.rt-choice.ok {
  background: rgba(52, 211, 153, 0.14);
  border: 1rpx solid rgba(52, 211, 153, 0.32);
  color: #34d399;
}

.rt-choice.not-ok {
  background: rgba(251, 146, 60, 0.12);
  border: 1rpx solid rgba(251, 146, 60, 0.3);
  color: #fdba74;
}

.rt-choice:active {
  opacity: 0.75;
}

.rt-feedback {
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.rt-feedback.good {
  background: rgba(52, 211, 153, 0.1);
  border: 1rpx solid rgba(52, 211, 153, 0.26);
}

.rt-feedback.warm {
  background: rgba(251, 191, 36, 0.08);
  border: 1rpx solid rgba(251, 191, 36, 0.24);
}

.rt-feedback-main {
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--text-primary);
}

.rt-feedback.good .rt-feedback-main {
  color: #6ee7b7;
}

.rt-anchor {
  font-size: 22rpx;
  color: var(--text-muted);
}

.rt-loading,
.rt-empty {
  padding: 40rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.rt-error {
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 26rpx;
  color: #fca5a5;
}

.rt-retry {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(129, 140, 248, 0.18);
  color: #a5b4fc;
  font-size: 26rpx;
  font-weight: 600;
}

.rt-done {
  padding: 36rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
  background:
    radial-gradient(circle at top, rgba(52, 211, 153, 0.14), transparent 55%),
    rgba(15, 23, 42, 0.62);
}

.rt-done-title {
  font-size: 34rpx;
  font-weight: 850;
  color: #fff;
}

.rt-done-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* ── 反馈精细化: 门道段 + 定位 chip + 完场分解 ── */
.rt-feedback-why { display: block; font-size: 25rpx; line-height: 1.7; margin-top: 8rpx; color: var(--text-primary); }
.rt-anchor-chip { display: inline-block; margin-top: 12rpx; font-size: 21rpx; padding: 4rpx 14rpx; border-radius: 99rpx; border: 2rpx solid rgba(128,128,128,.35); color: var(--text-muted); }
.rt-done-break { display: flex; gap: 12rpx; justify-content: center; margin: 10rpx 0 4rpx; }
.rt-done-chip { font-size: 22rpx; font-weight: 700; padding: 4rpx 16rpx; border-radius: 99rpx; }
.rt-done-chip.good { background: rgba(110,231,183,.14); color: #6ee7b7; }
.rt-done-chip.warm { background: rgba(240,180,100,.14); color: #f0b464; }
