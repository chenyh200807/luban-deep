@import "/packageDeeptutor/styles/paper-ink.wxss";

/* retest.wxss — 变体轻练/复测 · 纸墨版
 * token 全走 paper-ink.wxss --pk-*(单一 token 权威); 动效只动 transform/opacity。 */

.rt-page { min-height: 100vh; }

/* ── 导航(纸墨, 与 gauntlet 同构) ── */
.rt-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 20; background: var(--pk-paper); }
.rt-nav-inner { display: flex; align-items: center; gap: 18rpx; height: 88rpx; padding: 0 24rpx; }
.rt-back { width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--pk-card); border: 2rpx solid var(--pk-bd); }
.rt-back-arrow { font-size: 40rpx; line-height: 1; color: var(--pk-t1); margin-top: -4rpx; }
.rt-nav-titles { flex: 1; display: flex; flex-direction: column; }
.rt-nav-title { font-size: 30rpx; font-weight: 700; color: var(--pk-t1); }
.rt-nav-sub { font-size: 21rpx; color: var(--pk-t3); }
.rt-nav-count { font-size: 25rpx; font-weight: 700; color: var(--pk-t2); font-variant-numeric: tabular-nums; }

.rt-scroll { position: fixed; left: 0; right: 0; bottom: 0; }
.rt-inner { padding: 24rpx 24rpx 80rpx; display: flex; flex-direction: column; gap: 22rpx; }

/* ── 开场一句 ── */
.rt-hero { padding: 10rpx 6rpx 0; display: flex; flex-direction: column; gap: 6rpx; }
.rt-kicker { font-size: 23rpx; letter-spacing: 2rpx; color: var(--pk-t3); }
.rt-title { font-size: 40rpx; line-height: 1.4; font-weight: 700; color: var(--pk-t1); font-family: "Songti SC", "Noto Serif CJK SC", serif; }

/* ── 墨点进度 ── */
.rt-dots { display: flex; gap: 14rpx; padding: 4rpx 6rpx; }
.rt-dot { width: 16rpx; height: 16rpx; border-radius: 50%; border: 3rpx solid var(--pk-t3); opacity: .55; transition: transform .25s ease-out, opacity .25s ease-out; }
.rt-dot.now { border-color: var(--pk-t1); opacity: 1; transform: scale(1.35); }
.rt-dot.good { background: var(--pk-grn); border-color: var(--pk-grn); opacity: 1; }
.rt-dot.warm { background: var(--pk-warn); border-color: var(--pk-warn); opacity: 1; }
.rt-dot.picked { background: var(--pk-t2); border-color: var(--pk-t2); opacity: .8; }

/* ── 题卡(单题聚焦) ── */
.rt-card { padding: 30rpx 30rpx 34rpx; display: flex; flex-direction: column; gap: 22rpx; }
.rt-card-head { display: flex; align-items: center; justify-content: space-between; }
.rt-card-head-left { display: flex; align-items: center; gap: 14rpx; }
.rt-card-hint { font-size: 21rpx; color: var(--pk-t3); }
/* 考法坐标 chip(签发 rule_group): 竹青软底胶囊, 对照 practice 富页的题型标 */
.rt-tag { font-size: 20rpx; font-weight: 700; color: var(--pk-grn); background: var(--pk-accent-soft); border: 1rpx solid var(--pk-accent-border); border-radius: 999rpx; padding: 4rpx 16rpx; }
/* 进度条: 环底轨 + 墨色填充(答到第几题) */
.rt-bar { height: 8rpx; border-radius: 999rpx; background: var(--pk-gauge); overflow: hidden; }
.rt-bar-fill { height: 100%; border-radius: 999rpx; background: var(--pk-t1); transition: width .3s ease-out; }
.rt-surface { font-size: 32rpx; line-height: 1.75; color: var(--pk-t1); font-family: "Songti SC", "Noto Serif CJK SC", serif; }

.rt-choices { display: flex; gap: 18rpx; margin-top: 6rpx; }
.rt-choice { flex: 1; height: 92rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; font-size: 28rpx; font-weight: 700; border: 3rpx solid var(--pk-bd); color: var(--pk-t1); background: transparent; transition: transform .12s ease-out; }
.rt-choice.ok { border-color: var(--pk-grn); color: var(--pk-grn); }
.rt-choice.not-ok { border-color: var(--pk-warn); color: var(--pk-warn); }
.rt-choice-press { transform: scale(0.97); opacity: .85; }
.rt-choices.mcq { flex-direction: column; }
.rt-choice.mcq-option { flex: none; width: 100%; box-sizing: border-box; height: auto; min-height: 92rpx; justify-content: flex-start; text-align: left; padding: 20rpx 22rpx; gap: 16rpx; font-size: 25rpx; line-height: 1.55; font-weight: 500; align-items: flex-start; background: var(--pk-card); }
/* 选中态用墨(主选择语义), 不用竹青——竹青是"答对"信号, 判分权在服务端 */
.rt-choice.mcq-option.selected { border-color: var(--pk-t1); background: var(--pk-gauge); box-shadow: 0 4rpx 14rpx var(--pk-shadow); }
.rt-choice.mcq-option.selected .rt-choice-letter { background: var(--pk-t1); }
.rt-choice-letter { width: 44rpx; height: 44rpx; border-radius: 12rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: var(--pk-paper); background: var(--pk-t2); font-size: 23rpx; font-weight: 800; margin-top: 2rpx; }
.rt-pending { display: flex; flex-direction: column; gap: 18rpx; padding-top: 6rpx; font-size: 23rpx; line-height: 1.6; color: var(--pk-t2); }

/* ── 印章反馈(答后滑入, 只动 transform/opacity) ── */
@keyframes rt-slide-in {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes rt-stamp-in {
  0% { opacity: 0; transform: scale(1.6) rotate(-14deg); }
  60% { opacity: 1; transform: scale(0.94) rotate(-8deg); }
  100% { opacity: 1; transform: scale(1) rotate(-8deg); }
}
.rt-verdict { display: flex; flex-direction: column; gap: 20rpx; animation: rt-slide-in .32s ease-out both; }
.rt-seal-row { display: flex; align-items: center; gap: 22rpx; }
.rt-seal { width: 104rpx; height: 104rpx; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 27rpx; font-weight: 800; letter-spacing: 2rpx; border: 4rpx solid; animation: rt-stamp-in .45s ease-out both; font-family: "Songti SC", "Noto Serif CJK SC", serif; }
.rt-seal.good { color: var(--pk-grn); border-color: var(--pk-grn); background: transparent; }
.rt-seal.warm { color: var(--pk-warn); border-color: var(--pk-warn); background: transparent; }
.rt-seal-copy { display: flex; flex-direction: column; gap: 4rpx; }
.rt-verdict-main { font-size: 30rpx; font-weight: 700; color: var(--pk-t1); }
.rt-verdict-sub { font-size: 23rpx; color: var(--pk-t2); }

/* 门道(签发正确说法) */
.rt-truth { display: flex; gap: 16rpx; align-items: flex-start; padding: 20rpx 22rpx; border-radius: 14rpx; background: var(--pk-gauge); }
.rt-truth-label { flex-shrink: 0; font-size: 22rpx; font-weight: 800; color: var(--pk-t2); letter-spacing: 2rpx; padding-top: 4rpx; }
.rt-truth-text { font-size: 27rpx; line-height: 1.75; color: var(--pk-t1); }

/* 教材原文并排卡(书页样: 朱红书脊 + 衬线原文 + 页码角注) */
.rt-book { display: flex; border-radius: 14rpx; overflow: hidden; border: 2rpx solid var(--pk-bd); background: var(--pk-card); animation: rt-slide-in .4s ease-out .12s both; }
.rt-book-spine { width: 10rpx; flex-shrink: 0; background: var(--pk-red); }
.rt-book-body { flex: 1; padding: 22rpx 24rpx; display: flex; flex-direction: column; gap: 10rpx; }
.rt-book-kicker { font-size: 21rpx; letter-spacing: 2rpx; color: var(--pk-red); font-weight: 700; }
.rt-book-quote { font-size: 27rpx; line-height: 1.85; color: var(--pk-t1); font-family: "Songti SC", "Noto Serif CJK SC", serif; }
.rt-book-foot { display: flex; justify-content: space-between; align-items: baseline; border-top: 2rpx dashed var(--pk-bd); padding-top: 10rpx; }
.rt-book-label { font-size: 22rpx; color: var(--pk-t2); }
.rt-book-page { font-size: 22rpx; color: var(--pk-t3); font-variant-numeric: tabular-nums; }

.rt-anchor { font-size: 20rpx; color: var(--pk-t3); }
.rt-next { margin-top: 4rpx; }

/* ── 完场收据 ── */
.rt-receipt { padding: 34rpx 30rpx; display: flex; flex-direction: column; gap: 24rpx; animation: rt-slide-in .32s ease-out both; }
.rt-receipt-head { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 2rpx dashed var(--pk-bd); padding-bottom: 18rpx; }
.rt-receipt-kicker { font-size: 26rpx; font-weight: 700; color: var(--pk-t1); }
.rt-receipt-score { display: flex; align-items: baseline; gap: 6rpx; }
.rt-receipt-big { font-size: 64rpx; font-weight: 800; color: var(--pk-t1); font-variant-numeric: tabular-nums; font-family: "Songti SC", "Noto Serif CJK SC", serif; }
.rt-receipt-slash { font-size: 28rpx; color: var(--pk-t3); font-variant-numeric: tabular-nums; }
.rt-receipt-rows { display: flex; flex-direction: column; gap: 12rpx; }
.rt-receipt-row { display: flex; gap: 18rpx; align-items: baseline; }
.rt-receipt-k { flex-shrink: 0; font-size: 22rpx; color: var(--pk-t3); letter-spacing: 2rpx; }
.rt-receipt-v { font-size: 25rpx; color: var(--pk-t1); }

.rt-review-list, .rt-right-list { display: flex; flex-direction: column; gap: 16rpx; }
.rt-review-label { font-size: 23rpx; color: var(--pk-t2); padding: 0 4rpx; }

/* ── 结构化裁决卡(对照 practice 富页 ✓/✕ 卡, 纸墨化) ──
 * 左轨色 = 裁决语义: 赭红=失分 / 竹青=得分; 内容全部签发字段逐字。 */
.rt-vcard { border-radius: 14rpx; border: 2rpx solid var(--pk-bd); border-left-width: 8rpx; background: var(--pk-card); padding: 22rpx 24rpx; display: flex; flex-direction: column; gap: 14rpx; }
.rt-vcard.warm { border-left-color: var(--pk-warn); }
.rt-vcard.good { border-left-color: var(--pk-grn); }
.rt-vcard-head { display: flex; gap: 14rpx; align-items: flex-start; }
.rt-vmark { width: 40rpx; height: 40rpx; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 800; color: var(--pk-paper); margin-top: 4rpx; }
.rt-vmark.warm { background: var(--pk-warn); }
.rt-vmark.good { background: var(--pk-grn); }
.rt-vcard-truth { flex: 1; font-size: 26rpx; line-height: 1.7; font-weight: 700; color: var(--pk-t1); }
.rt-vrow { display: flex; flex-direction: column; gap: 4rpx; padding-left: 54rpx; }
.rt-vlabel { font-size: 21rpx; font-weight: 800; letter-spacing: 1rpx; }
.rt-vlabel.pick { color: var(--pk-t3); }
.rt-vlabel.bait { color: var(--pk-t2); }
.rt-vlabel.loss { color: var(--pk-warn); }
.rt-vlabel.fix { color: var(--pk-grn); }
.rt-vtext { font-size: 23rpx; line-height: 1.65; color: var(--pk-t2); }
.rt-vtext.fix { color: var(--pk-t1); font-weight: 600; }
.rt-vbook { margin-left: 54rpx; }
.rt-receipt-clean { font-size: 25rpx; color: var(--pk-grn); }

.rt-stamp-row { display: flex; align-items: center; gap: 20rpx; }
.rt-stamp { width: 120rpx; height: 120rpx; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 25rpx; font-weight: 800; line-height: 1.3; letter-spacing: 2rpx; color: var(--pk-red); border: 4rpx solid var(--pk-red); animation: rt-stamp-in .5s ease-out .1s both; font-family: "Songti SC", "Noto Serif CJK SC", serif; }
.rt-stamp-note { flex: 1; font-size: 24rpx; line-height: 1.7; color: var(--pk-t2); }

/* ── 状态 ── */
.rt-error, .rt-empty { padding: 36rpx 28rpx; text-align: center; font-size: 26rpx; color: var(--pk-t2); display: flex; flex-direction: column; gap: 18rpx; align-items: center; }
.rt-retry { padding: 12rpx 44rpx; }
.rt-loading { padding: 60rpx 24rpx; text-align: center; font-size: 26rpx; color: var(--pk-t3); }
.rt-pool { font-size: 22rpx; color: var(--pk-t3); margin-top: 4rpx; }

/* 三角回路: 复测→考点卡 */
.rt-cc-link {
  margin: 20rpx 0 4rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(72, 128, 106, 0.07);
  border: 1rpx dashed rgba(72, 128, 106, 0.32);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
}
.rt-cc-link-tx {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pk-grn);
}
.rt-cc-link-arrow {
  font-size: 30rpx;
  color: var(--pk-grn);
  font-weight: 700;
}
