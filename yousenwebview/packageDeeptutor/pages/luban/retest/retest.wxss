@import "/packageDeeptutor/theme.wxss";

/* 换皮复测 · 第10轮 10c 纸墨视觉（宣纸亮 / 夜宣纸暗）
 * 全部主题色走 --lb-* token；语义三态只用暖色（对=竹青 / 错=暖金提醒），
 * 禁红灯墙。低透明度 tint 为 token 色的 alpha 版（hex token 表达不了 alpha）。 */

.luban-page {
  height: 100vh;
  background-color: var(--lb-bg);
  background-image: radial-gradient(
    rgba(241, 239, 232, 0.05) 1.4rpx,
    transparent 1.4rpx
  );
  background-size: 36rpx 36rpx;
  color: var(--lb-t1);
  overflow: hidden;
}

.luban-page.light {
  background-image: radial-gradient(
    rgba(38, 36, 31, 0.1) 1.4rpx,
    transparent 1.4rpx
  );
}

.lb-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--lb-bg);
  border-bottom: 1rpx solid var(--lb-bd);
}

.lb-nav-inner {
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 0;
  gap: 16rpx;
}

.lb-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: 20rpx;
  padding: 8rpx 12rpx 8rpx 4rpx;
  border-radius: 8rpx;
}

.lb-back:active {
  opacity: 0.7;
}

.lb-back-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: var(--lb-t3);
  font-weight: 300;
  margin-top: -4rpx;
}

.lb-back-text {
  font-size: 28rpx;
  color: var(--lb-t3);
  font-weight: 500;
}

.lb-nav-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lb-t1);
}

.lb-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  overflow-y: auto;
}

.lb-inner {
  padding: 28rpx 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rt-hero,
.rt-card,
.rt-empty,
.rt-error,
.rt-done {
  border-radius: 28rpx;
  border: 1rpx solid var(--lb-bd);
  background: var(--lb-card);
}

.rt-hero {
  padding: 28rpx 26rpx;
}

.rt-kicker {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--lb-good);
}

.rt-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 800;
  color: var(--lb-t1);
}

.rt-card {
  padding: 26rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rt-index {
  font-size: 24rpx;
  color: var(--lb-t3);
}

.rt-surface {
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--lb-t1);
}

.rt-choices {
  display: flex;
  gap: 18rpx;
}

.rt-choice {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
}

/* 判断题二选一：竹青（妥当）/ 暖金（不妥当）——语义暖色，不上红 */
.rt-choice.ok {
  background: rgba(85, 150, 123, 0.14);
  border: 1rpx solid rgba(85, 150, 123, 0.35);
  color: var(--lb-good);
}

.rt-choice.not-ok {
  background: rgba(212, 178, 99, 0.12);
  border: 1rpx solid rgba(212, 178, 99, 0.32);
  color: var(--lb-warn);
}

.rt-choice:active {
  opacity: 0.75;
}

.rt-feedback {
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.rt-feedback.good {
  background: rgba(85, 150, 123, 0.1);
  border: 1rpx solid rgba(85, 150, 123, 0.28);
}

.rt-feedback.warm {
  background: rgba(212, 178, 99, 0.1);
  border: 1rpx solid rgba(212, 178, 99, 0.26);
}

.rt-feedback-main {
  font-size: 28rpx;
  line-height: 1.6;
  font-weight: 700;
  color: var(--lb-t1);
}

.rt-feedback.good .rt-feedback-main {
  color: var(--lb-good);
}

.rt-feedback-detail {
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--lb-t1);
}

.rt-anchor {
  font-size: 24rpx;
  color: var(--lb-t3);
}

.rt-loading,
.rt-empty {
  padding: 40rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--lb-t3);
}

.rt-loading {
  border-radius: 28rpx;
}

.rt-error {
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 26rpx;
  color: var(--lb-bad);
}

.rt-retry {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--lb-bd);
  color: var(--lb-t1);
  font-size: 26rpx;
  font-weight: 600;
}

.rt-done {
  padding: 36rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
}

.rt-done-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lb-t1);
}

.rt-done-desc {
  font-size: 26rpx;
  color: var(--lb-t3);
}
