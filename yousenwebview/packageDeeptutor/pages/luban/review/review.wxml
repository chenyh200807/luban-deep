<view class="luban-page {{isDark ? '' : 'light'}}">
  <view class="lb-inner" style="padding-top: {{statusBarHeight + 48}}px">

    <!-- 顶栏：复习 · 学过的到期回炉（10c） -->
    <view class="rv-head">
      <text class="rv-head-title">复习</text>
      <text class="rv-head-sub">学过的 · 到期回炉</text>
    </view>

    <view class="rv-error" wx:if="{{errorText}}">
      <text>{{errorText}}</text>
      <view class="rv-retry" bindtap="retry">重试</view>
    </view>

    <view class="rv-loading" wx:if="{{loading}}">
      <text>正在整理今天的回炉任务…</text>
    </view>

    <block wx:if="{{!loading && !errorText}}">

      <!-- 空态（D1 铁律）：一站未点亮，深链学习 tab -->
      <view class="rv-empty" wx:if="{{!lessons.length}}">
        <text class="rv-empty-kicker">复习 · 回炉</text>
        <text class="rv-empty-title">回炉的都是你学过的</text>
        <text class="rv-empty-desc">这里只放你点亮过的站。点亮第一站之后，第二天这里就会有你的复习任务。</text>
        <view class="rv-empty-cta" bindtap="goLearn">
          <text>先去点亮第一站 →</text>
        </view>
      </view>

      <block wx:else>
        <!-- 今日到期 hero -->
        <view class="rv-hero">
          <view class="rv-hero-row">
            <view
              class="rv-gauge"
              style="background: conic-gradient(var(--lb-good) {{duePercent}}%, var(--lb-bd) 0)"
            >
              <view class="rv-gauge-core">
                <text class="rv-gauge-num">{{dueCount}}</text>
                <text class="rv-gauge-label">到期</text>
              </view>
            </view>
            <view class="rv-hero-titles">
              <text class="rv-hero-title" wx:if="{{dueCount}}">今日回炉 {{dueCount}} 站 · 昨天的约定</text>
              <text class="rv-hero-title" wx:else>今天没有到期的回炉任务</text>
              <text class="rv-hero-desc" wx:if="{{dueCount}}">都是你学过的考点，换了身皮再见一面</text>
              <text class="rv-hero-desc" wx:else>你点亮的站都稳着。想主动翻一翻，用下面的检索。</text>
            </view>
          </view>
          <view class="rv-hero-cta" wx:if="{{dueCount}}" bindtap="startDue">
            <text>开始回炉</text>
          </view>
          <text class="rv-hero-note" wx:if="{{dueNotice}}">{{dueNotice}}</text>
        </view>

        <!-- 昨天的约定 · 换皮复测（首个到期站，兑现交接时刻） -->
        <view
          class="rv-pact"
          wx:if="{{firstDue}}"
          data-pack-id="{{firstDue.packId}}"
          bindtap="openRetest"
        >
          <view class="rv-pact-stamp"><text>变</text></view>
          <view class="rv-pact-body">
            <text class="rv-pact-kicker">昨天的约定 · 换皮复测</text>
            <text class="rv-pact-title">{{firstDue.title}} · 变体 {{firstDue.count}} 题</text>
            <text class="rv-pact-desc">数字和主体换了身皮，判别逻辑没变——认出它，你就是真懂了</text>
          </view>
          <text class="rv-pact-link">复测</text>
        </view>

        <!-- 到期清单 -->
        <view class="rv-list" wx:if="{{dueEntries.length}}">
          <view class="rv-list-head">
            <text class="rv-list-title">到期清单</text>
            <text class="rv-list-hint">今日到期 · 服务端排定</text>
          </view>
          <view
            class="rv-row"
            wx:for="{{dueEntries}}"
            wx:key="packId"
            data-pack-id="{{item.packId}}"
            bindtap="openRetest"
          >
            <view class="rv-row-icon icon-rv-card"></view>
            <view class="rv-row-body">
              <text class="rv-row-title">{{item.title}}</text>
              <text class="rv-row-sub">换皮复测 · {{item.count}} 题</text>
            </view>
            <text class="rv-row-link">回炉</text>
          </view>
        </view>

        <!-- 资产入口：错因银行（错题本唯一入口，错因名走 labelFor） -->
        <view class="rv-asset" bindtap="openMistakeBook">
          <view class="rv-row-icon warm icon-rv-bank"></view>
          <view class="rv-row-body">
            <text class="rv-row-title">错因银行{{mistakeActiveCount > 0 ? ' · ' + mistakeActiveCount + ' 笔待还' : ''}}</text>
            <text class="rv-row-sub">每笔都能回到当时的解析，还清一笔销一笔</text>
          </view>
          <text class="rv-asset-arrow">›</text>
        </view>

        <!-- 资产入口：考点卡库（后端未供给字段，诚实占位不造文案） -->
        <view class="rv-asset disabled">
          <view class="rv-row-icon icon-rv-book"></view>
          <view class="rv-row-body">
            <text class="rv-row-title">考点卡库</text>
            <text class="rv-row-sub">30 秒再认 · 教材原文并排</text>
          </view>
          <text class="rv-asset-badge">即将开通</text>
        </view>

        <!-- 自主检索（纯前端过滤已加载数据） -->
        <view class="rv-search">
          <text class="rv-search-title">想自己翻？按维度检索</text>
          <view class="rv-chips">
            <view
              class="rv-chip {{searchMode === 'pack' ? 'active' : ''}}"
              data-mode="pack"
              bindtap="setSearchMode"
            >
              <text>按母题</text>
            </view>
            <view
              class="rv-chip {{searchMode === 'error' ? 'active' : ''}}"
              data-mode="error"
              bindtap="setSearchMode"
            >
              <text>按错因</text>
            </view>
          </view>

          <block wx:if="{{searchMode === 'pack'}}">
            <view
              class="rv-row plain"
              wx:for="{{lessons}}"
              wx:key="pack_id"
              data-pack-id="{{item.pack_id}}"
              bindtap="openRetest"
            >
              <view class="rv-row-icon icon-rv-card"></view>
              <view class="rv-row-body">
                <text class="rv-row-title">{{item.title}}</text>
                <text class="rv-row-sub">已点亮 · 随时回炉</text>
              </view>
              <text class="rv-row-link">回炉</text>
            </view>
          </block>

          <block wx:else>
            <view
              class="rv-row plain"
              wx:for="{{errorBars}}"
              wx:key="key"
              bindtap="openMistakeBook"
            >
              <view class="rv-row-icon warm icon-rv-bank"></view>
              <view class="rv-row-body">
                <text class="rv-row-title">{{item.label}}</text>
                <text class="rv-row-sub">{{item.count}} 题 · 去错因银行看解析</text>
              </view>
              <text class="rv-row-link">查看</text>
            </view>
            <view class="rv-search-empty" wx:if="{{!errorBars.length}}">
              <text>还没有沉淀错因。做题后收藏错题，这里会按错因聚拢。</text>
            </view>
          </block>
        </view>
      </block>
    </block>
  </view>
  <workspace-shell id="workspaceShell"></workspace-shell>
</view>
