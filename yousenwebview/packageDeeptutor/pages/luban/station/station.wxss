@import "/packageDeeptutor/theme.wxss";

/* 站点页 · 第10轮 10a/10b 视觉（只换皮，三段结构与逻辑不动）
 * 全部颜色走 --lb-* token；主按钮墨色、暗色反转纸色（bg=t1 / 字=bg）。 */

page {
  height: 100%;
  background: var(--lb-bg);
}

.station-page {
  height: 100vh;
  background: var(--lb-bg);
}

web-view {
  width: 100%;
  height: 100%;
}

.st-loading,
.st-error,
.st-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 80rpx 48rpx;
  height: 60vh;
  color: var(--lb-t3);
  font-size: 28rpx;
  text-align: center;
}

.st-error text {
  color: var(--lb-bad);
}

.st-retry {
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: var(--lb-t1);
  color: var(--lb-bg);
  font-size: 28rpx;
  font-weight: 700;
}

.st-retry.ghost {
  background: transparent;
  border: 1rpx solid var(--lb-bd);
  color: var(--lb-t3);
}

.st-fallback-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lb-t1);
}

.st-fallback-hint {
  font-size: 26rpx;
  color: var(--lb-t3);
}

.st-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--lb-card);
  border-top: 1rpx solid var(--lb-bd);
}

/* 主按钮 = 墨色（亮色 t1=墨），暗色反转纸色（暗色 t1=纸） */
.st-primary {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: var(--lb-t1);
  color: var(--lb-bg);
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.st-primary:active {
  opacity: 0.85;
}
