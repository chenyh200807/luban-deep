@import "/packageDeeptutor/styles/paper-ink.wxss";

/* 站点播放页 native 壳 · 纸墨朱竹(web-view 内容为讲懂/闯关卡,归内容任务) */
.station-page {
  height: 100vh;
}

web-view {
  width: 100%;
  height: 100%;
}

.st-loading,
.st-error,
.st-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 80rpx 48rpx;
  height: 60vh;
  color: var(--pk-t2);
  font-size: 28rpx;
  text-align: center;
}

.st-error text {
  color: var(--pk-warn);
}

.st-retry {
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: var(--pk-ink-btn);
  color: var(--pk-ink-btn-t);
  font-size: 28rpx;
  font-weight: 700;
}

.st-retry.ghost {
  background: transparent;
  border: 1rpx solid var(--pk-bd);
  color: var(--pk-t2);
}

.st-fallback-title {
  font-family: "Long Cang", "Kaiti SC", serif;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--pk-red);
}

.st-fallback-hint {
  font-size: 26rpx;
  color: var(--pk-t3);
}
