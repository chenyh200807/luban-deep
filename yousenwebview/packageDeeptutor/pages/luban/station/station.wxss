@import "/packageDeeptutor/theme.wxss";

page {
  height: 100%;
  background: var(--bg-primary);
}

.station-page {
  height: 100vh;
}

web-view {
  width: 100%;
  height: 100%;
}

.st-loading,
.st-error,
.st-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 80rpx 48rpx;
  height: 60vh;
  color: var(--text-secondary);
  font-size: 28rpx;
  text-align: center;
}

.st-error text {
  color: #fca5a5;
}

.st-retry {
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: rgba(129, 140, 248, 0.18);
  color: #a5b4fc;
  font-size: 28rpx;
  font-weight: 600;
}

.st-retry.ghost {
  background: transparent;
  border: 1rpx solid rgba(148, 163, 184, 0.3);
  color: var(--text-tertiary);
}

.st-fallback-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.st-fallback-hint {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.st-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(10, 14, 24, 0.94);
  border-top: 1rpx solid var(--border);
}

.st-primary {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.st-primary:active {
  opacity: 0.85;
}
