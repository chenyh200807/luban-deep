<view class="station-page paper {{isDark ? '' : 'light'}} pk-paper-bg">
  <view class="st-loading" wx:if="{{loading}}">
    <text>正在打开这一站…</text>
  </view>

  <view class="st-error" wx:elif="{{errorText}}">
    <text>{{errorText}}</text>
    <view class="st-retry" bindtap="retry">重试</view>
    <view class="st-retry ghost" bindtap="goBack">返回路线</view>
  </view>

  <block wx:else>
    <!-- 所有已编译 pack 共用 finished 讲懂/随堂练两幕。 -->
    <web-view wx:if="{{currentUrl}}" src="{{currentUrl}}"></web-view>
    <view class="st-fallback" wx:else>
      <text class="st-fallback-title">{{title}}</text>
      <text class="st-fallback-hint">这一站的卡片正在准备中，先往下走也没问题。</text>
    </view>

    <!-- 底部常驻按钮（见 station.js 顶部 caveat：真机可能被 web-view 覆盖） -->
    <view class="st-footer" wx:if="{{tier === 'lesson'}}">
      <view class="st-primary" bindtap="onPrimaryTap">
        <text>看完了，练 5 题</text>
      </view>
    </view>
  </block>
</view>
