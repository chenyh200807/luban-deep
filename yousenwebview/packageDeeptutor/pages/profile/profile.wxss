@import "/packageDeeptutor/theme.wxss";

/* pages/profile/profile.wxss — 我的 tab（第10轮 10f：纸墨朱竹）
 *
 * --pk-* token 为页面作用域（theme.wxss 尚无纸墨 token，不越权改共享主题）：
 * 暗 = 10f2 夜宣纸；亮 = 10f 宣纸。取值权威 = 第10轮定稿画布 10f/10f2 区块。
 * 朱红 --pk-red 只留品牌位，本页不用作大面积强调色。 */

.profile-page {
  /* 夜宣纸（暗，默认） */
  --pk-bg: #1c1a15;
  --pk-card: #26231d;
  --pk-bd: #37332a;
  --pk-t1: #f0ede1;
  --pk-t2: #b7b2a2;
  --pk-t3: #8a8574;
  --pk-red: #cf4436;
  --pk-grn: #7fb99d;
  --pk-gauge: #3a362c;
  --pk-bad: #bf5b4e;

  height: 100vh;
  background-color: var(--pk-bg);
  overflow: hidden;
  color: var(--pk-t1);
}

.profile-page.light {
  /* 宣纸（亮） */
  --pk-bg: #f5f3ec;
  --pk-card: #fffdf8;
  --pk-bd: #e7e3d5;
  --pk-t1: #26241f;
  --pk-t2: #5b584e;
  --pk-t3: #96917e;
  --pk-red: #cf4436;
  --pk-grn: #48806a;
  --pk-gauge: #e9e5d7;
  --pk-bad: #bf5b4e;

  /* 宣纸点阵纹理（10f：radial-gradient 点阵） */
  background-image: radial-gradient(rgba(38, 36, 31, 0.1) 1.4rpx, transparent 1.4rpx);
  background-size: 36rpx 36rpx;
}

/* ── 导航栏 ──────────────────────────────────────── */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: rgba(28, 26, 21, 0.92);
  border-bottom: 1rpx solid var(--pk-bd);
}

.profile-page.light .nav-bar {
  background: rgba(245, 243, 236, 0.92);
}

.nav-content {
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 0;
  gap: 16rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: 20rpx;
  padding: 8rpx 12rpx 8rpx 4rpx;
  border-radius: 8rpx;
}

.nav-back:active {
  background: rgba(240, 237, 225, 0.08);
}

.profile-page.light .nav-back:active {
  background: rgba(38, 36, 31, 0.05);
}

.nav-back-arrow {
  font-size: 40rpx;
  color: var(--pk-grn);
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-back-txt {
  font-size: 28rpx;
  color: var(--pk-grn);
  font-weight: 500;
}

/* ── 滚动区域 ────────────────────────────────────── */
.page-scroll {
  position: fixed;
  left: 0;
  right: 0;
  overflow-y: auto;
}

.page-inner {
  padding: 16rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  box-sizing: border-box;
}

/* ── 卡片基底 ───────────────────────────────── */
.pk-card {
  border-radius: 28rpx;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  padding: 26rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.2);
}

.profile-page.light .pk-card {
  box-shadow: 0 4rpx 24rpx rgba(38, 36, 31, 0.06);
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--pk-t3);
  padding: 6rpx 8rpx 0;
}

/* ── 用户行 ─────────────────────────────────── */
.user-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 14rpx 8rpx 4rpx;
}

.user-avatar {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--pk-card);
  border: 3rpx solid rgba(72, 128, 106, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-avatar:active {
  transform: scale(0.95);
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.avatar-char {
  font-size: 44rpx;
  color: var(--pk-grn);
  font-weight: 700;
}

.avatar-edit-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--pk-t1);
  border: 3rpx solid var(--pk-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-edit-icon {
  font-size: 22rpx;
  line-height: 1;
  color: var(--pk-bg);
  font-weight: 700;
  margin-top: -2rpx;
}

.user-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.user-name-row:active {
  opacity: 0.7;
}

.user-name {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.user-name-edit {
  font-size: 30rpx;
  color: var(--pk-t3);
}

.user-sub {
  font-size: 24rpx;
  color: var(--pk-t3);
}

/* ── 浏览模式 ───────────────────────────────── */
.guest-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.guest-kicker {
  font-size: 24rpx;
  color: var(--pk-t3);
  font-weight: 700;
}

.guest-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.guest-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--pk-t3);
}

/* 主按钮 = 墨色（暗色下为纸色反转），朱红只留品牌位 */
.guest-action {
  margin-top: 8rpx;
  min-height: 84rpx;
  border-radius: 22rpx;
  background: var(--pk-t1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.guest-action-txt {
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--pk-bg);
}

/* ── 我的路线 ───────────────────────────────── */
.route-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.route-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.route-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.route-count {
  font-size: 24rpx;
  color: var(--pk-t3);
}

.route-meter {
  height: 16rpx;
  border-radius: 8rpx;
  background: var(--pk-gauge);
  overflow: hidden;
}

.route-meter-fill {
  height: 100%;
  border-radius: 8rpx;
  background: var(--pk-grn);
}

.route-copy {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--pk-t2);
}

.route-copy-strong {
  font-weight: 800;
  color: var(--pk-t1);
}

.route-cta {
  min-height: 84rpx;
  border-radius: 22rpx;
  background: var(--pk-t1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-cta:active {
  opacity: 0.85;
}

.route-cta-txt {
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--pk-bg);
}

.route-note {
  font-size: 22rpx;
  color: var(--pk-t3);
}

/* ── 学习权益 ───────────────────────────────── */
.usage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.usage-kicker {
  display: block;
  font-size: 24rpx;
  color: var(--pk-t3);
}

.usage-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--pk-t1);
  margin-top: 4rpx;
}

.usage-action {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: var(--pk-t1);
}

.usage-action:active {
  opacity: 0.85;
}

.usage-action-txt {
  font-size: 25rpx;
  font-weight: 800;
  color: var(--pk-bg);
}

.usage-summary-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.usage-summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.usage-summary-label {
  font-size: 25rpx;
  color: var(--pk-t3);
}

.usage-summary-detail {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--pk-t1);
}

.usage-free-note {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--pk-t3);
  padding-top: 4rpx;
}

.usage-more-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  padding-top: 4rpx;
}

.usage-more-text,
.usage-more-arrow {
  font-size: 24rpx;
  color: var(--pk-t3);
}

.usage-empty {
  margin-top: 16rpx;
}

.usage-empty-txt {
  font-size: 24rpx;
  color: var(--pk-t3);
}

/* ── 复习提醒 ───────────────────────────────── */
.remind-card {
  padding: 20rpx 28rpx;
}

.remind-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.remind-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--pk-t3);
  flex-shrink: 0;
}

.remind-dot.on {
  background: var(--pk-grn);
}

.remind-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--pk-t1);
}

.remind-switch {
  transform: scale(0.82);
  transform-origin: right center;
}

.remind-note {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--pk-t3);
}

/* ── 学习设置 ───────────────────────────────── */
.settings-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 92rpx;
  padding: 10rpx 0;
}

.setting-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--pk-t1);
  flex-shrink: 0;
}

.setting-value-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.setting-value {
  font-size: 27rpx;
  color: var(--pk-t3);
}

.setting-arrow {
  font-size: 28rpx;
  color: var(--pk-t3);
}

.setting-note {
  display: block;
  font-size: 24rpx;
  color: var(--pk-t3);
  padding-bottom: 14rpx;
  margin-top: -6rpx;
}

.divider {
  height: 1rpx;
  background: var(--pk-bd);
}

.chips-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--pk-bd);
  background: transparent;
}

.chip:active {
  opacity: 0.8;
}

.chip-active {
  border-color: var(--pk-grn);
  background: rgba(72, 128, 106, 0.14);
}

.chip-txt {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--pk-t1);
}

.chip-active .chip-txt {
  color: var(--pk-grn);
}

/* ── 聚合入口 ───────────────────────────────── */
.links-card {
  padding-top: 4rpx;
  padding-bottom: 4rpx;
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--pk-bd);
}

.link-row:active {
  opacity: 0.7;
}

.link-row:last-child {
  border-bottom: none;
}

.link-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--pk-t1);
}

.link-arrow {
  font-size: 30rpx;
  color: var(--pk-t3);
}

/* ── 底部铭牌 / 退出 ────────────────────────── */
.footnote {
  display: block;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--pk-t3);
  padding: 4rpx 16rpx;
}

.logout-btn {
  min-height: 88rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--pk-bd);
  background: var(--pk-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn:active {
  opacity: 0.8;
}

.logout-btn-txt {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--pk-bad);
}

.tail-spacer {
  height: calc(200rpx + env(safe-area-inset-bottom));
}

/* ── 权益详情弹层 ───────────────────────────── */
.usage-detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease-out;
  z-index: 30;
}

.usage-detail-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.profile-page.light .usage-detail-mask {
  background: rgba(38, 36, 31, 0.28);
}

.usage-detail-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
  background: var(--pk-card);
  border-top: 1rpx solid var(--pk-bd);
  padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(110%);
  transition: transform 0.25s ease-out;
  z-index: 31;
}

.usage-detail-sheet.show {
  transform: translateY(0);
}

/* 亮色详情面板显式覆写：宣纸面 + 竹青渐变进度（可读性契约） */
.profile-page.light .usage-detail-sheet {
  background: var(--pk-card);
  border-top: 1rpx solid var(--pk-bd);
  box-shadow: 0 -8rpx 40rpx rgba(38, 36, 31, 0.12);
}

.usage-detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.usage-detail-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.usage-detail-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--pk-gauge);
}

.usage-detail-close-txt {
  font-size: 36rpx;
  color: var(--pk-t3);
}

.usage-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.usage-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.usage-row-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--pk-t1);
}

.usage-row-reset {
  display: block;
  font-size: 24rpx;
  color: var(--pk-t3);
}

.usage-row-percent {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--pk-t1);
}

.usage-meter {
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--pk-gauge);
  overflow: hidden;
}

.usage-meter-fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--pk-grn);
}

.profile-page.light .usage-detail-sheet .usage-meter-fill {
  background: linear-gradient(90deg, #48806a, #7fb99d);
}
