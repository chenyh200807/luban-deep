@import "/packageDeeptutor/theme.wxss";

/* 我的 tab · 第10轮 10f（宣纸亮 / 夜宣纸暗）
 * 全部主题色走 --lb-* token；仅宣纸点阵纹理保留低透明度中性 rgba
 * （与学习 tab stations.wxss 同口径：alpha 无法用 hex token 表达）。 */

.mine-page {
  min-height: 100vh;
  background-color: var(--lb-bg);
  background-image: radial-gradient(
    rgba(241, 239, 232, 0.05) 1.4rpx,
    transparent 1.4rpx
  );
  background-size: 36rpx 36rpx;
  color: var(--lb-t1);
}

.mine-page.light {
  background-image: radial-gradient(
    rgba(38, 36, 31, 0.1) 1.4rpx,
    transparent 1.4rpx
  );
}

.mine-scroll {
  position: fixed;
  left: 0;
  right: 0;
}

.mine-inner {
  padding: 16rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  box-sizing: border-box;
}

/* ── 卡片基底 ───────────────────────────────── */
.mine-card {
  border-radius: 28rpx;
  background: var(--lb-card);
  border: 1rpx solid var(--lb-bd);
  padding: 26rpx 28rpx;
  box-sizing: border-box;
}

.mine-kicker {
  display: block;
  font-size: 24rpx;
  color: var(--lb-t3);
}

.mine-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--lb-t3);
  padding: 6rpx 8rpx 0;
}

/* ── 用户行 ─────────────────────────────────── */
.mine-user-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 14rpx 8rpx 4rpx;
}

.mine-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--lb-card);
  border: 3rpx solid rgba(85, 150, 123, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.mine-avatar-img {
  width: 100%;
  height: 100%;
}

.mine-avatar-char {
  font-size: 44rpx;
  color: var(--lb-good);
  font-weight: 700;
}

.mine-user-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.mine-user-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mine-user-name {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lb-t1);
}

.mine-user-edit {
  font-size: 30rpx;
  color: var(--lb-t3);
}

.mine-user-sub {
  font-size: 24rpx;
  color: var(--lb-t3);
}

/* ── 浏览模式 ───────────────────────────────── */
.mine-guest-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.mine-guest-kicker {
  font-size: 24rpx;
  color: var(--lb-warn);
  font-weight: 700;
}

.mine-guest-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--lb-t1);
}

.mine-guest-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--lb-t3);
}

/* 主按钮 = 墨色（暗色下反转为纸色），朱红只留品牌四处 */
.mine-primary-btn {
  margin-top: 8rpx;
  min-height: 84rpx;
  border-radius: 22rpx;
  background: var(--lb-t1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mine-primary-btn-txt {
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--lb-bg);
}

/* ── 会员 + 钱包 ────────────────────────────── */
.mine-usage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mine-usage-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.mine-usage-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lb-t1);
}

.mine-usage-action {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: var(--lb-t1);
}

.mine-usage-action-txt {
  font-size: 25rpx;
  font-weight: 800;
  color: var(--lb-bg);
}

.mine-usage-rows {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.mine-usage-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mine-usage-label {
  font-size: 25rpx;
  color: var(--lb-t3);
}

.mine-usage-detail {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--lb-t1);
}

.mine-usage-more {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  padding-top: 4rpx;
}

.mine-usage-more-txt,
.mine-usage-more-arrow {
  font-size: 24rpx;
  color: var(--lb-t3);
}

.mine-usage-empty {
  margin-top: 16rpx;
}

.mine-usage-empty-txt {
  font-size: 24rpx;
  color: var(--lb-t3);
}

/* ── 免费小课额度 ●●○ ───────────────────────── */
.mine-quota-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mine-quota-title {
  font-size: 29rpx;
  font-weight: 800;
  color: var(--lb-t1);
}

.mine-quota-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.mine-quota-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 2rpx solid var(--lb-good);
  box-sizing: border-box;
}

.mine-quota-dot.lit {
  background: var(--lb-good);
}

.mine-quota-count {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: var(--lb-t3);
}

.mine-quota-note {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--lb-t3);
}

/* ── 「明天见」复测提醒 ──────────────────────── */
.mine-remind-card {
  padding: 20rpx 28rpx;
}

.mine-remind-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.mine-remind-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--lb-t3);
  flex-shrink: 0;
}

.mine-remind-dot.on {
  background: var(--lb-good);
}

.mine-remind-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--lb-t1);
}

.mine-remind-switch {
  transform: scale(0.82);
  transform-origin: right center;
}

.mine-remind-note-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.mine-remind-note {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--lb-t3);
}

.mine-remind-note-link {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--lb-good);
  flex-shrink: 0;
}

/* ── 学习设置 ───────────────────────────────── */
.mine-settings-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.mine-setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 92rpx;
  padding: 10rpx 0;
}

.mine-setting-col {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  padding: 18rpx 0;
}

.mine-setting-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--lb-t1);
  flex-shrink: 0;
}

.mine-setting-value-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mine-setting-value {
  font-size: 27rpx;
  color: var(--lb-t3);
}

.mine-setting-arrow {
  font-size: 28rpx;
  color: var(--lb-t3);
}

.mine-setting-note {
  display: block;
  font-size: 24rpx;
  color: var(--lb-t3);
  padding-bottom: 14rpx;
  margin-top: -6rpx;
}

.mine-divider {
  height: 1rpx;
  background: var(--lb-bd);
}

.mine-chips-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.mine-setting-col .mine-chips-row {
  justify-content: flex-start;
}

.mine-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--lb-bd);
  background: transparent;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.mine-chip.active {
  border-color: var(--lb-good);
  background: rgba(85, 150, 123, 0.14);
}

.mine-chip-txt {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--lb-t1);
}

.mine-chip.active .mine-chip-txt {
  color: var(--lb-good);
}

.mine-chip-desc {
  font-size: 24rpx;
  color: var(--lb-t3);
}

/* ── 聚合入口 ───────────────────────────────── */
.mine-links-card {
  padding-top: 4rpx;
  padding-bottom: 4rpx;
}

.mine-link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--lb-bd);
}

.mine-link-row:last-child {
  border-bottom: none;
}

.mine-link-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--lb-t1);
}

.mine-link-arrow {
  font-size: 30rpx;
  color: var(--lb-t3);
}

/* ── 底部铭牌 / 退出 ────────────────────────── */
.mine-footnote {
  display: block;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--lb-t3);
  padding: 4rpx 16rpx;
}

.mine-logout {
  min-height: 88rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--lb-bd);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mine-logout-txt {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--lb-bad);
}

.mine-tail-spacer {
  /* 壳遮挡：workspace-shell 高 140rpx */
  height: calc(160rpx + env(safe-area-inset-bottom));
}

/* ── 权益详情弹层 ───────────────────────────── */
.mine-detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease-out;
  z-index: 30;
}

.mine-detail-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.mine-detail-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
  background: var(--lb-card);
  border-top: 1rpx solid var(--lb-bd);
  padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(110%);
  transition: transform 0.25s ease-out;
  z-index: 31;
}

.mine-detail-sheet.show {
  transform: translateY(0);
}

.mine-detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.mine-detail-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--lb-t1);
}

.mine-detail-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mine-detail-close-txt {
  font-size: 36rpx;
  color: var(--lb-t3);
}

.mine-detail-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.mine-detail-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.mine-detail-row-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--lb-t1);
}

.mine-detail-row-reset {
  display: block;
  font-size: 24rpx;
  color: var(--lb-t3);
}

.mine-detail-row-percent {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--lb-t1);
}

.mine-meter {
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--lb-bd);
  overflow: hidden;
}

.mine-meter-fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--lb-good);
}
