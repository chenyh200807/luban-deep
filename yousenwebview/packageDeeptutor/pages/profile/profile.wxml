<!-- pages/profile/profile.wxml — 我的 tab（第10轮 10f：权益透明 · 纸墨朱竹） -->
<view class="profile-page paper {{isDark?'':'light'}} pk-paper-bg">

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-content">
      <view class="nav-back" bindtap="goHome">
        <text class="nav-back-arrow">‹</text>
        <text class="nav-back-txt">{{navBackLabel}}</text>
      </view>
      <view style="flex:1"></view>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}" style="top: {{navHeight}}px; bottom: 0">
    <view class="page-inner">

      <!-- ── 用户行：头像 + 昵称 + 考试日副标题 ─────────── -->
      <view class="user-row">
        <view class="user-avatar" bindtap="onChangeAvatar">
          <image
            wx:if="{{avatarUrl}}"
            class="avatar-image"
            src="{{avatarUrl}}"
            mode="aspectFill"
          />
          <text wx:else class="avatar-char">{{avatarChar}}</text>
          <view class="avatar-edit-badge">
            <text class="avatar-edit-icon">+</text>
          </view>
        </view>
        <view class="user-info" bindtap="onChangeName">
          <view class="user-name-row">
            <text class="user-name">{{username}}</text>
            <text class="user-name-edit">›</text>
          </view>
          <text class="user-sub">一建建筑实务 · {{examDateLabel}}</text>
        </view>
      </view>

      <!-- ── 浏览模式提示 ───────────────────────────── -->
      <view class="pk-card guest-card" wx:if="{{isGuestPreview}}">
        <text class="guest-kicker">浏览模式</text>
        <text class="guest-title">登录后同步你的权益和学习档案</text>
        <text class="guest-desc">当前可以查看个人中心结构；修改设置、同步权益和保存学习记录时再快速登录。</text>
        <view class="guest-action" bindtap="goQuickLogin" aria-role="button" aria-label="快速登录">
          <text class="guest-action-txt">快速登录</text>
        </view>
      </view>

      <!-- ── 我的路线（点亮数=learn-view-model 单一权威；读不到只留口径文案） ── -->
      <view class="pk-card route-card">
        <view class="route-head">
          <text class="route-title">我的路线</text>
          <text class="route-count" wx:if="{{routeCard}}">{{routeCard.label}}</text>
        </view>
        <view class="route-meter" wx:if="{{routeCard}}">
          <view class="route-meter-fill" style="{{routeCard.barStyle}}"></view>
        </view>
        <text class="route-copy">每一站都标了「为什么对你重要」。会员解锁的是<text class="route-copy-strong">你这条路线的剩余部分</text>，不是题库。</text>
        <view class="route-cta" bindtap="goRoute" aria-role="button" aria-label="查看我的完整路线">
          <text class="route-cta-txt">查看我的完整路线</text>
        </view>
        <text class="route-note">已点亮站点生成的复习单元永久可回炉，不计费</text>
      </view>

      <!-- ── 学习权益（会员=钱包 read model；免费=静态规则说明，不自算计数） ── -->
      <view class="pk-card usage-card" bindtap="openUsageDetail" aria-role="button" aria-label="查看权益详情">
        <view class="usage-head">
          <view>
            <text class="usage-kicker">学习权益</text>
            <text class="usage-title">{{usagePrimaryLabel}}</text>
          </view>
          <view class="usage-action" catchtap="goBilling" aria-role="button" aria-label="打开权益中心">
            <text class="usage-action-txt">充值</text>
          </view>
        </view>
        <!-- 免费档：后端免费试用三规则的静态说明（无已用计数读接口，不造数） -->
        <view class="usage-summary-list" wx:if="{{freeTier}}">
          <view class="usage-summary-row">
            <text class="usage-summary-label">每日免费提问</text>
            <text class="usage-summary-detail">3 次（每天重置）</text>
          </view>
          <view class="usage-summary-row">
            <text class="usage-summary-label">7 日累计上限</text>
            <text class="usage-summary-detail">12 次</text>
          </view>
          <text class="usage-free-note">已生成的复习内容不计费，永久可回炉</text>
        </view>
        <!-- 会员档：标题已是「剩余 N%」，摘要行不再复读同一数字；
             带进度条的完整明细在底部抽屉（openUsageDetail）。 -->
        <block wx:elif="{{usageRows.length}}">
          <view class="usage-summary-list">
            <view class="usage-more-row">
              <text class="usage-more-text">查看详情</text>
              <text class="usage-more-arrow">›</text>
            </view>
          </view>
        </block>
        <view class="usage-empty" wx:elif="{{!usageLoading}}">
          <text class="usage-empty-txt">暂无使用数据</text>
        </view>
      </view>

      <!-- ── 复习提醒（review_reminder 偏好开关，如实文案） ── -->
      <view class="pk-card remind-card">
        <view class="remind-row">
          <text class="remind-dot {{reviewReminder ? 'on' : ''}}"></text>
          <text class="remind-title">复习提醒</text>
          <switch
            class="remind-switch"
            checked="{{reviewReminder}}"
            bindchange="onReminderChange"
            color="#48806a"
          />
        </view>
        <text class="remind-note">记录应用内提醒偏好；微信消息需在复测页另行授权</text>
      </view>

      <!-- ── 学习设置 ───────────────────────────────── -->
      <view class="section-title">学习设置</view>
      <view class="pk-card settings-card">
        <!-- 考试日期（picker → PATCH exam_date → 回显；真值喂复习调度引擎） -->
        <picker mode="date" value="{{examDate}}" bindchange="onExamDateChange">
          <view class="setting-row">
            <text class="setting-label">考试日期</text>
            <view class="setting-value-row">
              <text class="setting-value">{{examDate || '待设置'}}</text>
              <text class="setting-arrow">›</text>
            </view>
          </view>
          <text class="setting-note">用于安排你的复习节奏</text>
        </picker>

        <view class="divider"></view>

        <!-- 每日目标（TODO(time_budget)：后端落轻/中/重后换三档映射） -->
        <view class="setting-row">
          <text class="setting-label">每日目标</text>
          <view class="chips-row">
            <view
              class="chip {{dailyTarget === item ? 'chip-active' : ''}}"
              wx:for="{{dailyTargetOptions}}"
              wx:key="*this"
              bindtap="setDailyTarget"
              data-val="{{item}}"
            >
              <text class="chip-txt">{{item}} 题</text>
            </view>
          </view>
        </view>

        <view class="divider"></view>

        <!-- 难度偏好 -->
        <view class="setting-row">
          <text class="setting-label">难度偏好</text>
          <view class="chips-row">
            <view
              class="chip {{difficultyPref === item.val ? 'chip-active' : ''}}"
              wx:for="{{difficultyOptions}}"
              wx:key="val"
              bindtap="setDifficulty"
              data-val="{{item.val}}"
            >
              <text class="chip-txt">{{item.label}}</text>
            </view>
          </view>
        </view>

        <view class="divider"></view>

        <!-- 外观(亮/暗;本地偏好,全端跟随) -->
        <view class="setting-row">
          <text class="setting-label">外观</text>
          <view class="chips-row">
            <view
              class="chip {{appearance === item.val ? 'chip-active' : ''}}"
              wx:for="{{appearanceOptions}}"
              wx:key="val"
              bindtap="setAppearance"
              data-val="{{item.val}}"
            >
              <text class="chip-txt">{{item.label}}</text>
            </view>
          </view>
        </view>

        <view class="divider"></view>

        <!-- 解题风格 -->
        <view class="setting-row">
          <text class="setting-label">解题风格</text>
          <view class="chips-row">
            <view
              class="chip {{explainStyle === item.val ? 'chip-active' : ''}}"
              wx:for="{{explainOptions}}"
              wx:key="val"
              bindtap="setExplainStyle"
              data-val="{{item.val}}"
            >
              <text class="chip-txt">{{item.label}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ── 聚合入口（历史/学习统计绝不落本页：学习统计只做去学情的入口） ── -->
      <view class="pk-card links-card">
        <block wx:for="{{linkItems}}" wx:key="id">
          <view class="link-row" bindtap="openLink" data-id="{{item.id}}">
            <text class="link-title">{{item.title}}</text>
            <text class="link-arrow">›</text>
          </view>
        </block>
      </view>

      <!-- 商业化口径（10f 底部铭牌） -->
      <text class="footnote">不按题收费 · 会员 = 解锁你这条路线的剩余部分</text>

      <!-- 退出登录 / 退出体验 -->
      <view class="logout-btn" bindtap="logout" aria-role="button" aria-label="{{isGuestPreview ? '退出体验' : '退出登录'}}">
        <text class="logout-btn-txt">{{isGuestPreview ? '退出体验' : '退出登录'}}</text>
      </view>

      <view class="tail-spacer"></view>
    </view>
  </scroll-view>

  <view class="usage-detail-mask {{usageDetailShow ? 'show' : ''}}" bindtap="closeUsageDetail"></view>
  <view class="usage-detail-sheet {{usageDetailShow ? 'show' : ''}}">
    <view class="usage-detail-head">
      <text class="usage-detail-title">权益详情</text>
      <view class="usage-detail-close" bindtap="closeUsageDetail" aria-role="button" aria-label="关闭权益详情">
        <text class="usage-detail-close-txt">×</text>
      </view>
    </view>
    <view class="usage-list">
      <view class="usage-row" wx:for="{{usageRows}}" wx:key="key">
        <view class="usage-row-head">
          <view>
            <text class="usage-row-title">{{item.label}}</text>
            <text class="usage-row-reset" wx:if="{{item.resetLabel}}">{{item.resetLabel}}</text>
          </view>
          <text class="usage-row-percent">{{item.remainingLabel}}</text>
        </view>
        <view class="usage-meter">
          <view class="usage-meter-fill" style="{{item.barStyle}}"></view>
        </view>
      </view>
    </view>
  </view>

  <workspace-shell id="workspaceShell"></workspace-shell>

</view>
