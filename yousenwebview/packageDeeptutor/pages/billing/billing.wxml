<!-- pages/billing/billing.wxml — 使用情况与额度 -->
<view class="billing-page {{isDark?'':'light'}}">

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-content">
      <view class="nav-brand" bindtap="goHome" aria-role="button" aria-label="回到首页">
        <view class="nav-logo-shell">
          <image class="nav-logo" src="../../images/logo-mark-white.png" mode="aspectFit" />
        </view>
        <view class="nav-brand-copy">
          <text class="nav-kicker">鲁班智考</text>
          <text class="nav-title">额度中心</text>
        </view>
      </view>
      <view style="flex:1"></view>
      <view class="nav-back-pill" bindtap="goBack" aria-role="button" aria-label="返回对话">
        <text class="nav-back-arrow">‹</text>
        <text class="nav-back-label">返回对话</text>
      </view>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}" style="top: {{navHeight}}px; bottom: 0">
    <view class="page-inner">

      <!-- 使用情况 -->
      <view class="balance-card">
        <view class="balance-copy">
          <view class="balance-topline">
            <text class="balance-label">本周额度</text>
            <text class="balance-note">按周更新</text>
          </view>
          <view class="balance-core">
            <text class="balance-num">{{usagePrimaryLabel}}</text>
          </view>
        </view>
        <view class="balance-gauge" aria-hidden="true">
          <view class="balance-gauge-ring">
            <text class="balance-gauge-num">{{usagePrimaryPercent}}</text>
            <text class="balance-gauge-unit">%</text>
          </view>
        </view>
        <view class="usage-quota-list">
          <view class="usage-quota-row" wx:for="{{usageRows}}" wx:key="key">
            <view class="usage-quota-head">
              <view>
                <text class="usage-quota-title">{{item.label}}</text>
                <text class="usage-quota-reset" wx:if="{{item.resetLabel}}">重置时间：{{item.resetLabel}}</text>
              </view>
              <text class="usage-quota-percent">{{item.remainingLabel}}</text>
            </view>
            <view class="usage-meter">
              <view class="usage-meter-fill" style="{{item.barStyle}}"></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 套餐选择 -->
      <view class="section-head">
        <text class="section-title">选择备考强度</text>
        <text class="section-sub">按学习强度开通，每周自动更新。</text>
      </view>
      <view class="pkg-grid">
        <view
          class="pkg-card {{selectedPkg === item.id ? 'sel' : ''}}"
          wx:for="{{packages}}"
          wx:key="id"
          bindtap="onSelectPkg"
          data-id="{{item.id}}"
        >
          <view class="pkg-main">
            <view class="pkg-copy">
              <view class="pkg-topline">
                <text class="pkg-name">{{item.label}}</text>
                <text class="pkg-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
              </view>
              <text class="pkg-points">{{item.usageLabel}}</text>
              <text class="pkg-per">{{item.rhythm}}</text>
              <text class="pkg-desc">{{item.desc}}</text>
            </view>
            <view class="pkg-price-block">
              <view class="pkg-price-row">
                <text class="pkg-yen">¥</text>
                <text class="pkg-price">{{item.price}}</text>
              </view>
            </view>
          </view>
          <view class="pkg-check {{selectedPkg === item.id ? 'on' : ''}}">
            <view class="pkg-check-dot"></view>
          </view>
        </view>
      </view>

      <!-- 开通按钮 -->
      <view class="pay-dock">
        <view class="pay-dock-copy">
          <text class="pay-dock-label">{{selectedPkgLabel}}</text>
          <text class="pay-dock-meta">{{selectedPkgUsage}}</text>
        </view>
        <view class="pay-dock-action" bindtap="onRecharge">
          <text class="pay-dock-yen">¥</text>
          <text class="pay-dock-price">{{selectedPkgPrice}}</text>
          <text class="pay-dock-cta">开通</text>
        </view>
      </view>

      <text class="usage-inline">实际消耗会随上下文长度、案例批改和整卷复盘复杂度动态变化。</text>

      <!-- 额度记录 -->
      <view class="section-head section-head-records">
        <text class="section-title">额度记录</text>
        <text class="section-sub">最近流水</text>
      </view>

      <view wx:if="{{loading}}" class="loading-wrap">
        <view class="skel-item" wx:for="{{[1,2,3]}}" wx:key="index">
          <view class="skel-block" style="width: 40%; height: 24rpx"></view>
          <view class="skel-block" style="width: 25%; height: 22rpx; margin-top: 8rpx"></view>
        </view>
      </view>

      <view wx:elif="{{error}}" class="empty-card">
        <text class="empty-title">{{errorTitle}}</text>
        <view class="retry-btn" bindtap="retry"><text class="retry-btn-txt">重试</text></view>
      </view>

      <view wx:elif="{{entries.length === 0}}" class="empty-card">
        <text class="empty-title">暂无记录</text>
      </view>

      <view wx:else class="ledger-list">
        <view class="ledger-item" wx:for="{{entries}}" wx:key="id">
          <view class="ledger-left">
            <text class="ledger-reason">{{item.reason}}</text>
            <text class="ledger-time">{{item.time}}</text>
          </view>
          <text class="ledger-delta {{item.isDebit ? 'debit' : 'credit'}}">{{item.isDebit ? '已计入使用量' : '额度补充'}}</text>
        </view>
      </view>

      <!-- 分页控件（独立于列表，始终可见） -->
      <view class="pager-bar" wx:if="{{!loading && !error && entries.length > 0}}">
        <view class="pager-btn-wrap {{page <= 1 ? 'disabled' : ''}}" bindtap="onPrevPage">
          <text class="pager-chevron">‹</text>
          <text class="pager-label">上一页</text>
        </view>
        <view class="pager-indicator">
          <text class="pager-page-num">{{page}}</text>
        </view>
        <view class="pager-btn-wrap {{!hasMore ? 'disabled' : ''}}" bindtap="onNextPage">
          <text class="pager-label">下一页</text>
          <text class="pager-chevron">›</text>
        </view>
      </view>

      <view style="height: 60rpx"></view>
    </view>
  </scroll-view>

  <view wx:if="{{checkoutVisible}}" class="checkout-mask" bindtap="closeCheckout">
    <view class="checkout-sheet" catchtap="noop">
      <view class="checkout-handle"></view>
      <view class="checkout-head">
        <view>
          <text class="checkout-kicker">确认开通</text>
          <text class="checkout-title">{{selectedPkgLabel}}</text>
        </view>
        <text class="checkout-close" bindtap="closeCheckout">×</text>
      </view>
      <view class="checkout-summary">
        <view>
          <text class="checkout-summary-main">{{selectedPkgUsage}}</text>
          <text class="checkout-summary-sub">{{selectedPkgDesc}}</text>
        </view>
        <view class="checkout-price">
          <text class="checkout-yen">¥</text>
          <text class="checkout-amount">{{selectedPkgPrice}}</text>
        </view>
      </view>
      <view class="pay-channel-list">
        <view
          class="pay-channel {{selectedPayChannel === item.id ? 'active' : ''}}"
          wx:for="{{payChannels}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onSelectPayChannel"
        >
          <view class="pay-channel-mark {{item.id}}"></view>
          <view class="pay-channel-copy">
            <text class="pay-channel-title">{{item.label}}</text>
            <text class="pay-channel-desc">{{item.desc}}</text>
          </view>
          <view class="pay-channel-check"></view>
        </view>
      </view>
      <view class="checkout-submit {{paying ? 'loading' : ''}}" bindtap="onConfirmPay">
        <text class="checkout-submit-text">{{paying ? '正在拉起支付' : '确认支付 ¥' + selectedPkgPrice}}</text>
      </view>
    </view>
  </view>

</view>
