<!-- pages/billing/billing.wxml — 使用情况与权益 -->
<view class="billing-page paper {{isDark?'':'light'}} pk-paper-bg">

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-content">
      <view class="nav-brand" bindtap="goHome" aria-role="button" aria-label="回到首页">
        <view class="nav-logo-shell">
          <image class="nav-logo" src="../../images/logo-mark-white.png" mode="aspectFit" />
        </view>
        <view class="nav-brand-copy">
          <text class="nav-kicker">鲁班智考</text>
          <text class="nav-title">权益中心</text>
        </view>
      </view>
      <view style="flex:1"></view>
      <view class="nav-back-pill" bindtap="goBack" aria-role="button" aria-label="返回对话">
        <text class="nav-back-arrow">‹</text>
        <text class="nav-back-label">返回对话</text>
      </view>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}" style="top: {{navHeight}}px; bottom: 0">
    <view class="page-inner">

      <!-- 使用情况 -->
      <view class="balance-card">
        <view class="balance-copy">
          <view class="balance-topline">
            <text class="balance-label">剩余权益</text>
          </view>
          <view class="balance-core">
            <text class="balance-num">{{usagePrimaryLabel}}</text>
          </view>
        </view>
        <view class="balance-gauge" aria-hidden="true">
          <view class="balance-gauge-ring">
            <text class="balance-gauge-num">{{usageGaugeLabel}}</text>
          </view>
        </view>
        <view class="usage-quota-list">
          <view class="usage-quota-row" wx:for="{{usageRows}}" wx:key="key">
            <view class="usage-quota-head">
              <view>
                <text class="usage-quota-title">{{item.label}}</text>
              </view>
              <text class="usage-quota-percent">{{item.remainingLabel}}</text>
            </view>
            <view class="usage-meter">
              <view class="usage-meter-fill" style="{{item.barStyle}}"></view>
            </view>
          </view>
        </view>
      </view>

      <view class="experience-card" wx:if="{{experienceState !== 'unavailable'}}">
        <view class="experience-copy">
          <text class="experience-title">{{experienceMessage}}</text>
          <text class="experience-sub" wx:if="{{experienceState === 'active'}}">{{experienceVideoAccessLabel}}，AI 学习服务在体验期内开放。</text>
          <text class="experience-expiry" wx:if="{{experienceExpiresLabel}}">{{experienceExpiresLabel}}</text>
        </view>
        <view class="experience-redeem" wx:if="{{experienceState !== 'active'}}">
          <input class="experience-input" value="{{inviteCode}}" bindinput="onInviteInput" maxlength="64" placeholder="输入佑森学员邀请码" />
          <view class="experience-button {{redeemLoading ? 'loading' : ''}}" bindtap="redeemInvite" aria-role="button">
            <text>{{redeemLoading ? '开启中' : '开启体验'}}</text>
          </view>
        </view>
      </view>

      <view class="section-head">
        <text class="section-title">开通学习权益</text>
        <text class="section-sub">真实 AI 答疑、深度解析、批改和学习记录写回会消耗权益。</text>
      </view>

      <view class="pkg-grid">
        <view
          class="pkg-card {{selectedPackageId === item.id ? 'sel' : ''}}"
          wx:for="{{packages}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="selectPackage"
          aria-role="button"
          aria-label="选择 {{item.name}}"
        >
          <view class="pkg-main">
            <view class="pkg-copy">
              <view class="pkg-topline">
                <text class="pkg-name">{{item.name}}</text>
                <text class="pkg-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
              </view>
              <text class="pkg-turns">{{item.turns}} 次</text>
              <text class="pkg-desc">{{item.desc}}</text>
            </view>
            <view class="pkg-price-block">
              <text class="pkg-original-price" wx:if="{{item.originalPrice}}">原价 ¥{{item.originalPrice}}</text>
              <view class="pkg-price-row">
                <text class="pkg-yen">¥</text>
                <text class="pkg-price">{{item.price}}</text>
              </view>
            </view>
          </view>
          <view class="pkg-check {{selectedPackageId === item.id ? 'on' : ''}}">
            <view class="pkg-check-dot"></view>
          </view>
        </view>
      </view>

      <view class="section-head section-head-records">
        <text class="section-title">使用记录</text>
      </view>

      <view class="ledger-card">
        <view class="ledger-row" wx:for="{{ledgerRows}}" wx:key="id">
          <view class="ledger-main">
            <text class="ledger-title">{{item.title}}</text>
            <text class="ledger-time">{{item.timeLabel}}</text>
          </view>
          <view class="ledger-amount">
            <text class="ledger-usage">{{item.usageLabel}}</text>
            <text class="ledger-balance">{{item.balanceLabel}}</text>
          </view>
        </view>
        <view class="ledger-empty" wx:if="{{!ledgerRows.length && !ledgerLoading}}">
          <text class="ledger-empty-text">暂无使用记录</text>
        </view>
        <view class="ledger-empty" wx:if="{{ledgerLoading}}">
          <text class="ledger-empty-text">记录同步中</text>
        </view>
      </view>

      <view class="pay-dock" wx:if="{{selectedPackage}}">
        <view class="pay-dock-copy">
          <text class="pay-dock-label">当前选择：{{selectedPackage.name}}</text>
          <text class="pay-dock-original" wx:if="{{selectedPackage.originalPrice}}">原价 ¥{{selectedPackage.originalPrice}}</text>
          <text class="pay-dock-meta">微信支付成功后自动开通学习权益。</text>
        </view>
        <view class="pay-dock-action {{checkoutLoading ? 'loading' : ''}}" bindtap="openCheckout" aria-role="button" aria-label="开通权益">
          <view class="pay-dock-price-group">
            <text class="pay-dock-yen">¥</text>
            <text class="pay-dock-price">{{selectedPackage.price}}</text>
          </view>
          <text class="pay-dock-cta">{{checkoutLoading ? '支付中' : '开通'}}</text>
        </view>
      </view>

      <view style="height: 60rpx"></view>
    </view>
  </scroll-view>
</view>
