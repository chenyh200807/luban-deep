/* pages/billing/billing.wxss — 使用情况与额度 */

.billing-page {
  height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(59, 130, 246, 0.18), transparent 34%),
    linear-gradient(180deg, #07101f 0%, #0a1324 46%, #08101d 100%);
  overflow: hidden;
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: rgba(7, 14, 28, 0.88);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(18rpx);
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 20rpx;
  gap: 16rpx;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  flex-shrink: 1;
}

.nav-logo-shell {
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #0b1224, #13233d);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.22);
  flex-shrink: 0;
}

.nav-logo {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.nav-brand-copy {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.nav-kicker {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.42);
  letter-spacing: 2rpx;
}

.nav-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  white-space: nowrap;
}

.nav-back-pill {
  padding: 10rpx 20rpx 10rpx 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  flex-shrink: 0;
}

.nav-back-pill:active {
  background: rgba(255, 255, 255, 0.14);
}

.nav-back-arrow {
  font-size: 28rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.78);
}

.nav-back-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.page-scroll {
  position: fixed;
  left: 0;
  right: 0;
  overflow-y: auto;
}

.page-inner {
  padding: 22rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.demo-banner {
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(245, 158, 11, 0.1);
  border: 1rpx solid rgba(245, 158, 11, 0.18);
}

.demo-txt {
  font-size: 22rpx;
  color: #f3ab24;
}

.balance-card {
  padding: 24rpx 24rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(13, 24, 45, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.balance-topline {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.balance-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.48);
}

.balance-note {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.34);
  text-align: right;
}

.balance-core {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.balance-num {
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1;
  color: #ffffff;
  font-variant-numeric: tabular-nums;
}

.balance-demo {
  margin-top: 4rpx;
}

.usage-quota-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 4rpx;
}

.usage-quota-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.usage-quota-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.usage-quota-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.88);
}

.usage-quota-reset {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.42);
}

.usage-quota-percent {
  flex-shrink: 0;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.68);
}

.usage-meter {
  height: 12rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.1);
}

.usage-meter-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #ffffff;
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 2rpx 4rpx 0;
}

.section-head-records {
  margin-top: 6rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
}

.section-sub {
  font-size: 20rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.4);
}

.pkg-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pkg-card {
  padding: 20rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  gap: 14rpx;
  transition: border-color 0.15s, background 0.15s, transform 0.15s;
}

.pkg-card:active {
  border-color: rgba(96, 165, 250, 0.38);
  transform: scale(0.995);
}

.pkg-card.sel {
  background: rgba(20, 44, 88, 0.9);
  border-color: #3b82f6;
}

.pkg-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.pkg-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.pkg-topline {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pkg-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
}

.pkg-badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(245, 158, 11, 0.16);
  border: 1rpx solid rgba(245, 158, 11, 0.22);
  font-size: 18rpx;
  font-weight: 700;
  color: #f3ab24;
}

.pkg-points {
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  font-variant-numeric: tabular-nums;
}

.pkg-per {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.7);
}

.pkg-desc {
  font-size: 20rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.42);
}

.pkg-price-block {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0;
  flex-shrink: 0;
}

.pkg-price-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.pkg-yen {
  font-size: 22rpx;
  font-weight: 700;
  color: #f3ab24;
}

.pkg-price {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
  color: #f3ab24;
  font-variant-numeric: tabular-nums;
}

.pkg-check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pkg-check.on {
  border-color: rgba(96, 165, 250, 0.55);
  background: rgba(59, 130, 246, 0.12);
}

.pkg-check-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: transparent;
}

.pkg-check.on .pkg-check-dot {
  background: #60a5fa;
}

.recharge-btn {
  margin-top: 2rpx;
  padding: 24rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s, border-color 0.2s, opacity 0.2s;
}

.recharge-btn.on {
  background: linear-gradient(135deg, #2f6bff, #2563eb);
  border-color: rgba(96, 165, 250, 0.36);
  box-shadow: 0 12rpx 26rpx rgba(37, 99, 235, 0.2);
}

.recharge-btn.disabled {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.08);
  box-shadow: none;
}

.recharge-btn:active {
  opacity: 0.88;
}

.recharge-btn-txt {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.32);
}

.recharge-btn.on .recharge-btn-txt {
  color: #ffffff;
}

.recharge-btn.disabled .recharge-btn-txt {
  color: rgba(255, 255, 255, 0.48);
}

.usage-inline {
  display: block;
  padding: 2rpx 4rpx 0;
  font-size: 20rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.36);
}

.billing-page.light {
  background:
    radial-gradient(circle at top left, rgba(47, 107, 255, 0.12), transparent 32%),
    linear-gradient(180deg, #f7faff 0%, #eef4ff 50%, #f8fbff 100%);
}

.billing-page.light .nav-bar {
  background: rgba(248, 250, 255, 0.94);
  border-bottom-color: #dbe6f5;
  box-shadow: 0 10rpx 28rpx rgba(126, 147, 185, 0.1);
}

.billing-page.light .nav-kicker {
  color: #7b8da8;
}

.billing-page.light .nav-title {
  color: #0f172a;
}

.billing-page.light .nav-back-pill {
  background: rgba(255, 255, 255, 0.86);
  border-color: rgba(148, 163, 184, 0.22);
}

.billing-page.light .nav-back-arrow,
.billing-page.light .nav-back-label {
  color: #334155;
}

.billing-page.light .nav-logo-shell {
  background: linear-gradient(145deg, #111827, #263248);
  border-color: rgba(15, 23, 42, 0.12);
  box-shadow: 0 10rpx 24rpx rgba(30, 41, 59, 0.16);
}

.billing-page.light .hero-shell {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(239, 245, 255, 0.94));
  border-color: #d5e1fb;
  box-shadow: 0 18rpx 42rpx rgba(126, 147, 185, 0.14);
}

.billing-page.light .hero-kicker {
  color: #2f6bff;
}

.billing-page.light .hero-title {
  color: #0f172a;
}

.billing-page.light .hero-sub {
  color: #66758a;
}

.billing-page.light .demo-banner {
  background: #fff6e6;
  border-color: #f7cf8c;
}

.billing-page.light .demo-txt {
  color: #b45309;
}

.billing-page.light .balance-card {
  background: rgba(255, 255, 255, 0.94);
  border-color: #d5e1fb;
  box-shadow: 0 12rpx 28rpx rgba(126, 147, 185, 0.1);
}

.billing-page.light .balance-label {
  color: #64748b;
}

.billing-page.light .balance-note {
  color: #7b8799;
}

.billing-page.light .balance-num {
  color: #0f172a;
}

.billing-page.light .usage-quota-title {
  color: #1e293b;
}

.billing-page.light .usage-quota-reset {
  color: #7b8da8;
}

.billing-page.light .usage-quota-percent {
  color: #5f6f84;
}

.billing-page.light .usage-meter {
  background: #e5e7eb;
}

.billing-page.light .usage-meter-fill {
  background: #111827;
}

.billing-page.light .section-title {
  color: #1e293b;
}

.billing-page.light .section-sub {
  color: #7b8da8;
}

.billing-page.light .pkg-card {
  background: rgba(255, 255, 255, 0.92);
  border-color: #dbe6f5;
  box-shadow: 0 10rpx 28rpx rgba(126, 147, 185, 0.08);
}

.billing-page.light .pkg-card.sel {
  background: #eef4ff;
  border-color: #2f6bff;
}

.billing-page.light .pkg-name,
.billing-page.light .pkg-points {
  color: #0f172a;
}

.billing-page.light .pkg-per {
  color: #334155;
}

.billing-page.light .pkg-desc {
  color: #7b8da8;
}

.billing-page.light .pkg-badge {
  background: #fff1cf;
  border-color: #ffd995;
  color: #a16207;
}

.billing-page.light .pkg-check {
  border-color: #cbd5e1;
}

.billing-page.light .pkg-check.on {
  border-color: #60a5fa;
  background: #e8f0ff;
}

.billing-page.light .recharge-btn {
  background: #e8efff;
  border-color: #d4e1fa;
}

.billing-page.light .recharge-btn-txt {
  color: #7b8da8;
}

.billing-page.light .recharge-btn.on {
  background: linear-gradient(135deg, #2f6bff, #2563eb);
  border-color: #2f6bff;
}

.billing-page.light .recharge-btn.on .recharge-btn-txt {
  color: #ffffff;
}

.billing-page.light .recharge-btn.disabled {
  background: #f1f5f9;
  border-color: #dbe6f5;
}

.billing-page.light .recharge-btn.disabled .recharge-btn-txt {
  color: #64748b;
}

.billing-page.light .usage-inline {
  color: #7b8da8;
}

/* ══ Premium Billing Surface ══════════════════════════════ */
.billing-page {
  background: linear-gradient(180deg, #07101b 0%, #0b111d 48%, #090d15 100%);
}
.page-inner { padding: 24rpx 28rpx 132rpx; gap: 24rpx; }
.balance-card {
  position: relative;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(17, 27, 44, 0.98), rgba(10, 17, 29, 0.94));
  border: 1rpx solid rgba(198, 218, 255, 0.12);
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.28);
}
.balance-card::after {
  content: "";
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 0;
  height: 2rpx;
  background: linear-gradient(90deg, #38bdf8, #f6c04f, #34d399);
  opacity: 0.72;
}
.balance-copy { min-width: 0; flex: 1; }
.balance-topline { margin-bottom: 16rpx; }
.balance-label { font-size: 24rpx; color: rgba(255, 255, 255, 0.52); }
.balance-note { color: rgba(255, 255, 255, 0.42); }
.balance-num { font-size: 62rpx; letter-spacing: 0; }
.balance-gauge {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  padding: 8rpx;
  background: linear-gradient(135deg, #34d399, #38bdf8);
  flex-shrink: 0;
}
.balance-gauge-ring {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #0c1422;
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding-top: 38rpx;
  box-sizing: border-box;
}
.balance-gauge-num { font-size: 34rpx; line-height: 1; font-weight: 800; color: #fff; }
.balance-gauge-unit { font-size: 18rpx; font-weight: 700; color: rgba(255,255,255,0.62); }
.usage-quota-list { width: 100%; margin-top: 0; }
.usage-meter { height: 10rpx; background: rgba(255,255,255,0.12); }
.usage-meter-fill {
  background: linear-gradient(90deg, #34d399, #38bdf8);
  transition: width 0.28s ease;
}
.section-head { padding: 0 4rpx; }
.section-title { font-size: 30rpx; }
.section-sub { font-size: 22rpx; }
.pkg-grid { gap: 16rpx; }
.pkg-card {
  position: relative;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.035);
  border-color: rgba(255,255,255,0.08);
  overflow: hidden;
}
.pkg-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.16);
}
.pkg-card.sel {
  background: linear-gradient(135deg, rgba(18, 46, 75, 0.95), rgba(14, 34, 58, 0.92));
  border-color: rgba(56, 189, 248, 0.72);
  box-shadow: 0 22rpx 60rpx rgba(8, 145, 178, 0.16);
}
.pkg-card.sel::before { background: linear-gradient(180deg, #38bdf8, #34d399); }
.pkg-points { margin-top: 4rpx; }
.pkg-price, .pkg-yen { color: #f6c04f; }
.pkg-check.on { border-color: rgba(52, 211, 153, 0.68); background: rgba(52, 211, 153, 0.14); }
.pkg-check.on .pkg-check-dot { background: #34d399; }
.pay-dock {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 20rpx 18rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.1);
}
.pay-dock-copy { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.pay-dock-label { font-size: 26rpx; font-weight: 800; color: #fff; }
.pay-dock-meta { font-size: 20rpx; color: rgba(255,255,255,0.46); }
.pay-dock-action {
  min-width: 218rpx;
  height: 72rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: linear-gradient(135deg, #f6c04f, #f59e0b);
  box-shadow: 0 16rpx 36rpx rgba(245, 158, 11, 0.24);
}
.pay-dock-action:active { transform: scale(0.985); }
.pay-dock-price-group {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 3rpx;
  flex-shrink: 0;
}
.pay-dock-yen { font-size: 21rpx; line-height: 1; font-weight: 800; color: #141414; }
.pay-dock-price { font-size: 35rpx; line-height: 1; font-weight: 900; color: #141414; }
.pay-dock-cta { font-size: 25rpx; line-height: 1; font-weight: 800; color: #141414; flex-shrink: 0; }
.checkout-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0,0,0,0.52);
}
.checkout-sheet {
  width: 100%;
  padding: 16rpx 28rpx 44rpx;
  border-radius: 34rpx 34rpx 0 0;
  background: #0d1522;
  border-top: 1rpx solid rgba(255,255,255,0.12);
  box-shadow: 0 -24rpx 80rpx rgba(0,0,0,0.36);
}
.checkout-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  margin: 0 auto 26rpx;
  background: rgba(255,255,255,0.18);
}
.checkout-head, .checkout-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.checkout-kicker, .checkout-summary-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.46);
}
.checkout-title {
  display: block;
  margin-top: 4rpx;
  font-size: 38rpx;
  line-height: 1.15;
  font-weight: 900;
  color: #fff;
}
.checkout-close {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.72);
  font-size: 40rpx;
  background: rgba(255,255,255,0.08);
}
.checkout-summary {
  margin-top: 28rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(255,255,255,0.08);
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
}
.checkout-summary-main { display: block; font-size: 28rpx; font-weight: 800; color: #fff; }
.checkout-summary-sub { margin-top: 8rpx; }
.checkout-price { display: flex; align-items: baseline; flex-shrink: 0; }
.checkout-yen { font-size: 24rpx; font-weight: 800; color: #f6c04f; }
.checkout-amount { font-size: 52rpx; line-height: 1; font-weight: 900; color: #f6c04f; }
.pay-channel-list { display: flex; flex-direction: column; gap: 14rpx; margin-top: 24rpx; }
.pay-channel {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.08);
}
.pay-channel.active { border-color: rgba(52,211,153,0.58); background: rgba(52,211,153,0.1); }
.pay-channel-mark { width: 48rpx; height: 48rpx; border-radius: 16rpx; flex-shrink: 0; }
.pay-channel-mark.wechat { background: linear-gradient(135deg, #22c55e, #16a34a); }
.pay-channel-mark.alipay { background: linear-gradient(135deg, #38bdf8, #2563eb); }
.pay-channel-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.pay-channel-title { font-size: 26rpx; font-weight: 800; color: #fff; }
.pay-channel-desc { font-size: 20rpx; color: rgba(255,255,255,0.44); }
.pay-channel-check { width: 28rpx; height: 28rpx; border-radius: 50%; border: 2rpx solid rgba(255,255,255,0.2); }
.pay-channel.active .pay-channel-check { border-color: #34d399; background: #34d399; }
.checkout-submit {
  height: 88rpx;
  margin-top: 26rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f6c04f, #f59e0b);
}
.checkout-submit.loading { opacity: 0.7; }
.checkout-submit-text { font-size: 30rpx; font-weight: 900; color: #111827; }
.checkout-message {
  display: block;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(251, 191, 36, 0.1);
  border: 1rpx solid rgba(251, 191, 36, 0.18);
  font-size: 23rpx;
  line-height: 1.5;
  color: rgba(253, 230, 138, 0.92);
}
.billing-page.light .balance-card, .billing-page.light .checkout-sheet { background: #fff; }
.billing-page.light .balance-gauge-ring { background: #fff; }
.billing-page.light .balance-gauge-num,
.billing-page.light .checkout-title,
.billing-page.light .checkout-summary-main,
.billing-page.light .pay-channel-title,
.billing-page.light .pay-dock-label { color: #0f172a; }
.billing-page.light .pay-dock { background: rgba(255,255,255,0.92); border-color: #dbe6f5; }
.billing-page.light .pay-dock-meta,
.billing-page.light .checkout-kicker,
.billing-page.light .checkout-summary-sub,
.billing-page.light .pay-channel-desc { color: #64748b; }
.billing-page.light .pay-channel { background: #f8fbff; border-color: #dbe6f5; }
.billing-page.light .pay-channel.active { background: #ecfdf5; border-color: #86efac; }
.billing-page.light .checkout-close { background: #eef2f7; color: #334155; }
.billing-page.light .checkout-message {
  background: #fffbeb;
  border-color: #fde68a;
  color: #92400e;
}
