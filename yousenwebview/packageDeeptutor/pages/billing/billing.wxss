@import "/packageDeeptutor/styles/paper-ink.wxss";

/* pages/billing/billing.wxss — 权益中心（纸墨朱竹单层）
 * palette 全走 --pk-* token；亮/暗由 paper-ink 的 .paper/.paper.light 切换。
 * 有意保留的字面量：套餐营销徽标的赭黄 #c99f3d（10e 错因结构第三语义色，
 * paper-ink 未收录 gold token，仅此两处装饰性使用）。 */

.billing-page {
  height: 100vh;
  overflow: hidden;
  color: var(--pk-t1);
  font-family: -apple-system, "PingFang SC", sans-serif;
}

/* ── 导航：朱红品牌章 + 墨字 ────────────────────────────── */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--pk-paper);
  border-bottom: 1rpx solid var(--pk-bd);
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 20rpx;
  gap: 16rpx;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  flex-shrink: 1;
}

.nav-logo-shell {
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--pk-red);
  box-shadow: 0 6rpx 18rpx rgba(207, 68, 54, 0.28);
  flex-shrink: 0;
}

.nav-logo {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.nav-brand-copy {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.nav-kicker {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--pk-t3);
}

.nav-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--pk-t1);
  white-space: nowrap;
}

.nav-back-pill {
  padding: 10rpx 20rpx 10rpx 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  border: 1rpx solid var(--pk-bd);
  background: var(--pk-card);
  flex-shrink: 0;
}

.nav-back-pill:active {
  opacity: 0.72;
}

.nav-back-arrow {
  font-size: 28rpx;
  line-height: 1;
  color: var(--pk-grn);
}

.nav-back-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pk-grn);
}

.page-scroll {
  position: fixed;
  left: 0;
  right: 0;
  overflow-y: auto;
}

.page-inner {
  padding: 24rpx 28rpx 132rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ── 剩余权益卡 ─────────────────────────────────────────── */
.balance-card {
  position: relative;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
}

.balance-copy {
  min-width: 0;
  flex: 1;
}

.balance-topline {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.balance-label {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--pk-t3);
}

.balance-core {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.balance-num {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--pk-t1);
  font-variant-numeric: tabular-nums;
}

.balance-gauge {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  padding: 8rpx;
  box-sizing: border-box;
  background: var(--pk-gauge);
  flex-shrink: 0;
}

.balance-gauge-ring {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.balance-gauge-num {
  font-size: 34rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--pk-grn);
  font-variant-numeric: tabular-nums;
}

.usage-quota-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.usage-quota-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.usage-quota-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.usage-quota-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pk-t1);
}

.usage-quota-percent {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pk-t2);
  font-variant-numeric: tabular-nums;
}

.usage-meter {
  height: 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: var(--pk-gauge);
}

.usage-meter-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--pk-grn);
  transition: width 0.28s ease;
}

/* ── 区块标题 ───────────────────────────────────────────── */
.section-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 0 4rpx;
}

.section-head-records {
  margin-top: 6rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.section-sub {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--pk-t2);
}

/* ── 套餐卡 ─────────────────────────────────────────────── */
.pkg-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pkg-card {
  position: relative;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--pk-card);
  border: 2rpx solid var(--pk-bd);
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
  display: flex;
  align-items: center;
  gap: 14rpx;
  overflow: hidden;
  transition: border-color 0.15s, background 0.15s, transform 0.15s;
}

.pkg-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: var(--pk-sand);
}

.pkg-card:active {
  transform: scale(0.995);
}

.pkg-card.sel {
  background: var(--pk-accent-soft);
  border-color: var(--pk-grn);
}

.pkg-card.sel::before {
  background: var(--pk-grn);
}

.pkg-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.pkg-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.pkg-topline {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pkg-name {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.pkg-badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(201, 159, 61, 0.14);
  border: 1rpx solid rgba(201, 159, 61, 0.32);
  font-size: 20rpx;
  font-weight: 800;
  color: #a07f2e;
}

.pkg-turns {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--pk-t1);
  font-variant-numeric: tabular-nums;
}

.pkg-desc {
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--pk-t2);
}

.pkg-price-block {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}

.pkg-price-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.pkg-original-price {
  font-size: 20rpx;
  line-height: 1;
  color: var(--pk-t3);
  text-decoration: line-through;
  font-variant-numeric: tabular-nums;
}

.pkg-yen {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.pkg-price {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--pk-t1);
  font-variant-numeric: tabular-nums;
}

.pkg-check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid var(--pk-sand);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pkg-check.on {
  border-color: var(--pk-grn);
  background: var(--pk-accent-soft);
}

.pkg-check-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: transparent;
}

.pkg-check.on .pkg-check-dot {
  background: var(--pk-grn);
}

/* ── 使用记录账本 ───────────────────────────────────────── */
.ledger-card {
  padding: 4rpx 24rpx;
  border-radius: 24rpx;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
}

.ledger-row {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--pk-bd);
}

.ledger-row:last-child {
  border-bottom: 0;
}

.ledger-main,
.ledger-amount {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ledger-amount {
  align-items: flex-end;
  flex-shrink: 0;
}

.ledger-title {
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 700;
  color: var(--pk-t1);
}

.ledger-usage {
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 800;
  color: var(--pk-t1);
  font-variant-numeric: tabular-nums;
}

.ledger-time,
.ledger-balance {
  font-size: 21rpx;
  line-height: 1.25;
  color: var(--pk-t3);
}

.ledger-empty {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ledger-empty-text {
  font-size: 23rpx;
  color: var(--pk-t3);
}

/* ── 支付 dock：墨色主按钮 ──────────────────────────────── */
.pay-dock {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 20rpx 18rpx 24rpx;
  border-radius: 24rpx;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
}

.pay-dock-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.pay-dock-label {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.pay-dock-original {
  font-size: 20rpx;
  line-height: 1;
  color: var(--pk-t3);
  text-decoration: line-through;
  font-variant-numeric: tabular-nums;
}

.pay-dock-meta {
  font-size: 20rpx;
  color: var(--pk-t2);
}

.pay-dock-action {
  min-width: 218rpx;
  height: 76rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: var(--pk-ink-btn);
  box-shadow: 0 8rpx 20rpx var(--pk-shadow);
}

.pay-dock-action.loading {
  opacity: 0.72;
}

.pay-dock-action:active {
  transform: scale(0.985);
}

.pay-dock-price-group {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 3rpx;
  flex-shrink: 0;
}

.pay-dock-yen {
  font-size: 21rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--pk-ink-btn-t);
}

.pay-dock-price {
  font-size: 35rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--pk-ink-btn-t);
  font-variant-numeric: tabular-nums;
}

.pay-dock-cta {
  font-size: 25rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--pk-ink-btn-t);
  flex-shrink: 0;
}
.experience-card {
  margin: 24rpx 0;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.experience-copy,
.experience-redeem {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.experience-title {
  font-size: 30rpx;
  font-weight: 700;
}

.experience-sub,
.experience-expiry {
  font-size: 24rpx;
  opacity: 0.76;
}

.experience-redeem {
  margin-top: 22rpx;
  flex-direction: row;
}

.experience-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.1);
}

.experience-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  color: #fff;
  background: #2f6fed;
}

.experience-button.loading {
  opacity: 0.6;
}
