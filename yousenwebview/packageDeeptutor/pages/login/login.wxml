<!-- login.wxml — Zentra 风格登录 -->
<view class="scene">
  <view class="sky-wash" style="{{skyWashStyle}}"></view>
  <view class="orb o1" style="{{orbStyle1}}"></view>
  <view class="orb o2" style="{{orbStyle2}}"></view>
  <view class="orb o3" style="{{orbStyle3}}"></view>
  <view class="login-aurora-gold"></view>
  <view class="login-grain"></view>

  <view class="page-shell" style="{{pageShellStyle}}"
    bindtouchstart="onPageTouchStart" bindtouchmove="onPageTouchMove"
    bindtouchend="onPageTouchEnd" bindtouchcancel="onPageTouchEnd">

    <scroll-view class="body" scroll-y enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}" style="padding-top:{{statusBarHeight}}px">
      <view class="hero-stage">
        <view class="hero-block">
          <text class="hero-kicker">Luban AI Tutor</text>

          <view class="brand-row">
            <image class="brand-mark" src="../../images/logo-mark-white.png" mode="heightFix" />
            <text class="brand-name">鲁班智考</text>
          </view>

          <view class="hero-copy">
            <view class="hero-title-line">
              <text class="hero-char" style="animation-delay: 340ms">懂</text>
              <text class="hero-char" style="animation-delay: 395ms">你</text>
              <text class="hero-char" style="animation-delay: 450ms">的</text>
            </view>
            <view class="hero-title-line">
              <text class="hero-char hero-char-accent" style="animation-delay: 560ms">智</text>
              <text class="hero-char hero-char-accent" style="animation-delay: 615ms">能</text>
              <text class="hero-char hero-char-accent" style="animation-delay: 670ms">备</text>
              <text class="hero-char hero-char-accent" style="animation-delay: 725ms">考</text>
              <text class="hero-char hero-char-accent" style="animation-delay: 780ms">导</text>
              <text class="hero-char hero-char-accent" style="animation-delay: 835ms">师</text>
            </view>
            <text class="hero-desc">{{heroMessages[activeHeroIndex].line1}}</text>
            <text class="hero-desc hero-desc-sub">{{heroMessages[activeHeroIndex].line2}}</text>
          </view>

          <view class="pager-row"
            bindtouchstart="onSubtitleTouchStart" bindtouchmove="onSubtitleTouchMove"
            bindtouchend="onSubtitleTouchEnd" bindtouchcancel="onSubtitleTouchEnd">
            <view wx:for="{{heroMessages}}" wx:key="index"
              class="{{activeHeroIndex === index ? 'pager-dot pager-dot-active' : 'pager-dot pager-dot-idle'}}"></view>
          </view>
        </view>

      </view>
    </scroll-view>

    <view class="action-panel" style="padding-bottom: {{safeBottom + 24}}px">
      <view class="err" wx:if="{{errorMsg}}">
        <text class="err-txt">{{errorMsg}}</text>
      </view>

      <view class="btn-wechat-stack">
        <button
          wx:if="{{privacyChecked}}"
          class="btn-wechat-primary {{wechatLoading?'off':''}}"
          open-type="getPhoneNumber"
          bindgetphonenumber="handleWechatPhoneNumber"
          disabled="{{wechatLoading || loading}}"
        >
          <text class="btn-wechat-primary-txt">{{wechatLoading ? '登录中...' : '快速登录'}}</text>
        </button>
        <button
          wx:else
          class="btn-wechat-primary"
          bindtap="handlePrivacyRequiredTap"
          disabled="{{wechatLoading || loading}}"
        >
          <text class="btn-wechat-primary-txt">快速登录</text>
        </button>
      </view>

      <view class="privacy-consent-row" bindtap="handlePrivacyCheckboxTap" aria-role="checkbox" aria-label="同意用户隐私保护指引">
        <view class="privacy-checkbox {{privacyChecked ? 'checked' : ''}}">
          <text class="privacy-checkmark" wx:if="{{privacyChecked}}">✓</text>
        </view>
        <text class="privacy-copy">我已阅读并同意</text>
        <text class="privacy-link" catchtap="openPrivacyGuide">{{privacyContractName}}</text>
      </view>

      <view class="guest-entry" bindtap="handleGuestPreview" aria-role="button" aria-label="先体验导学">
        <text class="guest-entry-txt">先体验导学</text>
        <text class="guest-entry-arrow">›</text>
      </view>

      <view class="link-row">
        <text class="manual-link" bindtap="goManualLogin">手机号验证码 / 账号密码</text>
        <text class="link-sep">|</text>
        <text class="manual-link" bindtap="goPasswordReset">忘记密码</text>
      </view>
    </view>
  </view>
  <view class="guest-wave {{guestWaveActive ? 'play' : ''}}"></view>
</view>
