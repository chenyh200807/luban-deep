.reset-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #10214c 0%, #0b1635 34%, #070d1d 66%, #04070e 100%);
  position: relative;
  overflow: hidden;
}

.page-shell {
  position: relative;
  z-index: 1;
  min-height: 100vh;
}

.sky-wash {
  position: fixed;
  top: -10%;
  left: -12%;
  right: -12%;
  height: 56vh;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(circle at 16% 8%, rgba(255,255,255,0.60) 0%, rgba(199,220,255,0.34) 22%, rgba(91,135,235,0.16) 42%, transparent 66%),
    radial-gradient(circle at 84% 6%, rgba(77,126,255,0.20) 0%, transparent 36%),
    radial-gradient(circle at 50% 46%, rgba(19,44,105,0.18) 0%, transparent 56%);
}

.body {
  position: relative;
  z-index: 1;
  min-height: 100vh;
}

.nav-row {
  padding: 8rpx 44rpx 0;
}

.nav-back {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: rgba(226,232,240,0.72);
}

.nav-back-arrow {
  font-size: 34rpx;
  line-height: 1;
}

.nav-back-txt {
  font-size: 23rpx;
  font-weight: 560;
}

.hero {
  padding: 46rpx 48rpx 20rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.title-logo {
  height: 52rpx;
  display: block;
}

.title-main {
  font-size: 34rpx;
  font-weight: 740;
  color: rgba(255,255,255,0.96);
  letter-spacing: 0.2rpx;
  white-space: nowrap;
}

.hero-title {
  display: block;
  margin-top: 30rpx;
  font-size: 52rpx;
  line-height: 1.05;
  font-weight: 760;
  color: #ffffff;
  letter-spacing: 0.2rpx;
}

.hero-sub {
  display: block;
  margin-top: 16rpx;
  max-width: 86%;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(226,232,240,0.58);
}

.sheet {
  margin: 14rpx 44rpx 0;
  padding: 22rpx 22rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(8,17,38,0.58) 0%, rgba(5,10,24,0.78) 100%);
  border: 1rpx solid rgba(185,207,255,0.09);
  box-shadow: 0 18rpx 48rpx rgba(0,0,0,0.20), inset 0 1rpx 0 rgba(255,255,255,0.05);
  backdrop-filter: blur(22rpx);
}

.step-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0 12rpx;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(54,89,170,0.22);
  box-shadow: inset 0 0 0 1rpx rgba(109,156,255,0.24);
}

.step-dot-active {
  background: linear-gradient(180deg, rgba(74,135,255,0.92) 0%, rgba(38,94,220,0.92) 100%);
  box-shadow: 0 8rpx 20rpx rgba(45,121,255,0.20), inset 0 1rpx 0 rgba(255,255,255,0.20);
}

.step-dot-txt {
  font-size: 22rpx;
  font-weight: 720;
  color: #f8fbff;
}

.step-line {
  width: 96rpx;
  height: 2rpx;
  margin: 0 12rpx;
  background: linear-gradient(90deg, rgba(84,142,255,0.78), rgba(152,190,255,0.20));
}

.err {
  margin: 14rpx 0 0;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(127,29,29,0.22);
  border: 1rpx solid rgba(239,68,68,0.14);
}

.err-txt {
  font-size: 24rpx;
  color: #fecaca;
  text-align: center;
  display: block;
}

.section-label {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 18rpx;
  padding: 0 4rpx;
}

.section-label-next {
  margin-top: 24rpx;
}

.section-title {
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 700;
  color: rgba(248,251,255,0.94);
}

.section-sub {
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(226,232,240,0.44);
}

.form-block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 14rpx;
}

.inp-group {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(188,211,255,0.09);
  border-radius: 18rpx;
  overflow: hidden;
}

.inp-group:focus-within {
  border-color: rgba(118,169,255,0.34);
  background: rgba(255,255,255,0.06);
}

.inp-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 82rpx;
  height: 82rpx;
  border-right: 1rpx solid rgba(255,255,255,0.055);
}

.inp-icon-txt {
  font-size: 22rpx;
  font-weight: 680;
  color: rgba(226,232,240,0.44);
  letter-spacing: 0.4rpx;
}

.inp {
  flex: 1;
  height: 82rpx;
  min-width: 0;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: #f8fbff;
  background: transparent;
  border: none;
  box-sizing: border-box;
}

.inp-phone {
  letter-spacing: 1.5rpx;
}

.inp-code {
  letter-spacing: 6rpx;
  font-weight: 520;
}

.ph {
  color: rgba(226,232,240,0.32);
  font-size: 27rpx;
}

.code-row {
  display: flex;
  gap: 12rpx;
  align-items: stretch;
}

.code-input {
  flex: 1;
  min-width: 0;
}

.btn-send {
  width: 184rpx;
  flex: 0 0 184rpx;
  height: 82rpx;
  margin: 0;
  padding: 0 12rpx;
  border: none;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(54,89,170,0.18);
  box-shadow: inset 0 0 0 1rpx rgba(109,156,255,0.20);
  box-sizing: border-box;
}

.btn-send::after {
  border: none;
}

.btn-send-txt {
  font-size: 24rpx;
  line-height: 1.15;
  font-weight: 650;
  color: #9ac0ff;
  text-align: center;
}

.btn-send-counting {
  background: rgba(255,255,255,0.03);
  box-shadow: inset 0 0 0 1rpx rgba(255,255,255,0.06);
}

.btn-send-counting .btn-send-txt {
  color: rgba(255,255,255,0.34);
}

.btn-send-off {
  opacity: 0.42;
}

.eye {
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  height: 82rpx;
}

.eye-txt {
  font-size: 24rpx;
  color: rgba(146,190,255,0.74);
}

.guard-note {
  margin: 18rpx 4rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(59,130,246,0.08);
  border: 1rpx solid rgba(147,197,253,0.12);
}

.guard-note-txt {
  display: block;
  font-size: 22rpx;
  line-height: 1.45;
  color: rgba(191,219,254,0.70);
}

.btn-main {
  width: 420rpx;
  max-width: 100%;
  margin: 22rpx auto 0;
  height: 84rpx;
  padding: 0 30rpx;
  border-radius: 22rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: linear-gradient(90deg, #2d79ff 0%, #5a99ff 52%, #9abdfc 100%);
  box-shadow: 0 16rpx 34rpx rgba(37,99,235,0.26), inset 0 1rpx 0 rgba(255,255,255,0.18);
}

.btn-main::after {
  border: none;
}

.btn-main.off {
  opacity: 0.5;
}

.btn-main-txt {
  display: block;
  font-size: 27rpx;
  line-height: 1;
  font-weight: 720;
  color: #f8fbff;
  letter-spacing: 0.2rpx;
  white-space: nowrap;
}
