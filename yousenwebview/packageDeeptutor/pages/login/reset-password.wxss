@import "/packageDeeptutor/styles/paper-ink.wxss";

/* login/reset-password.wxss — 找回或设置密码(纸墨朱竹单层,root 挂 paper light)
 * 布局几何沿用旧版,材质换纸墨:宣纸底/墨字/竹青步骤点/墨色主按钮。 */

.reset-page {
  min-height: 100vh;
  background-color: var(--pk-paper);
  background-image: radial-gradient(var(--pk-dot) 1.3rpx, transparent 1.3rpx);
  background-size: 34rpx 34rpx;
  position: relative;
  overflow: hidden;
}

.page-shell {
  position: relative;
  z-index: 1;
  min-height: 100vh;
}

.sky-wash {
  position: fixed;
  top: -10%;
  left: -12%;
  right: -12%;
  height: 56vh;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(circle at 16% 8%, rgba(255, 253, 248, 0.9) 0%, rgba(201, 159, 61, 0.06) 30%, transparent 60%),
    radial-gradient(circle at 84% 6%, rgba(72, 128, 106, 0.08) 0%, transparent 36%);
}

.body {
  position: relative;
  z-index: 1;
  min-height: 100vh;
}

.nav-row {
  padding: 8rpx 44rpx 0;
}

.nav-back {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: var(--pk-grn);
}

.nav-back-arrow {
  font-size: 34rpx;
  line-height: 1;
}

.nav-back-txt {
  font-size: 23rpx;
  font-weight: 700;
}

.hero {
  padding: 46rpx 48rpx 20rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.title-logo {
  height: 36rpx;
  width: 48rpx;
  padding: 8rpx;
  box-sizing: content-box;
  display: block;
  background: var(--pk-red);
  border-radius: 12rpx;
  box-shadow: 0 5rpx 14rpx rgba(207, 68, 54, 0.26);
}

.title-main {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pk-t3);
  letter-spacing: 3rpx;
  text-transform: uppercase;
  white-space: nowrap;
}

.hero-title {
  display: block;
  margin-top: 30rpx;
  font-size: 52rpx;
  line-height: 1.1;
  font-weight: 800;
  color: var(--pk-t1);
}

.hero-sub {
  display: block;
  margin-top: 16rpx;
  max-width: 86%;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--pk-t2);
}

.sheet {
  margin: 14rpx 44rpx 0;
  padding: 22rpx 22rpx 28rpx;
  border-radius: 30rpx;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
}

.step-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0 12rpx;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--pk-gauge);
  box-shadow: inset 0 0 0 1rpx var(--pk-bd);
}

.step-dot-active {
  background: var(--pk-grn);
  box-shadow: 0 6rpx 14rpx rgba(72, 128, 106, 0.28);
}

.step-dot-txt {
  font-size: 22rpx;
  font-weight: 800;
  color: #ffffff;
}

.step-line {
  width: 96rpx;
  height: 2rpx;
  margin: 0 12rpx;
  background: var(--pk-accent-border);
}

.err {
  margin: 14rpx 0 0;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(194, 101, 85, 0.1);
  border: 1rpx solid rgba(194, 101, 85, 0.3);
}

.err-txt {
  font-size: 24rpx;
  color: var(--pk-warn);
  text-align: center;
  display: block;
}

.section-label {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 18rpx;
  padding: 0 4rpx;
}

.section-label-next {
  margin-top: 24rpx;
}

.section-title {
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 800;
  color: var(--pk-t1);
}

.section-sub {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--pk-t3);
}

.form-block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 14rpx;
}

.inp-group {
  display: flex;
  align-items: center;
  background: var(--pk-paper);
  border: 1rpx solid var(--pk-bd);
  border-radius: 18rpx;
  overflow: hidden;
}

.inp-group:focus-within {
  border-color: var(--pk-accent-border);
  background: var(--pk-card);
}

.inp-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 82rpx;
  height: 82rpx;
  border-right: 1rpx solid var(--pk-bd);
}

.inp-icon-txt {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--pk-t3);
  letter-spacing: 0.4rpx;
}

.inp {
  flex: 1;
  height: 82rpx;
  min-width: 0;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: var(--pk-t1);
  background: transparent;
  border: none;
  box-sizing: border-box;
}

.inp-phone {
  letter-spacing: 1.5rpx;
}

.inp-code {
  letter-spacing: 6rpx;
  font-weight: 600;
}

.ph {
  color: var(--pk-t3);
  font-size: 27rpx;
}

.code-row {
  display: flex;
  gap: 12rpx;
  align-items: stretch;
}

.code-input {
  flex: 1;
  min-width: 0;
}

.btn-send {
  width: 184rpx;
  flex: 0 0 184rpx;
  height: 82rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 1rpx solid var(--pk-accent-border);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--pk-accent-soft);
  box-sizing: border-box;
}

.btn-send::after {
  border: none;
}

.btn-send-txt {
  font-size: 24rpx;
  line-height: 1.15;
  font-weight: 800;
  color: var(--pk-grn);
  text-align: center;
}

.btn-send-counting {
  background: var(--pk-gauge);
  border-color: var(--pk-bd);
}

.btn-send-counting .btn-send-txt {
  color: var(--pk-t3);
}

.btn-send-off {
  opacity: 0.5;
}

.eye {
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  height: 82rpx;
}

.eye-txt {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pk-grn);
}

.guard-note {
  margin: 18rpx 4rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: var(--pk-accent-soft);
  border: 1rpx solid var(--pk-accent-border);
}

.guard-note-txt {
  display: block;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--pk-t2);
}

.btn-main {
  width: 420rpx;
  max-width: 100%;
  margin: 22rpx auto 0;
  height: 84rpx;
  padding: 0 30rpx;
  border-radius: 22rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--pk-ink-btn);
  box-shadow: 0 8rpx 20rpx var(--pk-shadow);
}

.btn-main::after {
  border: none;
}

.btn-main.off {
  opacity: 0.5;
}

.btn-main-txt {
  display: block;
  font-size: 27rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--pk-ink-btn-t);
  letter-spacing: 2rpx;
  white-space: nowrap;
}
