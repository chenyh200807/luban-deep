@import "/packageDeeptutor/styles/paper-ink.wxss";

/* login/manual.wxss — 其他登录方式(纸墨朱竹单层,root 挂 paper light) */

.manual-page { min-height: 100vh; background-color: var(--pk-paper); background-image: radial-gradient(var(--pk-dot) 1.3rpx, transparent 1.3rpx); background-size: 34rpx 34rpx; position: relative; overflow: hidden; }
.page-shell { position: relative; z-index: 1; min-height: 100vh; }
.sky-wash { position: fixed; top: -10%; left: -12%; right: -12%; height: 56vh; pointer-events: none; z-index: 0; background: radial-gradient(circle at 16% 8%, rgba(255, 253, 248, 0.9) 0%, rgba(201, 159, 61, 0.06) 30%, transparent 60%), radial-gradient(circle at 84% 6%, rgba(72, 128, 106, 0.08) 0%, transparent 36%); }
.body { position: relative; z-index: 1; min-height: 100vh; }
.nav-row { padding: 8rpx 44rpx 0; }
.nav-back { display: inline-flex; align-items: center; gap: 6rpx; color: var(--pk-grn); }
.nav-back-arrow { font-size: 34rpx; line-height: 1; }
.nav-back-txt { font-size: 23rpx; font-weight: 700; }

.hero { padding: 48rpx 48rpx 20rpx; }
.title-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 18rpx; }
.title-logo { height: 34rpx; width: 46rpx; padding: 7rpx; box-sizing: content-box; flex: 0 0 auto; display: block; background: var(--pk-red); border-radius: 12rpx; box-shadow: 0 5rpx 14rpx rgba(207, 68, 54, 0.26); }
.title-main { font-size: 22rpx; font-weight: 700; letter-spacing: 3rpx; text-transform: uppercase; color: var(--pk-t3); }
.hero-title { display: block; font-size: 52rpx; line-height: 1.2; font-weight: 800; color: var(--pk-t1); }
.hero-sub { display: block; margin-top: 12rpx; font-size: 24rpx; line-height: 1.6; color: var(--pk-t2); }

.sheet { margin: 6rpx 32rpx 0; padding: 26rpx 26rpx 30rpx; border-radius: 30rpx; background: var(--pk-card); border: 1rpx solid var(--pk-bd); box-shadow: 0 2rpx 12rpx var(--pk-shadow); }

.mode-switch { display: flex; gap: 10rpx; padding: 8rpx; border-radius: 20rpx; background: var(--pk-gauge); margin-bottom: 22rpx; }
.mode-pill { flex: 1; min-height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; }
.mode-pill-active { background: var(--pk-ink-btn); box-shadow: 0 4rpx 12rpx rgba(38, 36, 31, 0.18); }
.mode-pill-txt { font-size: 25rpx; font-weight: 700; color: var(--pk-t2); }
.mode-pill-active .mode-pill-txt { color: var(--pk-ink-btn-t); font-weight: 800; }

.err { margin-bottom: 18rpx; padding: 12rpx 20rpx; background: rgba(194, 101, 85, 0.1); border: 1rpx solid rgba(194, 101, 85, 0.3); border-radius: 14rpx; }
.err-txt { display: block; text-align: center; font-size: 23rpx; color: var(--pk-warn); }

.manual-form { display: flex; flex-direction: column; gap: 18rpx; }
.inp-group { display: flex; align-items: center; gap: 4rpx; min-height: 92rpx; border-radius: 20rpx; background: var(--pk-paper); border: 1rpx solid var(--pk-bd); box-sizing: border-box; padding: 0 22rpx 0 0; }
.inp-icon { width: 104rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.inp-icon-txt { font-size: 22rpx; font-weight: 800; letter-spacing: 1rpx; color: var(--pk-t3); }
.inp { flex: 1; min-width: 0; height: 92rpx; font-size: 27rpx; color: var(--pk-t1); }
.ph { color: var(--pk-t3); }
.eye { flex-shrink: 0; padding: 8rpx 6rpx; }
.eye-txt { font-size: 22rpx; font-weight: 700; color: var(--pk-grn); }

.code-row { display: flex; gap: 14rpx; align-items: stretch; }
.code-input { flex: 1; min-width: 0; }
.btn-send { flex-shrink: 0; min-width: 176rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; border: 1rpx solid var(--pk-accent-border); background: var(--pk-accent-soft); }
.btn-send:active { opacity: 0.8; }
.btn-send-counting { border-color: var(--pk-bd); background: var(--pk-gauge); }
.btn-send-off { opacity: 0.55; }
.btn-send-txt { font-size: 23rpx; font-weight: 800; color: var(--pk-grn); }
.btn-send-counting .btn-send-txt { color: var(--pk-t3); }

.btn-manual { width: 100%; height: 96rpx; margin: 6rpx 0 0; padding: 0; display: flex; align-items: center; justify-content: center; border: none; border-radius: 22rpx; background: var(--pk-ink-btn); box-shadow: 0 8rpx 20rpx var(--pk-shadow); }
.btn-manual::after { border: none; }
.btn-manual:active { transform: scale(0.985); opacity: 0.92; }
.btn-manual.off { opacity: 0.55; }
.btn-manual-txt { font-size: 28rpx; font-weight: 800; letter-spacing: 2rpx; color: var(--pk-ink-btn-t); }

.foot { margin-top: 24rpx; display: flex; align-items: center; justify-content: center; gap: 16rpx; }
.foot-link { font-size: 23rpx; font-weight: 700; color: var(--pk-grn); }
.foot-sep { font-size: 22rpx; color: var(--pk-sand); }
