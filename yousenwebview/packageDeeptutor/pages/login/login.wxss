@import "/packageDeeptutor/styles/paper-ink.wxss";

/* login.wxss — 登录首屏(纸墨朱竹单层)
 * 原 Zentra 深蓝版的入场编排/视差 orb/布局几何全保留,只换材质:
 * 宣纸底+点阵 / 墨字 / 朱红品牌章+书法点睛 / 墨色主按钮 / 竹青链接。
 * 单主题=宣纸亮(root 挂 paper light),登录场景不随夜间反转。 */

.scene {
  height: 100vh;
  background-color: var(--pk-paper);
  background-image: radial-gradient(var(--pk-dot) 1.3rpx, transparent 1.3rpx);
  background-size: 34rpx 34rpx;
  position: relative;
  overflow: hidden;
}

.page-shell {
  position: relative;
  z-index: 1;
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 天光:宣纸上的暖调洇染(替代深蓝冷光) */
.sky-wash {
  position: fixed;
  inset: -8% -10% auto -10%;
  height: 70vh;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(circle at 18% 10%, rgba(255, 253, 248, 0.9) 0%, rgba(201, 159, 61, 0.07) 34%, transparent 62%),
    radial-gradient(circle at 72% 58%, rgba(72, 128, 106, 0.08) 0%, transparent 52%),
    radial-gradient(circle at 90% 16%, rgba(207, 68, 54, 0.05) 0%, transparent 40%);
}

/* 视差 orb:js 惯性驱动的柔光,降为纸面淡彩 */
.orb {
  position: fixed;
  pointer-events: none;
  z-index: 0;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.o1 {
  width: 860rpx;
  height: 860rpx;
  background: radial-gradient(circle, rgba(255, 253, 248, 0.85) 0%, rgba(233, 229, 215, 0.5) 24%, transparent 66%);
}

.o2 {
  width: 760rpx;
  height: 760rpx;
  background: radial-gradient(circle, rgba(72, 128, 106, 0.08) 0%, transparent 60%);
}

.o3 {
  width: 720rpx;
  height: 720rpx;
  background: radial-gradient(circle, rgba(201, 159, 61, 0.07) 0%, transparent 60%);
}

.body {
  position: relative;
  z-index: 1;
  flex: 1;
  width: 100%;
  overflow-y: auto;
  box-sizing: border-box;
}

.hero-stage {
  width: 100%;
  min-height: calc(100vh - 40rpx);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: stretch;
  padding: 0 0 392rpx;
  box-sizing: border-box;
}

.hero-block {
  width: 590rpx;
  max-width: calc(100vw - 120rpx);
  padding: 0 36rpx;
}

.hero-kicker {
  display: block;
  margin-bottom: 14rpx;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 3.2rpx;
  text-transform: uppercase;
  color: var(--pk-t3);
  white-space: nowrap;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* 白 logo 落朱红章上(与权益中心导航章同构) */
.brand-mark {
  height: 44rpx;
  width: 60rpx;
  padding: 8rpx;
  box-sizing: content-box;
  display: block;
  background: var(--pk-red);
  border-radius: 14rpx;
  box-shadow: 0 6rpx 18rpx rgba(207, 68, 54, 0.28);
}

.brand-name {
  font-size: 54rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--pk-t1);
  letter-spacing: 0.4rpx;
  white-space: nowrap;
}

.hero-copy {
  margin-top: 22rpx;
  max-width: 100%;
}

.hero-line {
  display: block;
  font-weight: 800;
  letter-spacing: -1.4rpx;
}

.hero-line-single {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  white-space: nowrap;
}

.hero-line-main-inline {
  font-size: 68rpx;
  line-height: 1;
  color: var(--pk-t1);
}

/* 点睛词:书法体朱红(动画卡「鲁班智考」同一品牌书法资产语言) */
.hero-line-accent-inline {
  font-family: "Long Cang", "Kaiti SC", "STKaiti", "KaiTi", "楷体", cursive;
  font-size: 72rpx;
  line-height: 1;
  letter-spacing: 2rpx;
  color: var(--pk-red);
}

.hero-desc {
  display: block;
  margin-top: 20rpx;
  max-width: 100%;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--pk-t2);
}

.hero-desc-sub {
  margin-top: 2rpx;
}

.pager-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.pager-dot {
  border-radius: 999rpx;
}

.pager-dot-active {
  width: 36rpx;
  height: 8rpx;
  background: var(--pk-t1);
}

.pager-dot-idle {
  width: 8rpx;
  height: 8rpx;
  background: var(--pk-sand);
}

/* 行动区:底部宣纸渐变承托 */
.action-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  padding: 32rpx 18rpx 0;
  background: linear-gradient(
    180deg,
    rgba(245, 243, 236, 0) 0%,
    rgba(245, 243, 236, 0.62) 18%,
    rgba(245, 243, 236, 0.92) 46%,
    rgba(245, 243, 236, 0.99) 100%
  );
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  z-index: 2;
}

.err {
  margin-bottom: 20rpx;
  padding: 14rpx 22rpx;
  background: rgba(194, 101, 85, 0.1);
  border: 1rpx solid rgba(194, 101, 85, 0.3);
  border-radius: 16rpx;
}

.err-txt {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--pk-warn);
}

/* 主按钮:墨色(10a 定稿) */
.btn-wechat-stack {
  position: relative;
  width: 100%;
  padding: 0;
  border-radius: 32rpx;
  background: var(--pk-ink-btn);
  box-shadow: 0 12rpx 28rpx rgba(38, 36, 31, 0.24);
  box-sizing: border-box;
  overflow: hidden;
}

.btn-wechat-primary {
  display: flex;
  width: 100%;
  max-width: none;
  height: 102rpx;
  border-radius: 32rpx;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent !important;
  box-shadow: none;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn-wechat-primary::after {
  border: none;
}

.btn-wechat-primary:active {
  transform: scale(0.985);
  opacity: 0.92;
}

.btn-wechat-primary.off {
  opacity: 0.5;
}

.btn-wechat-primary-txt {
  font-size: 33rpx;
  font-weight: 800;
  color: var(--pk-ink-btn-t);
  letter-spacing: 2rpx;
}

.guest-entry {
  align-self: center;
  margin-top: 20rpx;
  min-width: 228rpx;
  height: 62rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--pk-bd);
  background: var(--pk-card);
  box-sizing: border-box;
}

.guest-entry:active {
  transform: scale(0.99);
  opacity: 0.88;
}

.guest-entry-txt {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pk-t2);
}

.guest-entry-arrow {
  font-size: 28rpx;
  line-height: 1;
  color: var(--pk-grn);
}

.link-row {
  width: 100%;
  margin-top: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 18rpx;
  background: transparent;
}

.manual-link {
  display: inline-block;
  font-size: 23rpx;
  line-height: 1.2;
  color: var(--pk-grn);
  font-weight: 700;
  text-align: center;
  background: transparent;
  padding: 0;
  border-radius: 0;
  box-shadow: none;
  margin: 0;
  transform: none;
}

.link-sep {
  font-size: 22rpx;
  line-height: 1;
  color: var(--pk-sand);
}

/* —— 先体验导学:色浪出场转场(改为宣纸→竹青暖浪) —— */
.guest-wave {
  position: fixed;
  left: 0;
  right: 0;
  top: -6%;
  bottom: -6%;
  z-index: 90;
  pointer-events: none;
  transform: translateY(104%);
  background: linear-gradient(0deg, #fffdf8 0%, #f0ede1 36%, #cfd9cd 68%, #7fa392 100%);
}

.guest-wave.play {
  animation: guestWaveUp 460ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}

@keyframes guestWaveUp {
  to {
    transform: translateY(0);
  }
}

/* ============================================================
   电影感入场编排(节奏不变,只换了纸墨材质)
   节奏: kicker 划入(80ms) → 品牌行(200ms) → 标题升起(340ms)
        → 书法点睛 → 文案(1.75s) → 行动区(1.15s+)
   ============================================================ */

.login-aurora-gold {
  position: fixed;
  width: 880rpx;
  height: 880rpx;
  bottom: -420rpx;
  right: -360rpx;
  pointer-events: none;
  opacity: 0.5;
  background: radial-gradient(circle, rgba(201, 159, 61, 0.12) 0%, rgba(201, 159, 61, 0.04) 36%, transparent 62%);
  animation: loginGoldDrift 22s ease-in-out infinite alternate;
}

@keyframes loginGoldDrift {
  to { transform: translate3d(-120rpx, -70rpx, 0) scale(1.1); }
}

/* 纸纹颗粒:沿用噪点贴图,宣纸上颗粒感更弱 */
.login-grain {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  opacity: 0.035;
  background-image: url("data:image/png;base64,");
  background-size: 110rpx 110rpx;
}

/* —— 一次性入场编排(原节奏保留) —— */
.hero-kicker {
  animation: loginKickIn 620ms ease 80ms both;
}

.brand-row {
  animation: loginRise 680ms cubic-bezier(0.22, 1, 0.36, 1) 200ms both;
}

.hero-line-single {
  animation: loginRise 760ms cubic-bezier(0.22, 1, 0.36, 1) 340ms both;
}

.hero-desc {
  animation: loginRise 640ms ease 1750ms both;
}

.hero-desc-sub {
  animation-delay: 1880ms;
}

.pager-row {
  animation: loginFade 600ms ease 2080ms both;
}

.btn-wechat-stack {
  animation: loginRise 720ms cubic-bezier(0.22, 1, 0.36, 1) 1150ms both;
}

.guest-entry {
  animation: loginRise 640ms cubic-bezier(0.22, 1, 0.36, 1) 1380ms both;
}

.link-row {
  animation: loginFade 620ms ease 1600ms both;
}

@keyframes loginRise {
  from {
    opacity: 0;
    transform: translateY(28rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes loginFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes loginKickIn {
  from {
    opacity: 0;
    transform: translateX(-24rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.privacy-consent-row {
  width: 100%;
  min-height: 36rpx;
  margin: 14rpx 0 0;
  padding: 0 20rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  animation: loginFade 620ms ease 1320ms both;
}

.privacy-consent-button,
.privacy-consent-toggle {
  width: auto;
  min-width: 0;
  min-height: 40rpx;
  height: auto;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
  border-radius: 8rpx;
  background: transparent !important;
  box-shadow: none;
  line-height: 1.35;
  font-size: inherit;
  box-sizing: border-box;
}

.privacy-consent-button::after {
  content: '';
  display: none;
  border: none;
}

.privacy-checkbox {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
  border-radius: 6rpx;
  border: 2rpx solid var(--pk-sand);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--pk-card);
}

.privacy-checkbox.checked {
  border-color: var(--pk-grn);
  background: var(--pk-grn);
}

.privacy-checkmark {
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 800;
}

.privacy-copy,
.privacy-link {
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--pk-t3);
  white-space: normal;
}

.privacy-link {
  color: var(--pk-grn);
  font-weight: 700;
}

/* ── 夜宣纸(paper 非 light):亮色字面量的暗态收口 ─────────── */
.scene.paper:not(.light) .sky-wash {
  opacity: 0.5;
}
.scene.paper:not(.light) .o1 {
  background: radial-gradient(circle, rgba(240, 237, 225, 0.08) 0%, rgba(240, 237, 225, 0.03) 24%, transparent 66%);
}
.scene.paper:not(.light) .action-panel {
  background: linear-gradient(
    180deg,
    rgba(28, 26, 21, 0) 0%,
    rgba(28, 26, 21, 0.62) 18%,
    rgba(28, 26, 21, 0.92) 46%,
    rgba(28, 26, 21, 0.99) 100%
  );
}
