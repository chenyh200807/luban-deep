.scene {
  height: 100vh;
  background: linear-gradient(180deg, #10214c 0%, #0b1635 38%, #070d1d 72%, #04070e 100%);
  position: relative;
  overflow: hidden;
}

.page-shell {
  position: relative;
  z-index: 1;
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sky-wash {
  position: fixed;
  inset: -8% -10% auto -10%;
  height: 70vh;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(circle at 18% 10%, rgba(255, 255, 255, 0.74) 0%, rgba(208, 226, 255, 0.42) 18%, rgba(122, 170, 255, 0.16) 40%, transparent 66%),
    radial-gradient(circle at 72% 58%, rgba(201, 223, 255, 0.82) 0%, rgba(157, 194, 255, 0.28) 18%, rgba(90, 142, 255, 0.10) 38%, transparent 60%),
    radial-gradient(circle at 90% 16%, rgba(55, 101, 225, 0.22) 0%, transparent 40%);
}

.orb {
  position: fixed;
  pointer-events: none;
  z-index: 0;
  border-radius: 50%;
  mix-blend-mode: screen;
  transform: translate(-50%, -50%);
}

.o1 {
  width: 860rpx;
  height: 860rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.90) 0%, rgba(232,241,255,0.56) 20%, rgba(119,162,255,0.14) 48%, transparent 72%);
}

.o2 {
  width: 760rpx;
  height: 760rpx;
  background: radial-gradient(circle, rgba(203,225,255,0.34) 0%, rgba(93,143,255,0.12) 36%, transparent 68%);
}

.o3 {
  width: 720rpx;
  height: 720rpx;
  background: radial-gradient(circle, rgba(70,120,240,0.12) 0%, transparent 66%);
}

.body {
  position: relative;
  z-index: 1;
  flex: 1;
  width: 100%;
  overflow-y: auto;
  box-sizing: border-box;
}

.hero-stage {
  width: 100%;
  min-height: calc(100vh - 40rpx);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: stretch;
  padding: 0 0 392rpx;
  box-sizing: border-box;
}

.hero-block {
  width: 590rpx;
  max-width: calc(100vw - 120rpx);
  padding: 0 36rpx;
}

.hero-kicker {
  display: block;
  margin-bottom: 14rpx;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 580;
  letter-spacing: 3.2rpx;
  text-transform: uppercase;
  color: rgba(226, 232, 240, 0.44);
  white-space: nowrap;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  opacity: 0.96;
}

.brand-mark {
  height: 44rpx;
  display: block;
}

.brand-name {
  font-size: 54rpx;
  line-height: 1;
  font-weight: 760;
  color: rgba(255, 255, 255, 0.98);
  letter-spacing: 0.4rpx;
  white-space: nowrap;
}

.hero-copy {
  margin-top: 22rpx;
  max-width: 100%;
}





.hero-desc {
  display: block;
  margin-top: 20rpx;
  max-width: 100%;
  font-size: 22rpx;
  line-height: 1.44;
  color: rgba(226, 232, 240, 0.56);
}

.hero-desc-sub {
  margin-top: 2rpx;
}

.pager-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.pager-dot {
  border-radius: 999rpx;
}

.pager-dot-active {
  width: 36rpx;
  height: 8rpx;
  background: #4d97ff;
}

.pager-dot-idle {
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.18);
}

.action-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  padding: 32rpx 18rpx 0;
  background: linear-gradient(
    180deg,
    rgba(4, 7, 14, 0) 0%,
    rgba(4, 7, 14, 0.54) 18%,
    rgba(4, 7, 14, 0.88) 46%,
    rgba(4, 7, 14, 0.98) 100%
  );
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  z-index: 2;
}

.err {
  margin-bottom: 20rpx;
  padding: 14rpx 22rpx;
  background: rgba(127, 29, 29, 0.28);
  border: 1rpx solid rgba(239, 68, 68, 0.18);
  border-radius: 16rpx;
}

.err-txt {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #fda4af;
}

.btn-wechat-stack {
  position: relative;
  width: 100%;
  padding: 0;
  border-radius: 32rpx;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0) 18%, rgba(255, 255, 255, 0.16) 100%),
    linear-gradient(135deg, #6fc0ff 0%, #3a8eff 48%, #1f6dff 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 24rpx 54rpx rgba(37, 99, 235, 0.30),
    0 8rpx 24rpx rgba(58, 142, 255, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.34),
    inset 0 -12rpx 24rpx rgba(10, 38, 118, 0.18);
  box-sizing: border-box;
  overflow: hidden;
}

.btn-wechat-primary {
  display: flex;
  width: 100%;
  max-width: none;
  height: 102rpx;
  border-radius: 32rpx;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent !important;
  box-shadow: none;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn-wechat-primary::after {
  border: none;
}

.btn-wechat-primary:active {
  transform: scale(0.985);
  opacity: 0.92;
}

.btn-wechat-primary.off {
  opacity: 0.5;
}

.btn-wechat-primary-txt {
  font-size: 33rpx;
  font-weight: 820;
  color: #ffffff;
  letter-spacing: 1.2rpx;
}

.privacy-consent-row {
  width: 100%;
  min-height: 36rpx;
  margin: 14rpx 0 0;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
  box-sizing: border-box;
}

.privacy-consent-button,
.privacy-consent-toggle {
  min-height: 40rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
  border-radius: 8rpx;
  background: transparent !important;
  box-shadow: none;
  line-height: 1.35;
  box-sizing: border-box;
}

.privacy-consent-button::after {
  border: none;
}

.privacy-checkbox {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
  border-radius: 6rpx;
  border: 2rpx solid rgba(226, 232, 240, 0.46);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.24);
}

.privacy-checkbox.checked {
  border-color: rgba(103, 183, 255, 0.92);
  background: #4198ff;
}

.privacy-checkmark {
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 800;
}

.privacy-copy,
.privacy-link {
  font-size: 22rpx;
  line-height: 1.35;
  color: rgba(226, 232, 240, 0.68);
  white-space: normal;
}

.privacy-link {
  color: #8fc7ff;
  font-weight: 620;
}

.guest-entry {
  align-self: center;
  margin-top: 20rpx;
  min-width: 228rpx;
  height: 62rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.12);
  background: rgba(226, 232, 240, 0.07);
  box-sizing: border-box;
}

.guest-entry:active {
  transform: scale(0.99);
  opacity: 0.88;
}

.guest-entry-txt {
  font-size: 24rpx;
  font-weight: 680;
  color: rgba(226, 232, 240, 0.86);
}

.guest-entry-arrow {
  font-size: 28rpx;
  line-height: 1;
  color: rgba(247, 201, 107, 0.86);
}

.link-row {
  width: 100%;
  margin-top: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 18rpx;
  background: transparent;
}

.manual-link {
  display: inline-block;
  font-size: 23rpx;
  line-height: 1.2;
  color: rgba(226, 232, 240, 0.72);
  font-weight: 560;
  text-align: center;
  background: transparent;
  padding: 0;
  border-radius: 0;
  box-shadow: none;
  margin: 0;
  transform: none;
}

.link-sep {
  font-size: 22rpx;
  line-height: 1;
  color: rgba(226, 232, 240, 0.24);
}

/* —— 先体验导学：色浪出场转场（与 onboarding wave-overlay 同渐变语言）—— */
.guest-wave {
  position: fixed;
  left: 0;
  right: 0;
  top: -6%;
  bottom: -6%;
  z-index: 90;
  pointer-events: none;
  transform: translateY(104%);
  background: linear-gradient(0deg, #cfeaff 0%, #5aa8f5 32%, #1c3f93 68%, #0b1635 100%);
}

.guest-wave.play {
  animation: guestWaveUp 460ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}

@keyframes guestWaveUp {
  to {
    transform: translateY(0);
  }
}


/* ============================================================
   电影感入场编排（与 onboarding 深夜蓝黑设计系统同语言）
   节奏: kicker 划入(80ms) → 品牌行(200ms) → 标题逐字升起(340ms+)
        → 「智能备考导师」点金(1.5s) → 文案(1.75s) → 行动区(1.15s+)
   ============================================================ */

.login-aurora-gold {
  position: fixed;
  width: 880rpx;
  height: 880rpx;
  bottom: -420rpx;
  right: -360rpx;
  pointer-events: none;
  opacity: 0.5;
  background: radial-gradient(circle, rgba(56, 182, 255, 0.16) 0%, rgba(56, 182, 255, 0.05) 36%, transparent 62%);
  animation: loginGoldDrift 22s ease-in-out infinite alternate;
}

@keyframes loginGoldDrift {
  to { transform: translate3d(-120rpx, -70rpx, 0) scale(1.1); }
}

.login-grain {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  opacity: 0.05;
  background-image: url("data:image/png;base64,");
  background-size: 110rpx 110rpx;
}

/* —— 标题逐字 mask-rise —— */
.hero-title-line {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  overflow: hidden;
  padding-bottom: 6rpx;
}

.hero-char {
  display: block;
  opacity: 0;
  transform: translateY(112%);
  font-family: "Songti SC", "STSong", "Source Han Serif SC", serif;
  font-weight: 900;
  color: #f2f5fb;
  font-size: 74rpx;
  line-height: 1.22;
  animation: loginCharRise 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.hero-char-pad {
  margin-right: 18rpx;
}

@keyframes loginCharRise {
  from {
    opacity: 0;
    transform: translateY(112%);
  }
  55% {
    opacity: 1;
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 升起完成后整词点金（颜色与辉光淡入，Apple 式克制） */
.hero-char-accent {
  animation:
    loginCharRise 760ms cubic-bezier(0.22, 1, 0.36, 1) both,
    loginGoldIn 880ms ease 1500ms both;
}

@keyframes loginGoldIn {
  from {
    color: #f2f5fb;
    text-shadow: 0 0 0 rgba(232, 181, 77, 0);
  }
  to {
    color: #7db8ff;
    text-shadow: 0 0 28rpx rgba(90, 162, 255, 0.45);
  }
}

/* —— 一次性入场编排 —— */
.hero-kicker {
  animation: loginKickIn 620ms ease 80ms both;
}

.brand-row {
  animation: loginRise 680ms cubic-bezier(0.22, 1, 0.36, 1) 200ms both;
}

.hero-desc {
  animation: loginRise 640ms ease 1750ms both;
}

.hero-desc-sub {
  animation-delay: 1880ms;
}

.pager-row {
  animation: loginFade 600ms ease 2080ms both;
}

.btn-wechat-stack {
  animation: loginRise 720ms cubic-bezier(0.22, 1, 0.36, 1) 1150ms both;
}

.guest-entry {
  animation: loginRise 640ms cubic-bezier(0.22, 1, 0.36, 1) 1380ms both;
}

.link-row {
  animation: loginFade 620ms ease 1600ms both;
}

@keyframes loginRise {
  from {
    opacity: 0;
    transform: translateY(28rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes loginFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes loginKickIn {
  from {
    opacity: 0;
    transform: translateX(-24rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}
