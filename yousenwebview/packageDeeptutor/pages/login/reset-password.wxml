<view class="reset-page paper light">
  <view class="sky-wash"></view>

  <view class="page-shell">
    <scroll-view class="body" scroll-y enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}" style="padding-top:{{statusBarHeight}}px">
      <view class="nav-row">
        <view class="nav-back" bindtap="goBack">
          <text class="nav-back-arrow">‹</text>
          <text class="nav-back-txt">返回登录</text>
        </view>
      </view>

      <view class="hero">
        <view class="title-row">
          <image class="title-logo" src="../../images/logo-mark-white.png" mode="heightFix" />
          <text class="title-main">Luban AI Tutor</text>
        </view>
        <text class="hero-title">找回或设置密码</text>
        <text class="hero-sub">用手机号验证码验证身份，快速登录用户也可以直接设置登录密码。</text>
      </view>

      <view class="sheet">
        <view class="step-row">
          <view class="step-dot step-dot-active"><text class="step-dot-txt">1</text></view>
          <view class="step-line"></view>
          <view class="step-dot step-dot-active"><text class="step-dot-txt">2</text></view>
        </view>

        <view class="err" wx:if="{{errorMsg}}">
          <text class="err-txt">{{errorMsg}}</text>
        </view>

        <view class="section-label">
          <text class="section-title">验证账号身份</text>
          <text class="section-sub">快速登录用户可只填手机号；填账号时会校验账号和手机号一致。</text>
        </view>

        <view class="form-block">
          <view class="inp-group">
            <view class="inp-icon"><text class="inp-icon-txt">ID</text></view>
            <input class="inp" value="{{username}}" bindinput="onUsernameInput"
              placeholder="用户名或邮箱（选填）" placeholder-class="ph" maxlength="50" />
          </view>

          <view class="inp-group">
            <view class="inp-icon"><text class="inp-icon-txt">+86</text></view>
            <input class="inp inp-phone" type="number" value="{{phone}}" bindinput="onPhoneInput"
              placeholder="注册手机号" placeholder-class="ph" maxlength="11" />
          </view>

          <view class="code-row">
            <view class="inp-group code-input">
              <view class="inp-icon"><text class="inp-icon-txt">OTP</text></view>
              <input class="inp inp-code" type="number" value="{{phoneCode}}" bindinput="onPhoneCodeInput"
                placeholder="6 位验证码" placeholder-class="ph" maxlength="6" />
            </view>
            <view class="btn-send {{codeCountdown > 0 ? 'btn-send-counting' : ''}} {{loading ? 'btn-send-off' : ''}}"
              bindtap="sendCode">
              <text class="btn-send-txt">{{codeCountdown > 0 ? codeCountdown + 's 后重发' : '获取验证码'}}</text>
            </view>
          </view>
        </view>

        <view class="section-label section-label-next">
          <text class="section-title">设置新密码</text>
          <text class="section-sub">至少 6 位，包含大写字母、小写字母和数字。</text>
        </view>

        <view class="form-block">
          <view class="inp-group">
            <view class="inp-icon"><text class="inp-icon-txt">KEY</text></view>
            <input class="inp" style="flex:1;" value="{{password}}" bindinput="onPasswordInput"
              placeholder="新登录密码" placeholder-class="ph" password="{{!showPassword}}" maxlength="128" />
            <view class="eye" bindtap="togglePassword">
              <text class="eye-txt">{{showPassword ? '隐藏' : '显示'}}</text>
            </view>
          </view>

          <view class="inp-group">
            <view class="inp-icon"><text class="inp-icon-txt">OK</text></view>
            <input class="inp" style="flex:1;" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput"
              placeholder="再次输入新密码" placeholder-class="ph" password="{{!showConfirmPassword}}" maxlength="128" />
            <view class="eye" bindtap="toggleConfirmPassword">
              <text class="eye-txt">{{showConfirmPassword ? '隐藏' : '显示'}}</text>
            </view>
          </view>
        </view>

        <view class="guard-note">
          <text class="guard-note-txt">重置成功后旧登录会话将失效，系统不会自动登录。</text>
        </view>

        <button class="btn-main {{loading?'off':''}}" bindtap="handleResetPassword" disabled="{{loading}}">
          <text class="btn-main-txt">{{loading ? '处理中...' : '确认重设密码'}}</text>
        </button>
      </view>

      <view style="height: {{safeBottom + 34}}px"></view>
    </scroll-view>
  </view>
</view>
