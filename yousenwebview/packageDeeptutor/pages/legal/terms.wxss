@import "/packageDeeptutor/styles/paper-ink.wxss";

/* pages/legal/terms.wxss — 服务条款（纸墨朱竹单层：palette 全走 --pk-* token，
 * 亮/暗由 paper-ink 的 .paper/.paper.light 切换，本文件不再自带第二套配色） */

.terms-page {
  min-height: 100vh;
  color: var(--pk-t1);
  font-family: -apple-system, "PingFang SC", sans-serif;
}

/* ── 导航（与 report/profile 同构） ─────────────────────── */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: var(--pk-paper);
  border-bottom: 1rpx solid var(--pk-bd);
}

.nav-content {
  height: 88rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-back {
  width: 96rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.nav-back:active {
  opacity: 0.72;
}

.nav-back-arrow {
  font-size: 38rpx;
  line-height: 1;
  color: var(--pk-grn);
}

.nav-back-txt {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pk-grn);
}

.nav-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.page-scroll {
  position: fixed;
  left: 0;
  right: 0;
}

.page-inner {
  padding: 24rpx 26rpx 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

/* ── 卡片（沿用 legacy 类名，材质=pk-card） ─────────────── */
.glass-card {
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  border-radius: 30rpx;
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
}

.hero-card {
  padding: 32rpx 30rpx;
}

.hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
  color: var(--pk-t1);
}

.hero-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--pk-grn);
}

.hero-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.72;
  color: var(--pk-t2);
}

.section-card,
.footer-card {
  padding: 26rpx 30rpx 28rpx;
}

.section-title,
.footer-title {
  display: block;
  padding-left: 18rpx;
  border-left: 6rpx solid var(--pk-grn);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  color: var(--pk-t1);
}

.section-paragraph,
.footer-text {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.76;
  color: var(--pk-t2);
}
