@import "/packageDeeptutor/theme.wxss";
@import "/packageDeeptutor/styles/paper-ink.wxss";

/* pages/report/report.wxss — 学情页(10e 诊断单)样式 */

.report-page {
  height: 100vh;
  background: var(--bg-primary);
  overflow: hidden;
}

/* 10e:诊断单主面走宣纸底(纸墨朱竹 --pk-* token,夜/亮随 .light 切换) */
.report-page.paper {
  background-color: var(--pk-paper);
  background-image: radial-gradient(var(--pk-dot) 1.3rpx, transparent 1.3rpx);
  background-size: 34rpx 34rpx;
}

/* ── 导航栏 ──────────────────────────────────────── */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: rgba(10, 10, 10, 0.9);
  border-bottom: 1rpx solid var(--border);
}

.nav-content {
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 0;
  gap: 16rpx;
}

/* 返回按钮 */
.nav-back {
  display: flex; align-items: center; gap: 4rpx;
  margin-left: 20rpx; padding: 8rpx 12rpx 8rpx 4rpx;
  border-radius: 8rpx;
}
.nav-back:active { background: rgba(255,255,255,0.08); }
.nav-back-arrow {
  font-size: 40rpx; color: #818cf8; font-weight: 300;
  line-height: 1; margin-top: -4rpx;
}
.nav-back-txt { font-size: 28rpx; color: #818cf8; font-weight: 500; }

.nav-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* ── 页面滚动区 ──────────────────────────────────── */
.page-scroll {
  position: fixed;
  left: 0;
  right: 0;
  overflow-y: auto;
}

.page-inner {
  padding: 28rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.focus-summary {
  padding: 18rpx;
  border-radius: 14rpx;
  background: rgba(15, 23, 42, 0.28);
  border: 1rpx solid rgba(148, 163, 184, 0.12);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.focus-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #93c5fd;
}

.focus-text {
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 800;
  color: var(--text-primary);
}

.primary-training-cta {
  margin-top: 2rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: rgba(6, 78, 59, 0.18);
  border: 1rpx solid rgba(52, 211, 153, 0.22);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.degraded-hint {
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(251, 191, 36, 0.1);
  border: 1rpx solid rgba(251, 191, 36, 0.18);
}

.degraded-hint-text {
  font-size: 22rpx;
  line-height: 1.45;
  color: #fbbf24;
}

.guest-report-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(135deg, rgba(247, 201, 107, 0.12), rgba(96, 165, 250, 0.08)),
    rgba(255,255,255,0.04);
  border: 1rpx solid rgba(247, 201, 107, 0.16);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.guest-report-copy {
  flex: 1;
  min-width: 0;
}

.guest-report-kicker {
  display: block;
  font-size: 21rpx;
  font-weight: 760;
  color: rgba(247, 201, 107, 0.86);
}

.guest-report-title {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.24;
  font-weight: 860;
  color: var(--text-primary);
}

.guest-report-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.42;
  color: var(--text-secondary);
}

.guest-report-action {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(248, 250, 252, 0.94);
}

.guest-report-action-txt {
  font-size: 24rpx;
  font-weight: 820;
  color: #0f172a;
}

.module-mini-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.module-mini-stats text {
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  font-size: 19rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.76);
}

/* ── 二级详情页头图与图表 ───────────────────── */
.report-detail-hero {
  padding: 26rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border-color: rgba(148, 163, 184, 0.16);
}

.detail-evidence {
  background:
    linear-gradient(145deg, rgba(8, 145, 178, 0.24), rgba(15, 23, 42, 0.72));
}

.detail-map {
  background:
    linear-gradient(145deg, rgba(79, 70, 229, 0.24), rgba(15, 23, 42, 0.72));
}

.detail-training {
  background:
    linear-gradient(145deg, rgba(5, 150, 105, 0.24), rgba(15, 23, 42, 0.72));
}

.detail-progress {
  background:
    linear-gradient(145deg, rgba(217, 119, 6, 0.22), rgba(15, 23, 42, 0.72));
}

.detail-hero-kicker,
.detail-hero-title,
.detail-hero-sub {
  display: block;
}

.detail-hero-kicker {
  font-size: 22rpx;
  font-weight: 800;
  color: #7dd3fc;
}

.detail-hero-title {
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 850;
  color: var(--text-primary);
}

.detail-hero-sub {
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--text-secondary);
}

.detail-metric-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.detail-metric-row > view {
  padding: 15rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.detail-metric-num,
.detail-metric-label {
  display: block;
}

.detail-metric-num {
  font-size: 32rpx;
  line-height: 1.1;
  font-weight: 850;
  color: #7dd3fc;
}

.detail-metric-label {
  margin-top: 5rpx;
  font-size: 19rpx;
  color: rgba(226, 232, 240, 0.66);
}

.report-map-summary {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.map-summary-label,
.map-summary-num {
  display: block;
}

.map-summary-label {
  font-size: 20rpx;
  color: rgba(226, 232, 240, 0.62);
}

.map-summary-num {
  margin-top: 2rpx;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 850;
  color: #7dd3fc;
}

.map-summary-bars {
  height: 18rpx;
  display: flex;
  gap: 6rpx;
}

.map-summary-bar {
  height: 18rpx;
  border-radius: 99rpx;
}

/* 四态暖色语义(10e):稳了/再看一眼/待复验——禁红灯墙 */
.map-summary-bar.strong { width: 120rpx; background: var(--pk-grn); }
.map-summary-bar.normal { width: 90rpx; background: rgba(72, 128, 106, 0.38); }
.map-summary-bar.weak { width: 54rpx; background: var(--pk-warn); }

.training-route {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.training-route-line {
  flex: 1;
  height: 2rpx;
  background: rgba(110, 231, 183, 0.24);
}

.training-route-step {
  min-width: 92rpx;
  height: 46rpx;
  padding: 0 12rpx;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.training-route-step.active {
  background: rgba(52, 211, 153, 0.16);
  border-color: rgba(52, 211, 153, 0.28);
}

.training-route-step text {
  font-size: 21rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.78);
}

.training-prescription-meta {
  margin-top: -4rpx;
}

.training-loop-card {
  margin-top: 16rpx;
  padding: 26rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  background:
    radial-gradient(circle at top right, rgba(20, 184, 166, 0.18), transparent 34%),
    linear-gradient(145deg, rgba(6, 95, 70, 0.22), rgba(15, 23, 42, 0.78));
}

.training-loop-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.training-loop-kicker,
.training-loop-title,
.training-loop-desc {
  display: block;
}

.training-loop-kicker {
  font-size: 21rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #5eead4;
}

.training-loop-title {
  margin-top: 8rpx;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #f8fafc;
}

.training-loop-badge {
  flex-shrink: 0;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #bfdbfe;
}

.training-loop-desc {
  font-size: 23rpx;
  line-height: 1.6;
  color: rgba(226, 232, 240, 0.78);
}

.training-loop-meter {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.training-loop-line {
  flex: 1;
  height: 3rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(94, 234, 212, 0.46), rgba(96, 165, 250, 0.2));
}

.training-loop-dot {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.training-loop-dot.active {
  background: rgba(45, 212, 191, 0.16);
  border-color: rgba(45, 212, 191, 0.28);
}

.training-loop-dot text {
  font-size: 19rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.78);
}

.training-loop-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.training-loop-stats text {
  padding: 7rpx 11rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  font-size: 20rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.76);
}

.grading-loop-stages {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.grading-loop-stage {
  min-width: 0;
  padding: 12rpx;
  border-radius: 8rpx;
  background: rgba(15, 23, 42, 0.42);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
}

.grading-loop-stage.status-ready,
.grading-loop-stage.status-verified {
  border-color: rgba(45, 212, 191, 0.32);
  background: rgba(20, 184, 166, 0.12);
}

.grading-loop-stage.status-due {
  border-color: rgba(251, 191, 36, 0.32);
  background: rgba(251, 191, 36, 0.1);
}

.grading-loop-stage-label,
.grading-loop-stage-status {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grading-loop-stage-label {
  font-size: 21rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #f8fafc;
}

.grading-loop-stage-status {
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.25;
  color: rgba(226, 232, 240, 0.72);
}

.training-action-card {
  min-height: 86rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #5eead4, #60a5fa);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  box-shadow: 0 18rpx 42rpx rgba(14, 165, 233, 0.18);
}

.training-action-card-pressed,
.battle-plan-action-pressed {
  transform: scale(0.985);
  opacity: 0.88;
}

.training-action-title,
.training-action-desc {
  display: block;
}

.training-action-title {
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: 900;
  color: rgba(15, 23, 42, 0.95);
}

.training-action-desc {
  margin-top: 5rpx;
  font-size: 21rpx;
  line-height: 1.35;
  color: rgba(15, 23, 42, 0.7);
}

.training-action-arrow {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 900;
  color: rgba(15, 23, 42, 0.82);
}

.progress-chart-card {
  padding: 16rpx 12rpx 8rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.07);
}

.progress-chart-bars {
  height: 132rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  gap: 18rpx;
}

.progress-chart-bar {
  width: 82rpx;
  border-radius: 14rpx 14rpx 6rpx 6rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 10rpx;
  background: rgba(251, 191, 36, 0.7);
}

.progress-chart-bar.today { height: 74rpx; }
.progress-chart-bar.recent { height: 116rpx; background: rgba(125, 211, 252, 0.78); }
.progress-chart-bar.streak { height: 94rpx; background: rgba(52, 211, 153, 0.72); }

.progress-chart-bar text {
  font-size: 18rpx;
  font-weight: 800;
  color: rgba(15, 23, 42, 0.82);
}

/* ── Learning Engine Evidence Fusion ───────────── */
.learning-engine-panel {
  position: relative;
  overflow: hidden;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  border-color: rgba(56, 189, 248, 0.22);
  background:
    linear-gradient(135deg, rgba(14, 116, 144, 0.22), rgba(15, 23, 42, 0.78)),
    radial-gradient(circle at 92% 0%, rgba(52, 211, 153, 0.18), transparent 34%);
}

.engine-panel-rail {
  position: absolute;
  left: 20rpx;
  top: 22rpx;
  bottom: 22rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #67e8f9, rgba(103, 232, 249, 0.08));
}

.engine-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding-left: 18rpx;
}

.engine-kicker {
  display: block;
  margin-bottom: 5rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #67e8f9;
}

.engine-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 900;
  color: var(--text-primary);
}

.engine-summary {
  flex-shrink: 0;
  max-width: 236rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(8, 145, 178, 0.16);
  border: 1rpx solid rgba(103, 232, 249, 0.2);
  font-size: 19rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #a5f3fc;
  text-align: right;
}

.engine-subtitle {
  display: block;
  padding-left: 18rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--text-muted);
}

.engine-source-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  padding-left: 18rpx;
}

.engine-source-card {
  min-height: 108rpx;
  padding: 14rpx;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 5rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.075);
}

.engine-source-card.source-active {
  border-color: rgba(103, 232, 249, 0.18);
  background: rgba(8, 145, 178, 0.1);
}

.engine-source-label {
  font-size: 20rpx;
  line-height: 1.25;
  color: #cbd5e1;
}

.engine-source-value {
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 900;
  color: var(--text-primary);
}

.engine-source-status {
  font-size: 18rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #94a3b8;
}

.source-active .engine-source-status {
  color: #67e8f9;
}

/* ── Learning State Inference ───────────────────── */
.learning-state-section {
  position: relative;
  overflow: hidden;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  box-shadow: 0 18rpx 48rpx rgba(2, 8, 23, 0.24);
}

.learning-state-section-rail {
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: rgba(96, 165, 250, 0.7);
}

.prescription-section {
  background:
    linear-gradient(135deg, rgba(6, 95, 70, 0.32), rgba(12, 28, 38, 0.78)),
    radial-gradient(circle at 88% 8%, rgba(52, 211, 153, 0.16), transparent 36%);
  border-color: rgba(52, 211, 153, 0.24);
}

.prescription-rail {
  background: #34d399;
}

.three-layer-state {
  background:
    linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(30, 41, 59, 0.76)),
    radial-gradient(circle at 8% 0%, rgba(125, 211, 252, 0.12), transparent 34%);
  border-color: rgba(125, 211, 252, 0.18);
}

.scoring-point-map-section {
  background:
    linear-gradient(135deg, rgba(30, 27, 75, 0.36), rgba(15, 23, 42, 0.82)),
    radial-gradient(circle at 90% 4%, rgba(129, 140, 248, 0.12), transparent 36%);
  border-color: rgba(129, 140, 248, 0.2);
}

.mistake-history-section {
  background:
    linear-gradient(135deg, rgba(69, 26, 3, 0.28), rgba(15, 23, 42, 0.82)),
    radial-gradient(circle at 90% 0%, rgba(251, 146, 60, 0.13), transparent 36%);
  border-color: rgba(251, 146, 60, 0.2);
}

.mistake-rail {
  background: #fb923c;
}

.scoring-rail {
  background: #818cf8;
}

.learning-state-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.learning-state-section-title {
  display: block;
  font-size: 25rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.learning-state-section-tag {
  flex-shrink: 0;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.065);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  font-size: 18rpx;
  font-weight: 700;
  color: #c7d2fe;
}

.learning-state-section-subtitle {
  display: block;
  font-size: 31rpx;
  line-height: 1.32;
  font-weight: 900;
  color: var(--text-primary);
}

.prescription-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.prescription-meta-chip {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(52, 211, 153, 0.12);
  border: 1rpx solid rgba(52, 211, 153, 0.18);
  font-size: 19rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #a7f3d0;
}

.battle-plan-action {
  margin-top: 18rpx;
  min-height: 76rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: rgba(96, 165, 250, 0.13);
  border: 1rpx solid rgba(96, 165, 250, 0.24);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.battle-plan-action text:first-child {
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #e0f2fe;
}

.battle-plan-action text:last-child {
  flex-shrink: 0;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(96, 165, 250, 0.18);
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #93c5fd;
}

.learning-state-section-desc {
  display: block;
  margin-top: -4rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--text-muted);
}

.learning-state-steps {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.learning-state-step {
  min-height: 44rpx;
  padding: 9rpx 13rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.learning-state-step-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #bfdbfe;
}

.learning-state-cta {
  min-height: 58rpx;
  justify-content: center;
  border-color: rgba(52, 211, 153, 0.3);
  background: rgba(6, 95, 70, 0.24);
}

.learning-state-cta-label {
  font-size: 23rpx;
  font-weight: 800;
  color: #6ee7b7;
}

.learning-state-layer {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.learning-state-layer-label {
  font-size: 21rpx;
  font-weight: 800;
  color: #7dd3fc;
}

.learning-state-row {
  padding: 18rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.learning-state-row-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.learning-state-row-title {
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 850;
  color: var(--text-primary);
}

.learning-state-row-meta {
  font-size: 20rpx;
  line-height: 1.35;
  color: var(--text-muted);
}

.learning-state-row-action {
  margin-top: 3rpx;
  font-size: 21rpx;
  line-height: 1.38;
  color: #bae6fd;
}

.learning-state-row-status {
  flex-shrink: 0;
  max-width: 132rpx;
  padding: 7rpx 10rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
  color: #cbd5e1;
  background: rgba(148, 163, 184, 0.12);
}

.learning-state-row.state-warn {
  border-color: rgba(251, 191, 36, 0.18);
  background: rgba(251, 191, 36, 0.055);
}

.learning-state-row.state-warn .learning-state-row-status {
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.12);
}

.learning-state-row.state-good {
  border-color: rgba(52, 211, 153, 0.18);
  background: rgba(52, 211, 153, 0.055);
}

.learning-state-row.state-good .learning-state-row-status {
  color: #6ee7b7;
  background: rgba(52, 211, 153, 0.12);
}

.scoring-point-row {
  padding: 17rpx;
  border-radius: 16rpx;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 8rpx 12rpx;
  align-items: start;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.scoring-point-badge {
  padding: 5rpx 9rpx;
  border-radius: 9rpx;
  background: rgba(96, 165, 250, 0.1);
  color: #93c5fd;
  font-size: 18rpx;
  font-weight: 800;
}

.scoring-point-name {
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 800;
  color: var(--text-primary);
}

.scoring-point-miss {
  grid-column: 2;
  font-size: 20rpx;
  font-weight: 800;
  color: #fca5a5;
}

.scoring-point-empty {
  padding: 18rpx;
  border-radius: 14rpx;
  background: rgba(99, 102, 241, 0.08);
  border: 1rpx dashed rgba(129, 140, 248, 0.22);
  font-size: 23rpx;
  line-height: 1.45;
  color: #cbd5e1;
}

.mistake-history-card {
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(15, 23, 42, 0.42);
  border: 1rpx solid rgba(251, 146, 60, 0.16);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.mistake-history-card:active {
  opacity: 0.84;
}

.mistake-history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mistake-history-time {
  font-size: 21rpx;
  font-weight: 800;
  color: #fdba74;
}

.mistake-history-result {
  padding: 5rpx 10rpx;
  border-radius: 9rpx;
  background: rgba(248, 113, 113, 0.14);
  font-size: 20rpx;
  font-weight: 800;
  color: #fca5a5;
}

.mistake-history-question {
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 800;
  color: var(--text-primary);
}

.mistake-history-row {
  display: grid;
  grid-template-columns: 120rpx 1fr;
  gap: 14rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(148, 163, 184, 0.12);
}

.mistake-history-label {
  font-size: 21rpx;
  font-weight: 800;
  color: #94a3b8;
}

.mistake-history-value {
  font-size: 22rpx;
  line-height: 1.5;
  color: #cbd5e1;
}

.mistake-history-value.strong {
  color: #fed7aa;
}

.mistake-history-cta {
  align-self: flex-start;
  margin-top: 2rpx;
  padding: 7rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(251, 146, 60, 0.12);
  border: 1rpx solid rgba(251, 146, 60, 0.18);
  font-size: 21rpx;
  font-weight: 800;
  color: #fdba74;
}

/* ── Learning Brain ─────────────────────────────── */
.learning-review-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.learning-brain {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.learning-brain-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.learning-brain-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.learning-brain-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.learning-brain-stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.brain-stat {
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(96, 165, 250, 0.12);
  border: 1rpx solid rgba(96, 165, 250, 0.18);
  font-size: 20rpx;
  color: #93c5fd;
}

.learning-brain-loading {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.brain-skel {
  height: 44rpx;
  width: 100%;
}

.brain-skel.short {
  width: 68%;
}

.learning-brain-state {
  padding: 8rpx 0 4rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.learning-brain-state-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.learning-brain-state-desc {
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--text-muted);
}

.learning-brain-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.brain-review-summary {
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(14, 165, 233, 0.08);
  border: 1rpx solid rgba(125, 211, 252, 0.16);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.brain-review-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #7dd3fc;
}

.brain-review-headline {
  font-size: 25rpx;
  line-height: 1.5;
  color: var(--text-primary);
}

.brain-review-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.brain-review-metric {
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(15, 23, 42, 0.24);
  font-size: 20rpx;
  color: #bfdbfe;
}

.brain-column {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.brain-column-title {
  font-size: 23rpx;
  font-weight: 700;
  color: #7dd3fc;
}

.brain-column-sub {
  margin-top: -4rpx;
  font-size: 21rpx;
  color: var(--text-muted);
}

.brain-truth-row,
.brain-diagnosis-row,
.brain-edge-row,
.brain-training-row,
.brain-chain-row,
.note-asset-row,
.attempt-card,
.brain-next-action {
  padding: 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.brain-truth-row,
.brain-diagnosis-row {
  display: flex;
  gap: 12rpx;
}

.brain-level {
  flex-shrink: 0;
  min-width: 92rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(148, 163, 184, 0.12);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
}

.brain-level-text {
  font-size: 19rpx;
  font-weight: 700;
  color: #cbd5e1;
}

.level-L1_repeated {
  background: rgba(251, 191, 36, 0.12);
  border-color: rgba(251, 191, 36, 0.22);
}

.level-L1_repeated .brain-level-text {
  color: #fbbf24;
}

.level-L2_confirmed {
  background: rgba(52, 211, 153, 0.12);
  border-color: rgba(52, 211, 153, 0.22);
}

.level-L2_confirmed .brain-level-text {
  color: #34d399;
}

.brain-row-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.brain-row-title,
.brain-training-title {
  font-size: 25rpx;
  line-height: 1.45;
  color: var(--text-primary);
}

.brain-row-meta,
.brain-training-meta,
.brain-edge-path,
.brain-edge-event {
  font-size: 21rpx;
  line-height: 1.4;
  color: var(--text-muted);
}

.brain-diagnosis-detail,
.brain-action-line {
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--text-muted);
}

.brain-action-line {
  color: #bfdbfe;
}

.brain-challenge-action {
  align-self: flex-start;
  min-height: 44rpx;
  margin-top: 4rpx;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(14, 165, 233, 0.12);
  border: 1rpx solid rgba(125, 211, 252, 0.2);
  color: #7dd3fc;
  font-size: 20rpx;
  font-weight: 800;
}

.attempt-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.attempt-card:active,
.brain-next-action:active {
  opacity: 0.82;
}

.attempt-wrong {
  border-color: rgba(248, 113, 113, 0.18);
  background: rgba(248, 113, 113, 0.055);
}

.attempt-correct {
  border-color: rgba(52, 211, 153, 0.18);
  background: rgba(16, 185, 129, 0.055);
}

.attempt-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.attempt-time {
  display: block;
  margin-bottom: 4rpx;
  font-size: 20rpx;
  color: #93c5fd;
}

.attempt-title {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--text-primary);
}

.attempt-result {
  flex-shrink: 0;
  padding: 5rpx 10rpx;
  border-radius: 9rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.result-wrong {
  background: rgba(248, 113, 113, 0.14);
  color: #fca5a5;
}

.result-correct {
  background: rgba(52, 211, 153, 0.14);
  color: #6ee7b7;
}

.attempt-answer {
  font-size: 23rpx;
  line-height: 1.45;
  color: #e5e7eb;
}

.attempt-diagnosis,
.attempt-explanation {
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--text-muted);
}

.attempt-explanation {
  padding-top: 2rpx;
  color: var(--text-secondary);
}

.attempt-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding-top: 2rpx;
}

.attempt-action {
  padding: 7rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(96, 165, 250, 0.12);
  border: 1rpx solid rgba(96, 165, 250, 0.18);
  font-size: 21rpx;
  font-weight: 700;
  color: #bfdbfe;
}

.bookmark-action.cloud {
  background: rgba(148, 163, 184, 0.1);
  border-color: rgba(148, 163, 184, 0.22);
  color: var(--text-muted);
  opacity: 0.78;
}

.bookmark-action.saved {
  opacity: 0.72;
}

.note-card-action {
  background: rgba(52, 211, 153, 0.1);
  border-color: rgba(52, 211, 153, 0.2);
  color: #86efac;
}

.note-card-action.primary {
  background: rgba(14, 165, 233, 0.16);
  border-color: rgba(125, 211, 252, 0.24);
  color: #7dd3fc;
}

.note-asset-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.note-asset-title,
.note-asset-summary,
.note-asset-source {
  display: block;
}

.note-asset-title {
  font-size: 23rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.note-asset-summary {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: var(--text-secondary);
}

.note-asset-source {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: #a7f3d0;
}

.note-asset-action {
  flex-shrink: 0;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(96, 165, 250, 0.14);
  border: 1rpx solid rgba(147, 197, 253, 0.2);
  color: #bfdbfe;
  font-size: 20rpx;
  font-weight: 800;
}

.brain-event-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.brain-event {
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(15, 23, 42, 0.28);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  font-size: 19rpx;
  color: #bfdbfe;
}

.brain-edge-row,
.brain-training-row,
.brain-chain-row,
.brain-next-action {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.brain-next-action {
  border-color: rgba(52, 211, 153, 0.18);
  background: rgba(6, 78, 59, 0.16);
}

.brain-next-cta {
  align-self: flex-start;
  margin-top: 6rpx;
  padding: 7rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(52, 211, 153, 0.13);
  font-size: 21rpx;
  font-weight: 700;
  color: #6ee7b7;
}

.brain-chain-row {
  border-color: rgba(96, 165, 250, 0.18);
  background: rgba(37, 99, 235, 0.08);
}

.chain-improved {
  border-color: rgba(52, 211, 153, 0.24);
  background: rgba(16, 185, 129, 0.09);
}

.chain-not-improved {
  border-color: rgba(251, 191, 36, 0.24);
  background: rgba(245, 158, 11, 0.09);
}

.brain-chain-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.brain-chain-step {
  font-size: 21rpx;
  line-height: 1.4;
  color: var(--text-muted);
}

.brain-chain-outcome {
  align-self: flex-start;
  margin-top: 2rpx;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(15, 23, 42, 0.22);
  font-size: 20rpx;
  font-weight: 700;
  color: #bfdbfe;
}

.chain-improved .brain-chain-outcome {
  color: #34d399;
}

.chain-not-improved .brain-chain-outcome {
  color: #fbbf24;
}

.brain-edge-type {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.brain-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding-top: 2rpx;
}

.brain-footer-text {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* ── Section Headers ─────────────────────────────── */
.section-header {
  padding: 6rpx 4rpx 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.section-header-large {
  padding-top: 4rpx;
}

.section-heading-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.section-kicker {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #60a5fa;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-subtitle {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-muted);
}

.sub-header {
  margin-top: 24rpx;
  margin-bottom: 8rpx;
}

.section-title-sm {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.section-subtitle-sm {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ── 空状态 / 加载 ───────────────────────────────── */
.loading-card {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-card {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 64rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.5;
}

.empty-btn {
  margin-top: 16rpx;
  padding: 14rpx 40rpx;
  background: rgba(99, 102, 241, 0.15);
  border: 1rpx solid rgba(99, 102, 241, 0.3);
  border-radius: var(--radius-full);
}

.empty-btn:active {
  opacity: 0.7;
}

.empty-btn-txt {
  font-size: 26rpx;
  font-weight: 600;
  color: #818cf8;
}

/* ── 雷达图 Canvas ───────────────────────────────── */
.radar-canvas-wrap {
  display: flex;
  justify-content: center;
  padding: 32rpx 0 16rpx;
}

.radar-canvas {
  width: 560rpx;
  height: 560rpx;
  max-width: 100%;
}

.radar-image {
  width: 560rpx;
  height: 560rpx;
  max-width: 100%;
}

/* ── 雷达统计 ────────────────────────────────────── */
.radar-summary {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 16rpx;
}

.radar-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-bottom: 4rpx;
}

/* 四态暖色(对齐 10e):红黄绿硬编码 → 竹青/淡竹青/赭 + 未学灰 */
.dot-strong { background: var(--pk-grn); }
.dot-normal { background: rgba(72, 128, 106, 0.38); }
.dot-weak   { background: var(--pk-warn); }

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ── 维度列表 ────────────────────────────────────── */
.dim-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dim-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}

.dim-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rank-strong { background: rgba(52, 211, 153, 0.15); }
.rank-normal { background: rgba(251, 191, 36, 0.15); }
.rank-weak   { background: rgba(248, 113, 113, 0.15); }

.dim-rank-txt {
  font-size: 24rpx;
  font-weight: 700;
}

/* 四态暖色(10e):禁红灯墙 */
.rank-strong .dim-rank-txt { color: var(--pk-grn); }
.rank-normal .dim-rank-txt { color: #6e937f; }
.rank-weak   .dim-rank-txt { color: var(--pk-warn); }
.rank-observed .dim-rank-txt { color: var(--pk-t3); }

.dim-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}

.dim-bar {
  width: 120rpx;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 5rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.dim-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.6s ease;
}

.dim-pct {
  font-size: 26rpx;
  font-weight: 600;
  min-width: 64rpx;
  text-align: right;
}

/* ── 掌握度大数字 ────────────────────────────────── */
.mastery-hero {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.mastery-score-wrap {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
}

.mastery-score {
  font-size: 96rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 0.92;
}

/* 四态暖色(10e):禁红灯墙 */
.score-good { color: var(--pk-grn); }
.score-mid  { color: #6e937f; }
.score-low  { color: var(--pk-warn); }

.mastery-unit {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-muted);
  line-height: 1;
  margin-bottom: 12rpx;
}

.mastery-label {
  font-size: 24rpx;
  color: var(--text-muted);
}

.mastery-map-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  width: 100%;
  margin-top: 20rpx;
}

.mastery-map-item {
  min-width: 0;
  padding: 14rpx 8rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  background: rgba(15, 23, 42, 0.28);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.mastery-map-num {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.mastery-map-label {
  font-size: 20rpx;
  color: var(--text-muted);
  white-space: nowrap;
}

.mastery-map-item.warn .mastery-map-num {
  color: var(--pk-warn);
}

.mastery-sub-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 16rpx;
}

.mastery-sub-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.mastery-sub-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.mastery-sub-warn {
  color: var(--pk-warn);
}

.mastery-sub-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.mastery-sub-divider {
  width: 1rpx;
  height: 40rpx;
  background: var(--border);
}

.textbook-directory {
  padding: 8rpx 20rpx;
  margin-bottom: 24rpx;
}

.directory-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--border);
}

.directory-row:last-child {
  border-bottom: none;
}

.directory-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.directory-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.directory-meta {
  font-size: 22rpx;
  color: var(--text-muted);
}

.directory-status {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  background: rgba(148, 163, 184, 0.12);
}

.directory-row.status-weak .directory-status {
  color: #fecaca;
  background: rgba(248, 113, 113, 0.16);
}

.directory-row.status-strong .directory-status {
  color: #bbf7d0;
  background: rgba(52, 211, 153, 0.14);
}

.directory-row.status-developing .directory-status {
  color: #fde68a;
  background: rgba(251, 191, 36, 0.14);
}

/* ── 科目掌握度分组 ──────────────────────────────── */
.mastery-group {
  padding: 24rpx;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 20rpx;
}

.group-title {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.group-preview {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.group-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.group-avg {
  font-size: 26rpx;
  font-weight: 700;
}

.group-toggle {
  font-size: 22rpx;
  color: var(--primary-400);
}

/* 四态暖色(10e):禁红灯墙 */
.avg-good { color: var(--pk-grn); }
.avg-mid  { color: #6e937f; }
.avg-low  { color: var(--pk-warn); }

.group-chapters {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.chapter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ch-name {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ch-bar {
  width: 120rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 4rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.ch-bar-fill {
  height: 100%;
  border-radius: 4rpx;
}

.ch-pct {
  font-size: 22rpx;
  font-weight: 600;
  min-width: 56rpx;
  text-align: right;
}

/* ── AI 作战方案 ───────────────────────────────── */
.battle-plan {
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  background:
    radial-gradient(circle at top right, rgba(37, 99, 235, 0.18), transparent 32%),
    linear-gradient(145deg, rgba(37, 99, 235, 0.12), rgba(15, 23, 42, 0.08));
}

.battle-plan-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.battle-plan-kicker {
  display: block;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #93c5fd;
}

.battle-plan-topic {
  display: block;
  margin-top: 10rpx;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #eff6ff;
}

.battle-plan-badge {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.battle-plan-badge-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #bfdbfe;
}

.battle-plan-note {
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(239, 246, 255, 0.82);
}

.battle-plan-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.battle-plan-row {
  display: grid;
  grid-template-columns: 120rpx 1fr;
  gap: 20rpx;
  align-items: start;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.battle-plan-row-first {
  padding-top: 0;
  border-top: none;
}

.battle-plan-label {
  font-size: 24rpx;
  color: rgba(191, 219, 254, 0.78);
}

.battle-plan-value {
  font-size: 24rpx;
  line-height: 1.7;
  color: #f8fafc;
}

/* ── 进步反馈 ───────────────────────────────────── */
.progress-panel {
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.progress-summary {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.progress-insight {
  margin-top: -6rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-muted);
}

.progress-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.progress-item {
  padding: 20rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.progress-item-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.progress-item-value {
  font-size: 36rpx;
  line-height: 1.1;
  font-weight: 700;
  color: var(--text-primary);
}

.progress-item-detail {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.progress-milestones {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 4rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.progress-milestone {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.progress-milestone-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: #7dd3fc;
  flex-shrink: 0;
}

.progress-milestone-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.progress-milestone-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.progress-milestone-detail {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.tone-good {
  color: #34d399;
}

.tone-accent {
  color: #7dd3fc;
}

.tone-warn {
  color: var(--pk-warn);
}

/* ═══════════════════════════════════════════════
   ★ 亮色模式
   ═══════════════════════════════════════════════ */

/* ── CSS 变量覆盖 ──────────────────────────── */
.report-page.light {
  --primary-400: #5e8cff;
  --primary-500: #2f6bff;
  --primary-600: #2557d8;
  --bg-primary: linear-gradient(180deg, #f7faff 0%, #eef4ff 52%, #f8fbff 100%);
  --bg-secondary: #ffffff;
  --bg-tertiary: #eef4ff;
  --bg-card: rgba(255, 255, 255, 0.92);
  --bg-elevated: rgba(255, 255, 255, 0.98);
  --text-primary: #111827;
  --text-secondary: #334155;
  --text-tertiary: #516174;
  --text-muted: #7b8799;
  --border-subtle: rgba(219, 230, 245, 0.65);
  --border-light: #dbe6f5;
  --border-medium: #d1def4;
  --border: #dbe6f5;
  --shadow-sm: 0 6rpx 18rpx rgba(126, 147, 185, 0.08);
  --shadow-md: 0 14rpx 34rpx rgba(126, 147, 185, 0.12);
}

/* ── 导航栏 ────────────────────────────────── */
.report-page.light .nav-bar {
  background: rgba(248, 250, 255, 0.96);
  border-color: #dbe6f5;
  box-shadow: 0 10rpx 28rpx rgba(126, 147, 185, 0.10);
}
.report-page.light .nav-back:active { background: rgba(0,0,0,0.04); }
.report-page.light .nav-back-arrow { color: #4f46e5; }
.report-page.light .nav-back-txt { color: #4f46e5; }

/* ── 进度条背景 ────────────────────────────── */
.report-page.light .dim-bar { background: #edf2fb; }
.report-page.light .ch-bar { background: #edf2fb; }
.report-page.light .empty-btn {
  background: #eef4ff;
  border-color: #c6d8ff;
}
.report-page.light .empty-btn-txt { color: #2f6bff; }

.report-page.light .battle-plan {
  background:
    radial-gradient(circle at top right, rgba(37, 99, 235, 0.16), transparent 32%),
    linear-gradient(145deg, rgba(47, 107, 255, 0.10), rgba(255, 255, 255, 0.92));
}

.report-page.light .battle-plan-topic {
  color: #0f172a;
}

.report-page.light .battle-plan-note {
  color: #334155;
}

.report-page.light .battle-plan-badge {
  background: rgba(47, 107, 255, 0.08);
  border-color: rgba(47, 107, 255, 0.14);
}

.report-page.light .battle-plan-badge-text,
.report-page.light .battle-plan-kicker,
.report-page.light .battle-plan-label {
  color: #2f6bff;
}

.report-page.light .battle-plan-row {
  border-color: rgba(209, 222, 244, 0.7);
}

.report-page.light .battle-plan-value {
  color: #0f172a;
}

.report-page.light .progress-item {
  background: rgba(255, 255, 255, 0.8);
  border-color: rgba(209, 222, 244, 0.85);
}

.report-page.light .progress-milestones {
  border-color: rgba(209, 222, 244, 0.7);
}

.report-page.light .report-detail-hero {
  border-color: rgba(209, 222, 244, 0.82);
  box-shadow: 0 16rpx 38rpx rgba(47, 107, 255, 0.08);
}

.report-page.light .detail-evidence {
  background: linear-gradient(145deg, rgba(14, 165, 233, 0.12), rgba(255, 255, 255, 0.94));
}

.report-page.light .detail-map {
  background: linear-gradient(145deg, rgba(79, 70, 229, 0.12), rgba(255, 255, 255, 0.94));
}

.report-page.light .detail-training {
  background: linear-gradient(145deg, rgba(16, 185, 129, 0.12), rgba(255, 255, 255, 0.94));
}

.report-page.light .detail-progress {
  background: linear-gradient(145deg, rgba(245, 158, 11, 0.12), rgba(255, 255, 255, 0.94));
}

.report-page.light .detail-hero-title {
  color: #0f172a;
}

.report-page.light .detail-hero-sub {
  color: #64748b;
}

.report-page.light .detail-metric-label,
.report-page.light .map-summary-label {
  color: #7b8799;
}

.report-page.light .module-mini-stats text,
.report-page.light .detail-metric-row > view,
.report-page.light .training-route-step,
.report-page.light .progress-chart-card {
  background: rgba(241, 245, 249, 0.72);
  border-color: rgba(209, 222, 244, 0.8);
  color: #475569;
}

.report-page.light .training-route-step text {
  color: #475569;
}

.report-page.light .progress-chart-bar text {
  color: #0f172a;
}

/* ============================================================
 * 10e 诊断单(第 10 轮定稿 + round11 增量①④)
 * token 源: styles/paper-ink.wxss --pk-*(夜基,.light 覆盖)
 * 铁律: 四态暖色禁红灯墙;蓝环=接触轨,绝不进红黄绿掌握色阶;
 *       辅助字号 ≥24rpx;朱红只留品牌位,本页不用。
 * ============================================================ */

.lr-head {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 8rpx 8rpx 4rpx;
}

.lr-head-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.lr-head-sub {
  font-size: 24rpx;
  color: var(--pk-t3);
}

.lr-card {
  border-radius: 34rpx;
  border: 1rpx solid var(--pk-bd);
  background: var(--pk-card);
  box-shadow: 0 4rpx 22rpx var(--pk-shadow);
  padding: 28rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
}

.lr-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.lr-card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.lr-card-note {
  font-size: 24rpx;
  color: var(--pk-t3);
}

.lr-card-link {
  align-self: flex-start;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--pk-t1);
  text-decoration: underline;
  text-underline-offset: 6rpx;
  padding: 4rpx 0;
}

.lr-pressed {
  opacity: 0.72;
}

/* ── ① 轻量诊断卡:档位词 + 主要差距 + 进步叙述(折叠单) ── */
.lr-diag-main {
  display: flex;
  align-items: center;
  gap: 26rpx;
}

.lr-risk-ring {
  width: 142rpx;
  height: 142rpx;
  border-radius: 50%;
  border: 10rpx solid var(--pk-gauge);
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.lr-risk-gear {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.lr-risk-label {
  font-size: 24rpx;
  color: var(--pk-t3);
}

.lr-risk-good { border-color: var(--pk-grn); }
.lr-risk-good .lr-risk-gear { color: var(--pk-grn); }
.lr-risk-mid { border-color: var(--pk-t2); }
.lr-risk-warn { border-color: var(--pk-warn); }
.lr-risk-warn .lr-risk-gear { color: var(--pk-warn); }
.lr-risk-none { border-color: var(--pk-gauge); }
.lr-risk-none .lr-risk-gear { color: var(--pk-t3); font-size: 26rpx; }

.lr-diag-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.lr-diag-headline {
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 800;
  color: var(--pk-t1);
}

.lr-diag-progress {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--pk-grn);
}

.lr-diag-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.lr-diag-meta {
  font-size: 24rpx;
  color: var(--pk-t2);
}

.lr-diag-meta-warn {
  color: var(--pk-warn);
  font-weight: 700;
}

.lr-diag-fold-toggle {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pk-t3);
}

.lr-diag-fold {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  border-top: 1rpx solid var(--pk-bd);
  padding-top: 18rpx;
}

.lr-diag-fold-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.lr-diag-fold-level {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pk-warn);
  border: 1rpx solid var(--pk-bd);
  border-radius: 10rpx;
  padding: 2rpx 10rpx;
}

.lr-diag-fold-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.lr-diag-fold-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--pk-t1);
}

.lr-diag-fold-meta {
  font-size: 24rpx;
  color: var(--pk-t3);
}

.lr-diag-fold-detail {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--pk-t2);
}

/* ── ⑤ 分数账本轻占位(一行,不喧宾) ── */
.lr-ledger-line {
  margin-top: 16rpx;
  padding: 0 10rpx;
  font-size: 24rpx;
  color: var(--pk-t3);
}

/* ── ② 掌握地图 40 格:四态暖色 + 蓝环第五态 ── */
.lr-map-grid {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 8rpx;
}

.lr-cell {
  aspect-ratio: 1;
  border-radius: 6rpx;
  background: var(--pk-gauge);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 掌握轨四态(暖色,待复验用赭非红,禁红灯墙) */
.lr-cell--stable { background: var(--pk-grn); }
.lr-cell--watch { background: rgba(72, 128, 106, 0.38); }
.report-page.paper:not(.light) .lr-cell--watch { background: rgba(127, 185, 157, 0.32); }
.lr-cell--reverify { background: var(--pk-warn); }
.lr-cell--unlearned { background: var(--pk-gauge); }

/* 蓝环第五态(接触轨):灰底 + 蓝描边 + 蓝勾;从对象蓝 #2f6db0 降饱和派生,
   绝不进红黄绿掌握色阶 */
.lr-cell--blue {
  background: var(--pk-gauge);
  border: 3rpx solid #4a7aab;
  box-sizing: border-box;
}
.report-page.paper:not(.light) .lr-cell--blue { border-color: #6f97bd; }

.lr-cell-bluecheck {
  font-size: 22rpx;
  line-height: 1;
  font-weight: 800;
  color: #4a7aab;
}
.report-page.paper:not(.light) .lr-cell-bluecheck { color: #6f97bd; }

.lr-map-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding-top: 4rpx;
}

.lr-map-legend-blue {
  border-top: 1rpx dashed var(--pk-bd);
  padding-top: 14rpx;
}

.lr-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--pk-t2);
}

.lr-legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 4rpx;
  aspect-ratio: auto;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lr-legend-dot .lr-cell-bluecheck {
  font-size: 14rpx;
}

.lr-map-degraded,
.lr-map-empty {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--pk-t3);
}

/* ── ④ 趋势(方向性描述,不画假曲线) ── */
.lr-trend-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--pk-t1);
}

.lr-trend-empty {
  color: var(--pk-t3);
}

/* ── ⑦ 错因结构(深链错题本) ── */
.lr-error-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.lr-error-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--pk-t1);
}

.lr-error-count {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--pk-t2);
}

.lr-error-empty {
  font-size: 24rpx;
  color: var(--pk-t3);
}

/* ── ⑥ 全页唯一行动键 ── */
.lr-absorb-btn {
  margin-top: 28rpx;
  min-height: 92rpx;
  border-radius: 24rpx;
  background: var(--pk-ink-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx var(--pk-shadow);
}

.lr-absorb-btn text {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--pk-ink-btn-t);
}

.lr-absorb-pressed {
  opacity: 0.82;
}

/* ── ③ 产品宣言页脚 ── */
.lr-manifesto {
  padding: 24rpx 10rpx 8rpx;
  display: flex;
  justify-content: center;
}

.lr-manifesto text {
  font-size: 24rpx;
  color: var(--pk-t3);
  text-align: center;
}

/* ── 深入页四态语义(维度/章节条,替换旧红绿硬编码色) ── */
.lr-state-strong { color: var(--pk-grn); }
.lr-state-normal { color: #6e937f; }
.report-page.paper:not(.light) .lr-state-normal { color: #8fb3a3; }
.lr-state-weak { color: var(--pk-warn); }
.lr-state-observed { color: var(--pk-t3); }

.lr-fill-strong { background: var(--pk-grn); }
.lr-fill-normal { background: rgba(72, 128, 106, 0.38); }
.report-page.paper:not(.light) .lr-fill-normal { background: rgba(127, 185, 157, 0.32); }
.lr-fill-weak { background: var(--pk-warn); }
.lr-fill-observed { background: var(--pk-gauge); }

.dot-observed { background: var(--pk-gauge); }
