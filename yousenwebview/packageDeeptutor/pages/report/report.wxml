<!-- pages/report/report.wxml — 学情页：诊断 + AI作战方案 + 进步反馈 -->
<view class="report-page {{isDark?'':'light'}}">

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-content">
      <view class="nav-back" bindtap="handleReportBack">
        <text class="nav-back-arrow">‹</text>
        <text class="nav-back-txt">{{reportDetailView == 'home' ? navBackLabel : '学情'}}</text>
      </view>
      <text class="nav-title">{{reportDetailTitle}}</text>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}" scroll-top="{{reportScrollTop}}" style="top: {{navHeight}}px; bottom: 0">
    <view class="page-inner">
      <view class="overview-hero glass-card" wx:if="{{reportDetailView == 'home'}}">
        <view class="overview-head">
          <view>
            <text class="overview-kicker">今日学习复盘</text>
            <text class="overview-title">{{learnerStageTitle}}</text>
            <text class="overview-sub">掌握可信度</text>
          </view>
          <view class="overview-score-wrap">
            <text class="overview-score">{{overallMastery}}%</text>
            <text class="overview-score-unit">{{masteryStatusLabel}}</text>
          </view>
        </view>
        <view class="focus-summary">
          <text class="focus-label">当前重点</text>
          <text class="focus-text">{{learningReviewSummary.primaryFocus || focusHint || '先完成一次批改'}}</text>
        </view>
        <text class="overview-tip" wx:if="{{studyTip}}">{{studyTip}}</text>
        <view class="overview-metrics">
          <view class="metric-chip metric-chip-progress" bindtap="goPractice" hover-class="metric-chip-hover">
            <text class="metric-num">{{todayDone}} / {{dailyTarget || 0}}</text>
            <text class="metric-label">今日</text>
          </view>
          <view class="metric-chip">
            <text class="metric-num">{{learningReviewSummary.recentThreeDone || 0}}</text>
            <text class="metric-label">近3天</text>
          </view>
          <view class="metric-chip">
            <text class="metric-num">{{streakDays}}天</text>
            <text class="metric-label">连续学习</text>
          </view>
          <view class="metric-chip metric-chip-warn">
            <text class="metric-num">{{learningReviewSummary.weakCount || weakNodeCount}}</text>
            <text class="metric-label">待补错因</text>
          </view>
        </view>
        <view class="primary-training-cta" bindtap="goPractice" hover-class="metric-chip-hover">
          <view>
            <text class="primary-training-title">{{learningNextAction.title || '开始今天的定向训练'}}</text>
            <text class="primary-training-sub">{{learningNextAction.subtitle || learningReviewSummary.headline || '根据你的最近作答生成训练'}}</text>
          </view>
          <text class="primary-training-btn">{{learningNextAction.cta || '开始训练'}}</text>
        </view>
      </view>

      <view class="degraded-hint" wx:if="{{reportDetailView == 'home' && degradedHint}}">
        <text class="degraded-hint-text">{{degradedHint}}</text>
      </view>

      <view class="report-home-shell" wx:if="{{reportDetailView == 'home'}}">
        <view class="home-section-head">
          <view>
            <text class="home-section-kicker">关键结论</text>
            <text class="home-section-title">点开任一模块查看具体依据</text>
          </view>
          <text class="home-section-note">少看结论，多看证据</text>
        </view>

        <view class="report-module-grid">
          <view class="report-module-card module-evidence" data-detail="evidence" bindtap="openReportDetail" hover-class="report-module-card-pressed">
            <view class="module-card-head">
              <view>
                <text class="module-card-kicker">为什么这样判断</text>
                <text class="module-card-title">学情依据</text>
              </view>
              <text class="module-card-arrow">›</text>
            </view>
            <text class="module-card-desc">作答、错因、采分点一起解释结论</text>
            <view class="mini-evidence-flow">
              <view class="mini-evidence-node active"></view>
              <view class="mini-evidence-line"></view>
              <view class="mini-evidence-node"></view>
              <view class="mini-evidence-line"></view>
              <view class="mini-evidence-node"></view>
            </view>
            <view class="module-mini-stats">
              <text>{{learningAttemptCards.length || 0}} 条作答</text>
              <text>{{learningDiagnosisCards.length || learningBrainTruths.length || 0}} 个诊断</text>
            </view>
          </view>

          <view class="report-module-card module-map" data-detail="map" bindtap="openReportDetail" hover-class="report-module-card-pressed">
            <view class="module-card-head">
              <view>
                <text class="module-card-kicker">哪里强哪里弱</text>
                <text class="module-card-title">{{overallMastery}}% 掌握地图</text>
              </view>
              <text class="module-card-arrow">›</text>
            </view>
            <view class="mini-radar">
              <view class="mini-radar-ring ring-one"></view>
              <view class="mini-radar-ring ring-two"></view>
              <view class="mini-radar-dot dot-one"></view>
              <view class="mini-radar-dot dot-two"></view>
              <view class="mini-radar-dot dot-three"></view>
            </view>
            <view class="module-mini-stats">
              <text>强 {{strongCount}}</text>
              <text>弱 {{weakCount}}</text>
            </view>
          </view>

          <view class="report-module-card module-training" data-detail="training" bindtap="openReportDetail" hover-class="report-module-card-pressed">
            <view class="module-card-head">
              <view>
                <text class="module-card-kicker">今天先练什么</text>
                <text class="module-card-title">训练安排</text>
              </view>
              <text class="module-card-arrow">›</text>
            </view>
            <text class="module-card-desc">{{battlePlan.priorityTask}}</text>
            <view class="module-chip-row">
              <text>诊断</text>
              <text>补弱</text>
              <text>验证</text>
            </view>
          </view>

          <view class="report-module-card module-progress" data-detail="progress" bindtap="openReportDetail" hover-class="report-module-card-pressed">
            <view class="module-card-head">
              <view>
                <text class="module-card-kicker">这几天有没有变好</text>
                <text class="module-card-title">进步反馈</text>
              </view>
              <text class="module-card-arrow">›</text>
            </view>
            <text class="module-card-desc">{{progressSummary}}</text>
            <view class="mini-bars">
              <view class="mini-bar today"></view>
              <view class="mini-bar recent"></view>
              <view class="mini-bar streak"></view>
            </view>
            <view class="module-mini-stats">
              <text>今日 {{todayDone}}</text>
              <text>近3天 {{learningReviewSummary.recentThreeDone || 0}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Batch C Task 8: today prescription + 3-layer learning state + scoring point map -->
      <block wx:if="{{reportDetailView == 'evidence'}}">
      <view class="report-detail-hero detail-evidence glass-card">
        <text class="detail-hero-kicker">学情依据</text>
        <text class="detail-hero-title">每个判断都能回到具体作答</text>
        <text class="detail-hero-sub">这里保留完整证据链：数据来源、错因、采分点、最近做题复盘和训练闭环。</text>
        <view class="detail-metric-row">
          <view>
            <text class="detail-metric-num">{{learningAttemptCards.length || 0}}</text>
            <text class="detail-metric-label">作答证据</text>
          </view>
          <view>
            <text class="detail-metric-num">{{learningDiagnosisCards.length || learningBrainTruths.length || 0}}</text>
            <text class="detail-metric-label">诊断结论</text>
          </view>
          <view>
            <text class="detail-metric-num">{{scoringPointMapItems.length || 0}}</text>
            <text class="detail-metric-label">采分点</text>
          </view>
        </view>
      </view>

      <view class="learning-engine-panel glass-card" wx:if="{{engineEvidenceVisible}}">
        <view class="engine-panel-rail"></view>
        <view class="engine-head">
          <view>
            <text class="engine-kicker">证据融合</text>
            <text class="engine-title">证据怎么合成结论</text>
          </view>
          <text class="engine-summary">{{engineEvidenceSummary}}</text>
        </view>
        <text class="engine-subtitle">{{engineEvidenceSubtitle}}</text>
        <view class="engine-source-grid">
          <view class="engine-source-card source-{{item.tone}}" wx:for="{{engineEvidenceSources}}" wx:key="key">
            <text class="engine-source-label">{{item.label}}</text>
            <text class="engine-source-value">{{item.value}}</text>
            <text class="engine-source-status">{{item.statusLabel}}</text>
          </view>
        </view>
      </view>

      <view class="learning-state-section prescription-section" wx:if="{{prescriptionTitle}}">
        <view class="learning-state-section-rail prescription-rail"></view>
        <view class="learning-state-section-head">
          <text class="learning-state-section-title">今天先做什么</text>
          <text class="learning-state-section-tag">学情引擎</text>
        </view>
        <text class="learning-state-section-subtitle">{{prescriptionTitle}}</text>
        <view class="prescription-meta" wx:if="{{prescriptionMeta.length}}">
          <text class="prescription-meta-chip" wx:for="{{prescriptionMeta}}" wx:key="key">{{item.label}}</text>
        </view>
        <text class="learning-state-section-desc" wx:if="{{prescriptionSubtitle || prescriptionReason}}">{{prescriptionSubtitle || prescriptionReason}}</text>
        <view class="learning-state-steps" wx:if="{{prescriptionSteps.length}}">
          <view class="learning-state-step" wx:for="{{prescriptionSteps}}" wx:key="key">
            <text class="learning-state-step-text">{{item.phaseLabel || item.phase}}</text>
            <text class="learning-state-step-text">{{item.questionCount}}题</text>
          </view>
        </view>
        <view class="learning-state-cta primary-training-cta" bindtap="goPractice">
          <text class="learning-state-cta-label">{{prescriptionCtaLabel}}</text>
        </view>
      </view>

      <view class="learning-state-section three-layer-state" wx:if="{{!learningStateIsEmpty}}">
        <view class="learning-state-section-rail state-rail"></view>
        <view class="learning-state-section-head">
          <text class="learning-state-section-title">为什么这样安排</text>
          <text class="learning-state-section-tag">知识 · 能力 · 行为</text>
        </view>
        <view class="learning-state-layer" wx:if="{{learningStateKnowledge.length}}">
          <text class="learning-state-layer-label">知识状态</text>
          <view class="learning-state-row state-{{item.stateTone}}" wx:for="{{learningStateKnowledge}}" wx:key="key">
            <view class="learning-state-row-main">
              <text class="learning-state-row-title">{{item.stateHeadline}}</text>
              <text class="learning-state-row-meta">{{item.label}}</text>
              <text class="learning-state-row-action" wx:if="{{item.actionLabel}}">{{item.actionLabel}}</text>
            </view>
            <text class="learning-state-row-status">{{item.evidenceText || item.stateLabel}}</text>
          </view>
        </view>
        <view class="learning-state-layer" wx:if="{{learningStateAbility.length}}">
          <text class="learning-state-layer-label">能力状态</text>
          <view class="learning-state-row state-{{item.stateTone}}" wx:for="{{learningStateAbility}}" wx:key="key">
            <view class="learning-state-row-main">
              <text class="learning-state-row-title">{{item.stateHeadline}}</text>
              <text class="learning-state-row-meta">{{item.label}}</text>
              <text class="learning-state-row-action" wx:if="{{item.actionLabel}}">{{item.actionLabel}}</text>
            </view>
            <text class="learning-state-row-status">{{item.evidenceText || item.stateLabel}}</text>
          </view>
        </view>
        <view class="learning-state-layer" wx:if="{{learningStateBehavior.length}}">
          <text class="learning-state-layer-label">行为状态</text>
          <view class="learning-state-row state-{{item.stateTone}}" wx:for="{{learningStateBehavior}}" wx:key="key">
            <view class="learning-state-row-main">
              <text class="learning-state-row-title">{{item.stateHeadline}}</text>
              <text class="learning-state-row-meta">{{item.label}}</text>
              <text class="learning-state-row-action" wx:if="{{item.actionLabel}}">{{item.actionLabel}}</text>
            </view>
            <text class="learning-state-row-status">{{item.evidenceText || item.stateLabel}}</text>
          </view>
        </view>
      </view>

      <view class="learning-state-section mistake-history-section" wx:if="{{mistakeHistoryCards.length}}">
        <view class="learning-state-section-rail mistake-rail"></view>
        <view class="learning-state-section-head">
          <text class="learning-state-section-title">错题历史怎么证明</text>
          <text class="learning-state-section-tag">真实作答</text>
        </view>
        <text class="learning-state-section-desc">把学情判断落回具体错题：当时哪道题、选了什么、错在什么边界。</text>
        <view class="mistake-history-card" wx:for="{{mistakeHistoryCards}}" wx:key="key" data-key="{{item.key}}" bindtap="openAttemptDetail">
          <view class="mistake-history-head">
            <text class="mistake-history-time">{{item.timeLabel || '最近一次'}}</text>
            <text class="mistake-history-result">{{item.resultLabel}}</text>
          </view>
          <text class="mistake-history-question">{{item.questionTitle}}</text>
          <view class="mistake-history-row">
            <text class="mistake-history-label">当时作答</text>
            <text class="mistake-history-value">{{item.answerLine}}</text>
          </view>
          <view class="mistake-history-row">
            <text class="mistake-history-label">错在哪里</text>
            <text class="mistake-history-value">{{item.whereWrong}}</text>
          </view>
          <view class="mistake-history-row">
            <text class="mistake-history-label">为什么错</text>
            <text class="mistake-history-value strong">{{item.whyWrong}}</text>
          </view>
          <text class="mistake-history-cta">{{item.detailCta}}</text>
        </view>
      </view>

      <view class="learning-state-section scoring-point-map-section" wx:if="{{scoringPointMapItems.length || scoringPointMapEmptyLabel}}">
        <view class="learning-state-section-rail scoring-rail"></view>
        <view class="learning-state-section-head">
          <text class="learning-state-section-title">采分点怎么补</text>
          <text class="learning-state-section-tag">案例题证据</text>
        </view>
        <view wx:if="{{scoringPointMapItems.length}}">
          <view class="scoring-point-row" wx:for="{{scoringPointMapItems}}" wx:key="key">
            <text class="scoring-point-badge">{{item.granularityLabel}}</text>
            <text class="scoring-point-name">{{item.label}}</text>
            <text class="scoring-point-miss">漏 {{item.missCount}} 次</text>
          </view>
        </view>
        <text wx:else class="scoring-point-empty">{{scoringPointMapEmptyLabel}}</text>
      </view>

      <view class="learning-review-panel">
        <view wx:if="{{learningBrainLoading}}" class="learning-brain-loading">
          <view class="skel-block brain-skel"></view>
          <view class="skel-block brain-skel short"></view>
        </view>

        <view wx:elif="{{learningBrainError}}" class="learning-brain-state">
          <text class="learning-brain-state-title">学习事实暂不可用</text>
          <text class="learning-brain-state-desc">稍后重试，或先完成一次案例题批改</text>
        </view>

        <view wx:elif="{{learningBrainEmpty}}" class="learning-brain-state">
          <text class="learning-brain-state-title">还没有可展示的学习事实</text>
          <text class="learning-brain-state-desc">完成一次案例题批改后，这里会显示可复盘的作答、错因和下一步训练</text>
        </view>

        <view wx:else class="learning-brain-body">
          <view class="brain-column">
            <text class="brain-column-title">错因诊断</text>
            <block wx:if="{{learningDiagnosisCards.length}}">
              <view class="brain-diagnosis-row" wx:for="{{learningDiagnosisCards}}" wx:key="key">
                <view class="brain-level">
                  <text class="brain-level-text">{{item.levelLabel}}</text>
                </view>
                <view class="brain-row-main">
                  <text class="brain-row-title">{{item.title}}</text>
                  <text class="brain-row-meta">{{item.meta}}</text>
                  <text class="brain-diagnosis-detail" wx:if="{{item.detail}}">{{item.detail}}</text>
                  <text class="brain-action-line">{{item.action}}</text>
                </view>
              </view>
            </block>
            <block wx:else>
              <view class="brain-truth-row" wx:for="{{learningBrainTruths}}" wx:key="key">
                <view class="brain-level level-{{item.level}}">
                  <text class="brain-level-text">{{item.levelLabel || item.level}}</text>
                </view>
                <view class="brain-row-main">
                  <text class="brain-row-title">{{item.title}}</text>
                  <text class="brain-row-meta">{{item.meta}}</text>
                  <view class="brain-event-list" wx:if="{{item.evidenceLabels.length}}">
                    <text class="brain-event" wx:for="{{item.evidenceLabels}}" wx:for-item="evidenceLabel" wx:key="*this">{{evidenceLabel}}</text>
                  </view>
                </view>
              </view>
            </block>
          </view>

          <view class="brain-column">
            <text class="brain-column-title">最近做题复盘</text>
            <text class="brain-column-sub">真实作答证据</text>
            <view
              class="attempt-card attempt-{{item.tone}}"
              wx:for="{{learningAttemptCards}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="openAttemptDetail"
            >
              <view class="attempt-head">
                <view>
                  <text class="attempt-time">{{item.timeLabel}}</text>
                  <text class="attempt-title">{{item.title}}</text>
                </view>
                <text class="attempt-result result-{{item.tone}}">{{item.resultLabel}}</text>
              </view>
              <text class="attempt-answer">{{item.answerLine}}</text>
              <text class="attempt-diagnosis">{{item.diagnosisDetail || item.diagnosis}}</text>
              <view class="attempt-actions">
                <text class="attempt-action">查看解析</text>
                <text
                  wx:if="{{item.isBookmarked}}"
                  class="attempt-action bookmark-action cloud saved"
                >{{item.bookmarkLabel || '已加入错题'}}</text>
                <text
                  wx:elif="{{item.collectable}}"
                  class="attempt-action bookmark-action cloud"
                  data-key="{{item.key}}"
                  catchtap="toggleMistakeBookmark"
                >收藏错题</text>
              </view>
            </view>
            <block wx:if="{{!learningAttemptCards.length}}">
              <view class="brain-edge-row" wx:for="{{learningBrainEvidence}}" wx:key="key">
                <text class="brain-edge-type">{{item.type}}</text>
                <text class="brain-edge-path">{{item.path}}</text>
                <text class="brain-edge-event" wx:if="{{item.eventLabel}}">{{item.eventLabel}}</text>
              </view>
            </block>
          </view>

          <view class="brain-column" wx:if="{{learningTrainingLoops.length || learningBrainChains.length}}">
            <text class="brain-column-title">训练闭环</text>
            <view class="brain-chain-row chain-{{item.tone}}" wx:for="{{learningTrainingLoops}}" wx:key="key">
              <text class="brain-chain-title">{{item.title}}</text>
              <text class="brain-chain-step">{{item.from}}</text>
              <text class="brain-chain-step">{{item.training}}</text>
              <text class="brain-chain-outcome">{{item.outcome}}</text>
            </view>
            <block wx:if="{{!learningTrainingLoops.length}}">
              <view class="brain-chain-row chain-{{item.tone}}" wx:for="{{learningBrainChains}}" wx:key="key">
                <text class="brain-chain-title">{{item.title}}</text>
                <text class="brain-chain-step">{{item.training}}</text>
                <text class="brain-chain-step" wx:if="{{item.question}}">{{item.question}}</text>
                <text class="brain-chain-outcome">{{item.outcome}}</text>
                <text class="brain-edge-event" wx:if="{{item.eventLabel}}">{{item.eventLabel}}</text>
              </view>
            </block>
          </view>

          <view class="brain-column">
            <text class="brain-column-title">下一步训练</text>
            <view class="brain-next-action" wx:if="{{learningNextAction.title}}" bindtap="goPractice">
              <view>
                <text class="brain-training-title">{{learningNextAction.title}}</text>
                <text class="brain-training-meta">{{learningNextAction.subtitle}}</text>
              </view>
              <text class="brain-next-cta">{{learningNextAction.cta}}</text>
            </view>
            <block wx:else>
              <view class="brain-training-row" wx:for="{{learningBrainTraining}}" wx:key="key">
                <text class="brain-training-title">{{item.title}}</text>
                <text class="brain-training-meta">{{item.meta}}</text>
              </view>
            </block>
          </view>

          <view class="brain-footer" wx:if="{{learningBrainGraphStats.projectionSubject}}">
            <text class="brain-footer-text">{{learningBrainGraphStats.projectionSubjectLabel || learningBrainGraphStats.projectionSubject}}</text>
            <text class="brain-footer-text">稳定结论 {{learningBrainGraphStats.createdClaimCount || 0}}</text>
          </view>
        </view>
      </view>
      </block>

      <!-- 加载中 -->
      <block wx:if="{{reportDetailView == 'map'}}">
      <view class="report-detail-hero detail-map glass-card">
        <text class="detail-hero-kicker">掌握地图</text>
        <text class="detail-hero-title">把掌握度拆成可行动的结构</text>
        <text class="detail-hero-sub">雷达图看能力结构，掌握分布看章节和复习压力，避免只盯一个总分。</text>
        <view class="report-map-summary">
          <view>
            <text class="map-summary-label">总体掌握</text>
            <text class="map-summary-num">{{overallMastery}}%</text>
          </view>
          <view class="map-summary-bars">
            <view class="map-summary-bar strong"></view>
            <view class="map-summary-bar normal"></view>
            <view class="map-summary-bar weak"></view>
          </view>
          <view class="module-mini-stats">
            <text>强项 {{strongCount}}</text>
            <text>一般 {{normalCount}}</text>
            <text>薄弱 {{weakCount}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{radarLoading}}" class="glass-card loading-card">
        <view class="skel-block" style="width: 280rpx; height: 280rpx; border-radius: 50%; margin: 0 auto"></view>
        <view class="skel-block" style="width: 60%; height: 32rpx; margin: 24rpx auto 0"></view>
      </view>

      <!-- 错误 -->
      <view wx:elif="{{radarError}}" class="glass-card empty-card">
        <text class="empty-icon">{{warnIcon}}</text>
        <text class="empty-title">加载失败</text>
        <text class="empty-desc">无法获取能力数据，请检查网络后重试</text>
        <view class="empty-btn" bindtap="retryRadar">
          <text class="empty-btn-txt">重试</text>
        </view>
      </view>

      <!-- 空数据 -->
      <view wx:elif="{{radarDimensions.length === 0 && !radarLoading}}" class="glass-card empty-card">
        <text class="empty-icon">{{radarIcon}}</text>
        <text class="empty-title">能力数据生成中</text>
        <text class="empty-desc">完成一定量的练习后，系统会自动分析你的各维度能力</text>
        <view class="empty-btn" bindtap="goPractice">
          <text class="empty-btn-txt">去练习</text>
        </view>
      </view>

      <!-- 雷达图 + 统计 -->
      <view wx:else>
        <view class="section-header sub-header">
          <text class="section-title-sm">诊断维度</text>
          <text class="section-subtitle-sm">这里看整体能力结构，具体章节放到下面的掌握分布里展开</text>
        </view>

        <!-- Canvas 雷达图（绘制后转为图片跟随滚动） -->
        <view class="radar-canvas-wrap">
          <canvas type="2d" id="radarCanvas" class="radar-canvas"
            style="{{radarImage ? 'position:fixed;left:-9999px;top:-9999px' : ''}}"></canvas>
          <image wx:if="{{radarImage}}" class="radar-image" src="{{radarImage}}" mode="aspectFit"></image>
        </view>

        <!-- 强项/一般/薄弱 统计 -->
        <view class="radar-summary">
          <view class="radar-stat">
            <view class="stat-dot dot-strong"></view>
            <text class="stat-num">{{strongCount}}</text>
            <text class="stat-label">强项</text>
          </view>
          <view class="radar-stat">
            <view class="stat-dot dot-normal"></view>
            <text class="stat-num">{{normalCount}}</text>
            <text class="stat-label">一般</text>
          </view>
          <view class="radar-stat">
            <view class="stat-dot dot-weak"></view>
            <text class="stat-num">{{weakCount}}</text>
            <text class="stat-label">薄弱</text>
          </view>
        </view>

        <view class="section-header sub-header">
          <text class="section-title-sm">各维度详情</text>
        </view>

        <view class="dim-list">
          <view
            class="dim-item glass-card"
            wx:for="{{dimList}}"
            wx:key="rank"
          >
            <view class="dim-rank rank-{{item.cls}}">
              <text class="dim-rank-txt">{{item.rank}}</text>
            </view>
            <text class="dim-name">{{item.name}}</text>
            <view class="dim-bar">
              <view
                class="dim-bar-fill"
                style="width: {{item.pct}}%; background: {{item.color}}"
              ></view>
            </view>
            <text class="dim-pct" style="color: {{item.color}}">{{item.pct}}%</text>
          </view>
        </view>
      </view>

      <view class="section-header">
        <text class="section-title">掌握分布</text>
        <text class="section-subtitle">按章节展开看掌握情况</text>
      </view>

      <!-- 加载中 -->
      <view wx:if="{{masteryLoading}}" class="glass-card loading-card">
        <view class="skel-block" style="width: 50%; height: 64rpx; margin: 0 auto"></view>
        <view class="skel-block" style="width: 80%; height: 24rpx; margin: 16rpx auto 0"></view>
      </view>

      <!-- 错误 -->
      <view wx:elif="{{masteryError}}" class="glass-card empty-card">
        <text class="empty-title">加载失败</text>
        <view class="empty-btn" bindtap="retryMastery">
          <text class="empty-btn-txt">重试</text>
        </view>
      </view>

      <!-- 掌握度数据 -->
      <view wx:else>
        <view class="mastery-hero glass-card">
          <view class="mastery-score-wrap">
            <text class="mastery-score {{masteryScoreClass}}">
              {{overallMastery}}
            </text>
            <text class="mastery-unit">%</text>
          </view>
          <text class="mastery-label">总体掌握度</text>
          <view class="mastery-sub-row">
            <view class="mastery-sub-item">
              <text class="mastery-sub-num">{{reviewSummary.total_due || 0}}</text>
              <text class="mastery-sub-label">待复习</text>
            </view>
            <view class="mastery-sub-divider"></view>
            <view class="mastery-sub-item">
              <text class="mastery-sub-num mastery-sub-warn">{{reviewSummary.overdue_count || 0}}</text>
              <text class="mastery-sub-label">已逾期</text>
            </view>
            <view class="mastery-sub-divider"></view>
            <view class="mastery-sub-item">
              <text class="mastery-sub-num">{{hotspots.length}}</text>
              <text class="mastery-sub-label">热点</text>
            </view>
          </view>
        </view>

        <view
          class="mastery-group glass-card"
          wx:for="{{masteryGroups}}"
          wx:key="name"
        >
          <view class="group-header">
            <text class="group-name">{{item.name}}</text>
            <text class="group-avg {{item.avgClass}}">
              {{item.avgMastery}}%
            </text>
          </view>
          <view class="group-chapters">
            <view
              class="chapter-row"
              wx:for="{{item.chapters}}"
              wx:for-item="ch"
              wx:key="name"
            >
              <text class="ch-name">{{ch.name}}</text>
              <view class="ch-bar">
                <view
                  class="ch-bar-fill"
                  style="width: {{ch.mastery}}%; background: {{ch.color}}"
                ></view>
              </view>
              <text class="ch-pct" style="color: {{ch.color}}">{{ch.mastery}}%</text>
            </view>
          </view>
        </view>
      </view>
      </block>

      <block wx:if="{{reportDetailView == 'training'}}">
      <view class="report-detail-hero detail-training glass-card">
        <text class="detail-hero-kicker">训练安排</text>
        <text class="detail-hero-title">{{battlePlan.focusTopic}}</text>
        <text class="detail-hero-sub">{{battlePlan.coachNote}}</text>
        <view class="training-route">
          <view class="training-route-step active"><text>诊断</text></view>
          <view class="training-route-line"></view>
          <view class="training-route-step"><text>专项题</text></view>
          <view class="training-route-line"></view>
          <view class="training-route-step"><text>复盘</text></view>
        </view>
      </view>

      <view class="section-header">
        <text class="section-title">AI作战方案</text>
        <text class="section-subtitle">下一步学什么、先做什么、今天怎么学</text>
      </view>

      <view class="battle-plan glass-card">
        <view class="battle-plan-head">
          <view>
            <text class="battle-plan-kicker">今日主攻</text>
            <text class="battle-plan-topic">{{battlePlan.focusTopic}}</text>
          </view>
          <view class="battle-plan-badge">
            <text class="battle-plan-badge-text">AI建议</text>
          </view>
        </view>
        <text class="battle-plan-note">{{battlePlan.coachNote}}</text>
        <view class="battle-plan-list">
          <view class="battle-plan-row battle-plan-row-first">
            <text class="battle-plan-label">优先任务</text>
            <text class="battle-plan-value">{{battlePlan.priorityTask}}</text>
          </view>
          <view class="battle-plan-row">
            <text class="battle-plan-label">学习顺序</text>
            <text class="battle-plan-value">{{battlePlan.studyMethod}}</text>
          </view>
          <view class="battle-plan-row">
            <text class="battle-plan-label">建议投入</text>
            <text class="battle-plan-value">{{battlePlan.timeBudget}}</text>
          </view>
        </view>
      </view>
      </block>

      <block wx:if="{{reportDetailView == 'progress'}}">
      <view class="report-detail-hero detail-progress glass-card">
        <text class="detail-hero-kicker">进步反馈</text>
        <text class="detail-hero-title">不只看完成量，也看趋势和稳定性</text>
        <text class="detail-hero-sub">{{progressInsight || progressSummary}}</text>
        <view class="progress-chart-card">
          <view class="progress-chart-bars">
            <view class="progress-chart-bar today"><text>今日</text></view>
            <view class="progress-chart-bar recent"><text>近3天</text></view>
            <view class="progress-chart-bar streak"><text>连续</text></view>
          </view>
        </view>
      </view>

      <view class="section-header">
        <text class="section-title">进步反馈</text>
        <text class="section-subtitle">把正在发生的变化明确展示出来</text>
      </view>

      <view class="progress-panel glass-card">
        <text class="progress-summary">{{progressSummary}}</text>
        <text class="progress-insight" wx:if="{{progressInsight}}">{{progressInsight}}</text>
        <view class="progress-grid">
          <view
            class="progress-item"
            wx:for="{{progressCards}}"
            wx:key="label"
          >
            <text class="progress-item-label">{{item.label}}</text>
            <text class="progress-item-value {{item.toneClass}}">{{item.value}}</text>
            <text class="progress-item-detail">{{item.detail}}</text>
          </view>
        </view>
        <view class="progress-milestones" wx:if="{{progressMilestones.length}}">
          <view
            class="progress-milestone"
            wx:for="{{progressMilestones}}"
            wx:key="title"
          >
            <view class="progress-milestone-dot {{item.toneClass}}"></view>
            <view class="progress-milestone-copy">
              <text class="progress-milestone-title">{{item.title}}</text>
              <text class="progress-milestone-detail">{{item.detail}}</text>
            </view>
          </view>
        </view>
      </view>
      </block>

      <!-- 摸底测试入口 -->
      <view class="assess-entry glass-card" wx:if="{{reportDetailView == 'home' && assessmentEnabled}}" bindtap="goAssessment">
        <view class="assess-entry-left">
          <view class="assess-entry-icon">
            <text class="assess-entry-icon-txt">AI</text>
          </view>
          <view class="assess-entry-info">
            <text class="assess-entry-title">摸底测试</text>
            <text class="assess-entry-sub">重新评估知识掌握程度</text>
          </view>
        </view>
        <text class="assess-entry-arrow">›</text>
      </view>

      <!-- 底部安全距离 -->
      <view style="height: 240rpx"></view>
    </view>
  </scroll-view>

  <workspace-shell id="workspaceShell"></workspace-shell>

</view>
