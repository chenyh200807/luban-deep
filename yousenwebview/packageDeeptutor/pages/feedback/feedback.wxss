@import "/packageDeeptutor/styles/paper-ink.wxss";

/* pages/feedback/feedback.wxss — 结构化意见反馈（纸墨朱竹单层：
 * palette 全走 --pk-* token，亮/暗由 paper-ink 切换，不再自带第二套配色） */

.feedback-page {
  height: 100vh;
  color: var(--pk-t1);
  overflow: hidden;
  font-family: -apple-system, "PingFang SC", sans-serif;
}

/* ── 导航 ───────────────────────────────────────────────── */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--pk-paper);
  border-bottom: 1rpx solid var(--pk-bd);
}

.nav-content {
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 0;
  gap: 16rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: 20rpx;
  padding: 8rpx 12rpx 8rpx 4rpx;
  border-radius: 8rpx;
}

.nav-back:active {
  opacity: 0.72;
}

.nav-back-arrow {
  font-size: 40rpx;
  line-height: 1;
  margin-top: -4rpx;
  color: var(--pk-grn);
}

.nav-back-txt {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--pk-grn);
}

.nav-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.page-scroll {
  position: fixed;
  left: 0;
  right: 0;
  overflow-y: auto;
}

.page-inner {
  padding: 24rpx 24rpx 52rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

/* ── 卡片（沿用 legacy 类名，材质=pk-card） ─────────────── */
.glass-card {
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  border-radius: 28rpx;
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
}

.feedback-hero {
  padding: 32rpx;
}

.hero-kicker {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--pk-grn);
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
  color: var(--pk-t1);
}

.hero-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--pk-t2);
}

.hero-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.hero-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--pk-accent-border);
  background: var(--pk-accent-soft);
  font-size: 22rpx;
  font-weight: 700;
  color: var(--pk-grn);
}

.locate-strip {
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.locate-kicker {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--pk-t3);
}

.locate-title {
  display: block;
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.locate-count {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--pk-accent-border);
  background: var(--pk-accent-soft);
  font-size: 22rpx;
  font-weight: 800;
  color: var(--pk-grn);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.section-hint {
  font-size: 22rpx;
  color: var(--pk-t3);
}

/* ── 模块九宫格 ─────────────────────────────────────────── */
.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.type-card {
  min-height: 164rpx;
  padding: 22rpx;
  border: 1rpx solid var(--pk-bd);
  border-radius: 24rpx;
  background: var(--pk-card);
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
  transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
}

.type-card:active {
  transform: scale(0.98);
}

.type-card-active {
  border-color: var(--pk-grn);
  background: var(--pk-accent-soft);
}

.type-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 56rpx;
  height: 36rpx;
  padding: 0 10rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  background: var(--pk-accent-soft);
  font-size: 20rpx;
  font-weight: 800;
  color: var(--pk-grn);
}

.type-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.type-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--pk-t2);
}

/* ── 现象多选 chip ─────────────────────────────────────── */
.symptom-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.symptom-chip {
  min-height: 66rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--pk-bd);
  background: var(--pk-card);
  display: flex;
  align-items: center;
  gap: 10rpx;
  transition: transform 140ms ease, background 140ms ease, border-color 140ms ease;
}

.symptom-chip:active {
  transform: scale(0.96);
}

.symptom-chip-active {
  border-color: var(--pk-grn);
  background: var(--pk-accent-soft);
}

.symptom-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--pk-gauge);
}

.symptom-chip-active .symptom-dot {
  background: var(--pk-grn);
}

.symptom-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pk-t2);
}

.symptom-chip-active .symptom-text {
  color: var(--pk-grn);
}

/* ── 补充说明 ───────────────────────────────────────────── */
.feedback-input {
  width: 100%;
  min-height: 196rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--pk-t1);
}

.feedback-placeholder {
  color: var(--pk-t3);
}

/* ── 附件 ───────────────────────────────────────────────── */
.attachment-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.attachment-item {
  aspect-ratio: 1;
  border-radius: 22rpx;
  border: 1rpx dashed var(--pk-sand);
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.attachment-filled {
  border-style: solid;
  border-color: var(--pk-accent-border);
  background: var(--pk-accent-soft);
}

.attachment-plus {
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--pk-grn);
}

.attachment-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pk-t1);
}

.attachment-sub {
  font-size: 20rpx;
  color: var(--pk-t3);
}

/* ── 自动上下文说明 ─────────────────────────────────────── */
.context-box {
  padding: 22rpx;
  border-color: var(--pk-accent-border);
  background: var(--pk-accent-soft);
  box-shadow: none;
}

.context-title {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--pk-grn);
}

.context-text {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--pk-t2);
}

/* ── 提交（墨色主按钮，夜=纸色反转） ────────────────────── */
.submit-btn {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--pk-ink-btn);
  box-shadow: 0 8rpx 20rpx var(--pk-shadow);
}

.submit-btn:active {
  opacity: 0.82;
}

.submit-btn-disabled {
  opacity: 0.62;
}

.submit-btn-text {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--pk-ink-btn-t);
}
