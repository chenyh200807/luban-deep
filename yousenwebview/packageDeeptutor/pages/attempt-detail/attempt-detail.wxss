@import "/packageDeeptutor/styles/paper-ink.wxss";

/* pages/attempt-detail/attempt-detail.wxss — 学情证据链三级页（纸墨朱竹单层）
 * 字号阶梯统一：20(装饰) / 22(注) / 24(辅) / 26(正文) / 28(强调正文) / 32(节标) / 40(页题)
 * palette 全走 --pk-* token；亮/暗由 paper-ink 切换。 */

.attempt-detail-page {
  height: 100vh;
  overflow: hidden;
  color: var(--pk-t1);
  font-family: -apple-system, "PingFang SC", sans-serif;
}

/* ── 导航 ───────────────────────────────────────────────── */
.detail-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: var(--pk-paper);
  border-bottom: 1rpx solid var(--pk-bd);
}

.detail-nav-inner {
  height: 96rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 24rpx;
}

.detail-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-width: 128rpx;
  padding: 10rpx 10rpx 10rpx 0;
}

.detail-back:active {
  opacity: 0.72;
}

.detail-back-arrow {
  font-size: 44rpx;
  line-height: 1;
  color: var(--pk-grn);
}

.detail-back-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--pk-grn);
}

.detail-nav-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.detail-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
}

.detail-inner {
  padding: 24rpx 26rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

/* ── 头卡：结论 chip + 标题 ─────────────────────────────── */
.detail-hero {
  padding: 28rpx 28rpx 24rpx;
  border-radius: 30rpx;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
}

.detail-result {
  display: inline-flex;
  margin-bottom: 14rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.result-good {
  color: var(--pk-grn);
  background: var(--pk-accent-soft);
}

.result-bad,
.result-danger {
  color: var(--pk-warn);
  background: rgba(194, 101, 85, 0.12);
}

.detail-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 800;
  color: var(--pk-t1);
}

.detail-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--pk-t3);
}

/* ── 摘要卡：知识点 / 作答 / 错因 ───────────────────────── */
.detail-summary {
  padding: 6rpx 28rpx;
  border-radius: 30rpx;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
}

.summary-row {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--pk-bd);
}

.summary-row:last-child {
  border-bottom: 0;
}

.summary-label {
  width: 96rpx;
  flex: none;
  padding-top: 2rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--pk-t3);
}

.summary-value {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--pk-t1);
}

.detail-error {
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(194, 101, 85, 0.32);
  background: rgba(194, 101, 85, 0.1);
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--pk-warn);
}

/* ── 加载骨架 ───────────────────────────────────────────── */
.detail-skel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.skel-card {
  padding: 26rpx 28rpx;
  border-radius: 30rpx;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skel-line {
  height: 26rpx;
  border-radius: 13rpx;
  background: var(--pk-gauge);
  animation: pkSkelPulse 1.4s ease-in-out infinite;
}

.skel-kicker {
  width: 32%;
  height: 20rpx;
}

.skel-short {
  width: 58%;
}

@keyframes pkSkelPulse {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}

.detail-loading-note {
  padding: 4rpx 8rpx 0;
  font-size: 22rpx;
  color: var(--pk-t3);
  text-align: center;
}

/* ── 空态 ───────────────────────────────────────────────── */
.detail-empty {
  margin-top: 24rpx;
  padding: 56rpx 40rpx 48rpx;
  border-radius: 30rpx;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.empty-seal {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid var(--pk-accent-border);
  background: var(--pk-accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
}

.empty-seal-txt {
  font-family: "Long Cang", "Kaiti SC", "STKaiti", "KaiTi", "楷体", cursive;
  font-size: 44rpx;
  color: var(--pk-grn);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--pk-t1);
  text-align: center;
}

.empty-desc {
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--pk-t2);
  text-align: center;
}

.empty-cta {
  margin-top: 14rpx;
  min-height: 76rpx;
  padding: 0 44rpx;
  border-radius: 20rpx;
  background: var(--pk-ink-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx var(--pk-shadow);
}

.empty-cta-pressed {
  opacity: 0.82;
}

.empty-cta-txt {
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--pk-ink-btn-t);
}

/* ── 讲解区 ─────────────────────────────────────────────── */
.section-kicker {
  display: block;
  margin: 8rpx 4rpx 0;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: var(--pk-t3);
}

.explanation-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.explanation-card {
  margin-top: 16rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid var(--pk-bd);
  border-radius: 26rpx;
  background: var(--pk-card);
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
}

.explanation-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--pk-grn);
}

.explanation-content {
  display: block;
  white-space: pre-wrap;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--pk-t1);
}

.explanation-blocks {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.explanation-rich-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--pk-t1);
}

.explanation-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.explanation-list-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.explanation-list-bullet {
  flex: none;
  width: 34rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--pk-grn);
}

.explanation-list-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--pk-t1);
}

/* ── 表格 ───────────────────────────────────────────────── */
.explanation-table-wrap {
  margin: 4rpx 0 2rpx;
}

.md-table-scroll {
  width: 100%;
  margin: 12rpx 0;
  white-space: nowrap;
}

.md-table {
  display: table;
  width: 100%;
  min-width: 100%;
  border: 1rpx solid var(--pk-bd);
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--pk-card);
}

.md-thead {
  display: table-row;
  background: var(--pk-gauge);
}

.md-th,
.md-td {
  display: table-cell;
  padding: 14rpx 16rpx;
  white-space: normal;
  word-break: break-word;
  border-right: 1rpx solid var(--pk-bd);
  border-bottom: 1rpx solid var(--pk-bd);
}

.md-th {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--pk-t1);
}

.md-tr {
  display: table-row;
}

.md-td {
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--pk-t2);
}

.md-table-card {
  margin-top: 12rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--pk-bd);
  background: var(--pk-card);
}

.md-table-card-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: var(--pk-grn);
}

.md-table-card-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 10rpx 0;
  border-top: 1rpx solid var(--pk-bd);
}

.md-table-card-key {
  flex: 0 0 160rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--pk-t3);
}

.md-table-card-val {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--pk-t1);
}

/* ── 下一步训练 ─────────────────────────────────────────── */
.detail-next {
  margin-top: 12rpx;
  padding: 24rpx 28rpx;
  border-radius: 26rpx;
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
}

.detail-next .section-kicker {
  margin: 0 0 10rpx;
}

.next-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--pk-t1);
}
