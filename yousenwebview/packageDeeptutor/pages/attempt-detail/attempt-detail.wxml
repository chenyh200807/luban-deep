<view class="attempt-detail-page paper {{isDark?'':'light'}} pk-paper-bg">
  <view class="detail-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="detail-nav-inner">
      <view class="detail-back" bindtap="goBack">
        <text class="detail-back-arrow">‹</text>
        <text class="detail-back-text">学情</text>
      </view>
      <text class="detail-nav-title">作答复盘</text>
    </view>
  </view>

  <scroll-view class="detail-scroll" scroll-y enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}" style="top: {{navHeight}}px">
    <view class="detail-inner">
      <view class="detail-hero">
        <view class="detail-result result-{{detail.tone}}" wx:if="{{detail.resultLabel}}">{{detail.resultLabel}}</view>
        <text class="detail-title">{{detail.title}}</text>
        <text class="detail-subtitle">{{detail.subtitle}}</text>
      </view>

      <view class="detail-summary" wx:if="{{detail.concept || detail.answerLine || detail.error}}">
        <view class="summary-row" wx:if="{{detail.concept}}">
          <text class="summary-label">知识点</text>
          <text class="summary-value">{{detail.concept}}</text>
        </view>
        <view class="summary-row" wx:if="{{detail.answerLine}}">
          <text class="summary-label">作答</text>
          <text class="summary-value">{{detail.answerLine}}</text>
        </view>
        <view class="summary-row" wx:if="{{detail.error}}">
          <text class="summary-label">错因</text>
          <text class="summary-value">{{detail.error}}</text>
        </view>
      </view>

      <view class="detail-error" wx:if="{{errorText}}">{{errorText}}</view>

      <!-- 加载骨架：卡片轮廓与正文行 -->
      <view class="detail-skel" wx:if="{{loading}}">
        <view class="skel-card">
          <view class="skel-line skel-kicker"></view>
          <view class="skel-line"></view>
          <view class="skel-line skel-short"></view>
        </view>
        <view class="skel-card">
          <view class="skel-line skel-kicker"></view>
          <view class="skel-line"></view>
          <view class="skel-line"></view>
          <view class="skel-line skel-short"></view>
        </view>
        <text class="detail-loading-note">正在读取当时的作答与解析…</text>
      </view>

      <!-- 空态：没有任何可复盘证据时不再留白 -->
      <view class="detail-empty" wx:if="{{!loading && isEmpty}}">
        <view class="empty-seal">
          <text class="empty-seal-txt">复</text>
        </view>
        <text class="empty-title">这条作答还没有可复盘的细节</text>
        <text class="empty-desc">完成一次可批改的练习后，当时的作答、错因和系统讲解会沉淀到这里。</text>
        <view class="empty-cta" bindtap="goBack" hover-class="empty-cta-pressed" aria-role="button" aria-label="返回学情">
          <text class="empty-cta-txt">返回学情</text>
        </view>
      </view>

      <view class="explanation-section" wx:if="{{detail.explanationSections && detail.explanationSections.length}}">
        <text class="section-kicker">系统当时怎么讲清楚的</text>
        <view class="explanation-card" wx:for="{{detail.explanationSections}}" wx:key="key">
          <text class="explanation-label">{{item.label}}</text>
          <view class="explanation-blocks" wx:if="{{item.blocks && item.blocks.length}}">
            <block wx:for="{{item.blocks}}" wx:key="id" wx:for-item="b">
              <rich-text wx:if="{{b.type==='paragraph' || b.type==='callout' || b.type==='heading'}}" class="explanation-rich-text" nodes="{{b.nodes}}"></rich-text>
              <view wx:elif="{{b.type==='ul' || b.type==='ol'}}" class="explanation-list">
                <view class="explanation-list-item" wx:for="{{b.items}}" wx:key="index" wx:for-item="li">
                  <text class="explanation-list-bullet">{{b.type==='ol' ? (index + 1) + '.' : '•'}}</text>
                  <rich-text class="explanation-list-text" nodes="{{li.nodes}}"></rich-text>
                </view>
              </view>
              <view wx:elif="{{b.type==='table'}}" class="explanation-table-wrap">
                <view wx:if="{{b.mobileStrategy==='compact_cards'}}">
                  <view class="md-table-card" wx:for="{{b.rows}}" wx:key="index" wx:for-item="row" wx:for-index="rowIndex">
                    <text class="md-table-card-title">第{{rowIndex + 1}}条</text>
                    <view class="md-table-card-row" wx:for="{{b.headers}}" wx:key="index" wx:for-item="h" wx:for-index="colIndex">
                      <rich-text class="md-table-card-key" nodes="{{h.nodes}}"></rich-text>
                      <rich-text class="md-table-card-val" nodes="{{row[colIndex] ? row[colIndex].nodes : []}}"></rich-text>
                    </view>
                  </view>
                </view>
                <scroll-view wx:else scroll-x class="md-table-scroll">
                  <view class="md-table">
                    <view class="md-thead">
                      <rich-text class="md-th" wx:for="{{b.headers}}" wx:key="index" nodes="{{item.nodes}}"></rich-text>
                    </view>
                    <view class="md-tr" wx:for="{{b.rows}}" wx:key="index" wx:for-item="row">
                      <rich-text class="md-td" wx:for="{{row}}" wx:key="index" nodes="{{item.nodes}}"></rich-text>
                    </view>
                  </view>
                </scroll-view>
              </view>
              <text wx:else class="explanation-content">{{b.raw || b.text || ''}}</text>
            </block>
          </view>
          <text wx:else class="explanation-content">{{item.content}}</text>
        </view>
      </view>

      <view class="detail-next" wx:if="{{detail.nextTraining}}">
        <text class="section-kicker">下一步训练</text>
        <text class="next-text">{{detail.nextTraining}}</text>
      </view>
    </view>
  </scroll-view>
</view>
