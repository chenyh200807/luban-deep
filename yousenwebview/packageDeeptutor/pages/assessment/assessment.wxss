@import "/packageDeeptutor/styles/paper-ink.wxss";

/* pages/assessment/assessment.wxss — 摸底测试 */

.assess-page { height: 100vh; background: #080c18; overflow: hidden; position: relative; }

/* ── 极光背景（复用主页风格）────────────── */
.aurora-layer { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 0; pointer-events: none; overflow: hidden; }
.orb { position: absolute; border-radius: 50%; will-change: transform, opacity; }
.orb1 {
  width: 500rpx; height: 500rpx; top: -8%; right: -15%;
  background: radial-gradient(circle, rgba(99,102,241,0.3) 0%, transparent 70%);
  animation: ab1 8s ease-in-out infinite;
}
.orb2 {
  width: 400rpx; height: 400rpx; top: 35%; left: -15%;
  background: radial-gradient(circle, rgba(59,130,246,0.22) 0%, transparent 70%);
  animation: ab2 10s ease-in-out infinite;
}
.orb3 {
  width: 360rpx; height: 360rpx; bottom: 10%; right: -10%;
  background: radial-gradient(circle, rgba(139,92,246,0.2) 0%, transparent 70%);
  animation: ab3 12s ease-in-out infinite;
}
@keyframes ab1 { 0%,100%{transform:translate(0,0) scale(1);opacity:.6} 50%{transform:translate(-30rpx,40rpx) scale(1.15);opacity:1} }
@keyframes ab2 { 0%,100%{transform:translate(0,0) scale(1);opacity:.5} 50%{transform:translate(50rpx,-30rpx) scale(1.2);opacity:.9} }
@keyframes ab3 { 0%,100%{transform:translate(0,0) scale(1);opacity:.5} 50%{transform:translate(-40rpx,-50rpx) scale(1.25);opacity:.85} }
.bg-horizon {
  position: fixed; left: 0; right: 0; bottom: 0;
  width: 100%; height: 100vh; z-index: 0; pointer-events: none; opacity: 0.5;
}

/* ── 导航栏 ────────────────────────────── */
.nav-bar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 50;
  background: transparent;
}
.nav-content {
  height: 88rpx; display: flex; align-items: center; padding: 0 24rpx; gap: 12rpx;
}
.nav-back {
  width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: rgba(255,255,255,0.06);
}
.nav-back-arrow { font-size: 42rpx; color: #fff; font-weight: 300; }
.nav-back:active { background: rgba(255,255,255,0.12); }
.nav-title { font-size: 34rpx; font-weight: 700; color: #fff; }
.nav-progress { font-size: 26rpx; color: rgba(255,255,255,0.5); font-variant-numeric: tabular-nums; }

.page-body { position: fixed; left: 0; right: 0; bottom: 0; overflow-y: auto; z-index: 1; }

/* ═══════════════════════════════════════
   ★ 欢迎页
   ═══════════════════════════════════════ */
.welcome { padding: 0 32rpx; }

.welcome-hero {
  display: flex; flex-direction: column; align-items: center; gap: 16rpx;
  padding-bottom: 48rpx;
}

/* AI 图标环 — 替代 emoji */
.hero-icon-ring {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(139,92,246,0.2));
  border: 2rpx solid rgba(99,102,241,0.3);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 8rpx;
  animation: iconPulse 3s ease-in-out infinite;
}
.hero-icon-txt { font-size: 40rpx; font-weight: 800; color: var(--pk-grn); }
@keyframes iconPulse {
  0%,100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(99,102,241,0.2); }
  50% { transform: scale(1.05); box-shadow: 0 0 40rpx 10rpx rgba(99,102,241,0.15); }
}

.welcome-title { font-size: 44rpx; font-weight: 800; color: #fff; }
.welcome-sub { font-size: 26rpx; color: rgba(255,255,255,0.45); text-align: center; line-height: 1.6; }

/* 数据卡片 */
.stats-row { display: flex; gap: 16rpx; margin-bottom: 40rpx; }
.stat-card {
  flex: 1; padding: 28rpx 16rpx; border-radius: 16rpx;
  background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.08);
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
}
.stat-num { font-size: 44rpx; font-weight: 800; color: var(--pk-grn); }
.stat-label { font-size: 22rpx; color: rgba(255,255,255,0.4); }

.mode-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.mode-card {
  min-height: 112rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.04);
  border: 2rpx solid rgba(255,255,255,0.08);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}
.mode-card.selected {
  border-color: rgba(96,165,250,0.86);
  background: rgba(37,99,235,0.18);
}
.mode-title-row { display: flex; align-items: center; gap: 10rpx; }
.mode-title { font-size: 28rpx; font-weight: 800; color: #fff; }
.mode-desc { font-size: 21rpx; color: rgba(255,255,255,0.5); }
.recommend-badge {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: var(--pk-accent-soft);
  color: var(--pk-grn);
  font-size: 19rpx;
  font-weight: 700;
}
.recommend-badge.small { font-size: 18rpx; padding: 3rpx 8rpx; }
.recommend-reason {
  display: block;
  margin: -8rpx 0 24rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--pk-t2);
}

.topic-catalog {
  margin-bottom: 36rpx;
}
.topic-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  margin-bottom: 16rpx;
}
.topic-head-title { font-size: 28rpx; font-weight: 700; color: rgba(255,255,255,0.9); }
.topic-head-sub { font-size: 20rpx; color: rgba(191,219,254,0.58); }
.topic-catalog-error { display: block; margin-bottom: 12rpx; font-size: 22rpx; color: #fbbf24; }
.topic-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.topic-card {
  min-height: 150rpx; padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.04);
  border: 2rpx solid rgba(255,255,255,0.08);
  display: flex; flex-direction: column; gap: 8rpx;
}
.topic-card.selected { border-color: rgba(96,165,250,0.86); background: rgba(37,99,235,0.18); }
.topic-card.disabled { opacity: 0.48; }
.topic-name { font-size: 26rpx; font-weight: 700; color: #fff; }
.topic-desc { font-size: 21rpx; line-height: 1.35; color: rgba(255,255,255,0.52); }
.topic-status-row { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.topic-status { font-size: 21rpx; color: rgba(191,219,254,0.82); }

/* 特性列表 */
.welcome-features { margin-bottom: 48rpx; padding: 0 8rpx; }
.feature-item { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; }
.feature-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%; flex-shrink: 0;
  background: var(--pk-grn);
}
.feature-txt { font-size: 28rpx; color: rgba(255,255,255,0.65); }

/* 开始按钮 */
.start-btn {
  padding: 28rpx; border-radius: 16rpx;
  background: var(--pk-grn);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(37,99,235,0.3);
}
.start-btn:active { opacity: 0.85; transform: scale(0.98); }
.start-btn-txt { font-size: 32rpx; font-weight: 700; color: #fff; }

/* ═══════════════════════════════════════
   ★ 答题页
   ═══════════════════════════════════════ */
.quiz { padding: 16rpx 24rpx; }

.progress-bar {
  height: 6rpx; border-radius: 3rpx; background: rgba(255,255,255,0.08);
  margin-bottom: 28rpx; overflow: hidden;
}
.progress-fill {
  height: 100%; border-radius: 3rpx;
  background: var(--pk-grn);
  transition: width 0.3s ease;
}

.answer-card {
  margin-bottom: 22rpx; padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(18,24,42,0.68); border: 1rpx solid rgba(255,255,255,0.07);
}
.answer-card-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.answer-card-title { font-size: 26rpx; font-weight: 700; color: rgba(255,255,255,0.86); }
.answer-card-count { font-size: 24rpx; color: rgba(255,255,255,0.5); font-variant-numeric: tabular-nums; }
.answer-card-hint { display: block; margin: -6rpx 0 14rpx; font-size: 22rpx; line-height: 1.38; color: rgba(191,219,254,0.76); }
.answer-card-notice { display: block; margin: -4rpx 0 16rpx; font-size: 24rpx; line-height: 1.45; color: #fbbf24; }
.answer-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.answer-chip {
  width: 56rpx; height: 56rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.1);
}
.answer-chip.answered { background: rgba(34,197,94,0.18); border-color: rgba(34,197,94,0.38); }
.answer-chip.current { background: var(--pk-grn); border-color: var(--pk-grn); }
.answer-chip:active { opacity: 0.82; }
.answer-chip-txt { font-size: 24rpx; font-weight: 700; color: rgba(255,255,255,0.78); }
.answer-chip.current .answer-chip-txt { color: #fff; }

.question-card {
  padding: 28rpx; border-radius: 20rpx;
  background: rgba(18,24,42,0.8); border: 1rpx solid rgba(255,255,255,0.07);
}
.q-header { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.q-type {
  padding: 6rpx 18rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 600;
  background: var(--pk-accent-soft); color: var(--pk-grn);
}
.q-diff {
  padding: 6rpx 18rpx; border-radius: 999rpx; font-size: 22rpx;
  background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.45);
}
.q-stem { font-size: 30rpx; color: #fff; line-height: 1.7; font-weight: 500; display: block; }

.options { margin-top: 28rpx; display: flex; flex-direction: column; gap: 12rpx; }
.option {
  display: flex; align-items: center; gap: 16rpx;
  padding: 22rpx 20rpx; border-radius: 14rpx;
  background: rgba(255,255,255,0.03); border: 2rpx solid rgba(255,255,255,0.08);
  transition: border-color 0.15s, background 0.15s;
}
.option:active { border-color: rgba(59,130,246,0.4); }
.option.selected { border-color: var(--pk-grn); background: rgba(72, 128, 106, 0.1); }
.opt-key {
  width: 48rpx; height: 48rpx; border-radius: 12rpx; flex-shrink: 0;
  background: rgba(255,255,255,0.06);
  display: flex; align-items: center; justify-content: center;
}
.opt-key-txt { font-size: 26rpx; font-weight: 700; color: rgba(255,255,255,0.5); }
.option.selected .opt-key { background: var(--pk-grn); }
.option.selected .opt-key-txt { color: #fff; }
.opt-text { font-size: 28rpx; color: rgba(255,255,255,0.85); line-height: 1.5; }

.quiz-nav { display: flex; gap: 16rpx; margin-top: 32rpx; }
.quiz-nav-btn {
  flex: 1; padding: 22rpx; border-radius: 14rpx;
  background: rgba(255,255,255,0.06);
  display: flex; align-items: center; justify-content: center;
}
.quiz-nav-btn.disabled { opacity: 0.3; }
.quiz-nav-btn.primary { background: var(--pk-grn); }
.quiz-nav-btn.submit { background: #16a34a; }
.quiz-nav-btn:active { opacity: 0.85; }
.quiz-nav-txt { font-size: 28rpx; font-weight: 600; color: #fff; }

/* ═══════════════════════════════════════
   ★ 加载
   ═══════════════════════════════════════ */
.loading-view {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding-top: 30vh;
}
.loading-spinner {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.1);
  border-top-color: var(--pk-grn);
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-txt { margin-top: 32rpx; font-size: 28rpx; color: #fff; font-weight: 600; }
.loading-sub { margin-top: 8rpx; font-size: 24rpx; color: rgba(255,255,255,0.4); }

/* ═══════════════════════════════════════
   ★ 结果页
   ═══════════════════════════════════════ */
.result { padding: 32rpx; display: flex; flex-direction: column; align-items: center; }

.score-ring-wrap { margin: 24rpx 0; }
.score-ring {
  width: 240rpx; height: 240rpx; border-radius: 50%;
  background: rgba(18,24,42,0.8);
  border: 4rpx solid rgba(59,130,246,0.3);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-shadow: 0 0 60rpx rgba(59,130,246,0.15);
}
.score-num { font-size: 72rpx; font-weight: 800; color: #fff; }
.score-label { font-size: 22rpx; color: rgba(255,255,255,0.4); margin-top: -4rpx; }

.level-badge {
  padding: 8rpx 32rpx; border-radius: 999rpx; margin-bottom: 40rpx;
}
.level-beginner { background: rgba(239,68,68,0.15); border: 1rpx solid rgba(239,68,68,0.3); }
.level-intermediate { background: rgba(245,158,11,0.15); border: 1rpx solid rgba(245,158,11,0.3); }
.level-advanced { background: rgba(59,130,246,0.15); border: 1rpx solid rgba(59,130,246,0.3); }
.level-expert { background: rgba(16,185,129,0.15); border: 1rpx solid rgba(16,185,129,0.3); }
.level-txt { font-size: 26rpx; font-weight: 700; color: #fff; }

.section-title {
  align-self: flex-start; font-size: 28rpx; font-weight: 600;
  color: rgba(255,255,255,0.7); margin-bottom: 16rpx;
}

.chapter-grid { width: 100%; display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 32rpx; }
.chapter-item { display: flex; align-items: center; gap: 12rpx; }
.chapter-name { font-size: 24rpx; color: rgba(255,255,255,0.6); min-width: 140rpx; }
.chapter-bar-wrap {
  flex: 1; height: 16rpx; border-radius: 8rpx; background: rgba(255,255,255,0.06); overflow: hidden;
}
.chapter-bar { height: 100%; border-radius: 8rpx; transition: width 0.6s ease; min-width: 4rpx; }
.chapter-bar.green { background: linear-gradient(90deg, #22c55e, #16a34a); }
.chapter-bar.gold { background: linear-gradient(90deg, #f59e0b, #d97706); }
.chapter-bar.red { background: var(--pk-warn); }
.chapter-pct { font-size: 24rpx; color: rgba(255,255,255,0.5); min-width: 60rpx; text-align: right; font-variant-numeric: tabular-nums; }

/* ── 学员画像卡片（核心） ─────────────── */
.archetype-card {
  width: 100%; padding: 28rpx; border-radius: 20rpx; margin-bottom: 28rpx;
  background: rgba(18,24,42,0.85); border: 1rpx solid rgba(255,255,255,0.07);
  border-left: 6rpx solid var(--pk-grn);
  display: flex; flex-direction: column; gap: 16rpx;
}
.archetype-header { display: flex; align-items: center; gap: 16rpx; }
.archetype-icon {
  width: 64rpx; height: 64rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  background: var(--pk-gauge);
}
.archetype-icon-txt { font-size: 30rpx; font-weight: 800; color: var(--pk-grn); }
.archetype-title-col { display: flex; flex-direction: column; gap: 2rpx; }
.archetype-label { font-size: 22rpx; color: rgba(255,255,255,0.4); }
.archetype-name { font-size: 36rpx; font-weight: 800; color: #fff; }
.archetype-desc { font-size: 26rpx; color: rgba(255,255,255,0.65); line-height: 1.7; }
.archetype-traits { display: flex; flex-wrap: wrap; gap: 10rpx; }
.trait-tag {
  padding: 6rpx 18rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 600;
  color: var(--pk-t2); background: var(--pk-gauge); border: 1rpx solid var(--pk-bd);
}
.archetype-tip {
  padding: 16rpx 20rpx; border-radius: 12rpx;
  background: var(--pk-gauge);
  display: flex; flex-direction: column; gap: 6rpx;
}
.tip-label { font-size: 22rpx; font-weight: 700; color: rgba(255,255,255,0.5); }
.tip-text { font-size: 26rpx; color: rgba(255,255,255,0.75); line-height: 1.7; }

/* ── 认知风格行 ──────────────────────── */
.insight-row {
  width: 100%; display: flex; gap: 12rpx; margin-bottom: 28rpx; flex-wrap: wrap;
}
.insight-card {
  flex: 1; min-width: 180rpx; padding: 20rpx; border-radius: 14rpx;
  background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.07);
  display: flex; flex-direction: column; gap: 6rpx;
}
.insight-label { font-size: 20rpx; color: rgba(255,255,255,0.4); }
.insight-value { font-size: 28rpx; font-weight: 700; color: var(--pk-grn); }
.insight-desc { font-size: 22rpx; color: rgba(255,255,255,0.5); line-height: 1.5; }

/* ── 优先攻克 ────────────────────────── */
.priority-card { width: 100%; margin-bottom: 28rpx; }
.priority-list { display: flex; flex-direction: column; gap: 8rpx; }
.priority-item {
  display: flex; align-items: center; gap: 14rpx;
  padding: 16rpx 20rpx; border-radius: 12rpx;
  background: rgba(239,68,68,0.06); border: 1rpx solid rgba(239,68,68,0.12);
}
.priority-idx {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(239,68,68,0.15);
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; color: var(--pk-warn); flex-shrink: 0;
}
.priority-name { font-size: 26rpx; color: rgba(255,255,255,0.7); }

.result-actions { width: 100%; display: flex; flex-direction: column; gap: 12rpx; }
.result-btn {
  padding: 24rpx; border-radius: 14rpx; background: rgba(255,255,255,0.06);
  display: flex; align-items: center; justify-content: center;
}
.result-btn.primary {
  background: var(--pk-grn);
  box-shadow: 0 8rpx 32rpx rgba(37,99,235,0.25);
}
.result-btn:active { opacity: 0.85; }
.result-btn-txt { font-size: 30rpx; font-weight: 700; color: #fff; }
.secondary-txt { color: rgba(255,255,255,0.4); font-weight: 500; }

.dr-hero,
.dr-card,
.dr-wrong-card {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid var(--pk-bd);
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
}

.dr-hero {
  position: relative;
  overflow: hidden;
  padding: 32rpx;
  border-radius: 32rpx;
  background: var(--pk-card);
}

.dr-hero::before {
  content: "";
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 0;
  height: 5rpx;
  border-radius: 999rpx;
  background: var(--pk-grn);
}

.dr-hero::after {
  content: "";
  position: absolute;
  right: -78rpx;
  bottom: -92rpx;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  border: 1rpx solid var(--pk-bd);
  background: radial-gradient(circle, var(--pk-accent-soft), transparent 64%);
}

.dr-hero-top {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 170rpx;
  gap: 20rpx;
  align-items: start;
}

.dr-hero-copy { min-width: 0; }

.dr-kicker {
  display: block;
  color: var(--pk-grn);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.04em;
}

.dr-title {
  display: block;
  max-width: 390rpx;
  margin-top: 12rpx;
  color: #f8fbff;
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 950;
}

.dr-score-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 170rpx;
}

.dr-score-ring {
  position: relative;
  width: 158rpx;
  height: 158rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: conic-gradient(from 210deg, var(--pk-grn) 0deg 106deg, var(--pk-gauge) 106deg 360deg);
  box-shadow:
    0 0 0 1rpx var(--pk-bd),
    0 2rpx 12rpx var(--pk-shadow),
    inset 0 0 0 14rpx var(--pk-card);
}

.dr-score-ring::before {
  content: "";
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 14rpx;
  bottom: 14rpx;
  border-radius: 50%;
  border: 1rpx solid var(--pk-bd);
  background: var(--pk-accent-soft);
}

.dr-score-inner {
  position: relative;
  z-index: 1;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: var(--pk-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.dr-score-num {
  color: var(--pk-grn);
  font-size: 58rpx;
  line-height: 1;
  font-weight: 950;
}

.dr-score-label {
  margin-top: 4rpx;
  color: var(--pk-t3);
  font-size: 20rpx;
  font-weight: 850;
}

.dr-score-caption {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  margin-top: 12rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--pk-accent-border);
  border-radius: 999rpx;
  background: var(--pk-accent-soft);
  color: var(--pk-grn);
  font-size: 20rpx;
  font-weight: 950;
}

.dr-hero-desc {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 28rpx;
  color: var(--pk-t2);
  font-size: 26rpx;
  line-height: 1.65;
  font-weight: 700;
}

.dr-conclusion-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}

.dr-conclusion-cell {
  min-height: 116rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--pk-bd);
  background: var(--pk-card);
}

.dr-conclusion-cell:nth-child(1),
.dr-conclusion-cell:nth-child(2),
.dr-conclusion-cell:nth-child(3),
.dr-conclusion-cell:nth-child(4) { border-color: var(--pk-bd); background: var(--pk-card); }

.dr-cell-label {
  display: block;
  color: rgba(202, 215, 236, 0.58);
  font-size: 22rpx;
  font-weight: 850;
}

.dr-cell-value {
  display: block;
  margin-top: 10rpx;
  color: #f8fbff;
  font-size: 28rpx;
  line-height: 1.32;
  font-weight: 950;
}

.dr-hero-actions {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 176rpx;
  gap: 20rpx;
  margin-top: 30rpx;
}

.dr-primary-btn,
.dr-ghost-btn,
.dr-same-type-btn,
.dr-ai-btn,
.dr-filter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  border-radius: 22rpx;
}

.dr-primary-btn {
  background: var(--pk-ink-btn);
  box-shadow: 0 14rpx 34rpx rgba(47, 107, 255, 0.28);
}

.dr-primary-btn text,
.dr-ghost-btn text,
.dr-same-type-btn text,
.dr-ai-btn text,
.dr-filter-btn text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 950;
}

.dr-ghost-btn {
  border: 1rpx solid rgba(116, 178, 255, 0.24);
  background: rgba(116, 178, 255, 0.1);
}

.dr-ghost-btn text { color: #bfdbfe; }

.dr-metric-row {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.dr-metric {
  position: relative;
  overflow: hidden;
  min-height: 130rpx;
  padding: 22rpx;
  border: 1rpx solid var(--pk-bd);
  border-radius: 22rpx;
  background: var(--pk-card);
}

.dr-metric::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 5rpx;
  background: var(--pk-grn);
}

.dr-metric:nth-child(2)::before,
.dr-metric:nth-child(3)::before { background: var(--pk-grn); }

.dr-metric-value {
  display: block;
  color: var(--pk-grn);
  font-size: 38rpx;
  line-height: 1;
  font-weight: 950;
}

.dr-metric-label {
  display: block;
  margin-top: 16rpx;
  color: var(--pk-t2);
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 800;
}

.dr-section {
  width: 100%;
  margin-top: 28rpx;
  box-sizing: border-box;
}

.dr-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: rgba(18, 31, 52, 0.78);
}

.dr-section-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.dr-section-title {
  display: block;
  margin-top: 8rpx;
  color: #fff;
  font-size: 32rpx;
  line-height: 1.34;
  font-weight: 950;
}

.dr-section-note {
  display: block;
  margin-top: 12rpx;
  color: rgba(224, 234, 250, 0.8);
  font-size: 24rpx;
  line-height: 1.65;
}

.dr-filter-btn {
  min-height: 58rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(116, 178, 255, 0.34);
  border-radius: 999rpx;
  background: rgba(116, 178, 255, 0.1);
}

.dr-filter-btn text {
  color: var(--pk-t2);
  font-size: 23rpx;
}

.dr-wrong-list,
.dr-issue-list,
.dr-step-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.dr-wrong-card {
  overflow: hidden;
  padding: 28rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(251, 191, 36, 0.08), transparent 32%),
    linear-gradient(135deg, rgba(21, 43, 74, 0.9), rgba(29, 35, 68, 0.86));
}

.dr-wrong-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.dr-q-num,
.dr-status-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 950;
}

.dr-q-num {
  background: linear-gradient(135deg, rgba(52, 120, 246, 0.26), rgba(103, 232, 249, 0.13));
  color: var(--pk-t2);
}

.dr-status-badge {
  border: 1rpx solid rgba(251, 191, 36, 0.2);
  background: rgba(251, 191, 36, 0.11);
  color: #fde68a;
}

.dr-stem {
  display: block;
  margin-top: 24rpx;
  color: #f8fbff;
  font-size: 32rpx;
  line-height: 1.6;
  font-weight: 900;
}

.dr-choice-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 24rpx;
}

.dr-choice {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.045);
}

.dr-choice-key,
.dr-option-key {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.08);
  color: var(--pk-t2);
  font-size: 24rpx;
  font-weight: 950;
}

.dr-choice-text {
  flex: 1;
  min-width: 0;
  color: rgba(224, 234, 250, 0.82);
  font-size: 26rpx;
  line-height: 1.52;
  font-weight: 760;
}

.dr-answer-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
}

.dr-answer-box {
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.055);
}

.dr-answer-label {
  display: block;
  color: rgba(202, 215, 236, 0.58);
  font-size: 22rpx;
  font-weight: 850;
}

.dr-answer-value {
  display: block;
  margin-top: 10rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 950;
}

.dr-verdict {
  display: block;
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.24);
  border-radius: 20rpx;
  background: rgba(251, 191, 36, 0.08);
  color: #fde68a;
  font-size: 26rpx;
  line-height: 1.65;
  font-weight: 820;
}

.dr-simple-actions {
  display: grid;
  grid-template-columns: 1fr 200rpx;
  gap: 16rpx;
  margin-top: 22rpx;
}

.dr-same-type-btn {
  border: 1rpx solid rgba(251, 191, 36, 0.22);
  background: rgba(251, 191, 36, 0.08);
}

.dr-same-type-btn text { color: #fde68a; }

.dr-ai-btn {
  border: 1rpx solid rgba(103, 232, 249, 0.28);
  background: linear-gradient(135deg, rgba(52, 120, 246, 0.2), rgba(103, 232, 249, 0.12));
}

.dr-ai-btn text {
  color: #dff8ff;
  font-size: 24rpx;
}

.dr-detail {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.dr-detail-head,
.dr-review-section {
  padding: 22rpx;
  border: 1rpx solid rgba(157, 179, 216, 0.18);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.045);
}

.dr-generating {
  border-color: rgba(96, 165, 250, 0.28);
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.14), rgba(103, 232, 249, 0.08));
}

.dr-error {
  border-color: rgba(251, 113, 133, 0.3);
  background: rgba(251, 113, 133, 0.08);
}

.dr-detail-head {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  background: rgba(103, 232, 249, 0.065);
  border-color: rgba(103, 232, 249, 0.18);
}

.dr-detail-title,
.dr-review-title {
  display: block;
  color: #bfdbfe;
  font-size: 25rpx;
  font-weight: 950;
}

.dr-detail-sub,
.dr-detail-status {
  display: block;
  margin-top: 8rpx;
  color: rgba(202, 215, 236, 0.58);
  font-size: 20rpx;
  font-weight: 850;
}

.dr-review-text {
  display: block;
  margin-top: 12rpx;
  color: rgba(224, 234, 250, 0.8);
  font-size: 24rpx;
  line-height: 1.65;
}

.dr-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.dr-chip {
  display: inline-flex;
  align-items: center;
  min-height: 46rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(157, 179, 216, 0.18);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.055);
  color: rgba(224, 234, 250, 0.82);
  font-size: 22rpx;
  font-weight: 850;
}

.dr-chip.risk { border-color: rgba(251, 113, 133, 0.28); background: rgba(251, 113, 133, 0.1); color: #fecdd3; }
.dr-chip.gold { border-color: rgba(251, 191, 36, 0.28); background: rgba(251, 191, 36, 0.1); color: #fde68a; }
.dr-chip.good { border-color: rgba(52, 211, 153, 0.24); background: rgba(52, 211, 153, 0.1); color: #bbf7d0; }

.dr-option-review-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.dr-option-review {
  display: grid;
  grid-template-columns: 48rpx minmax(0, 1fr) 56rpx;
  gap: 14rpx;
  align-items: flex-start;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(8, 17, 31, 0.38);
}

.dr-option-review.correct { border-color: rgba(52, 211, 153, 0.22); background: rgba(52, 211, 153, 0.07); }
.dr-option-review.missed { border-color: rgba(251, 191, 36, 0.24); background: rgba(251, 191, 36, 0.07); }
.dr-option-review.extra { border-color: rgba(251, 113, 133, 0.24); background: rgba(251, 113, 133, 0.07); }

.dr-option-text {
  color: rgba(224, 234, 250, 0.8);
  font-size: 24rpx;
  line-height: 1.5;
}

.dr-option-tag {
  color: rgba(202, 215, 236, 0.58);
  font-size: 20rpx;
  font-weight: 900;
  text-align: right;
}

.dr-memory-section {
  border-color: rgba(167, 139, 250, 0.26);
  background: linear-gradient(135deg, rgba(88, 28, 135, 0.24), rgba(52, 211, 153, 0.06), rgba(255, 255, 255, 0.045));
}

.dr-source-section {
  border-color: rgba(103, 232, 249, 0.2);
}

.dr-issue-list {
  margin-top: 24rpx;
}

.dr-issue,
.dr-step {
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr) 66rpx;
  gap: 18rpx;
  align-items: center;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.045);
}

.dr-issue-rank,
.dr-step-num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: var(--pk-gauge);
  color: var(--pk-grn);
  font-size: 24rpx;
  font-weight: 950;
}

.dr-issue:nth-child(2) .dr-issue-rank { background: rgba(251, 191, 36, 0.16); color: #fde68a; }
.dr-issue:nth-child(3) .dr-issue-rank { background: var(--pk-accent-soft); color: var(--pk-grn); }
.dr-issue:nth-child(4) .dr-issue-rank { background: rgba(103, 232, 249, 0.14); color: #a5f3fc; }
.dr-issue:nth-child(5) .dr-issue-rank { background: rgba(251, 113, 133, 0.15); color: #fecdd3; }

.dr-issue-title,
.dr-step-title {
  display: block;
  color: #fff;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 950;
}

.dr-issue-desc,
.dr-step-desc {
  display: block;
  margin-top: 6rpx;
  color: rgba(202, 215, 236, 0.58);
  font-size: 22rpx;
  line-height: 1.4;
}

.dr-issue-count {
  color: #fecdd3;
  font-size: 24rpx;
  font-weight: 950;
  text-align: right;
}

.dr-map-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.dr-map-row {
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr) 86rpx;
  gap: 14rpx;
  align-items: center;
}

.dr-map-name {
  color: rgba(224, 234, 250, 0.8);
  font-size: 23rpx;
  font-weight: 850;
}

.dr-map-track {
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
}

.dr-map-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: inherit;
  background: linear-gradient(90deg, #fb7185, #fbbf24);
}

.dr-map-fill.gold { background: linear-gradient(90deg, #fb7185, #fbbf24); }
.dr-map-fill.good { background: linear-gradient(90deg, #34d399, #67e8f9); }

.dr-map-action {
  color: #fde68a;
  font-size: 20rpx;
  font-weight: 950;
  text-align: right;
}

.dr-step-list {
  margin-top: 24rpx;
}

.dr-step-time {
  color: var(--pk-grn);
  font-size: 22rpx;
  font-weight: 950;
  text-align: right;
}

/* ══ Light Mode ══════════════════════════════ */
.assess-page.light {
  background: var(--pk-paper);
}

/* ── 极光背景 ────────────────────────────── */
.assess-page.light .aurora-layer { opacity: 0.22; }
.assess-page.light .orb1 { background: radial-gradient(circle, rgba(110,142,255,0.16) 0%, transparent 72%); }
.assess-page.light .orb2 { background: radial-gradient(circle, rgba(88,166,255,0.12) 0%, transparent 72%); }
.assess-page.light .orb3 { background: radial-gradient(circle, rgba(139,92,246,0.10) 0%, transparent 72%); }
.assess-page.light .bg-horizon { opacity: 0.12; }

/* ── 导航栏 ──────────────────────────────── */
.assess-page.light .nav-back {
  background: rgba(255,255,255,0.88);
  border: 1rpx solid rgba(176,193,224,0.5);
}
.assess-page.light .nav-back-arrow { color: #333; }
.assess-page.light .nav-title { color: #0f172a; }
.assess-page.light .nav-progress { color: #666; }
.assess-page.light .answer-card-hint { color: #64748b; }

/* ═══ 欢迎页 ═════════════════════════════ */
.assess-page.light .hero-icon-ring {
  background: var(--pk-accent-soft);
  border-color: rgba(99,102,241,0.2);
}
.assess-page.light .hero-icon-txt { color: var(--pk-grn); }
.assess-page.light .welcome-title { color: #0f172a; }
.assess-page.light .welcome-sub { color: #666; }

/* 数据卡片 */
.assess-page.light .stat-card {
  background: rgba(255,255,255,0.9);
  border-color: #e5e5e5;
}
.assess-page.light .stat-num { color: var(--pk-grn); }
.assess-page.light .stat-label { color: #666; }
.assess-page.light .mode-card {
  background: rgba(255,255,255,0.9);
  border-color: #e5e5e5;
}
.assess-page.light .mode-card.selected {
  background: rgba(37,99,235,0.08);
  border-color: rgba(37,99,235,0.42);
}
.assess-page.light .mode-title { color: #0f172a; }
.assess-page.light .mode-desc { color: #64748b; }
.assess-page.light .recommend-reason { color: var(--pk-grn); }
.assess-page.light .recommend-badge { background: rgba(22, 163, 74, 0.12); color: #15803d; }

/* 特性列表 */
.assess-page.light .feature-txt { color: #333; }

/* 开始按钮 — 保持渐变，调浅阴影 */
.assess-page.light .start-btn {
  box-shadow: 0 8rpx 32rpx rgba(37,99,235,0.2);
}

/* ═══ 答题页 ═════════════════════════════ */
.assess-page.light .progress-bar { background: rgba(0,0,0,0.06); }

.assess-page.light .question-card {
  background: rgba(255,255,255,0.92);
  border-color: #e5e5e5;
}
.assess-page.light .q-type {
  background: var(--pk-accent-soft);
  color: var(--pk-grn);
}
.assess-page.light .q-diff {
  background: #f5f5f5;
  color: #666;
}
.assess-page.light .q-stem { color: #0f172a; }

/* 选项 */
.assess-page.light .option {
  background: #ffffff;
  border-color: #e5e5e5;
}
.assess-page.light .option:active { border-color: rgba(59,130,246,0.3); }
.assess-page.light .option.selected {
  border-color: var(--pk-grn);
  background: var(--pk-accent-soft);
}
.assess-page.light .opt-key {
  background: #f5f5f5;
}
.assess-page.light .opt-key-txt { color: #666; }
.assess-page.light .option.selected .opt-key { background: var(--pk-grn); }
.assess-page.light .option.selected .opt-key-txt { color: #fff; }
.assess-page.light .opt-text { color: #333; }

/* 导航按钮 */
.assess-page.light .quiz-nav-btn {
  background: #f5f5f5;
}
.assess-page.light .quiz-nav-btn.disabled { opacity: 0.3; }
.assess-page.light .quiz-nav-txt { color: #333; }
.assess-page.light .quiz-nav-btn.primary { background: var(--pk-grn); }
.assess-page.light .quiz-nav-btn.primary .quiz-nav-txt { color: #fff; }
.assess-page.light .quiz-nav-btn.submit { background: #16a34a; }
.assess-page.light .quiz-nav-btn.submit .quiz-nav-txt { color: #fff; }

/* ═══ 加载 ═══════════════════════════════ */
.assess-page.light .loading-spinner {
  border-color: rgba(0,0,0,0.08);
  border-top-color: var(--pk-grn);
}
.assess-page.light .loading-txt { color: #0f172a; }
.assess-page.light .loading-sub { color: #666; }

/* ═══ 结果页 ═════════════════════════════ */
.assess-page.light .score-ring {
  background: rgba(255,255,255,0.92);
  border-color: rgba(59,130,246,0.2);
  box-shadow: 0 0 40rpx rgba(72, 128, 106, 0.1);
}
.assess-page.light .score-num { color: #0f172a; }
.assess-page.light .score-label { color: #666; }
.assess-page.light .level-txt { color: #0f172a; }

/* 章节掌握度 */
.assess-page.light .section-title { color: #333; }
.assess-page.light .chapter-name { color: #333; }
.assess-page.light .chapter-bar-wrap { background: rgba(0,0,0,0.06); }
.assess-page.light .chapter-pct { color: #666; }

/* 学员画像 */
.assess-page.light .archetype-card {
  background: rgba(255,255,255,0.92);
  border-color: #e5e5e5;
}
.assess-page.light .archetype-label { color: #666; }
.assess-page.light .archetype-name { color: #0f172a; }
.assess-page.light .archetype-desc { color: #333; }
.assess-page.light .trait-tag {
  color: #333;
  background: #f5f5f5;
  border-color: #e5e5e5;
}
.assess-page.light .archetype-tip {
  background: #f8fafc;
}
.assess-page.light .tip-label { color: #666; }
.assess-page.light .tip-text { color: #333; }

/* 认知风格 */
.assess-page.light .insight-card {
  background: rgba(255,255,255,0.92);
  border-color: #e5e5e5;
}
.assess-page.light .insight-label { color: #666; }
.assess-page.light .insight-value { color: var(--pk-grn); }
.assess-page.light .insight-desc { color: #666; }

/* 优先攻克 */
.assess-page.light .priority-item {
  background: rgba(239,68,68,0.05);
  border-color: rgba(239,68,68,0.1);
}
.assess-page.light .priority-name { color: #333; }

/* 操作按钮 */
.assess-page.light .result-btn {
  background: #f5f5f5;
}
.assess-page.light .result-btn.primary {
  background: var(--pk-grn);
