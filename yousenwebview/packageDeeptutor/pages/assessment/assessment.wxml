<!-- pages/assessment/assessment.wxml — 摸底测试 -->
<view class="assess-page {{isDark?'':'light'}}">

  <!-- 呼吸极光背景（低端设备跳过） -->
  <view class="aurora-layer" wx:if="{{enableOrbs}}">
    <view class="orb orb1"></view>
    <view class="orb orb2"></view>
    <view class="orb orb3"></view>
  </view>
  <image class="bg-horizon" src="../../images/bg_horizon.jpg" mode="aspectFill" />

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-content">
      <view class="nav-back" bindtap="goBack">
        <text class="nav-back-arrow">‹</text>
      </view>
      <text class="nav-title">{{stage === 'result' ? '诊断报告' : '摸底测试'}}</text>
      <view style="flex:1"></view>
      <text class="nav-progress" wx:if="{{stage === 'quiz'}}">{{currentIndex + 1}} / {{questions.length}}</text>
    </view>
  </view>

  <scroll-view class="page-body" scroll-y enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}" style="top:{{navHeight}}px">

    <!-- ═══ 欢迎页 ═══ -->
    <view class="welcome" wx:if="{{stage === 'welcome'}}">

      <!-- 顶部撑开空间 -->
      <view style="height:12vh"></view>

      <!-- Hero -->
      <view class="welcome-hero">
        <view class="hero-icon-ring">
          <text class="hero-icon-txt">AI</text>
        </view>
        <text class="welcome-title">{{welcomeTitle}}</text>
        <text class="welcome-sub">{{welcomeSub}}</text>
      </view>

      <!-- 数据卡片 -->
      <view class="stats-row">
        <view class="stat-card">
          <text class="stat-num">{{welcomeQuestionCount}}</text>
          <text class="stat-label">{{welcomeQuestionLabel}}</text>
        </view>
        <view class="stat-card">
          <text class="stat-num">{{welcomeDuration}}</text>
          <text class="stat-label">分钟</text>
        </view>
        <view class="stat-card">
          <text class="stat-num">{{welcomeFormCount}}</text>
          <text class="stat-label">套轮换</text>
        </view>
      </view>

      <view class="mode-switch">
        <view class="mode-card {{assessmentMode === 'diagnostic' ? 'selected' : ''}}" bindtap="onSelectAssessmentMode" data-mode="diagnostic">
          <view class="mode-title-row">
            <text class="mode-title">综合摸底</text>
            <text class="recommend-badge" wx:if="{{recommendedMode === 'diagnostic'}}">推荐</text>
          </view>
          <text class="mode-desc">20 题 · 全科校准</text>
        </view>
        <view class="mode-card {{assessmentMode === 'topic' ? 'selected' : ''}}" bindtap="onSelectAssessmentMode" data-mode="topic">
          <view class="mode-title-row">
            <text class="mode-title">专题测评</text>
            <text class="recommend-badge" wx:if="{{recommendedMode === 'topic'}}">推荐</text>
          </view>
          <text class="mode-desc">12 题 · 选择知识模块</text>
        </view>
      </view>
      <text class="recommend-reason" wx:if="{{assessmentRecommendationReason}}">{{assessmentRecommendationReason}}</text>

      <view class="topic-catalog" wx:if="{{assessmentMode === 'topic'}}">
        <view class="topic-head">
          <text class="topic-head-title">专题测评目录</text>
          <text class="topic-head-sub">开放专题按 3 套试运行 / 5 套稳定分级展示</text>
        </view>
        <text class="topic-catalog-error" wx:if="{{topicCatalogError}}">{{topicCatalogError}}</text>
        <view class="topic-grid">
          <view
            class="topic-card {{item.topicId === selectedTopicId ? 'selected' : ''}} {{item.enabled ? '' : 'disabled'}}"
            wx:for="{{topicCatalog}}"
            wx:key="topicId"
            bindtap="onSelectTopic"
            data-topic-id="{{item.topicId}}"
          >
            <text class="topic-name">{{item.label}}</text>
            <text class="topic-desc">{{item.description}}</text>
            <view class="topic-status-row">
              <text class="topic-status">{{item.statusLabel}}</text>
              <text class="recommend-badge small" wx:if="{{item.recommended}}">推荐</text>
            </view>
          </view>
        </view>
      </view>

      <view class="welcome-features">
        <view class="feature-item">
          <view class="feature-dot"></view>
          <text class="feature-txt">整卷提交后统一出分</text>
        </view>
        <view class="feature-item">
          <view class="feature-dot"></view>
          <text class="feature-txt">定位本次错题和知识点</text>
        </view>
        <view class="feature-item">
          <view class="feature-dot"></view>
          <text class="feature-txt">记录到学情和错题本</text>
        </view>
      </view>

      <!-- 开始按钮 -->
      <view class="start-btn" bindtap="onStart">
        <text class="start-btn-txt">开始诊断</text>
      </view>

      <view style="height:120rpx"></view>
    </view>

    <!-- ═══ 答题页 ═══ -->
    <view class="quiz" wx:elif="{{stage === 'quiz' && questions.length}}">
      <!-- 进度条 -->
      <view class="progress-bar">
        <view class="progress-fill" style="width:{{(currentIndex + 1) / questions.length * 100}}%"></view>
      </view>

      <!-- 答题卡 -->
      <view class="answer-card">
        <view class="readonly-banner" wx:if="{{readOnlyBanner}}">
          <text class="readonly-banner-txt">{{readOnlyBanner}}</text>
        </view>
        <view class="answer-card-meta">
          <text class="answer-card-title">答题卡</text>
          <text class="answer-card-count">已答 {{answeredCount}} / {{questions.length}}</text>
        </view>
        <text class="answer-card-hint">点数字可跳题，已选答案会保留。</text>
        <text class="answer-card-notice" wx:if="{{assessmentNotice}}">{{assessmentNotice}}</text>
        <view class="answer-grid">
          <view
            class="answer-chip {{item.answered ? 'answered' : ''}} {{item.current ? 'current' : ''}}"
            wx:for="{{answerSheet}}"
            wx:key="id"
            bindtap="onJumpQuestion"
            data-index="{{item.index}}"
          >
            <text class="answer-chip-txt">{{item.number}}</text>
          </view>
        </view>
      </view>

      <!-- 题目卡片 -->
      <view class="question-card">
        <view class="q-header">
          <text class="q-type">{{currentQ.question_type === 'profile_probe' ? '学习画像' : currentQ.question_type === 'multi_choice' ? '多选题' : '单选题'}}</text>
          <text class="q-diff" wx:if="{{currentQ.difficulty}}">{{currentQ.difficulty === 'hard' ? '难' : currentQ.difficulty === 'medium' ? '中' : '易'}}</text>
        </view>
        <text class="q-stem">{{currentQ.question_stem}}</text>

        <!-- 选项 -->
        <view class="options">
          <view
            class="option {{selMap[currentQ.id + '_' + opt.key] ? 'selected' : ''}}"
            wx:for="{{currentQ.options}}"
            wx:key="key"
            wx:for-item="opt"
            bindtap="onSelectOption"
            data-key="{{opt.key}}"
          >
            <view class="opt-key">
              <text class="opt-key-txt">{{opt.key}}</text>
            </view>
            <text class="opt-text">{{opt.text}}</text>
          </view>
        </view>
      </view>

      <!-- 导航按钮 -->
      <view class="quiz-nav">
        <view class="quiz-nav-btn {{currentIndex === 0 ? 'disabled' : ''}}" bindtap="onPrev">
          <text class="quiz-nav-txt">上一题</text>
        </view>
        <view wx:if="{{currentIndex < questions.length - 1}}" class="quiz-nav-btn primary" bindtap="onNext">
          <text class="quiz-nav-txt">下一题</text>
        </view>
        <view wx:else class="quiz-nav-btn submit" bindtap="onSubmit">
          <text class="quiz-nav-txt">提交答卷</text>
        </view>
      </view>

      <view style="height:120rpx"></view>
    </view>

    <!-- ═══ 加载中 ═══ -->
    <view class="loading-view" wx:elif="{{stage === 'loading'}}">
      <view class="loading-spinner"></view>
      <text class="loading-txt">正在分析答题数据...</text>
      <text class="loading-sub">正在生成本次专题测评报告</text>
    </view>

    <!-- ═══ 结果页 ═══ -->
    <view class="result" wx:elif="{{stage === 'result'}}">
      <block wx:if="{{serverReportMode}}">
        <view class="dr-hero">
          <view class="dr-hero-top">
            <view class="dr-hero-copy">
              <text class="dr-kicker">{{topicLabel}} · {{scoredCount}} 题 · 已完成</text>
              <text class="dr-title">{{resultDiagnosisTitle}}</text>
            </view>
            <view class="dr-score-block" aria-label="得分 {{resultScore}} 分">
              <view class="dr-score-ring">
                <view class="dr-score-inner">
                  <text class="dr-score-num">{{resultScore}}</text>
                  <text class="dr-score-label">分</text>
                </view>
              </view>
              <text class="dr-score-caption">{{scoreStatusLabel}}</text>
            </view>
          </view>
          <text class="dr-hero-desc">本次答对 {{correctCount}} / {{scoredCount}} 题。优先修 {{resultShortcoming}}，今天先完成一轮 8 分钟补弱。</text>
          <view class="dr-conclusion-grid">
            <view class="dr-conclusion-cell">
              <text class="dr-cell-label">这次测了什么</text>
              <text class="dr-cell-value">{{topicLabel}}</text>
            </view>
            <view class="dr-conclusion-cell">
              <text class="dr-cell-label">诊断可信度</text>
              <text class="dr-cell-value">{{resultConfidenceLabel}} · {{resultEvidenceCount}} 题证据</text>
            </view>
            <view class="dr-conclusion-cell">
              <text class="dr-cell-label">主要短板</text>
              <text class="dr-cell-value">{{resultShortcoming}}</text>
            </view>
            <view class="dr-conclusion-cell">
              <text class="dr-cell-label">下一步先做</text>
              <text class="dr-cell-value">8 分钟补弱训练</text>
            </view>
          </view>
          <view class="dr-hero-actions">
            <view class="dr-primary-btn" bindtap="goLearningPlan">
              <text>开始 8 分钟补弱</text>
            </view>
            <view class="dr-ghost-btn">
              <text>看依据</text>
            </view>
          </view>
        </view>

        <view class="dr-metric-row">
          <view class="dr-metric">
            <text class="dr-metric-value">{{scoredCount}}题</text>
            <text class="dr-metric-label">测评证据</text>
          </view>
          <view class="dr-metric">
            <text class="dr-metric-value">{{resultConfidenceLabel}}</text>
            <text class="dr-metric-label">诊断可信度</text>
          </view>
          <view class="dr-metric">
            <text class="dr-metric-value">{{resultPrescriptionStatus}}</text>
            <text class="dr-metric-label">训练处方</text>
          </view>
        </view>

        <view class="dr-section dr-wrong-section" wx:if="{{wrongItems.length}}">
          <view class="dr-section-head">
            <view>
              <text class="dr-kicker">错题讲评</text>
              <text class="dr-section-title">默认看讲评，不重复堆原题</text>
            </view>
            <view class="dr-filter-btn">
              <text>筛选错因</text>
            </view>
          </view>

          <view class="dr-wrong-list">
            <view class="dr-wrong-card" wx:for="{{wrongItems}}" wx:key="questionId">
              <view class="dr-wrong-top">
                <text class="dr-q-num">第 {{item.index}} 题</text>
                <text class="dr-status-badge">{{item.issueBadge}}</text>
              </view>
              <text class="dr-stem">{{item.stem}}</text>
              <view class="dr-choice-list" wx:if="{{item.options.length}}">
                <view class="dr-choice" wx:for="{{item.options}}" wx:for-item="opt" wx:key="key">
                  <text class="dr-choice-key">{{opt.key}}</text>
                  <text class="dr-choice-text">{{opt.text}}</text>
                </view>
              </view>
              <view class="dr-answer-row">
                <view class="dr-answer-box">
                  <text class="dr-answer-label">你的答案</text>
                  <text class="dr-answer-value">{{item.learnerAnswer || '未作答'}}</text>
                </view>
                <view class="dr-answer-box">
                  <text class="dr-answer-label">正确答案</text>
                  <text class="dr-answer-value">{{item.correctAnswer}}</text>
                </view>
              </view>
              <text class="dr-verdict">{{item.explanation}}</text>
              <view class="dr-simple-actions">
                <view class="dr-same-type-btn" bindtap="onPracticeWrongItem" data-question-id="{{item.questionId}}">
                  <text>练 3 道同类题</text>
                </view>
                <view class="dr-ai-btn" bindtap="onToggleWrongDetail" data-question-id="{{item.questionId}}">
                  <text>{{item.expanded ? '收起本题讲评' : '展开本题讲评'}}</text>
                </view>
              </view>
              <view class="dr-detail" wx:if="{{item.expanded}}">
                <view class="dr-detail-head">
                  <view>
                    <text class="dr-detail-title">本题讲评</text>
                    <text class="dr-detail-sub">为什么错 · 原因分析 · 采分点 · 易错点 · 口诀</text>
                  </view>
                  <text class="dr-detail-status">已展开</text>
                </view>
                <view class="dr-review-section">
                  <text class="dr-review-title">题干关键词</text>
                  <view class="dr-chip-row">
                    <text class="dr-chip" wx:for="{{item.detail.keyTerms}}" wx:key="*this">{{item}}</text>
                  </view>
                </view>
                <view class="dr-review-section">
                  <text class="dr-review-title">为什么错</text>
                  <text class="dr-review-text">{{item.detail.whyWrong}}</text>
                </view>
                <view class="dr-review-section">
                  <text class="dr-review-title">原因分析</text>
                  <text class="dr-review-text">{{item.detail.cause}}</text>
                </view>
                <view class="dr-review-section">
                  <text class="dr-review-title">采分点</text>
                  <text class="dr-review-text">{{item.detail.scoringPoints}}</text>
                </view>
                <view class="dr-review-section">
                  <text class="dr-review-title">选项拆解</text>
                  <view class="dr-option-review-list">
                    <view class="dr-option-review {{opt.statusClass}}" wx:for="{{item.optionReviews}}" wx:for-item="opt" wx:key="key">
                      <text class="dr-option-key">{{opt.key}}</text>
                      <text class="dr-option-text">{{opt.review}}</text>
                      <text class="dr-option-tag" wx:if="{{opt.statusLabel}}">{{opt.statusLabel}}</text>
                    </view>
                  </view>
                </view>
                <view class="dr-review-section dr-memory-section">
                  <text class="dr-review-title">记忆口诀</text>
                  <text class="dr-review-text">{{item.detail.mnemonic}}</text>
                </view>
                <view class="dr-review-section">
                  <text class="dr-review-title">易错点</text>
                  <text class="dr-review-text">{{item.detail.pitfall}}</text>
                </view>
                <view class="dr-review-section dr-source-section">
                  <text class="dr-review-title">依据</text>
                  <text class="dr-review-text">{{item.detail.source}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="dr-section dr-card" wx:if="{{issueSummary.length}}">
          <text class="dr-kicker">错因结构</text>
          <text class="dr-section-title">把错误归成 5 类可训练问题</text>
          <text class="dr-section-note">不是列错题，而是先告诉你主要错在什么类型；前 3 类优先训练。</text>
          <view class="dr-issue-list">
            <view class="dr-issue" wx:for="{{issueSummary}}" wx:key="rank">
              <text class="dr-issue-rank">{{item.rank}}</text>
              <view class="dr-issue-copy">
                <text class="dr-issue-title">{{item.title}}</text>
                <text class="dr-issue-desc">{{item.desc}}</text>
              </view>
              <text class="dr-issue-count">{{item.countLabel}}</text>
            </view>
          </view>
        </view>

        <view class="dr-section dr-card" wx:if="{{actionKnowledgeMap.length}}">
          <text class="dr-kicker">掌握地图</text>
          <text class="dr-section-title">先补弱项，不平均用力</text>
          <text class="dr-section-note">知识点表现只回答“先补哪里”，不做无行动意义的漂亮图表。</text>
          <view class="dr-map-list">
            <view class="dr-map-row" wx:for="{{actionKnowledgeMap}}" wx:key="name">
              <text class="dr-map-name">{{item.name}}</text>
              <view class="dr-map-track">
                <view class="dr-map-fill {{item.actionClass}}" style="width:{{item.pct}}%"></view>
              </view>
              <text class="dr-map-action">{{item.actionLabel}}</text>
            </view>
          </view>
          <view class="dr-chip-row">
            <text class="dr-chip {{item.actionClass}}" wx:for="{{actionKnowledgeMap}}" wx:key="name">{{item.name}} {{item.correct}}/{{item.attempted}}</text>
          </view>
        </view>

        <view class="dr-section dr-card">
          <text class="dr-kicker">训练处方</text>
          <text class="dr-section-title">接下来按这 3 步补弱</text>
          <text class="dr-section-note">先看最关键的错题，再做同类题，最后用 1 道新题确认是否改掉。</text>
          <view class="dr-step-list">
            <view class="dr-step" wx:for="{{prescriptionSteps}}" wx:key="index">
              <text class="dr-step-num">{{item.index}}</text>
              <view class="dr-step-copy">
                <text class="dr-step-title">{{item.title}}</text>
                <text class="dr-step-desc">{{item.desc}}</text>
              </view>
              <text class="dr-step-time">{{item.time}}</text>
            </view>
          </view>
        </view>

        <view class="degraded-card" wx:if="{{degradedCopy}}">
          <text class="degraded-title">同步状态</text>
          <text class="degraded-text">{{degradedCopy}}</text>
        </view>
      </block>

      <block wx:else>

      <!-- 1. 分数 + 等级 -->
      <view class="score-ring-wrap">
        <view class="score-ring">
          <text class="score-num">{{resultScore}}</text>
          <text class="score-label">综合得分</text>
        </view>
      </view>
      <view class="level-badge level-{{resultLevel}}">
        <text class="level-txt">{{resultLevelName}}</text>
      </view>

      <!-- 2. 学员画像（核心卡片） -->
      <view class="archetype-card" wx:if="{{archetype}}" style="border-left-color:{{archetypeColor}}">
        <view class="archetype-header">
          <view class="archetype-icon" style="background:{{archetypeColor}}">
            <text class="archetype-icon-txt">{{archetypeIcon}}</text>
          </view>
          <view class="archetype-title-col">
            <text class="archetype-label">你的学习类型</text>
            <text class="archetype-name">{{archetypeName}}</text>
          </view>
        </view>
        <text class="archetype-desc" wx:if="{{archetypeDesc}}">{{archetypeDesc}}</text>
        <view class="archetype-traits" wx:if="{{archetypeTraits.length}}">
          <text class="trait-tag" wx:for="{{archetypeTraits}}" wx:key="index">{{item}}</text>
        </view>
        <view class="archetype-tip" wx:if="{{archetypeTip}}">
          <text class="tip-label">学习建议</text>
          <text class="tip-text">{{archetypeTip}}</text>
        </view>
      </view>

      <!-- 3. 认知风格 -->
      <view class="insight-row" wx:if="{{responseLabel || calibrationLabel}}">
        <view class="insight-card" wx:if="{{responseLabel}}">
          <text class="insight-label">答题风格</text>
          <text class="insight-value">{{responseLabel}}</text>
          <text class="insight-desc">{{responseDesc}}</text>
        </view>
        <view class="insight-card" wx:if="{{calibrationLabel}}">
          <text class="insight-label">自我评估</text>
          <text class="insight-value">{{calibrationLabel}}</text>
        </view>
        <view class="insight-card" wx:if="{{errorPatternName}}">
          <text class="insight-label">错误模式</text>
          <text class="insight-value">{{errorPatternName}}</text>
        </view>
      </view>

      <!-- 4. 章节掌握度 -->
      <text class="section-title" wx:if="{{chapterList.length}}">章节掌握度</text>
      <view class="chapter-grid" wx:if="{{chapterList.length}}">
        <view class="chapter-item" wx:for="{{chapterList}}" wx:key="name">
          <text class="chapter-name">{{item.name}}</text>
          <view class="chapter-bar-wrap">
            <view class="chapter-bar {{item.pct >= 70 ? 'green' : item.pct >= 40 ? 'gold' : 'red'}}" style="width:{{item.pct}}%"></view>
          </view>
          <text class="chapter-pct">{{item.pct}}%</text>
        </view>
      </view>

      <!-- 5. 优先攻克 -->
      <view class="priority-card" wx:if="{{priorityChapters.length}}">
        <text class="section-title">优先攻克</text>
        <view class="priority-list">
          <view class="priority-item" wx:for="{{priorityChapters}}" wx:key="index">
            <text class="priority-idx">{{index + 1}}</text>
            <text class="priority-name">{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 6. 操作 -->
      <view class="result-actions">
        <view class="result-btn primary" bindtap="goLearningPlan">
          <text class="result-btn-txt">去学习计划查看</text>
        </view>
        <view class="result-btn" bindtap="onRetake">
          <text class="result-btn-txt secondary-txt">重新测试</text>
        </view>
      </view>
      </block>

      <view style="height:120rpx"></view>
    </view>

  </scroll-view>
</view>
