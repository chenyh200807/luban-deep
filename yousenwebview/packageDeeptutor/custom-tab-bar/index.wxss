/* 中央朱红章(问鲁班):.pk-seal 底 + 纸边圈,凸出壳顶 */
.tab-item--center {
  color: var(--pk-t1);
  margin-top: -60rpx;
  justify-content: flex-end;
  gap: 8rpx;
}
.tab-item--center .tab-text {
  font-weight: 800;
}
.tab-seal {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 8rpx solid var(--pk-card);
  box-sizing: content-box;
  box-shadow: 0 20rpx 48rpx rgba(207, 68, 54, 0.35);
}
.tab-seal-logo {
  width: 52rpx;
  height: 52rpx;
}
