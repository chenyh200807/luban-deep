/* 中央朱红章(问鲁班):.pk-seal 底 + 纸边圈,凸出壳顶 */
.tab-item--center {
  color: var(--pk-t1);
}
.tab-item--center .tab-text {
  font-weight: 800;
}
.tab-seal {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 8rpx solid var(--pk-paper);
  box-sizing: content-box;
}
.tab-seal-logo {
  width: 48rpx;
  height: 48rpx;
}
