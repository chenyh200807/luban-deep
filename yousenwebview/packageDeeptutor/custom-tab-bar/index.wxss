/* ── 亮色（宣纸）─────────────────────────────── */
.tab-bar.light {
  background: rgba(250, 249, 245, 0.98);
  border-top-color: #e7e3d5;
}
.tab-bar.light .tab-text {
  color: #8a8574;
}
.tab-bar.light .tab-item.active .tab-text {
  color: #26241f;
}

/* 问鲁班激活字色 = 朱红（置于亮色块之后以覆盖同权重规则） */
.tab-item-seal.active .tab-text,
.tab-bar.light .tab-item-seal.active .tab-text {
  color: #cf4436;
}
