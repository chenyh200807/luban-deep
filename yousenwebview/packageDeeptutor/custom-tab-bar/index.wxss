/* workspace-shell 五 tab（第10轮「纸墨朱竹」）
 * 色值对应 theme.wxss 的 --lb-* token（组件不依赖宿主页 @import，故用字面量）：
 * dark bg#101315 t1#f1efe8 t3#8b9398 / light 宣纸#faf9f5 墨#26241f t3#8a8574
 * 朱红 #cf4436 只用于问鲁班红章。 */

.tab-bar {
  display: flex;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 140rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #101315;
  border-top: 1rpx solid rgba(241, 239, 232, 0.08);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding-top: 10rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.85;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.tab-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #8b9398;
}

.tab-item.active .tab-icon {
  opacity: 1;
}
.tab-item.active .tab-text {
  color: #f1efe8;
  font-weight: 700;
}

/* ── 问鲁班中央红章（54px 圆形 #cf4436 白边，凸起）───────── */
.tab-item-seal {
  justify-content: flex-start;
}

.tab-seal {
  width: 108rpx; /* 54px */
  height: 108rpx;
  margin-top: -50rpx;
  border-radius: 50%;
  background: #cf4436;
  border: 6rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(207, 68, 54, 0.35);
}

.tab-seal-text {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

/* ── 线性图标（1.8 stroke；源文件见 images/icons/*.svg）────
