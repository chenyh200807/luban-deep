/* 共享五 tab 纸墨壳 — token 单一权威 = styles/paper-ink.wxss
 * 根节点带 .paper(夜基)/.paper.light(宣纸亮),--pk-* 在组件内自洽解析。
 * 视觉源: learn 页第 10 轮 lr-tabbar 定稿(线性 mask 图标 + 中央朱红章)。
 * 总高保持 140rpx + safe-area —— chat 页 workspaceShellHeight 布局算式依赖。 */
@import "/packageDeeptutor/styles/paper-ink.wxss";

.tab-bar {
  display: flex;
  justify-content: space-around;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 140rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--pk-card);
  border-top: 1rpx solid var(--pk-bd);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  padding-bottom: 18rpx;
  color: var(--pk-t3);
}

.tab-item.active {
  color: var(--pk-t1);
}

.tab-text {
  font-size: 24rpx;
  font-weight: 600;
  color: inherit;
}
.tab-item.active .tab-text {
  font-weight: 800;
}

/* 线性图标:SVG 作 mask,颜色跟 currentColor(主题+激活态自适应) */
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  background-color: currentColor;
  -webkit-mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-size: contain;
  mask-repeat: no-repeat;
  mask-position: center;
}
