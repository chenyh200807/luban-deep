/* ============================================================
 * paper-ink.wxss — 纸墨朱竹设计 token(五模块第 10 轮定稿)
 * 源: docs/plan/鲁班移动端提分闭环/设计资产-五模块第10轮/鲁班智考五模块·第10轮定稿.dc.html #10a/#10b
 * 语言: 宣纸底 + 点阵 / 暖白卡 / 墨色数字 / 竹青正向 / 朱红只留品牌四处
 * 主题: 夜(10b)= 基; .light(10a)覆盖 —— 匹配现有 {{isDark ? '' : 'light'}} 惯例
 * 单位: rpx = 设计 px × 750/402 ≈ ×1.866
 * ============================================================ */

/* ── 夜宣纸(10b · 默认基) ─────────────────────────────── */
.paper {
  --pk-paper: #1c1a15;       /* 页面纸底 */
  --pk-dot: rgba(240, 237, 225, 0.06);
  --pk-card: #26231d;        /* 暖卡 */
  --pk-bd: #37332a;          /* 卡边 */
  --pk-t1: #f0ede1;          /* 墨字·主 */
  --pk-t2: #b7b2a2;          /* 墨字·次 */
  --pk-t3: #8a8574;          /* 墨字·弱 */
  --pk-red: #cf4436;         /* 朱红·品牌四处(logo/播放/红海报/问鲁班) */
  --pk-grn: #7fb99d;         /* 竹青·正向 */
  --pk-gauge: #3a362c;       /* 环底 */
  --pk-warn: #c26555;        /* 赭·警示 */
  --pk-ink-btn: #f0ede1;     /* 主按钮(夜=纸色反转) */
  --pk-ink-btn-t: #26231d;   /* 主按钮文字 */
  --pk-shadow: rgba(0, 0, 0, 0.28);
}

/* ── 宣纸亮(10a · .light 覆盖) ────────────────────────── */
.paper.light {
  --pk-paper: #f5f3ec;
  --pk-dot: #e4e0d0;
  --pk-card: #fffdf8;
  --pk-bd: #e7e3d5;
  --pk-t1: #26241f;
  --pk-t2: #5b584e;
  --pk-t3: #96917e;
  --pk-red: #cf4436;
  --pk-grn: #48806a;
  --pk-gauge: #e9e5d7;
  --pk-warn: #c26555;
  --pk-ink-btn: #26241f;     /* 亮=墨色主按钮 */
  --pk-ink-btn-t: #f5f3ec;
  --pk-shadow: rgba(38, 36, 31, 0.06);
}

/* ── 宣纸底 + 18px 点阵(全 app 铺满,舞台展开零边界) ── */
.pk-paper-bg {
  background-color: var(--pk-paper);
  background-image: radial-gradient(var(--pk-dot) 1.3rpx, transparent 1.3rpx);
  background-size: 34rpx 34rpx;
}

/* ── 暖白卡 ─────────────────────────────────────────────── */
.pk-card {
  background: var(--pk-card);
  border: 1rpx solid var(--pk-bd);
  border-radius: 30rpx;
  box-shadow: 0 2rpx 12rpx var(--pk-shadow);
}

/* ── 层级: kicker → 标题 → 说明 ───────────────────────── */
.pk-kicker {
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: var(--pk-t3);
  font-weight: 700;
}
.pk-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--pk-t1);
  line-height: 1.3;
}
.pk-desc {
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--pk-t2);
}

/* ── chip(正向/中性) ───────────────────────────────────── */
.pk-chip {
  padding: 6rpx 15rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}
.pk-chip--grn {
  background: rgba(72, 128, 106, 0.1);
  color: var(--pk-grn);
}

/* ── 主按钮: 墨色(夜反转纸色) ─────────────────────────── */
.pk-btn-ink {
  min-height: 86rpx;
  border-radius: 22rpx;
  background: var(--pk-ink-btn);
  color: var(--pk-ink-btn-t);
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx var(--pk-shadow);
}
.pk-btn-ghost {
  min-height: 86rpx;
  padding: 0 26rpx;
  border-radius: 22rpx;
  border: 1rpx solid var(--pk-bd);
  background: transparent;
  color: var(--pk-t2);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── 竹青进度条 ─────────────────────────────────────────── */
.pk-progress {
  height: 18rpx;
  border-radius: 9rpx;
  background: var(--pk-gauge);
  overflow: hidden;
}
.pk-progress__fill {
  height: 100%;
  border-radius: 9rpx;
  background: var(--pk-grn);
}

/* ── 书法海报(84×112 → rpx),三态: 墨已学 / 朱推荐 / 纸未学-锁 ──
 * 学习 home 课程架 + stations 路线图复用同一组件 */
.pk-poster {
  position: relative;
  flex-shrink: 0;
  width: 157rpx;
  height: 209rpx;
  border-radius: 19rpx;
  overflow: hidden;
  box-shadow: 0 3rpx 10rpx var(--pk-shadow);
}
.pk-poster__name {   /* 竖排书法考点名 */
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  writing-mode: vertical-rl;
  font-family: "Long Cang", "Kaiti SC", serif;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  line-height: 1;
}
.pk-poster__slot {   /* 左上 slot 徽标 S2/S4… */
  position: absolute;
  top: 15rpx;
  left: 15rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 19rpx;
  font-weight: 800;
}
.pk-poster__foot {
  position: absolute;
  left: 15rpx;
  bottom: 15rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.pk-poster__bar {    /* 底部进度线 */
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 6rpx;
}
/* 墨已学 */
.pk-poster--ink {
  background-color: #26241f;
  background-image: radial-gradient(rgba(244, 243, 236, 0.08) 1.3rpx, transparent 1.3rpx);
  background-size: 26rpx 26rpx;
}
.pk-poster--ink .pk-poster__name { color: #f4f3ec; }
/* 朱推荐(下一站) */
.pk-poster--red {
  background-color: #cf4436;
  background-image: radial-gradient(rgba(255, 255, 255, 0.14) 1.3rpx, transparent 1.3rpx);
  background-size: 26rpx 26rpx;
}
.pk-poster--red .pk-poster__name { color: #fff; }
/* 纸未学-锁 */
.pk-poster--paper {
  background-color: #f4f3ec;
  background-image: radial-gradient(#e4e2d7 1.3rpx, transparent 1.3rpx);
  background-size: 26rpx 26rpx;
  border: 1rpx solid var(--pk-bd);
}
.pk-poster--paper .pk-poster__name { color: #cf4436; }

/* ── 朱红品牌章(logo/播放/问鲁班) ────────────────────── */
.pk-seal {
  background: var(--pk-red);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(207, 68, 54, 0.28);
}
